# Copy to /etc/matharc-research/matharc-research.env with mode 0640.
# Values are deployment inputs, never credentials. Secrets come from the
# service manager/secret store and are intentionally absent from this file.
MATHARC_BIND_HOST=127.0.0.1
MATHARC_PORT=8000
MATHARC_RUN_PATH=/var/lib/matharc-research/runs/current.json
MATHARC_WORKSPACE=/var/lib/matharc-research/workspace
MATHARC_RUNTIME_RUN_ID=pilot-REPLACE-ME
MATHARC_RELEASE_ID=release-REPLACE-ME
MATHARC_LOG_PATH=/var/log/matharc-research/runtime.jsonl
MATHARC_BACKUP_PATH=/var/lib/matharc-research/backups
MATHARC_PER_USER_QUOTA=100
MATHARC_GLOBAL_QUOTA=1000
MATHARC_STARTUP_TIMEOUT_SECONDS=30
MATHARC_CANCEL_POLICY=SIGTERM_THEN_TIMEOUT
MATHARC_FAILURE_POLICY=classify_and_restart
MATHARC_ROLLBACK_RELEASE_ID=
MATHARC_SECRET_FILE=%d/api-token
# Provide secret material through systemd credentials or an external secret
# manager, e.g. LoadCredential=api-token:/etc/matharc-research/api-token.
