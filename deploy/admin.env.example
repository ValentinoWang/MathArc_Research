# Copy to /etc/matharc-research/admin.env with mode 0640.
# Keep credentials in the service manager/secret store in production.
MATHARC_ADMIN_ENABLED=false
MATHARC_ADMIN_TRUST_PROXY=false
MATHARC_ADMIN_DASHBOARD_PATH=/opt/matharc-research/current/docs/prototypes/admin-console.html
MATHARC_ADMIN_DATABASE_URL=postgresql://matharc_admin:REPLACE_ME@127.0.0.1:5432/matharc
MATHARC_ACCESS_SOURCE=/var/lib/matharc-research/access/access-state.json
# Optional connection tuning consumed by the deployment wrapper.
MATHARC_ADMIN_DB_CONNECT_TIMEOUT_SECONDS=10
