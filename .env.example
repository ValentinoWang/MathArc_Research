# MathArc Web service
MATHARC_HOST=0.0.0.0
MATHARC_PORT=8000

# Optional exact/formal tool command
MATHARC_LEAN_COMMAND=lake env lean

# Official Codex CLI integration
# Install with: npm install -g @openai/codex
# Configure credentials only in a local .env or deployment secret store.
CODEX_API_KEY=
MATHARC_CODEX_EXECUTABLE=codex
MATHARC_CODEX_MODEL=
MATHARC_CODEX_WORKSPACE=/app
MATHARC_CODEX_SESSION_DIR=/app/.matharc/codex-sessions
MATHARC_CODEX_SANDBOX=read-only
MATHARC_CODEX_TIMEOUT=900
MATHARC_CODEX_NETWORK=0
MATHARC_CODEX_WEB_SEARCH=disabled

# Trust boundary:
# - read-only is the default browser mode;
# - workspace-write must be selected explicitly;
# - Codex proposals never bypass MathArc claim/evidence verification gates;
# - no secret is serialized into a public reasoning trace or session ledger.
