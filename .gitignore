__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.matharc/
artifacts/
*.egg-info/
dist/
build/
.env
.DS_Store

# Harness symlink-local runtime state is machine-specific and regenerated by
# harnessctl init/link/lock; only the portable manifest and project adapter are tracked.
.harness/local.yaml
.harness/lock.yaml
.agents/skills/*
# Exception: matharc-publication is deliberately committed project content
# (predates this ignore rule), not a harnessctl-regenerated symlink target.
!.agents/skills/matharc-publication/
develop/Harness/*
