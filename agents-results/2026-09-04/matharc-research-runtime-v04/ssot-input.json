  "releases": [
    {
      "id": "RTRZ",
      "title": "RT-R0 原生运行时章程",
      "user_value": "MathArc 自己拥有执行权威、数据合同和运行边界。",
      "independent_acceptance": "权威边界、后端替换规则和依赖允许清单可被机器检查。",
      "independent_failure": "不启动真实研究；后续运行时切片保持未接受。"
    },
    {
      "id": "RTR1",
      "title": "RT-R1 单任务运行闭环",
      "user_value": "一个数学任务可以从验证、运行到候选回传形成闭环。",
      "independent_acceptance": "单任务运行合同、运行存储、评价器和第一方协调器可重放。",
      "independent_failure": "单任务失败不改变数学工作区，也不产生正式证据。"
    },
    {
      "id": "RTR2",
      "title": "RT-R2 多研究成员并行",
      "user_value": "不同研究路线可以在隔离工作区中真实并行执行。",
      "independent_acceptance": "至少三个研究成员存在真实时间重叠，写入区域和预算可审计。",
      "independent_failure": "单成员失败不破坏整轮，且不得伪造并行证据。"
    },
    {
      "id": "RTR3",
      "title": "RT-R3 持久化与恢复",
      "user_value": "中断后可以从明确的代际边界继续运行。",
      "independent_acceptance": "停止、暂停、取消、崩溃恢复和幂等导入都有明确状态。",
      "independent_failure": "不确定状态不得猜测完成、重复计费或跳过代际。"
    },
    {
      "id": "RTR4",
      "title": "RT-R4 代际学习",
      "user_value": "上一代的失败和研究经历可以改变下一代议程。",
      "independent_acceptance": "第二代明确消费第一代事实，但历史经验不直接改变数学结论。",
      "independent_failure": "蒸馏失败或缺少出处时，下一代保持未启动。"
    },
    {
      "id": "RTR5",
      "title": "RT-R5 数学验证汇合",
      "user_value": "候选结果可以经过独立验证后受控转换为正式证据。",
      "independent_acceptance": "候选身份、验证回执、证据记录和晋升边界可重放。",
      "independent_failure": "运行成功、模型自报或篡改候选都不能成为证明。"
    },
    {
      "id": "RTR6",
      "title": "RT-R6 邀请制控制台",
      "user_value": "受邀用户可以查看并受控操作研究运行。",
      "independent_acceptance": "控制台只投影 RuntimeStore，并对动作、权限和敏感信息做 fail-closed 保护。",
      "independent_failure": "浏览器不能执行任意命令、目录、环境变量或未登记后端。"
    },
    {
      "id": "RTR7",
      "title": "RT-R7 真实任务与试点",
      "user_value": "真实两代研究和邀请制试点具备可复核发布证据。",
      "independent_acceptance": "真实并行、恢复、验证、权限和用户理解检查全部有证据。",
      "independent_failure": "任一错误晋升、越权动作或不可重放结果阻断试点发布。"
    }
  ],
