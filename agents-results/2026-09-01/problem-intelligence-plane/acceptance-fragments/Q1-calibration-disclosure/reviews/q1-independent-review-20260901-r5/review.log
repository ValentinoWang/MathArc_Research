     1	"""Promotion policy: per-obligation assurance ladder (v0.3-review R4).
     2	
     3	Replaces the "max-weight path" framing the spec explicitly rejects (weight
     4	is a scheduling metric, not mathematical necessity -- a low-weight
     5	dependency can still be a load-bearing logical prerequisite). Instead:
     6	every obligation in a claim's `ReviewBundle` (R2) carries a
     7	`required_assurance`; promotion checks that *every* obligation's actually
     8	achieved assurance meets or exceeds what it asks for.
     9	
    10	Default policy (spec's own proposal, coded here as the default -- pending
    11	the chief-scientist sign-off the spec itself calls for; see module-level
    12	`DEFAULT_POLICY_STATUS` and the traceability doc for the honest boundary):
    13	a critical claim that closes partly or wholly on HUMAN_AUDIT evidence needs
    14	at least two independent reviewer groups to have approved it.
    15	
    16	Trigger / opt-in boundary: this gate only activates for a claim whose
    17	proof-capable accepted evidence includes at least one HUMAN_AUDIT item.
    18	A claim that closes purely on machine evidence (EXACT_CERTIFICATE,
    19	EXACT_COMPUTATION, FORMAL_PROOF, CHECKED_DERIVATION) is completely
    20	unaffected -- this targets exactly the "two independent HUMAN_AUDIT groups
    21	with no governance" loophole IMPROVEMENT_PLAN_V03 names as the system's
    22	largest, not every claim that has ever touched review.py.
    23	"""
    24	
    25	from __future__ import annotations
    26	
    27	from dataclasses import dataclass, field
    28	from enum import Enum
    29	from typing import TYPE_CHECKING, Any
    30	
    31	from .review import ObligationVerdictKind, ReviewLifecycleStatus, get_reviewer_roster, reviews_for_claim
    32	from .review_bundle import RequiredAssurance, ReviewBundleError, build_review_bundle
    33	from .schema import EvidenceKind, EvidenceStatus
    34	
    35	if TYPE_CHECKING:
    36	    from .trace import ResearchTrace
    37	
    38	DEFAULT_POLICY_STATUS = (
    39	    "CODED_DEFAULT_PENDING_CHIEF_SCIENTIST_SIGN_OFF -- this is the policy the "
    40	    "spec itself proposes as a starting point, not a value anyone with the "
    41	    "authority to set promotion policy has actually approved."
    42	)
    43	
    44	_MACHINE_EVIDENCE_KINDS = frozenset(
    45	    {
    46	        EvidenceKind.EXACT_CERTIFICATE.value,
    47	        EvidenceKind.EXACT_COMPUTATION.value,
    48	        EvidenceKind.FORMAL_PROOF.value,
    49	        EvidenceKind.CHECKED_DERIVATION.value,
    50	    }
    51	)
    52	
    53	
    54	class ClosureTrustClass(str, Enum):
    55	    MACHINE = "machine"
    56	    HUMAN = "human"
    57	    MIXED = "mixed"
    58	
    59	
    60	def _proof_capable_accepted_evidence(trace: "ResearchTrace", claim_id: str) -> tuple[Any, ...]:
    61	    claim = trace.claims.get(claim_id)
    62	    if claim is None:
    63	        return ()
    64	    return tuple(
    65	        trace.evidence[evidence_id]
    66	        for evidence_id in claim.evidence_ids
    67	        if evidence_id in trace.evidence
    68	        and trace.evidence[evidence_id].status is EvidenceStatus.ACCEPTED
    69	        and trace.evidence[evidence_id].kind
    70	        not in {EvidenceKind.NUMERICAL_EXPERIMENT, EvidenceKind.HEURISTIC, EvidenceKind.COUNTEREXAMPLE}
    71	    )
    72	
    73	
    74	def claim_closure_trust_class(trace: "ResearchTrace", claim_id: str) -> ClosureTrustClass:
    75	    evidence = _proof_capable_accepted_evidence(trace, claim_id)
    76	    kinds = {item.kind.value for item in evidence}
    77	    machine_present = bool(kinds & _MACHINE_EVIDENCE_KINDS)
    78	    human_present = bool(kinds - _MACHINE_EVIDENCE_KINDS)
    79	    if machine_present and human_present:
    80	        return ClosureTrustClass.MIXED
    81	    if human_present:
    82	        return ClosureTrustClass.HUMAN
    83	    return ClosureTrustClass.MACHINE
    84	
    85	
    86	def review_gate_applies(trace: "ResearchTrace", claim_id: str) -> bool:
    87	    """The R4 gate is opt-in: it only engages when the claim actually
    88	    relies on HUMAN_AUDIT evidence. A pure-machine claim never pays for
    89	    machinery it never asked for."""
    90	
    91	    evidence = _proof_capable_accepted_evidence(trace, claim_id)
    92	    return any(item.kind is EvidenceKind.HUMAN_AUDIT for item in evidence)
    93	
    94	
    95	@dataclass(slots=True, frozen=True)
    96	class ObligationAssuranceSnapshot:
    97	    obligation_id: str
    98	    required_assurance: RequiredAssurance
    99	    achieved_assurance: RequiredAssurance | None
   100	    satisfied: bool
   101	    supporting_reviewer_groups: tuple[str, ...] = ()
   102	
   103	    def to_dict(self) -> dict[str, Any]:
   104	        return {
   105	            "obligation_id": self.obligation_id,
   106	            "required_assurance": self.required_assurance.value,
   107	            "achieved_assurance": self.achieved_assurance.value if self.achieved_assurance else None,
   108	            "satisfied": self.satisfied,
   109	            "supporting_reviewer_groups": list(self.supporting_reviewer_groups),
   110	        }
   111	
   112	
   113	def _reviewer_group(trace: "ResearchTrace", roster_version: str, reviewer_id: str) -> str:
   114	    roster = get_reviewer_roster(trace, roster_version)
   115	    if roster is None:
   116	        return ""
   117	    reviewer = roster.get(reviewer_id)
   118	    return reviewer.independence_group if reviewer is not None else ""
   119	
   120	
   121	def _achieved_human_assurance(count: int) -> RequiredAssurance | None:
   122	    if count >= 2:
   123	        return RequiredAssurance.HUMAN_DOUBLE
   124	    if count >= 1:
   125	        return RequiredAssurance.HUMAN_SINGLE
   126	    return None
   127	
   128	
   129	def assurance_snapshot_for_claim(
   130	    trace: "ResearchTrace", claim_id: str
   131	) -> tuple[ObligationAssuranceSnapshot, ...]:
   132	    """Rebuild the claim's obligations fresh from current trace state (same
   133	    "re-derive, don't trust a cached decision" convention as F2's
   134	    `promotion_route_blockers`) and, for each, compute what assurance has
   135	    actually been achieved from ACTIVE, current-revision ReviewRecords."""
   136	
   137	    claim = trace.claims.get(claim_id)
   138	    if claim is None:
   139	        return ()
   140	    try:
   141	        bundle = build_review_bundle(trace, claim_id, bundle_id=f"assurance-check:{claim_id}")
   142	    except ReviewBundleError:
   143	        return ()
   144	
   145	    active_reviews = tuple(
   146	        record
   147	        for record in reviews_for_claim(trace, claim_id)
   148	        if record.lifecycle_status is ReviewLifecycleStatus.ACTIVE
   149	        and record.claim_revision == claim.revision
   150	    )
   151	
   152	    snapshots: list[ObligationAssuranceSnapshot] = []
   153	    for obligation in bundle.obligations:
   154	        if obligation.required_assurance is RequiredAssurance.MACHINE_SUFFICIENT:
   155	            # OB-DEP-* today: satisfied iff the underlying machine fact
   156	            # actually holds. The unique promotion authority already
   157	            # independently blocks on an unproved dependency; this
   158	            # snapshot just makes that fact visible per-obligation too.
   159	            dependency_id = obligation.ref.removeprefix("claim:")
   160	            dependency = trace.claims.get(dependency_id)
   161	            satisfied = dependency is not None and dependency.status.value == "PROVED"
   162	            snapshots.append(
   163	                ObligationAssuranceSnapshot(
   164	                    obligation_id=obligation.obligation_id,
   165	                    required_assurance=obligation.required_assurance,
   166	                    achieved_assurance=RequiredAssurance.MACHINE_SUFFICIENT if satisfied else None,
   167	                    satisfied=satisfied,
   168	                )
   169	            )
   170	            continue
   171	
   172	        groups: set[str] = set()
   173	        for record in active_reviews:
   174	            verdict = next(
   175	                (item for item in record.verdicts if item.obligation_id == obligation.obligation_id),
   176	                None,
   177	            )
   178	            if verdict is not None and verdict.verdict is ObligationVerdictKind.OK:
   179	                group = _reviewer_group(trace, record.roster_version, record.reviewer_id)
   180	                if group:
   181	                    groups.add(group)
   182	        achieved = _achieved_human_assurance(len(groups))
   183	        satisfied = achieved is not None and (
   184	            (obligation.required_assurance is RequiredAssurance.HUMAN_SINGLE and len(groups) >= 1)
   185	            or (obligation.required_assurance is RequiredAssurance.HUMAN_DOUBLE and len(groups) >= 2)
   186	        )
   187	        snapshots.append(
   188	            ObligationAssuranceSnapshot(
   189	                obligation_id=obligation.obligation_id,
   190	                required_assurance=obligation.required_assurance,
   191	                achieved_assurance=achieved,
   192	                satisfied=satisfied,
   193	                supporting_reviewer_groups=tuple(sorted(groups)),
   194	            )
   195	        )
   196	    return tuple(snapshots)
   197	
   198	
   199	def assurance_blockers(trace: "ResearchTrace", claim_id: str) -> tuple[str, ...]:
   200	    """Machine-readable, per-obligation promotion blockers. Empty unless
   201	    `review_gate_applies` -- see module docstring for the opt-in trigger."""
   202	
   203	    if not review_gate_applies(trace, claim_id):
   204	        return ()
   205	    blockers = []
   206	    for snapshot in assurance_snapshot_for_claim(trace, claim_id):
   207	        if not snapshot.satisfied:
   208	            blockers.append(
   209	                f"claim {claim_id} obligation {snapshot.obligation_id} requires "
   210	                f"{snapshot.required_assurance.value} but only achieved "
   211	                f"{snapshot.achieved_assurance.value if snapshot.achieved_assurance else 'nothing'}"
   212	            )
   213	    return tuple(blockers)

