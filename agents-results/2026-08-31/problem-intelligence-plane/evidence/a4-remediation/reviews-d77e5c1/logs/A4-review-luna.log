    15	def _fsync_directory(directory: Path) -> None:
    16	    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    17	    directory_fd = os.open(directory, flags)
    18	    try:
    19	        os.fsync(directory_fd)
    20	    finally:
    21	        os.close(directory_fd)
