   999	    def _item_evidence(
  1000	        self,
  1001	        item: TopicObservationInput,
  1002	        result: TopicItemResult,
  1003	        basis: str,
  1004	        *,
  1005	        persisted: SourceObservation | None = None,
  1006	        manual_id: str | None = None,
  1007	        manual_reason: ManualReviewReason | None = None,
  1008	        import_disposition: ImportDisposition | None = None,
  1009	        prior_cursor: str | None = None,
  1010	        prior_input_id: str | None = None,
