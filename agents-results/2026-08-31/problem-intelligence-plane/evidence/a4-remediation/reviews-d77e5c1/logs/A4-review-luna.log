    89	class ArtifactRecord:
    90	    artifact_id: str
    91	    sha256: str
    92	    size_bytes: int
    93	    media_type: str
    94	    relative_path: str
    95	    logical_role: str
    96	    producer: str
    97	    linked_claim_ids: tuple[str, ...] = ()
    98	    linked_tool_call_ids: tuple[str, ...] = ()
    99	    source_filename: str = ""
   100	    created_at: str = field(default_factory=utc_now)
