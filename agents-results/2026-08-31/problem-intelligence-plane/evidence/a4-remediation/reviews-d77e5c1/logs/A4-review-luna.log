   109	                    runner.run(batch("c0", "c1", input_for("A")))
   110	                    interrupted_batch = batch("c1", "c2", input_for("B"))
   111	                    expected_cursor = "c1"
   112	                    expected_observations = ["OBS-A"]
   113	                else:
