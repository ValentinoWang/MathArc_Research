from matharc.v02.source_observation import LicenseStatus, new_observation
from matharc.v02.topic_observation import TopicObservationBatch, TopicObservationInput, TopicObservationRunner

class FlipBudget(BudgetLedger):
    def __init__(self) -> None:
        super().__init__(cost_usd_limit=1.0)
        self.checks = 0
    def exhausted(self) -> bool:
        self.checks += 1
        return self.checks >= 3

def make_input(input_id: str, uri: str, content: bytes, license_status: LicenseStatus) -> TopicObservationInput:
    return TopicObservationInput(
        input_id,
        new_observation(
            observation_id=f\"OBS-{input_id}\",
            canonical_uri=uri,
            pinned_version=\"v1\",
            license_status=license_status,
            license_basis=\"probe license\",
            content_summary=\"Descriptive probe metadata.\",
            summary_basis=\"probe\",
            media_type=\"text/plain\",
            content_digest_sha256=hashlib.sha256(content).hexdigest(),
            observed_at=\"2026-09-02T08:00:00+00:00\",
        ),
        content,
    )

def make_batch(cursor: str, next_cursor: str, input_value: TopicObservationInput) -> TopicObservationBatch:
    return TopicObservationBatch(\"probe-topic\", cursor, next_cursor, (input_value,))

