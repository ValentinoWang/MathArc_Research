  1359	        elif phase == _TRANSACTION_COMMIT_INTENT:
  1360	            _require_fields(
  1361	                payload,
  1362	                common_fields
  1363	                | {
  1364	                    "target_key_sha256",
  1365	                    "target_state",
  1366	                    "target_authentication",
  1367	                    "target_literature_files",
  1368	                    "target_literature_files_sha256",
  1369	                },
  1370	                "topic observation transaction journal",
  1371	            )
