   199	        if artifact_id in self._records:
   200	            raise ValueError(f"duplicate artifact id: {artifact_id}")
   201	        sha256 = hashlib.sha256(content).hexdigest()
   202	        relative_path = Path("sha256") / sha256[:2] / sha256
   203	        target = self.root / relative_path
   204	        _ensure_directory_durable(target.parent)
   205	        if target.exists():
   206	            with target.open("rb") as existing_file:
   207	                existing = existing_file.read()
   208	                if existing != content:
   209	                    raise ValueError(f"content-address collision at {target}")
