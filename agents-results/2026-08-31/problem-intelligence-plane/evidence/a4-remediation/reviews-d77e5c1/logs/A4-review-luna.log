    25	@dataclass(slots=True)
    26	class BudgetLedger:
    27	    wall_seconds_limit: float | None = None
    28	    input_token_limit: int | None = None
    29	    output_token_limit: int | None = None
    30	    cost_usd_limit: float | None = None
    31	
    32	    spent_wall_seconds: float = 0.0
    33	    spent_input_tokens: int = 0
    34	    spent_output_tokens: int = 0
    35	    spent_cost_usd: float = 0.0
    36	    tool_call_count: int = 0
    37	    model_call_count: int = 0
    38	    divergent_usage_reports: list[dict[str, Any]] = field(default_factory=list)
    39	
    40	    def charge_tool_call(self, record: ToolCallRecord) -> None:
    41	        try:
    42	            started = _parse_iso(record.started_at)
    43	            ended = _parse_iso(record.ended_at)
    44	            self.spent_wall_seconds += max(0.0, (ended - started).total_seconds())
    45	        except ValueError:
    46	            pass
    47	        self.tool_call_count += 1
    48	
    49	    def charge_model_usage(self, usage: Mapping[str, Any]) -> None:
    50	        raw_input_tokens = usage.get("input_tokens", 0)
    51	        raw_output_tokens = usage.get("output_tokens", 0)
    52	        input_tokens = int(raw_input_tokens or 0)
    53	        output_tokens = int(raw_output_tokens or 0)
    54	        cost_usd = usage.get("cost_usd")
    55	        if (
    56	            input_tokens < 0
    57	            or output_tokens < 0
    58	            or isinstance(raw_input_tokens, (int, float)) and raw_input_tokens < 0
    59	            or isinstance(raw_output_tokens, (int, float)) and raw_output_tokens < 0
    60	        ):
    61	            raise ValueError("model usage tokens cannot be negative")
    62	        if isinstance(cost_usd, bool) or (cost_usd is not None and not isinstance(cost_usd, (int, float))):
    63	            raise ValueError("cost_usd must be a number when provided")
    64	        if isinstance(cost_usd, (int, float)) and cost_usd < 0:
    65	            raise ValueError("model usage cost_usd cannot be negative")
    66	        self.spent_input_tokens += input_tokens
    67	        self.spent_output_tokens += output_tokens
    68	        if isinstance(cost_usd, (int, float)):
    69	            self.spent_cost_usd += float(cost_usd)
    70	        self.model_call_count += 1
    71	
    72	    def reconcile_self_report(
    73	        self,
    74	        *,
    75	        source: str,
    76	        reported: Mapping[str, Any],
    77	        metered: Mapping[str, Any],
    78	        tolerance: float = 0.2,
    79	    ) -> bool:
    80	        """Flag a worker's self-reported usage that diverges from metered usage.
    81	
    82	        Returns True if the report was accepted as consistent, False if it was
    83	        flagged into divergent_usage_reports.  A worker that consistently
    84	        under-reports usage should not be trusted for budget accounting even
    85	        though the metered ledger, not the self-report, is authoritative.
    86	        """
    87	
    88	        for key in ("input_tokens", "output_tokens"):
    89	            reported_value = float(reported.get(key, 0) or 0)
    90	            metered_value = float(metered.get(key, 0) or 0)
    91	            if metered_value <= 0:
    92	                continue
    93	            if abs(reported_value - metered_value) / metered_value > tolerance:
    94	                self.divergent_usage_reports.append(
    95	                    {
    96	                        "source": source,
    97	                        "field": key,
    98	                        "reported": reported_value,
    99	                        "metered": metered_value,
   100	                    }
   101	                )
   102	                return False
   103	        return True
   104	
   105	    def exhausted(self) -> bool:
   106	        if self.wall_seconds_limit is not None and self.spent_wall_seconds >= self.wall_seconds_limit:
   107	            return True
   108	        if self.input_token_limit is not None and self.spent_input_tokens >= self.input_token_limit:
   109	            return True
   110	        if (
   111	            self.output_token_limit is not None
   112	            and self.spent_output_tokens >= self.output_token_limit
   113	        ):
   114	            return True
   115	        if self.cost_usd_limit is not None and self.spent_cost_usd >= self.cost_usd_limit:
   116	            return True
   117	        return False
   118	
   119	    def to_dict(self) -> dict[str, Any]:
   120	        return {
   121	            "limits": {
   122	                "wall_seconds": self.wall_seconds_limit,
   123	                "input_tokens": self.input_token_limit,
   124	                "output_tokens": self.output_token_limit,
   125	                "cost_usd": self.cost_usd_limit,
   126	            },
   127	            "spent": {
   128	                "wall_seconds": self.spent_wall_seconds,
   129	                "input_tokens": self.spent_input_tokens,
   130	                "output_tokens": self.spent_output_tokens,
   131	                "cost_usd": self.spent_cost_usd,
   132	                "tool_calls": self.tool_call_count,
   133	                "model_calls": self.model_call_count,
   134	            },
   135	            "divergent_usage_reports": list(self.divergent_usage_reports),
   136	            "exhausted": self.exhausted(),
   137	        }
