  1382	            payload["old_state"], name="old topic observation state", required=False
  1383	        )
  1384	        old_authentication = self._validated_private_snapshot(
  1385	            payload["old_authentication"],
  1386	            name="old topic observation authentication",
  1387	            required=False,
  1388	        )
  1389	        old_literature_files = self._validated_literature_file_snapshots(
  1390	            payload["old_literature_files"]
