   142	def _require_sha256(value: object, name: str) -> str:
   143	    if (
   144	        not isinstance(value, str)
   145	        or len(value) != 64
   146	        or any(character not in "0123456789abcdef" for character in value)
   147	    ):
   148	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   149	    return value
