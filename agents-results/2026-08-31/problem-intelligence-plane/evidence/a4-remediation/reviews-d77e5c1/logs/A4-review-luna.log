    12	import os
    13	from pathlib import Path
    14	from typing import Any, Iterator, Mapping
    15	
    16	from .schema import canonical_json, digest_json
    17	
    18	
    19	class LocalStoreError(ValueError):
    20	    """Raised for malformed, tampered, or incorrectly located local state."""
    21	
    22	
    23	def external_root(root: str | Path) -> Path:
    24	    """Resolve a local-store root and reject a research workspace or descendant."""
    25	
    26	    resolved = Path(root).resolve()
    27	    for candidate in (resolved, *resolved.parents):
    28	        if (candidate / "workspace.json").is_file():
    29	            raise LocalStoreError("local console state must be outside a research workspace")
    30	    return resolved
    31	
    32	
    33	def require_digest(value: object, label: str) -> str:
    34	    if not isinstance(value, str) or len(value) != 64 or set(value) - set("0123456789abcdef"):
    35	        raise LocalStoreError(f"{label} must be a lowercase SHA-256 digest")
    36	    return value
    37	
    38	
    39	def strict_mapping(value: object, expected: set[str], label: str) -> Mapping[str, Any]:
    40	    if not isinstance(value, Mapping):
    41	        raise LocalStoreError(f"{label} must be an object")
    42	    unknown = set(value) - expected
    43	    missing = expected - set(value)
    44	    if unknown or missing:
    45	        raise LocalStoreError(
    46	            f"{label} fields mismatch: missing={sorted(missing)}, unknown={sorted(unknown)}"
    47	        )
    48	    return value
    49	
    50	
    51	def read_json(path: Path, label: str) -> Any:
    52	    try:
    53	        return json.loads(path.read_text(encoding="utf-8"))
    54	    except (OSError, json.JSONDecodeError) as exc:
    55	        raise LocalStoreError(f"{label} is unreadable") from exc
    56	
    57	
    58	def write_json_atomic(path: Path, value: object) -> None:
    59	    path.parent.mkdir(parents=True, exist_ok=True)
    60	    temporary = path.with_suffix(path.suffix + ".tmp")
    61	    temporary.write_text(canonical_json(value) + "\n", encoding="utf-8")
    62	    os.replace(temporary, path)
    63	
    64	
    65	@contextmanager
    66	def exclusive_lock(root: Path, name: str) -> Iterator[None]:
    67	    root.mkdir(parents=True, exist_ok=True)
    68	    lock_path = root / f".{name}.lock"
    69	    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    70	    try:
    71	        fcntl.flock(descriptor, fcntl.LOCK_EX)
    72	        yield
    73	    finally:
    74	        fcntl.flock(descriptor, fcntl.LOCK_UN)
    75	        os.close(descriptor)
    76	
    77	
    78	def state_digest(payload: Mapping[str, Any], digest_field: str = "state_digest_sha256") -> str:
    79	    unsigned = dict(payload)
    80	    unsigned.pop(digest_field, None)
    81	    return digest_json(unsigned)

