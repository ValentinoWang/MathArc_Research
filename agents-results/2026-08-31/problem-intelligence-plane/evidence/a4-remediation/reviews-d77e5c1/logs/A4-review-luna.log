  1343	        if raw != canonical_bytes:
  1344	            raise TopicObservationError("topic observation transaction journal is not canonical")
  1345	
  1346	        phase = payload.get("phase")
  1347	        common_fields = {
  1348	            "schema_version",
  1349	            "recovery_contract",
  1350	            "phase",
  1351	            "old_key_sha256",
  1352	            "old_state",
  1353	            "old_authentication",
  1354	            "old_literature_files",
  1355	            "old_literature_files_sha256",
  1356	        }
