  1107	@unittest.skipUnless(hasattr(os, "fork"), "POSIX fork is required")
  1108	class TopicWriterForkTests(unittest.TestCase):
  1109	    def test_forked_child_exit_cannot_unlock_parent_topic_lock(self) -> None:
  1110	        with tempfile.TemporaryDirectory() as directory:
  1111	            runner = TopicObservationRunner(
  1112	                directory,
  1113	                topic_id="integrity-topic",
  1114	                initial_cursor="c0",
  1115	            )
  1116	            child_pid: int | None = None
  1117	            contender_pid: int | None = None
  1118	            try:
  1119	                with runner._writer_lock():
  1120	                    child_pid = os.fork()
  1121	                    if child_pid == 0:
  1122	                        os._exit(0)
  1123	                    _, child_status = os.waitpid(child_pid, 0)
  1124	                    child_pid = None
  1125	                    self.assertTrue(os.WIFEXITED(child_status))
  1126	                    self.assertEqual(0, os.WEXITSTATUS(child_status))
  1127	
  1128	                    contender_pid = os.fork()
  1129	                    if contender_pid == 0:
  1130	                        try:
  1131	                            import fcntl
  1132	
  1133	                            descriptor = os.open(runner.lock_path, os.O_RDWR)
  1134	                            try:
  1135	                                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
  1136	                            finally:
  1137	                                os.close(descriptor)
  1138	                        except BlockingIOError:
  1139	                            os._exit(0)
  1140	                        except BaseException:
  1141	                            os._exit(2)
  1142	                        os._exit(1)
  1143	                    _, contender_status = os.waitpid(contender_pid, 0)
  1144	                    contender_pid = None
  1145	                    self.assertTrue(os.WIFEXITED(contender_status))
  1146	                    self.assertEqual(0, os.WEXITSTATUS(contender_status))
  1147	            finally:
  1148	                for pid in (child_pid, contender_pid):
  1149	                    if pid is not None:
  1150	                        os.waitpid(pid, 0)
  1151	
