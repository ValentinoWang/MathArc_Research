   155	class LiteratureBase:
   156	    """Keep literature observations separate from verified mathematical claims."""
   157	
   158	    def __init__(self, root: str | Path, budget: BudgetLedger | None = None) -> None:
   159	        self.root = Path(root)
   160	        _ensure_directory_durable(self.root)
   161	        self.artifacts = ArtifactStore.load(self.root / "artifacts")
   162	        self.manifest_path = self.root / "observations.json"
   163	        self.lock_path = self.root / ".observations.lock"
   164	        self.budget = budget
   165	        self._observations: dict[str, SourceObservation] = {}
   166	        self._reload_state()
   167	
   168	    @property
   169	    def observations(self) -> tuple[SourceObservation, ...]:
   170	        return tuple(self._observations[key] for key in sorted(self._observations))
   171	
   172	    def import_file(self, observation: SourceObservation, source: str | Path) -> ImportResult:
   173	        path = Path(source)
   174	        return self.import_bytes(observation, path.read_bytes(), source_filename=path.name)
   175	
   176	    def import_bytes(
   177	        self,
   178	        observation: SourceObservation,
   179	        content: bytes,
   180	        *,
   181	        source_filename: str = "",
   182	    ) -> ImportResult:
   183	        with self._writer_lock():
   184	            if _topic_transaction_pending(self.root) and not _topic_transaction_authorized(
   185	                self.root
   186	            ):
   187	                return ImportResult(
   188	                    ImportDisposition.REJECTED,
   189	                    self._rejected(observation),
   190	                    reason="topic observation transaction recovery is pending",
   191	                )
   192	            try:
   193	                self._reload_state()
   194	            except (KeyError, ValueError) as exc:
   195	                return ImportResult(
   196	                    ImportDisposition.REJECTED,
   197	                    self._rejected(observation),
   198	                    reason=f"stored state integrity failure: {exc}",
   199	                )
   200	            return self._import_bytes_locked(
   201	                observation,
   202	                content,
   203	                source_filename=source_filename,
   204	            )
   205	
   206	    def _import_bytes_locked(
   207	        self,
   208	        observation: SourceObservation,
   209	        content: bytes,
   210	        *,
   211	        source_filename: str,
   212	    ) -> ImportResult:
   213	        actual_digest = hashlib.sha256(content).hexdigest()
   214	        existing_id = self._observations.get(observation.observation_id)
   215	        if existing_id is not None and existing_id.logical_identity != observation.logical_identity:
   216	            rejected = self._rejected(observation)
   217	            return ImportResult(ImportDisposition.REJECTED, rejected, reason="observation_id already names another logical identity")
   218	        existing_identity = sorted(
   219	            (item for item in self.observations if item.logical_identity == observation.logical_identity),
