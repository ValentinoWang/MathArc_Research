   351	    def _pending(self, observation: SourceObservation) -> SourceObservation:
   352	        return SourceObservation.from_dict(
   353	            {**observation.to_dict(), "status": ObservationStatus.PENDING.value, "artifact_id": None}
   354	        )
   355	
   356	    def _rejected(self, observation: SourceObservation) -> SourceObservation:
   357	        return SourceObservation.from_dict(
   358	            {**observation.to_dict(), "status": ObservationStatus.REJECTED.value, "artifact_id": None}
   359	        )
   360	
   361	    def _conflict(self, observation: SourceObservation) -> SourceObservation | None:
   362	        """Build a deterministic conflict ID without replacing any stored record."""
   363	
   364	        identity_digest = hashlib.sha256(
   365	            f"{observation.logical_identity}|{observation.content_digest_sha256}".encode("utf-8")
   366	        ).hexdigest()
   367	        conflict_id = f"{observation.observation_id}-conflict-{identity_digest}"
   368	        conflict = SourceObservation.from_dict(
   369	            {
   370	                **observation.to_dict(),
   371	                "observation_id": conflict_id,
   372	                "status": ObservationStatus.CONFLICT.value,
   373	                "artifact_id": None,
   374	            }
   375	        )
   376	        existing = self._observations.get(conflict_id)
   377	        if existing is not None and existing.to_dict() != conflict.to_dict():
   378	            return None
   379	        return conflict
   380	
   381	    @contextmanager
   382	    def _writer_lock(self) -> Iterator[None]:
   383	        with literature_writer_lock(self.root):
   384	            yield
   385	
   386	    def _reload_state(self) -> None:
   387	        artifacts = ArtifactStore.load(self.root / "artifacts")
   388	        observations: dict[str, SourceObservation] = {}
   389	        if not self.manifest_path.is_file():
   390	            self.artifacts = artifacts
   391	            self._observations = observations
   392	            return
   393	        payload = json.loads(self.manifest_path.read_text(encoding="utf-8"))
   394	        if not isinstance(payload, dict) or set(payload) != {"schema_version", "observations"}:
   395	            raise ValueError("invalid literature observation manifest")
   396	        if payload["schema_version"] != "1.0":
   397	            raise ValueError("unsupported literature observation schema")
   398	        if not isinstance(payload["observations"], list):
   399	            raise ValueError("invalid literature observation manifest")
   400	        observation_keys: dict[str, str] = {}
   401	        for item in payload["observations"]:
   402	            observation = SourceObservation.from_dict(item)
   403	            if observation.observation_id in observations:
   404	                raise ValueError("duplicate observation id")
   405	            existing_observation_id = observation_keys.get(observation.idempotency_key)
   406	            if (
   407	                existing_observation_id is not None
   408	                and existing_observation_id != observation.observation_id
   409	            ):
   410	                raise ValueError("duplicate observation idempotency key")
   411	            observation_keys[observation.idempotency_key] = observation.observation_id
   412	            observations[observation.observation_id] = observation
   413	        self._validate_observed_artifacts(artifacts=artifacts, observations=observations)
   414	        self.artifacts = artifacts
   415	        self._observations = observations
   416	
   417	    def _record(self, observation: SourceObservation) -> None:
   418	        candidate_observations = dict(self._observations)
   419	        existing = candidate_observations.get(observation.observation_id)
   420	        if existing is not None and existing.to_dict() != observation.to_dict():
   421	            if (
   422	                existing.logical_identity != observation.logical_identity
   423	                or existing.status is not ObservationStatus.PENDING
   424	            ):
   425	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   426	        for existing in candidate_observations.values():
   427	            if (
   428	                existing.observation_id != observation.observation_id
   429	                and existing.idempotency_key == observation.idempotency_key
   430	            ):
   431	                raise ValueError("refusing to record duplicate observation idempotency key")
   432	        candidate_observations[observation.observation_id] = observation
   433	        payload = {
   434	            "schema_version": "1.0",
   435	            "observations": [
   436	                candidate_observations[key].to_dict()
   437	                for key in sorted(candidate_observations)
   438	            ],
   439	        }
   440	        content = (
   441	            json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
   442	        ).encode("utf-8")
   443	        _durable_atomic_replace(self.manifest_path, content)
   444	        self._observations = candidate_observations
   445	
   446	    def _verified_artifact(
   447	        self,
   448	        artifact_id: str,
   449	        expected_digest: str,
   450	        *,
   451	        expected_media_type: str | None = None,
   452	        artifacts: ArtifactStore | None = None,
   453	    ) -> ArtifactRecord:
   454	        artifact_store = artifacts if artifacts is not None else self.artifacts
   455	        artifact = artifact_store.get(artifact_id)
   456	        path = artifact_store.path_for(artifact_id)
   457	        if (
   458	            artifact.sha256 != expected_digest
   459	            or not path.is_file()
   460	            or artifact.logical_role != "literature-observation"
   461	            or artifact.producer != "matharc-literature-base"
   462	            or (expected_media_type is not None and artifact.media_type != expected_media_type)
   463	        ):
   464	            raise ValueError("artifact reference is not intact")
   465	        content = path.read_bytes()
   466	        if hashlib.sha256(content).hexdigest() != artifact.sha256:
   467	            raise ValueError("artifact blob digest mismatch")
   468	        if len(content) != artifact.size_bytes:
   469	            raise ValueError("artifact blob size mismatch")
   470	        return artifact
   471	
   472	    def _validate_observed_artifacts(
   473	        self,
   474	        *,
   475	        artifacts: ArtifactStore | None = None,
   476	        observations: Mapping[str, SourceObservation] | None = None,
   477	    ) -> None:
   478	        artifact_store = artifacts if artifacts is not None else self.artifacts
   479	        stored_observations = observations if observations is not None else self._observations
   480	        for observation in stored_observations.values():
   481	            if observation.status is not ObservationStatus.OBSERVED:
   482	                continue
   483	            if not observation.artifact_id or not observation.content_digest_sha256:
   484	                raise ValueError(f"observed record has incomplete artifact reference: {observation.observation_id}")
   485	            try:
   486	                self._verified_artifact(
   487	                    observation.artifact_id,
   488	                    observation.content_digest_sha256,
   489	                    expected_media_type=observation.media_type,
   490	                    artifacts=artifact_store,
   491	                )
   492	            except (KeyError, ValueError) as exc:
   493	                raise ValueError(f"invalid artifact for observed record {observation.observation_id}: {exc}") from exc
   494	
   495	    def _reuse_or_put_artifact(
   496	        self,
   497	        artifact_id: str,
   498	        content: bytes,
   499	        observation: SourceObservation,
   500	        source_filename: str,
   501	    ) -> ArtifactRecord:
   502	        try:
   503	            existing = self.artifacts.get(artifact_id)
   504	        except KeyError:
   505	            existing = None
   506	        actual_digest = hashlib.sha256(content).hexdigest()
   507	        if existing is not None:
   508	            if (
   509	                existing.sha256 != actual_digest
   510	                or existing.size_bytes != len(content)
   511	                or existing.logical_role != "literature-observation"
   512	                or existing.producer != "matharc-literature-base"
   513	                or existing.media_type != observation.media_type
   514	            ):
   515	                raise ValueError("existing artifact metadata conflicts with imported content")
   516	            self._verified_artifact(
   517	                artifact_id,
   518	                actual_digest,
   519	                expected_media_type=observation.media_type,
   520	            )
   521	            return existing
   522	        return self.artifacts.put_bytes(
   523	            artifact_id,
   524	            content,
   525	            logical_role="literature-observation",
   526	            producer="matharc-literature-base",
   527	            media_type=observation.media_type,
   528	            source_filename=source_filename,
   529	        )
