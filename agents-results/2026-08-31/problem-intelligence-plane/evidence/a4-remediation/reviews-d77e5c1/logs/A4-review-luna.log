   780	                    "result_digest_sha256": digest_json(batch_result.to_dict()),
   781	                    "input_fingerprints": {
   782	                        item.input_id: item.fingerprint_sha256 for item in batch.inputs
   783	                    },
   784	                    "input_projection_digest_sha256": _input_projection_digest(
   785	                        topic_id=batch.topic_id,
   786	                        cursor=batch.cursor,
   787	                        next_cursor=batch.next_cursor,
   788	                        batch_digest_sha256=batch_digest_sha256,
   789	                        input_projections=input_projections,
   790	                    ),
   791	                    "input_projections": input_projections,
   792	                    "input_observation_ids": {
   793	                        item.input_id: item.observation_id for item in results
   794	                    },
   795	                    "disposition_evidence": disposition_evidence,
   796	                    "result": batch_result.to_dict(),
   797	                }
   798	                state["next_cursor"] = batch.next_cursor
   799	                self._save_state(state)
   800	                return batch_result
   801	            finally:
   802	                self._active_transaction = None
