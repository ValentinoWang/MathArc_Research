    39	def _read_with_timeout(file_descriptor: int, timeout: float) -> bytes | None:
    40	    readable, _, _ = select.select([file_descriptor], [], [], timeout)
    41	    if not readable:
    42	        return None
    43	    return os.read(file_descriptor, 1)
