   139	class ImportDisposition(str, Enum):
   140	    IMPORTED = "IMPORTED"
   141	    IDEMPOTENT = "IDEMPOTENT"
   142	    PENDING = "PENDING"
   143	    CONFLICT = "CONFLICT"
   144	    REJECTED = "REJECTED"
