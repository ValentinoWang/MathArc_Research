  1569	            expected_mode=_PRIVATE_FILE_MODE,
  1570	            missing_ok=True,
  1571	        )
  1572	        current_key_sha256 = (
  1573	            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
  1574	        )
  1575	        old_key_sha256 = payload["old_key_sha256"]
