  1164	            raise
  1165	        owner_pid = os.getpid()
  1166	        with lock_file:
  1167	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
  1168	            try:
  1169	                yield
  1170	            finally:
  1171	                if os.getpid() == owner_pid:
  1172	                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
