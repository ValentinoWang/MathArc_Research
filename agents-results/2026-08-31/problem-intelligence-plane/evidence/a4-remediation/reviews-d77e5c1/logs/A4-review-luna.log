    58	class ArtifactStoreDurabilityTests(unittest.TestCase):
    59	    def test_blob_and_manifest_replacements_are_fsync_ordered(self) -> None:
    60	        events: list[object] = []
    61	        original_fsync = artifact_store_module.os.fsync
    62	        original_replace = artifact_store_module.os.replace
    63	
    64	        def record_fsync(file_descriptor: int) -> None:
    65	            mode = os.fstat(file_descriptor).st_mode
    66	            events.append("file-fsync" if stat.S_ISREG(mode) else "directory-fsync")
    67	            original_fsync(file_descriptor)
    68	
    69	        def record_replace(source: str | os.PathLike[str], target: str | os.PathLike[str]) -> None:
    70	            events.append(("replace", Path(target).name))
    71	            original_replace(source, target)
    72	
    73	        with tempfile.TemporaryDirectory() as directory:
    74	            store = ArtifactStore(Path(directory) / "store")
    75	            with patch.object(artifact_store_module.os, "fsync", side_effect=record_fsync):
    76	                with patch.object(artifact_store_module.os, "replace", side_effect=record_replace):
    77	                    store.put_bytes(
    78	                        "A",
    79	                        b"durable artifact",
    80	                        logical_role="fixture",
    81	                        producer="test",
    82	                    )
    83	
    84	        replacements = [index for index, event in enumerate(events) if isinstance(event, tuple)]
    85	        self.assertEqual(2, len(replacements))
    86	        for index in replacements:
    87	            self.assertGreater(index, 0)
    88	            self.assertLess(index + 1, len(events))
    89	            self.assertEqual("file-fsync", events[index - 1])
    90	            self.assertEqual("directory-fsync", events[index + 1])
