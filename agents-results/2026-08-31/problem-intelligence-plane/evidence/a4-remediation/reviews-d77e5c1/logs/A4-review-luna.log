   278	    def import_file(
   279	        self,
   280	        artifact_id: str,
   281	        source: str | Path,
   282	        *,
   283	        logical_role: str,
   284	        producer: str,
   285	        media_type: str | None = None,
   286	        linked_claim_ids: Iterable[str] = (),
   287	        linked_tool_call_ids: Iterable[str] = (),
   288	    ) -> ArtifactRecord:
   289	        path = Path(source)
   290	        guessed = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
   291	        return self.put_bytes(
   292	            artifact_id,
