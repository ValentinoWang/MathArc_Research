   102	    def to_dict(self) -> dict[str, Any]:
   103	        return {
   104	            "artifact_id": self.artifact_id,
   105	            "sha256": self.sha256,
   106	            "size_bytes": self.size_bytes,
   107	            "media_type": self.media_type,
   108	            "relative_path": self.relative_path,
   109	            "logical_role": self.logical_role,
   110	            "producer": self.producer,
   111	            "linked_claim_ids": list(self.linked_claim_ids),
   112	            "linked_tool_call_ids": list(self.linked_tool_call_ids),
