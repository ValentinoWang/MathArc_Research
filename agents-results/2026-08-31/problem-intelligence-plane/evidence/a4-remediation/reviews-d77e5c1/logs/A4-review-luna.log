   226	    size_bytes = value["size_bytes"]
   227	    if isinstance(size_bytes, bool) or not isinstance(size_bytes, int) or size_bytes < 0:
   228	        raise TopicObservationError(f"{name} snapshot size is invalid")
   229	    mode = value["mode"]
   230	    if isinstance(mode, bool) or not isinstance(mode, int) or mode < 0 or mode > 0o7777:
   231	        raise TopicObservationError(f"{name} snapshot mode is invalid")
   232	    content_b64 = value["content_b64"]
   233	    if not isinstance(content_b64, str):
   234	        raise TopicObservationError(f"{name} snapshot content is invalid")
   235	    try:
   236	        content = base64.b64decode(content_b64.encode("ascii"), validate=True)
   237	    except (UnicodeEncodeError, binascii.Error, ValueError) as exc:
   238	        raise TopicObservationError(f"{name} snapshot content is invalid") from exc
   239	    if len(content) != size_bytes or hashlib.sha256(content).hexdigest() != digest:
   240	        raise TopicObservationError(f"{name} snapshot digest mismatch")
   241	    return content, mode
   242	
   243	
   244	def _validate_snapshot_path(value: object, name: str) -> str:
   245	    if not isinstance(value, str) or not value:
   246	        raise TopicObservationError(f"{name} snapshot path is invalid")
   247	    path = Path(value)
   248	    if path.is_absolute() or not path.parts or "." in path.parts or ".." in path.parts:
   249	        raise TopicObservationError(f"{name} snapshot path is invalid")
   250	    if "\x00" in value:
   251	        raise TopicObservationError(f"{name} snapshot path is invalid")
   252	    return path.as_posix()
