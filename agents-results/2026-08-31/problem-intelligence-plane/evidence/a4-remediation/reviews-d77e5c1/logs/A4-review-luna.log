    33	def input_for(input_id: str, *, risk_flags: tuple[str, ...] = ()) -> TopicObservationInput:
    34	    content = f"integrity source bytes for {input_id}".encode("utf-8")
    35	    return TopicObservationInput(
    36	        input_id=input_id,
    37	        observation=new_observation(
    38	            observation_id=f"OBS-{input_id}",
    39	            canonical_uri=f"https://integrity.example/{input_id}",
    40	            pinned_version="v1",
    41	            license_status=LicenseStatus.OPEN,
    42	            license_basis="integrity fixture license",
    43	            content_summary="Descriptive integrity fixture metadata.",
    44	            summary_basis="fixture",
    45	            media_type="text/plain",
    46	            content_digest_sha256=hashlib.sha256(content).hexdigest(),
    47	            observed_at="2026-09-02T08:00:00+00:00",
    48	        ),
    49	        content=content,
    50	        risk_flags=risk_flags,
    51	    )
