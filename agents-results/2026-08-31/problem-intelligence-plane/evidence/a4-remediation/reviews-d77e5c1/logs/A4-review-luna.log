   142	    def test_crash_blocks_concurrent_literature_writer_until_recovery(self) -> None:
   143	        with tempfile.TemporaryDirectory() as directory:
   144	            root = Path(directory)
   145	            runner = TopicObservationRunner(root, topic_id="integrity-topic", initial_cursor="c0")
   146	            save_reached = threading.Event()
   147	            release_save = threading.Event()
   148	            writer_started = threading.Event()
   149	            writer_done = threading.Event()
   150	            runner_errors: list[BaseException] = []
   151	            writer_results: list[Any] = []
   152	
   153	            def interrupt_save(_state: Mapping[str, Any]) -> None:
   154	                save_reached.set()
   155	                if not release_save.wait(timeout=5):
   156	                    raise RuntimeError("test did not release interrupted save")
   157	                raise RuntimeError("simulated crash before topic state commit")
   158	
   159	            def run_topic_transaction() -> None:
   160	                try:
   161	                    runner.run(batch("c0", "c1", input_for("A")))
   162	                except BaseException as exc:
   163	                    runner_errors.append(exc)
   164	
   165	            external_input = input_for("EXTERNAL")
   166	
   167	            def run_external_writer() -> None:
   168	                writer_started.set()
   169	                writer_results.append(
   170	                    LiteratureBase(root / "literature").import_bytes(
   171	                        external_input.observation,
   172	                        external_input.content,
   173	                    )
   174	                )
   175	                writer_done.set()
   176	
   177	            runner._save_state = interrupt_save
   178	            runner_thread = threading.Thread(target=run_topic_transaction)
   179	            runner_thread.start()
   180	            self.assertTrue(save_reached.wait(timeout=5))
   181	
   182	            writer_thread = threading.Thread(target=run_external_writer)
   183	            writer_thread.start()
   184	            self.assertTrue(writer_started.wait(timeout=5))
   185	            self.assertFalse(writer_done.wait(timeout=0.2))
   186	
   187	            release_save.set()
   188	            runner_thread.join(timeout=5)
   189	            writer_thread.join(timeout=5)
   190	            self.assertFalse(runner_thread.is_alive())
   191	            self.assertFalse(writer_thread.is_alive())
   192	            self.assertEqual(1, len(runner_errors))
   193	            self.assertRegex(str(runner_errors[0]), "simulated crash")
   194	            self.assertEqual(1, len(writer_results))
   195	            self.assertEqual("REJECTED", writer_results[0].disposition.value)
   196	            self.assertEqual(
   197	                "topic observation transaction recovery is pending",
   198	                writer_results[0].reason,
   199	            )
   200	
   201	            recovered = TopicObservationRunner(
   202	                root,
   203	                topic_id="integrity-topic",
   204	                initial_cursor="c0",
   205	            )
   206	            self.assertEqual("c0", recovered.next_cursor)
   207	            retry = LiteratureBase(root / "literature").import_bytes(
   208	                external_input.observation,
   209	                external_input.content,
   210	            )
   211	            self.assertEqual("IMPORTED", retry.disposition.value)
   212	            restarted = TopicObservationRunner(
   213	                root,
   214	                topic_id="integrity-topic",
   215	                initial_cursor="c0",
   216	            )
   217	            self.assertEqual(
   218	                ["OBS-EXTERNAL"],
   219	                [item.observation_id for item in restarted.literature.observations],
   220	            )
   221	            self.assertFalse((root / ".topic-observation-transaction.json").exists())
