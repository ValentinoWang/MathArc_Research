  1091	    ) -> str | None:
  1092	        matches = [
  1093	            cursor
  1094	            for cursor, stored in state["batches"].items()
  1095	            if isinstance(stored, dict)
  1096	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
  1097	        ]
  1098	        return sorted(matches)[0] if matches else None
