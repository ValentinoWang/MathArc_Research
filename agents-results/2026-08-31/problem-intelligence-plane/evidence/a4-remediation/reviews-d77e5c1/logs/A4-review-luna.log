   500	                original_atomic_write(path, content, mode)
   501	
   502	            with (
   503	                patch.object(
   504	                    topic_observation_module,
   505	                    "_fsync_directory",
   506	                    side_effect=fail_unlink_fsync_once,
   507	                ),
   508	                patch.object(
