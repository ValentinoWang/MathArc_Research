   198	class LiteratureWriterForkTests(unittest.TestCase):
   199	    def test_fork_does_not_inherit_reentrancy_or_transaction_authority(self) -> None:
   200	        with tempfile.TemporaryDirectory() as directory:
   201	            root = Path(directory)
   202	            read_fd, write_fd = os.pipe()
   203	            child_pid: int | None = None
   204	            try:
   205	                with literature_writer_lock(root, allow_topic_transaction=True):
   206	                    child_pid = os.fork()
   207	                    if child_pid == 0:
   208	                        os.close(read_fd)
   209	                        try:
   210	                            os.write(write_fd, b"X" if _topic_transaction_authorized(root) else b"A")
   211	                            with literature_writer_lock(root):
   212	                                os.write(write_fd, b"L")
   213	                        except BaseException:
   214	                            try:
   215	                                os.write(write_fd, b"E")
   216	                            finally:
   217	                                os._exit(1)
   218	                        os._exit(0)
   219	                    os.close(write_fd)
   220	                    write_fd = -1
   221	                    self.assertEqual(b"A", _read_with_timeout(read_fd, 1.0))
   222	                    self.assertIsNone(_read_with_timeout(read_fd, 0.1))
   223	                self.assertEqual(b"L", _read_with_timeout(read_fd, 1.0))
   224	            finally:
   225	                if write_fd != -1:
   226	                    os.close(write_fd)
   227	                os.close(read_fd)
   228	                if child_pid is not None and child_pid > 0:
   229	                    status = _reap(child_pid)
   230	                    self.assertTrue(os.WIFEXITED(status))
   231	                    self.assertEqual(0, os.WEXITSTATUS(status))
   232	
   233	    def test_child_exiting_inherited_context_cannot_unlock_parent(self) -> None:
   234	        with tempfile.TemporaryDirectory() as directory:
   235	            root = Path(directory)
   236	            read_fd, write_fd = os.pipe()
   237	            first_child: int | None = None
   238	            contender: int | None = None
   239	            try:
   240	                with literature_writer_lock(root):
   241	                    first_child = os.fork()
   242	                    if first_child == 0:
   243	                        os.close(read_fd)
   244	                    else:
   245	                        self.assertEqual(b"C", _read_with_timeout(read_fd, 1.0))
   246	                        contender = os.fork()
   247	                        if contender == 0:
   248	                            os.close(read_fd)
   249	                            try:
   250	                                with literature_writer_lock(root):
   251	                                    os.write(write_fd, b"A")
   252	                            except BaseException:
   253	                                try:
   254	                                    os.write(write_fd, b"E")
   255	                                finally:
   256	                                    os._exit(1)
   257	                            os._exit(0)
   258	                        self.assertIsNone(_read_with_timeout(read_fd, 0.1))
   259	                if first_child == 0:
   260	                    os.write(write_fd, b"C")
   261	                    os._exit(0)
   262	                self.assertEqual(b"A", _read_with_timeout(read_fd, 1.0))
   263	            finally:
   264	                os.close(read_fd)
   265	                os.close(write_fd)
   266	                if first_child is not None and first_child > 0:
   267	                    status = _reap(first_child)
   268	                    self.assertTrue(os.WIFEXITED(status))
   269	                    self.assertEqual(0, os.WEXITSTATUS(status))
   270	                if contender is not None and contender > 0:
   271	                    status = _reap(contender)
   272	                    self.assertTrue(os.WIFEXITED(status))
   273	                    self.assertEqual(0, os.WEXITSTATUS(status))
