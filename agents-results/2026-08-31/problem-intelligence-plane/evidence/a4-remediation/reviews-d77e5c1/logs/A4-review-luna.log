    30	    while True:
    31	        try:
    32	            current.stat()
    33	        except FileNotFoundError:
    34	            missing.append(current)
    35	        else:
    36	            if not current.is_dir():
    37	                raise NotADirectoryError(f"directory path is not a directory: {current}")
    38	            break
    39	        parent = current.parent
    40	        if parent == current:
    41	            raise FileNotFoundError(f"could not find directory parent: {current}")
    42	        current = parent
    43	
    44	    for child in reversed(missing):
    45	        try:
    46	            child.mkdir()
    47	        except FileExistsError:
    48	            if not child.is_dir():
    49	                raise
    50	            continue
    51	        _fsync_directory(child.parent)
    52	
    53	
    54	def _durable_atomic_replace(path: str | Path, content: bytes) -> Path:
    55	    target = Path(path)
    56	    if not target.is_absolute():
    57	        target = Path.cwd() / target
    58	    _ensure_directory_durable(target.parent)
    59	    temporary_path: Path | None = None
    60	    open_fd = -1
    61	    renamed = False
    62	    try:
    63	        open_fd, temporary_name = tempfile.mkstemp(
    64	            prefix=f".{target.name}.",
    65	            suffix=".tmp",
    66	            dir=target.parent,
    67	        )
    68	        temporary_path = Path(temporary_name)
    69	        with os.fdopen(open_fd, "wb") as temporary_file:
    70	            open_fd = -1
    71	            temporary_file.write(content)
    72	            temporary_file.flush()
    73	            os.fsync(temporary_file.fileno())
    74	        os.replace(temporary_path, target)
    75	        renamed = True
    76	        _fsync_directory(target.parent)
    77	        return target
    78	    finally:
    79	        if open_fd != -1:
    80	            os.close(open_fd)
    81	        if not renamed and temporary_path is not None:
    82	            try:
    83	                temporary_path.unlink()
    84	            except FileNotFoundError:
    85	                pass
