  1626	            return
  1627	        journal_bytes, journal_mode = snapshot
  1628	        if _path_entry_exists(self.retired_transaction_path):
  1629	            raise TopicObservationError(
  1630	                "retired topic observation transaction journal already exists"
  1631	            )
  1632	        try:
  1633	            os.replace(self.transaction_path, self.retired_transaction_path)
  1634	        except FileNotFoundError:
