  1185	        retired_transaction_exists = _path_entry_exists(self.retired_transaction_path)
  1186	        if active_transaction_exists and retired_transaction_exists:
  1187	            raise TopicObservationError(
  1188	                "active and retired topic observation transaction journals coexist"
  1189	            )
