   117	    @classmethod
   118	    def from_dict(cls, payload: Mapping[str, Any]) -> "ArtifactRecord":
   119	        allowed = {
   120	            "artifact_id",
   121	            "sha256",
   122	            "size_bytes",
   123	            "media_type",
   124	            "relative_path",
   125	            "logical_role",
