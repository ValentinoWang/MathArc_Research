    65	def _topic_transaction_pending(root: Path) -> bool:
    66	    canonical_root = _canonical_literature_root(root)
    67	    for path_name in (
    68	        TOPIC_OBSERVATION_TRANSACTION_PATH_NAME,
    69	        TOPIC_OBSERVATION_RETIRED_TRANSACTION_PATH_NAME,
    70	    ):
