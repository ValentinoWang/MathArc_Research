   969	    @staticmethod
   970	    def _rewrite_first_batch_to_b_and_second_to_duplicate(state: dict[str, Any]) -> None:
   971	        batches = state["batches"]
   972	        assert isinstance(batches, dict)
   973	        stored_a = batches["c0"]
   974	        stored_b = batches["c1"]
   975	        assert isinstance(stored_a, dict) and isinstance(stored_b, dict)
   976	        source_b = input_for("B")
   977	        swapped = TopicObservationInput("A", source_b.observation, source_b.content)
   978	        stored_a["input_projections"]["A"] = swapped.input_projection
   979	        stored_a["input_fingerprints"]["A"] = swapped.fingerprint_sha256
   980	        stored_a["input_observation_ids"]["A"] = source_b.observation.observation_id
   981	        evidence_a = dict(stored_b["disposition_evidence"]["B"])
   982	        evidence_a["input_id"] = "A"
   983	        stored_a["disposition_evidence"]["A"] = evidence_a
   984	        stored_a["result"]["item_results"][0]["observation_id"] = source_b.observation.observation_id
   985	        state["processed_input_ids"]["A"] = swapped.fingerprint_sha256
   986	        state["seen_observation_keys"] = [evidence_a["input_idempotency_key"]]
   987	        stored_a["batch_digest_sha256"] = batch("c0", "c1", swapped).batch_digest_sha256
   988	        stored_a["input_projection_digest_sha256"] = _input_projection_digest(
   989	            topic_id="integrity-topic",
   990	            cursor="c0",
   991	            next_cursor="c1",
   992	            batch_digest_sha256=stored_a["batch_digest_sha256"],
   993	            input_projections=stored_a["input_projections"],
   994	        )
   995	        evidence_a["input_projection_binding_sha256"] = _input_projection_binding_digest(
   996	            topic_id="integrity-topic",
   997	            cursor="c0",
   998	            next_cursor="c1",
   999	            batch_digest_sha256=stored_a["batch_digest_sha256"],
  1000	            input_projection=swapped.input_projection,
  1001	        )
  1002	        stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
  1003	        stored_b["result"]["item_results"][0]["status"] = TopicItemStatus.DUPLICATE.value
  1004	        stored_b["disposition_evidence"]["B"]["basis"] = "SEEN_OBSERVATION_KEY"
  1005	        stored_b["disposition_evidence"]["B"]["import_disposition"] = None
  1006	        stored_b["result_digest_sha256"] = digest_json(stored_b["result"])
  1007	
  1008	    @staticmethod
  1009	    def _rewrite_manual_reference_laundering(state: dict[str, Any]) -> None:
  1010	        batches = state["batches"]
  1011	        assert isinstance(batches, dict)
  1012	        stored_a = batches["c0"]
  1013	        stored_b = batches["c1"]
  1014	        assert isinstance(stored_a, dict) and isinstance(stored_b, dict)
  1015	        original_a_evidence = dict(stored_a["disposition_evidence"]["A"])
  1016	        source_b = input_for("B", risk_flags=("forged-risk",))
  1017	        source_b_without_risk = input_for("B")
  1018	        swapped = TopicObservationInput(
  1019	            "A", source_b_without_risk.observation, source_b_without_risk.content
  1020	        )
  1021	        stored_a["input_projections"]["A"] = swapped.input_projection
  1022	        stored_a["input_fingerprints"]["A"] = swapped.fingerprint_sha256
  1023	        stored_a["input_observation_ids"]["A"] = "OBS-B"
  1024	        evidence_a = dict(stored_b["disposition_evidence"]["B"])
  1025	        evidence_a["input_id"] = "A"
  1026	        stored_a["disposition_evidence"]["A"] = evidence_a
  1027	        stored_a["result"]["item_results"][0]["observation_id"] = "OBS-B"
  1028	        state["processed_input_ids"]["A"] = swapped.fingerprint_sha256
  1029	        state["seen_observation_keys"] = [evidence_a["input_idempotency_key"]]
  1030	        stored_a["batch_digest_sha256"] = batch("c0", "c1", swapped).batch_digest_sha256
  1031	        stored_a["input_projection_digest_sha256"] = _input_projection_digest(
  1032	            topic_id="integrity-topic",
  1033	            cursor="c0",
  1034	            next_cursor="c1",
  1035	            batch_digest_sha256=stored_a["batch_digest_sha256"],
  1036	            input_projections=stored_a["input_projections"],
  1037	        )
  1038	        evidence_a["input_projection_binding_sha256"] = _input_projection_binding_digest(
  1039	            topic_id="integrity-topic",
  1040	            cursor="c0",
  1041	            next_cursor="c1",
  1042	            batch_digest_sha256=stored_a["batch_digest_sha256"],
  1043	            input_projection=swapped.input_projection,
  1044	        )
  1045	        stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
  1046	
  1047	        original_a = input_for("A")
