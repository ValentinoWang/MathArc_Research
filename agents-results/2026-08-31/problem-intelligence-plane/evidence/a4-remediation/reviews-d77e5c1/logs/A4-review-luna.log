   154	class ArtifactStore:
   155	    """Content-addressed storage for certificates, logs, sources and reports."""
   156	
   157	    def __init__(
   158	        self,
   159	        root: str | Path,
   160	        records: Iterable[ArtifactRecord] = (),
   161	    ) -> None:
   162	        self.root = Path(root)
   163	        self.blob_root = self.root / "sha256"
   164	        self.manifest_path = self.root / "manifest.json"
   165	        _ensure_directory_durable(self.blob_root)
   166	        self._records: dict[str, ArtifactRecord] = {}
   167	        for record in records:
   168	            self._add_record(record)
   169	
   170	    @property
   171	    def records(self) -> tuple[ArtifactRecord, ...]:
   172	        return tuple(self._records[key] for key in sorted(self._records))
   173	
   174	    def get(self, artifact_id: str) -> ArtifactRecord:
   175	        try:
   176	            return self._records[artifact_id]
   177	        except KeyError as exc:
   178	            raise KeyError(f"unknown artifact: {artifact_id}") from exc
   179	
   180	    def path_for(self, artifact_id: str) -> Path:
   181	        record = self.get(artifact_id)
   182	        path = (self.root / record.relative_path).resolve()
   183	        if self.root.resolve() not in path.parents:
   184	            raise ValueError(f"artifact path escapes store root: {record.relative_path}")
   185	        return path
   186	
   187	    def put_bytes(
   188	        self,
   189	        artifact_id: str,
   190	        content: bytes,
   191	        *,
   192	        logical_role: str,
   193	        producer: str,
   194	        media_type: str = "application/octet-stream",
   195	        linked_claim_ids: Iterable[str] = (),
   196	        linked_tool_call_ids: Iterable[str] = (),
   197	        source_filename: str = "",
   198	    ) -> ArtifactRecord:
   199	        if artifact_id in self._records:
   200	            raise ValueError(f"duplicate artifact id: {artifact_id}")
   201	        sha256 = hashlib.sha256(content).hexdigest()
   202	        relative_path = Path("sha256") / sha256[:2] / sha256
   203	        target = self.root / relative_path
   204	        _ensure_directory_durable(target.parent)
   205	        if target.exists():
   206	            with target.open("rb") as existing_file:
   207	                existing = existing_file.read()
   208	                if existing != content:
   209	                    raise ValueError(f"content-address collision at {target}")
   210	                os.fsync(existing_file.fileno())
   211	            _fsync_directory(target.parent)
   212	        else:
   213	            _durable_atomic_replace(target, content)
   214	        record = ArtifactRecord(
   215	            artifact_id=artifact_id,
   216	            sha256=sha256,
   217	            size_bytes=len(content),
   218	            media_type=media_type,
   219	            relative_path=relative_path.as_posix(),
   220	            logical_role=logical_role,
   221	            producer=producer,
   222	            linked_claim_ids=tuple(str(item) for item in linked_claim_ids),
   223	            linked_tool_call_ids=tuple(str(item) for item in linked_tool_call_ids),
   224	            source_filename=source_filename,
   225	        )
   226	        candidate_records = dict(self._records)
   227	        self._add_record_to(candidate_records, record)
   228	        self._save_manifest(candidate_records)
   229	        self._records = candidate_records
   230	        return record
