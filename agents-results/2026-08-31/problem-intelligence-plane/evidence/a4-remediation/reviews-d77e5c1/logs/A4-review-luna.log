  1220	    def _literature_file_snapshots(self) -> list[dict[str, Any]]:
  1221	        literature_root = self.root / "literature"
  1222	        try:
  1223	            root_metadata = literature_root.lstat()
  1224	        except FileNotFoundError:
  1225	            return []
  1226	        except OSError as exc:
  1227	            raise TopicObservationError("topic observation literature root is unreadable") from exc
