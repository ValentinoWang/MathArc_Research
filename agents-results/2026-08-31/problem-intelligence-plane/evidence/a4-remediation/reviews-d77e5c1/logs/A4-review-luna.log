   645	class TopicObservationRunner:
   646	    """Durably process one topic without granting status or proof authority."""
   647	
   648	    def __init__(
   649	        self,
   650	        root: str | Path,
   651	        *,
   652	        topic_id: str,
   653	        initial_cursor: str,
   654	        budget: BudgetLedger | None = None,
   655	    ) -> None:
   656	        self.root = external_root(root)
   657	        self.root.mkdir(parents=True, exist_ok=True)
   658	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   659	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   660	        if budget is not None and not isinstance(budget, BudgetLedger):
   661	            raise TypeError("budget must be a BudgetLedger or None")
   662	        self.budget = budget
   663	        self.state_path = self.root / "topic-observation-state.json"
   664	        # The key is a separate, non-JSON trust boundary. Data-path writers can
   665	        # rewrite state and literature JSON, but cannot mint a valid MAC without it.
   666	        # This does not protect against a fully compromised same-user host that
   667	        # can read the key and replace both the data and authentication files.
   668	        self.signing_key_path = self.root / ".topic-observation-signing.key"
   669	        self.authentication_path = self.root / ".topic-observation-state.auth.json"
   670	        self.lock_path = self.root / ".topic-observation.lock"
   671	        self.transaction_path = self.root / _TRANSACTION_PATH_NAME
   672	        self.retired_transaction_path = self.root / _RETIRED_TRANSACTION_PATH_NAME
   673	        self._active_transaction: dict[str, Any] | None = None
   674	        with self._storage_lock():
   675	            self._prepare_locked()
   676	
   677	    @property
   678	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   679	        with self._storage_lock():
   680	            self._prepare_locked()
   681	            state = self._load_state()
   682	            return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   683	
   684	    @property
   685	    def next_cursor(self) -> str:
   686	        with self._storage_lock():
   687	            self._prepare_locked()
   688	            return _require_nonempty(self._load_state()["next_cursor"], "next_cursor")
   689	
   690	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   691	        if not isinstance(batch, TopicObservationBatch):
   692	            raise TypeError("batch must be a TopicObservationBatch")
   693	        if batch.topic_id != self.topic_id:
   694	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   695	        with self._storage_lock():
   696	            self._prepare_locked()
   697	            state = self._load_state()
   698	            batches = state["batches"]
   699	            previous = batches.get(batch.cursor)
   700	            if previous is not None:
   701	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   702	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   703	                manual = self._add_manual(
   704	                    state,
   705	                    cursor=batch.cursor,
   706	                    input_id="cursor",
   707	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   708	                    detail="A cursor was replayed with different batch content.",
   709	                )
   710	                self._record_manual_event(
   711	                    state,
   712	                    manual,
   713	                    conflict_kind="REPLAY_DIFFERENT_CONTENT",
   714	                    expected_cursor=None,
   715	                )
   716	                transaction = self._begin_transaction()
   717	                self._active_transaction = transaction
   718	                try:
   719	                    self._save_state(state)
   720	                    return TopicBatchResult(
   721	                        self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   722	                        (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   723	                    )
   724	                finally:
   725	                    self._active_transaction = None
   726	            if batch.cursor != state["next_cursor"]:
   727	                manual = self._add_manual(
   728	                    state,
   729	                    cursor=batch.cursor,
   730	                    input_id="cursor",
   731	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   732	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   733	                )
   734	                self._record_manual_event(
   735	                    state,
   736	                    manual,
   737	                    conflict_kind="EXPECTED_CURSOR",
   738	                    expected_cursor=state["next_cursor"],
   739	                )
   740	                transaction = self._begin_transaction()
   741	                self._active_transaction = transaction
   742	                try:
   743	                    self._save_state(state)
   744	                    return TopicBatchResult(
   745	                        self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   746	                        (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   747	                    )
   748	                finally:
   749	                    self._active_transaction = None
   750	
   751	            transaction = self._begin_transaction()
   752	            self._active_transaction = transaction
   753	            results: list[TopicItemResult] = []
   754	            disposition_evidence: dict[str, dict[str, Any]] = {}
   755	            try:
   756	                batch_digest_sha256 = batch.batch_digest_sha256
   757	                for item in batch.inputs:
   758	                    item_result, evidence = self._process_input(state, batch, item)
   759	                    results.append(item_result)
   760	                    disposition_evidence[item.input_id] = evidence
   761	                status = TopicRunStatus.MANUAL_REVIEW if any(
