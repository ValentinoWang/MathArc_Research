   302	    def verify(self) -> dict[str, Any]:
   303	        errors: list[str] = []
   304	        verified = 0
   305	        for record in self._records.values():
   306	            try:
   307	                path = self.path_for(record.artifact_id)
   308	            except ValueError as exc:
   309	                errors.append(str(exc))
   310	                continue
   311	            if not path.is_file():
   312	                errors.append(f"artifact file is missing: {record.artifact_id}")
   313	                continue
   314	            content = path.read_bytes()
   315	            actual = hashlib.sha256(content).hexdigest()
   316	            if actual != record.sha256:
   317	                errors.append(f"artifact digest mismatch: {record.artifact_id}")
   318	                continue
   319	            if len(content) != record.size_bytes:
   320	                errors.append(f"artifact size mismatch: {record.artifact_id}")
   321	                continue
   322	            verified += 1
   323	        return {
   324	            "valid": not errors,
   325	            "errors": errors,
   326	            "artifact_count": len(self._records),
   327	            "verified_count": verified,
   328	            "manifest_digest_sha256": digest_json(self.to_dict()),
   329	        }
   330	
   331	    def to_dict(self) -> dict[str, Any]:
   332	        return self._manifest_dict(self._records)
   333	
   334	    @staticmethod
   335	    def _manifest_dict(records: Mapping[str, ArtifactRecord]) -> dict[str, Any]:
   336	        return {
   337	            "schema_version": "1.0",
   338	            "content_addressing": "sha256",
   339	            "records": [records[key].to_dict() for key in sorted(records)],
   340	        }
   341	
   342	    def save_manifest(self) -> Path:
   343	        self._save_manifest(self._records)
   344	        return self.manifest_path
   345	
   346	    def _save_manifest(self, records: Mapping[str, ArtifactRecord]) -> None:
   347	        content = (
   348	            json.dumps(
   349	                self._manifest_dict(records),
   350	                ensure_ascii=False,
   351	                indent=2,
   352	                sort_keys=True,
   353	            )
   354	            + "\n"
   355	        ).encode("utf-8")
   356	        _durable_atomic_replace(self.manifest_path, content)
   357	
   358	    @classmethod
   359	    def load(cls, root: str | Path) -> "ArtifactStore":
   360	        root_path = Path(root)
   361	        manifest = root_path / "manifest.json"
   362	        if not manifest.is_file():
   363	            return cls(root_path)
   364	        payload = json.loads(manifest.read_text(encoding="utf-8"))
   365	        if not isinstance(payload, dict):
   366	            raise ValueError("artifact manifest root must be an object")
   367	        if set(payload) - {"schema_version", "content_addressing", "records"}:
   368	            raise ValueError("unknown artifact-manifest fields")
   369	        if str(payload.get("schema_version")) != "1.0":
   370	            raise ValueError("unsupported artifact-manifest schema")
   371	        if str(payload.get("content_addressing")) != "sha256":
   372	            raise ValueError("unsupported artifact addressing scheme")
   373	        store = cls(
   374	            root_path,
   375	            (ArtifactRecord.from_dict(item) for item in payload.get("records", [])),
   376	        )
   377	        verification = store.verify()
   378	        if not verification["valid"]:
   379	            raise ValueError("; ".join(verification["errors"]))
   380	        return store
   381	
   382	    def _add_record(self, record: ArtifactRecord) -> None:
   383	        self._add_record_to(self._records, record)
   384	
   385	    @staticmethod
   386	    def _add_record_to(
   387	        records: dict[str, ArtifactRecord],
   388	        record: ArtifactRecord,
   389	    ) -> None:
   390	        if record.artifact_id in records:
   391	            existing = records[record.artifact_id]
   392	            if existing.to_dict() != record.to_dict():
   393	                raise ValueError(f"conflicting artifact id: {record.artifact_id}")
   394	            return
   395	        if len(record.sha256) != 64:
   396	            raise ValueError(f"artifact {record.artifact_id} has invalid SHA-256")
   397	        records[record.artifact_id] = record

