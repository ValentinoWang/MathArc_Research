  1561	    def _recover_transaction_files(self) -> bool:
  1562	        payload = self._read_transaction()
  1563	        if payload is None:
  1564	            return False
  1565	        phase = payload["phase"]
  1566	        current_key = _read_verified_file(
  1567	            self.signing_key_path,
  1568	            label="topic observation signing key",
  1569	            expected_mode=_PRIVATE_FILE_MODE,
  1570	            missing_ok=True,
  1571	        )
  1572	        current_key_sha256 = (
  1573	            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
  1574	        )
  1575	        old_key_sha256 = payload["old_key_sha256"]
  1576	        use_target = False
  1577	        if phase == _TRANSACTION_PREPARED:
  1578	            if current_key_sha256 != old_key_sha256:
  1579	                raise TopicObservationError(
  1580	                    "topic observation transaction signing authority does not match prepared generation"
  1581	                )
  1582	        else:
  1583	            target_key_sha256 = payload["target_key_sha256"]
  1584	            if current_key_sha256 == target_key_sha256:
  1585	                use_target = True
  1586	            elif current_key_sha256 == old_key_sha256:
  1587	                if old_key_sha256 is None:
  1588	                    raise TopicObservationError(
  1589	                        "initial topic observation transaction has no signing "
  1590	                        "authority for the persisted generation"
  1591	                    )
  1592	            else:
  1593	                raise TopicObservationError(
  1594	                    "topic observation transaction signing authority is neither old nor committed generation"
  1595	                )
  1596	
  1597	        if use_target:
  1598	            literature_files = payload["target_literature_files"]
  1599	            state = payload["target_state"]
  1600	            authentication = payload["target_authentication"]
  1601	        else:
  1602	            literature_files = payload["old_literature_files"]
  1603	            state = payload["old_state"]
  1604	            authentication = payload["old_authentication"]
  1605	        self._restore_literature_files(literature_files)
  1606	        self._restore_private_snapshot(
  1607	            self.state_path,
  1608	            state,
  1609	            name="topic observation state",
  1610	        )
  1611	        self._restore_private_snapshot(
  1612	            self.authentication_path,
  1613	            authentication,
  1614	            name="topic observation authentication state",
  1615	        )
  1616	        return True
