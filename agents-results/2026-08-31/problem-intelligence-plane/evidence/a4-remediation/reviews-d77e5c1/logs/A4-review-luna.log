   117	    @classmethod
   118	    def from_dict(cls, payload: Mapping[str, Any]) -> "ArtifactRecord":
   119	        allowed = {
   120	            "artifact_id",
   121	            "sha256",
   122	            "size_bytes",
   123	            "media_type",
   124	            "relative_path",
   125	            "logical_role",
   126	            "producer",
   127	            "linked_claim_ids",
   128	            "linked_tool_call_ids",
   129	            "source_filename",
   130	            "created_at",
   131	        }
   132	        unknown = set(payload) - allowed
   133	        if unknown:
   134	            raise ValueError(f"unknown artifact-record fields: {sorted(unknown)}")
   135	        return cls(
   136	            artifact_id=str(payload["artifact_id"]),
   137	            sha256=str(payload["sha256"]),
   138	            size_bytes=int(payload["size_bytes"]),
   139	            media_type=str(payload["media_type"]),
   140	            relative_path=str(payload["relative_path"]),
   141	            logical_role=str(payload["logical_role"]),
   142	            producer=str(payload["producer"]),
   143	            linked_claim_ids=tuple(
   144	                str(item) for item in payload.get("linked_claim_ids", [])
   145	            ),
   146	            linked_tool_call_ids=tuple(
   147	                str(item) for item in payload.get("linked_tool_call_ids", [])
   148	            ),
   149	            source_filename=str(payload.get("source_filename", "")),
   150	            created_at=str(payload.get("created_at") or utc_now()),
   151	        )
