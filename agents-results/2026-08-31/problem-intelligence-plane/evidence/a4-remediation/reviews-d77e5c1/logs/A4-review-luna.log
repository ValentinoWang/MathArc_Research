   735	                    state,
   736	                    manual,
   737	                    conflict_kind="EXPECTED_CURSOR",
   738	                    expected_cursor=state["next_cursor"],
   739	                )
   740	                transaction = self._begin_transaction()
   741	                self._active_transaction = transaction
   742	                try:
   743	                    self._save_state(state)
   744	                    return TopicBatchResult(
   745	                        self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   746	                        (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   747	                    )
   748	                finally:
   749	                    self._active_transaction = None
   750	
   751	            transaction = self._begin_transaction()
   752	            self._active_transaction = transaction
   753	            results: list[TopicItemResult] = []
   754	            disposition_evidence: dict[str, dict[str, Any]] = {}
   755	            try:
