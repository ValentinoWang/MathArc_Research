  1265	    @staticmethod
  1266	    def _validated_literature_file_snapshots(value: object) -> list[dict[str, Any]]:
  1267	        if not isinstance(value, list):
  1268	            raise TopicObservationError("topic observation literature transaction snapshot is malformed")
  1269	        validated: list[dict[str, Any]] = []
  1270	        paths: list[str] = []
  1271	        for item in value:
  1272	            if not isinstance(item, dict):
  1273	                raise TopicObservationError("topic observation literature transaction file is malformed")
  1274	            _require_fields(
  1275	                item,
  1276	                {"path", "sha256", "size_bytes", "mode", "content_b64"},
  1277	                "topic observation literature transaction file",
  1278	            )
  1279	            path = _validate_snapshot_path(item["path"], "topic observation literature")
  1280	            if path != item["path"] or path == ".observations.lock":
  1281	                raise TopicObservationError("topic observation literature transaction path is invalid")
  1282	            file_snapshot = dict(item)
  1283	            file_snapshot.pop("path")
  1284	            content, mode = _decode_file_snapshot(
  1285	                file_snapshot,
  1286	                "topic observation literature transaction",
  1287	            )
  1288	            validated.append(
  1289	                {
  1290	                    "path": path,
  1291	                    **_encoded_file_snapshot(content, mode),
  1292	                }
  1293	            )
  1294	            paths.append(path)
  1295	        if paths != sorted(paths) or len(paths) != len(set(paths)):
  1296	            raise TopicObservationError(
  1297	                "topic observation literature transaction paths must be sorted and unique"
  1298	            )
  1299	        return validated
