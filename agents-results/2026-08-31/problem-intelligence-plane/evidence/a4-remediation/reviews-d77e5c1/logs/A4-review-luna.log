   477	    def test_retired_marker_normal_restore_failure_uses_fallback_fence(self) -> None:
   478	        with tempfile.TemporaryDirectory() as directory:
   479	            root = Path(directory)
   480	            runner = TopicObservationRunner(root, topic_id="integrity-topic", initial_cursor="c0")
   481	            original_fsync_directory = topic_observation_module._fsync_directory
   482	            original_atomic_write = topic_observation_module._atomic_write_bytes
   483	            failed_unlink_fsync = False
   484	
   485	            def fail_unlink_fsync_once(path: Path) -> None:
   486	                nonlocal failed_unlink_fsync
   487	                if (
   488	                    not failed_unlink_fsync
   489	                    and path == runner.root
   490	                    and not runner.retired_transaction_path.exists()
   491	                    and not runner.transaction_path.exists()
   492	                ):
   493	                    failed_unlink_fsync = True
   494	                    raise OSError("simulated retired unlink fsync failure")
   495	                original_fsync_directory(path)
   496	
   497	            def fail_normal_restore(path: Path, content: bytes, mode: int) -> None:
   498	                if path == runner.retired_transaction_path:
   499	                    raise OSError("simulated normal marker restore failure")
   500	                original_atomic_write(path, content, mode)
   501	
   502	            with (
   503	                patch.object(
   504	                    topic_observation_module,
   505	                    "_fsync_directory",
   506	                    side_effect=fail_unlink_fsync_once,
   507	                ),
   508	                patch.object(
   509	                    topic_observation_module,
   510	                    "_atomic_write_bytes",
   511	                    side_effect=fail_normal_restore,
   512	                ),
   513	            ):
   514	                with self.assertRaisesRegex(TopicObservationError, "normally restore"):
   515	                    runner.run(batch("c0", "c1", input_for("A")))
   516	
   517	            self.assertTrue(failed_unlink_fsync)
   518	            self.assertTrue(runner.retired_transaction_path.exists())
   519	            external = input_for("EXTERNAL")
   520	            blocked = LiteratureBase(root / "literature").import_bytes(
   521	                external.observation,
   522	                external.content,
   523	            )
   524	            self.assertEqual("REJECTED", blocked.disposition.value)
