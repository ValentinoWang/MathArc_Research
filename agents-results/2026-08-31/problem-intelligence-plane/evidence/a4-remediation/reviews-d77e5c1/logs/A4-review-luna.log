    26	TOPIC_OBSERVATION_TRANSACTION_PATH_NAME = ".topic-observation-transaction.json"
    27	TOPIC_OBSERVATION_RETIRED_TRANSACTION_PATH_NAME = (
    28	    ".topic-observation-transaction.retiring.json"
    29	)
    30	_WRITER_LOCK_STATE = threading.local()
    31	
    32	
    33	def _reset_lock_state_if_forked() -> None:
    34	    process_id = os.getpid()
    35	    if getattr(_WRITER_LOCK_STATE, "process_id", None) == process_id:
    36	        return
    37	    _WRITER_LOCK_STATE.process_id = process_id
    38	    _WRITER_LOCK_STATE.held_paths = set()
    39	    _WRITER_LOCK_STATE.authorized_paths = set()
    40	
    41	
    42	def _thread_lock_paths(name: str) -> set[str]:
    43	    _reset_lock_state_if_forked()
    44	    paths = getattr(_WRITER_LOCK_STATE, name, None)
    45	    if paths is None:
    46	        paths = set()
    47	        setattr(_WRITER_LOCK_STATE, name, paths)
    48	    return paths
    49	
    50	
    51	def _literature_root_key(root: Path) -> str:
    52	    return str(_canonical_literature_root(root))
    53	
    54	
    55	def _canonical_literature_root(root: Path) -> Path:
    56	    try:
    57	        canonical_root = root.resolve(strict=True)
    58	    except (OSError, RuntimeError) as exc:
    59	        raise ValueError("literature root is unreadable") from exc
    60	    if not canonical_root.is_dir():
    61	        raise ValueError("literature root is not a directory")
    62	    return canonical_root
    63	
    64	
    65	def _topic_transaction_pending(root: Path) -> bool:
    66	    canonical_root = _canonical_literature_root(root)
    67	    for path_name in (
    68	        TOPIC_OBSERVATION_TRANSACTION_PATH_NAME,
    69	        TOPIC_OBSERVATION_RETIRED_TRANSACTION_PATH_NAME,
    70	    ):
    71	        try:
    72	            (canonical_root.parent / path_name).lstat()
    73	        except FileNotFoundError:
    74	            continue
    75	        except OSError:
    76	            return True
    77	        return True
    78	    return False
    79	
    80	
    81	@contextmanager
    82	def literature_writer_lock(
    83	    root: str | Path,
    84	    *,
    85	    allow_topic_transaction: bool = False,
    86	) -> Iterator[None]:
    87	    """Serialize all writers, including a topic transaction spanning many imports."""
    88	
    89	    literature_root = Path(root)
    90	    _ensure_directory_durable(literature_root)
    91	    root_key = _literature_root_key(literature_root)
    92	    held_paths = _thread_lock_paths("held_paths")
    93	    authorized_paths = _thread_lock_paths("authorized_paths")
    94	    if root_key in held_paths:
    95	        added_authority = allow_topic_transaction and root_key not in authorized_paths
    96	        if added_authority:
    97	            authorized_paths.add(root_key)
    98	        try:
    99	            yield
   100	        finally:
   101	            if added_authority:
   102	                authorized_paths.remove(root_key)
   103	        return
   104	
   105	    lock_path = literature_root / ".observations.lock"
   106	    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
   107	    try:
   108	        descriptor = os.open(lock_path, flags, 0o600)
   109	    except OSError as exc:
   110	        raise ValueError("literature writer lock is unreadable") from exc
   111	    try:
   112	        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
   113	            raise ValueError("literature writer lock is not a regular file")
   114	        lock_file = os.fdopen(descriptor, "a+", encoding="utf-8")
   115	        descriptor = -1
   116	    except Exception:
   117	        if descriptor != -1:
   118	            os.close(descriptor)
   119	        raise
   120	    owner_pid = os.getpid()
   121	    with lock_file:
   122	        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   123	        held_paths.add(root_key)
   124	        if allow_topic_transaction:
   125	            authorized_paths.add(root_key)
   126	        try:
   127	            yield
   128	        finally:
   129	            if os.getpid() == owner_pid:
   130	                authorized_paths.discard(root_key)
   131	                held_paths.remove(root_key)
   132	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
   133	
   134	
   135	def _topic_transaction_authorized(root: Path) -> bool:
   136	    return _literature_root_key(root) in _thread_lock_paths("authorized_paths")
