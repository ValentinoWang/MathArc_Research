  1052	    def _persisted_observation_for_input(
  1053	        self,
  1054	        item: TopicObservationInput,
  1055	        *,
  1056	        allow_observation_id_conflict: bool = False,
  1057	    ) -> SourceObservation | None:
  1058	        by_id = next(
  1059	            (
  1060	                observation
  1061	                for observation in self.literature.observations
  1062	                if observation.observation_id == item.observation.observation_id
  1063	            ),
  1064	            None,
  1065	        )
  1066	        by_key = next(
  1067	            (
  1068	                observation
  1069	                for observation in self.literature.observations
  1070	                if observation.idempotency_key == item.observation.idempotency_key
  1071	            ),
  1072	            None,
  1073	        )
  1074	        if by_id is not None and by_id.idempotency_key != item.observation.idempotency_key:
  1075	            if allow_observation_id_conflict and by_key is None:
  1076	                return by_id
  1077	            raise TopicObservationError(
  1078	                "persisted observation id and idempotency key identify different records"
  1079	            )
  1080	        if by_id is not None and by_key is not None and by_id.observation_id != by_key.observation_id:
  1081	            raise TopicObservationError(
  1082	                "persisted observation id and idempotency key identify different records"
  1083	            )
  1084	        return by_id if by_id is not None else by_key
