   386	    def _reload_state(self) -> None:
   387	        artifacts = ArtifactStore.load(self.root / "artifacts")
   388	        observations: dict[str, SourceObservation] = {}
   389	        if not self.manifest_path.is_file():
   390	            self.artifacts = artifacts
   391	            self._observations = observations
   392	            return
   393	        payload = json.loads(self.manifest_path.read_text(encoding="utf-8"))
   394	        if not isinstance(payload, dict) or set(payload) != {"schema_version", "observations"}:
   395	            raise ValueError("invalid literature observation manifest")
   396	        if payload["schema_version"] != "1.0":
   397	            raise ValueError("unsupported literature observation schema")
   398	        if not isinstance(payload["observations"], list):
   399	            raise ValueError("invalid literature observation manifest")
   400	        observation_keys: dict[str, str] = {}
   401	        for item in payload["observations"]:
   402	            observation = SourceObservation.from_dict(item)
   403	            if observation.observation_id in observations:
   404	                raise ValueError("duplicate observation id")
   405	            existing_observation_id = observation_keys.get(observation.idempotency_key)
   406	            if (
   407	                existing_observation_id is not None
   408	                and existing_observation_id != observation.observation_id
   409	            ):
   410	                raise ValueError("duplicate observation idempotency key")
   411	            observation_keys[observation.idempotency_key] = observation.observation_id
   412	            observations[observation.observation_id] = observation
   413	        self._validate_observed_artifacts(artifacts=artifacts, observations=observations)
   414	        self.artifacts = artifacts
   415	        self._observations = observations
   416	
   417	    def _record(self, observation: SourceObservation) -> None:
   418	        candidate_observations = dict(self._observations)
   419	        existing = candidate_observations.get(observation.observation_id)
   420	        if existing is not None and existing.to_dict() != observation.to_dict():
   421	            if (
   422	                existing.logical_identity != observation.logical_identity
   423	                or existing.status is not ObservationStatus.PENDING
   424	            ):
   425	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   426	        for existing in candidate_observations.values():
   427	            if (
   428	                existing.observation_id != observation.observation_id
   429	                and existing.idempotency_key == observation.idempotency_key
   430	            ):
   431	                raise ValueError("refusing to record duplicate observation idempotency key")
   432	        candidate_observations[observation.observation_id] = observation
   433	        payload = {
   434	            "schema_version": "1.0",
   435	            "observations": [
   436	                candidate_observations[key].to_dict()
   437	                for key in sorted(candidate_observations)
   438	            ],
   439	        }
   440	        content = (
   441	            json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
   442	        ).encode("utf-8")
   443	        _durable_atomic_replace(self.manifest_path, content)
   444	        self._observations = candidate_observations
