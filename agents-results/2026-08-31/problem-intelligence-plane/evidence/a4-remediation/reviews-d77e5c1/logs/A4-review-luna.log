   254	
   255	def _fsync_directory(directory: Path) -> None:
   256	    directory_fd = os.open(directory, os.O_RDONLY)
   257	    try:
   258	        os.fsync(directory_fd)
   259	    finally:
   260	        os.close(directory_fd)
   261	
   262	
   263	def _atomic_write_bytes(path: Path, content: bytes, mode: int) -> None:
   264	    temporary_name: str | None = None
   265	    try:
   266	        fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
   267	        open_fd = fd
   268	        try:
   269	            os.fchmod(open_fd, mode)
   270	            with os.fdopen(open_fd, "wb") as temporary_file:
   271	                open_fd = -1
   272	                temporary_file.write(content)
   273	                temporary_file.flush()
   274	                os.fsync(temporary_file.fileno())
   275	        finally:
   276	            if open_fd != -1:
   277	                os.close(open_fd)
   278	        os.replace(temporary_name, path)
   279	        temporary_name = None
   280	        _fsync_directory(path.parent)
   281	    finally:
   282	        if temporary_name is not None:
   283	            try:
   284	                os.unlink(temporary_name)
   285	            except FileNotFoundError:
   286	                pass
   287	
   288	
   289	def _state_authentication_message(state_bytes: bytes, literature_snapshot_bytes: bytes) -> bytes:
   290	    return (
   291	        _STATE_AUTH_DOMAIN
   292	        + len(state_bytes).to_bytes(8, "big")
   293	        + state_bytes
   294	        + len(literature_snapshot_bytes).to_bytes(8, "big")
   295	        + literature_snapshot_bytes
   296	    )
