  1398	
  1399	        if phase == _TRANSACTION_COMMIT_INTENT:
  1400	            target_key = payload["target_key_sha256"]
  1401	            if not isinstance(target_key, str):
  1402	                raise TopicObservationError("target topic observation signing key digest is missing")
  1403	            _require_sha256(target_key, "target topic observation signing key digest")
  1404	            if target_key == old_key:
