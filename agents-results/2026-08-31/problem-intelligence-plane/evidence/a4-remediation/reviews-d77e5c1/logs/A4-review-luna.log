    81	@contextmanager
    82	def literature_writer_lock(
    83	    root: str | Path,
    84	    *,
    85	    allow_topic_transaction: bool = False,
    86	) -> Iterator[None]:
    87	    """Serialize all writers, including a topic transaction spanning many imports."""
    88	
    89	    literature_root = Path(root)
    90	    _ensure_directory_durable(literature_root)
    91	    root_key = _literature_root_key(literature_root)
    92	    held_paths = _thread_lock_paths("held_paths")
    93	    authorized_paths = _thread_lock_paths("authorized_paths")
    94	    if root_key in held_paths:
    95	        added_authority = allow_topic_transaction and root_key not in authorized_paths
    96	        if added_authority:
    97	            authorized_paths.add(root_key)
    98	        try:
    99	            yield
   100	        finally:
   101	            if added_authority:
   102	                authorized_paths.remove(root_key)
   103	        return
   104	
   105	    lock_path = literature_root / ".observations.lock"
   106	    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
   107	    try:
   108	        descriptor = os.open(lock_path, flags, 0o600)
   109	    except OSError as exc:
   110	        raise ValueError("literature writer lock is unreadable") from exc
   111	    try:
   112	        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
   113	            raise ValueError("literature writer lock is not a regular file")
   114	        lock_file = os.fdopen(descriptor, "a+", encoding="utf-8")
   115	        descriptor = -1
   116	    except Exception:
   117	        if descriptor != -1:
   118	            os.close(descriptor)
   119	        raise
   120	    owner_pid = os.getpid()
   121	    with lock_file:
   122	        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   123	        held_paths.add(root_key)
   124	        if allow_topic_transaction:
   125	            authorized_paths.add(root_key)
   126	        try:
   127	            yield
   128	        finally:
   129	            if os.getpid() == owner_pid:
   130	                authorized_paths.discard(root_key)
   131	                held_paths.remove(root_key)
   132	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
   133	
   134	
   135	def _topic_transaction_authorized(root: Path) -> bool:
   136	    return _literature_root_key(root) in _thread_lock_paths("authorized_paths")
