    32	
    33	_DIGEST_RE = re.compile(r"^[0-9a-f]{64}$")
    34	_STATUS_ASSERTION_LANGUAGE = re.compile(
    35	    r"\b(?:proved|proof|solved|novel)\b|"
    36	    r"\b(?:open|closed)\s+(?:problem|question|conjecture)\b|"
    37	    r"\b(?:remains?|is|was)\s+(?:provably\s+)?open\b",
    38	    re.I,
    39	)
    40	_MEDIA_TYPES = frozenset(
    41	    {
