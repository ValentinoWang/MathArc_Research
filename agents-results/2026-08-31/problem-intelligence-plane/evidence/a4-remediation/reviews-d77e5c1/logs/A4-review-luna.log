   211	            _fsync_directory(target.parent)
   212	        else:
   213	            _durable_atomic_replace(target, content)
   214	        record = ArtifactRecord(
   215	            artifact_id=artifact_id,
   216	            sha256=sha256,
   217	            size_bytes=len(content),
   218	            media_type=media_type,
   219	            relative_path=relative_path.as_posix(),
   220	            logical_role=logical_role,
   221	            producer=producer,
   222	            linked_claim_ids=tuple(str(item) for item in linked_claim_ids),
   223	            linked_tool_call_ids=tuple(str(item) for item in linked_tool_call_ids),
   224	            source_filename=source_filename,
