   765	                    self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results)
   766	                )
   767	                input_projections = {
   768	                    item.input_id: item.input_projection for item in batch.inputs
   769	                }
   770	                for input_id, evidence in disposition_evidence.items():
   771	                    evidence["input_projection_binding_sha256"] = _input_projection_binding_digest(
   772	                        topic_id=batch.topic_id,
   773	                        cursor=batch.cursor,
   774	                        next_cursor=batch.next_cursor,
   775	                        batch_digest_sha256=batch_digest_sha256,
   776	                        input_projection=input_projections[input_id],
   777	                    )
