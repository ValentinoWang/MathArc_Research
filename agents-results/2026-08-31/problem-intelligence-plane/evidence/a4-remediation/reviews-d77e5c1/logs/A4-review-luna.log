  1618	    def _remove_transaction(self) -> None:
  1619	        snapshot = _read_verified_file(
  1620	            self.transaction_path,
  1621	            label="topic observation transaction journal",
  1622	            expected_mode=_PRIVATE_FILE_MODE,
  1623	            missing_ok=True,
  1624	        )
