import hashlib
from pathlib import Path
from tempfile import TemporaryDirectory

from matharc.v02.source_observation import LicenseStatus, SourceObservation, new_observation
from matharc.v02.topic_observation import (
    TopicObservationBatch, TopicObservationInput, TopicObservationRunner,
)

content = b\"pending replay after upgrade\"
base_kwargs = dict(
    observation_id=\"OBS-A\",
    canonical_uri=\"https://repro.example/pending-replay\",
    pinned_version=\"v1\",
    license_basis=\"fixture\",
    content_summary=\"Descriptive pending replay metadata.\",
    summary_basis=\"fixture\",
    media_type=\"text/plain\",
    content_digest_sha256=hashlib.sha256(content).hexdigest(),
    observed_at=\"2026-09-02T08:00:00+00:00\",
)
pending_obs = new_observation(**base_kwargs, license_status=LicenseStatus.RESTRICTED)
observed_obs = SourceObservation.from_dict({**pending_obs.to_dict(), \"license_status\": \"OPEN\", \"license_basis\": \"open fixture\"})
pending = TopicObservationInput(\"A\", pending_obs, content)
observed = TopicObservationInput(\"B\", observed_obs, content)
def batch(cursor, next_cursor, item):
    return TopicObservationBatch(\"repro-topic\", cursor, next_cursor, (item,))
with TemporaryDirectory(prefix=\"a4-review-luna-\", dir=\"/tmp\") as directory:
    runner = TopicObservationRunner(Path(directory), topic_id=\"repro-topic\", initial_cursor=\"c0\")
    print(\"first\", runner.run(batch(\"c0\", \"c1\", pending)).item_results[0].status.value)
    print(\"upgrade\", runner.run(batch(\"c1\", \"c2\", observed)).item_results[0].status.value)
    try:
        replay = runner.run(batch(\"c2\", \"c3\", pending))
    except BaseException as exc:
        print(\"replay_exception\", type(exc).__name__, str(exc))
        print(\"transaction_left\", runner.transaction_path.exists())
    else:
        print(\"replay_result\", replay.item_results[0].status.value, replay.item_results[0].observation_id)
