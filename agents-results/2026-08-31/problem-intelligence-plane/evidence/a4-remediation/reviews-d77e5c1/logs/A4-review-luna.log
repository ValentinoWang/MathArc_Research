   133	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   134	    unknown = set(payload) - expected
   135	    missing = expected - set(payload)
   136	    if unknown:
   137	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   138	    if missing:
