   198	class LiteratureWriterForkTests(unittest.TestCase):
   199	    def test_fork_does_not_inherit_reentrancy_or_transaction_authority(self) -> None:
   200	        with tempfile.TemporaryDirectory() as directory:
   201	            root = Path(directory)
   202	            read_fd, write_fd = os.pipe()
   203	            child_pid: int | None = None
   204	            try:
   205	                with literature_writer_lock(root, allow_topic_transaction=True):
   206	                    child_pid = os.fork()
   207	                    if child_pid == 0:
   208	                        os.close(read_fd)
   209	                        try:
   210	                            os.write(write_fd, b"X" if _topic_transaction_authorized(root) else b"A")
   211	                            with literature_writer_lock(root):
   212	                                os.write(write_fd, b"L")
   213	                        except BaseException:
   214	                            try:
   215	                                os.write(write_fd, b"E")
   216	                            finally:
   217	                                os._exit(1)
   218	                        os._exit(0)
   219	                    os.close(write_fd)
   220	                    write_fd = -1
   221	                    self.assertEqual(b"A", _read_with_timeout(read_fd, 1.0))
   222	                    self.assertIsNone(_read_with_timeout(read_fd, 0.1))
   223	                self.assertEqual(b"L", _read_with_timeout(read_fd, 1.0))
   224	            finally:
   225	                if write_fd != -1:
   226	                    os.close(write_fd)
   227	                os.close(read_fd)
   228	                if child_pid is not None and child_pid > 0:
   229	                    status = _reap(child_pid)
   230	                    self.assertTrue(os.WIFEXITED(status))
   231	                    self.assertEqual(0, os.WEXITSTATUS(status))
