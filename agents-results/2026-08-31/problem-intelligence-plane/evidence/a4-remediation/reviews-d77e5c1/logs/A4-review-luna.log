  1636	        except OSError as exc:
  1637	            raise TopicObservationError(
  1638	                "could not retire topic observation transaction journal"
  1639	            ) from exc
  1640	        try:
  1641	            _fsync_directory(self.root)
  1642	        except OSError as exc:
  1643	            raise TopicObservationError(
  1644	                "could not durably retire topic observation transaction journal"
  1645	            ) from exc
  1646	        self._remove_retired_transaction(
  1647	            journal_bytes=journal_bytes,
  1648	            journal_mode=journal_mode,
  1649	        )
