  1229	            raise TopicObservationError("topic observation literature root is not a directory")
  1230	
  1231	        snapshots: list[dict[str, Any]] = []
  1232	        for current, directories, files in os.walk(literature_root, followlinks=False):
  1233	            current_path = Path(current)
  1234	            for directory_name in directories:
  1235	                directory_path = current_path / directory_name
  1236	                try:
  1237	                    metadata = directory_path.lstat()
  1238	                except OSError as exc:
  1239	                    raise TopicObservationError("topic observation literature directory is unreadable") from exc
  1240	                if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
  1241	                    raise TopicObservationError("topic observation literature directory is not regular")
  1242	            for file_name in files:
  1243	                file_path = current_path / file_name
  1244	                relative_path = file_path.relative_to(literature_root).as_posix()
  1245	                if relative_path == ".observations.lock":
  1246	                    continue
  1247	                result = _read_verified_file(
  1248	                    file_path,
  1249	                    label=f"topic observation literature file {relative_path}",
  1250	                    expected_mode=None,
  1251	                    missing_ok=False,
  1252	                )
  1253	                if result is None:
  1254	                    raise TopicObservationError("topic observation literature file disappeared")
  1255	                content, mode = result
  1256	                snapshots.append(
  1257	                    {
  1258	                        "path": relative_path,
  1259	                        **_encoded_file_snapshot(content, mode),
  1260	                    }
  1261	                )
  1262	        snapshots.sort(key=lambda item: item["path"])
  1263	        return snapshots
