   154	class ArtifactStore:
   155	    """Content-addressed storage for certificates, logs, sources and reports."""
   156	
   157	    def __init__(
   158	        self,
   159	        root: str | Path,
   160	        records: Iterable[ArtifactRecord] = (),
   161	    ) -> None:
   162	        self.root = Path(root)
   163	        self.blob_root = self.root / "sha256"
   164	        self.manifest_path = self.root / "manifest.json"
   165	        _ensure_directory_durable(self.blob_root)
   166	        self._records: dict[str, ArtifactRecord] = {}
   167	        for record in records:
   168	            self._add_record(record)
   169	
   170	    @property
   171	    def records(self) -> tuple[ArtifactRecord, ...]:
   172	        return tuple(self._records[key] for key in sorted(self._records))
   173	
   174	    def get(self, artifact_id: str) -> ArtifactRecord:
   175	        try:
   176	            return self._records[artifact_id]
   177	        except KeyError as exc:
   178	            raise KeyError(f"unknown artifact: {artifact_id}") from exc
   179	
   180	    def path_for(self, artifact_id: str) -> Path:
   181	        record = self.get(artifact_id)
   182	        path = (self.root / record.relative_path).resolve()
   183	        if self.root.resolve() not in path.parents:
   184	            raise ValueError(f"artifact path escapes store root: {record.relative_path}")
   185	        return path
   186	
   187	    def put_bytes(
   188	        self,
   189	        artifact_id: str,
   190	        content: bytes,
   191	        *,
   192	        logical_role: str,
   193	        producer: str,
   194	        media_type: str = "application/octet-stream",
   195	        linked_claim_ids: Iterable[str] = (),
   196	        linked_tool_call_ids: Iterable[str] = (),
   197	        source_filename: str = "",
   198	    ) -> ArtifactRecord:
   199	        if artifact_id in self._records:
   200	            raise ValueError(f"duplicate artifact id: {artifact_id}")
   201	        sha256 = hashlib.sha256(content).hexdigest()
   202	        relative_path = Path("sha256") / sha256[:2] / sha256
   203	        target = self.root / relative_path
   204	        _ensure_directory_durable(target.parent)
   205	        if target.exists():
   206	            with target.open("rb") as existing_file:
   207	                existing = existing_file.read()
   208	                if existing != content:
   209	                    raise ValueError(f"content-address collision at {target}")
   210	                os.fsync(existing_file.fileno())
   211	            _fsync_directory(target.parent)
   212	        else:
   213	            _durable_atomic_replace(target, content)
   214	        record = ArtifactRecord(
   215	            artifact_id=artifact_id,
   216	            sha256=sha256,
   217	            size_bytes=len(content),
   218	            media_type=media_type,
   219	            relative_path=relative_path.as_posix(),
   220	            logical_role=logical_role,
   221	            producer=producer,
   222	            linked_claim_ids=tuple(str(item) for item in linked_claim_ids),
   223	            linked_tool_call_ids=tuple(str(item) for item in linked_tool_call_ids),
   224	            source_filename=source_filename,
   225	        )
   226	        candidate_records = dict(self._records)
   227	        self._add_record_to(candidate_records, record)
   228	        self._save_manifest(candidate_records)
   229	        self._records = candidate_records
   230	        return record
   231	
   232	    def put_text(
   233	        self,
   234	        artifact_id: str,
   235	        text: str,
   236	        *,
   237	        logical_role: str,
   238	        producer: str,
   239	        media_type: str = "text/plain; charset=utf-8",
   240	        linked_claim_ids: Iterable[str] = (),
   241	        linked_tool_call_ids: Iterable[str] = (),
   242	        source_filename: str = "",
   243	    ) -> ArtifactRecord:
   244	        return self.put_bytes(
   245	            artifact_id,
   246	            text.encode("utf-8"),
   247	            logical_role=logical_role,
   248	            producer=producer,
   249	            media_type=media_type,
   250	            linked_claim_ids=linked_claim_ids,
   251	            linked_tool_call_ids=linked_tool_call_ids,
   252	            source_filename=source_filename,
   253	        )
   254	
   255	    def put_json(
   256	        self,
   257	        artifact_id: str,
   258	        value: Any,
   259	        *,
   260	        logical_role: str,
   261	        producer: str,
   262	        linked_claim_ids: Iterable[str] = (),
   263	        linked_tool_call_ids: Iterable[str] = (),
   264	        source_filename: str = "",
   265	    ) -> ArtifactRecord:
   266	        text = json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
   267	        return self.put_text(
   268	            artifact_id,
   269	            text,
   270	            logical_role=logical_role,
   271	            producer=producer,
   272	            media_type="application/json; charset=utf-8",
   273	            linked_claim_ids=linked_claim_ids,
   274	            linked_tool_call_ids=linked_tool_call_ids,
   275	            source_filename=source_filename,
   276	        )
   277	
   278	    def import_file(
   279	        self,
   280	        artifact_id: str,
   281	        source: str | Path,
   282	        *,
   283	        logical_role: str,
   284	        producer: str,
   285	        media_type: str | None = None,
   286	        linked_claim_ids: Iterable[str] = (),
   287	        linked_tool_call_ids: Iterable[str] = (),
   288	    ) -> ArtifactRecord:
   289	        path = Path(source)
   290	        guessed = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
   291	        return self.put_bytes(
   292	            artifact_id,
   293	            path.read_bytes(),
   294	            logical_role=logical_role,
   295	            producer=producer,
   296	            media_type=media_type or guessed,
   297	            linked_claim_ids=linked_claim_ids,
   298	            linked_tool_call_ids=linked_tool_call_ids,
   299	            source_filename=path.name,
   300	        )
   301	
   302	    def verify(self) -> dict[str, Any]:
   303	        errors: list[str] = []
   304	        verified = 0
   305	        for record in self._records.values():
   306	            try:
   307	                path = self.path_for(record.artifact_id)
   308	            except ValueError as exc:
   309	                errors.append(str(exc))
   310	                continue
   311	            if not path.is_file():
   312	                errors.append(f"artifact file is missing: {record.artifact_id}")
   313	                continue
   314	            content = path.read_bytes()
   315	            actual = hashlib.sha256(content).hexdigest()
   316	            if actual != record.sha256:
   317	                errors.append(f"artifact digest mismatch: {record.artifact_id}")
   318	                continue
   319	            if len(content) != record.size_bytes:
   320	                errors.append(f"artifact size mismatch: {record.artifact_id}")
   321	                continue
   322	            verified += 1
   323	        return {
   324	            "valid": not errors,
   325	            "errors": errors,
   326	            "artifact_count": len(self._records),
   327	            "verified_count": verified,
   328	            "manifest_digest_sha256": digest_json(self.to_dict()),
   329	        }
   330	
   331	    def to_dict(self) -> dict[str, Any]:
   332	        return self._manifest_dict(self._records)
   333	
   334	    @staticmethod
   335	    def _manifest_dict(records: Mapping[str, ArtifactRecord]) -> dict[str, Any]:
   336	        return {
   337	            "schema_version": "1.0",
   338	            "content_addressing": "sha256",
   339	            "records": [records[key].to_dict() for key in sorted(records)],
   340	        }
   341	
   342	    def save_manifest(self) -> Path:
   343	        self._save_manifest(self._records)
   344	        return self.manifest_path
   345	
   346	    def _save_manifest(self, records: Mapping[str, ArtifactRecord]) -> None:
   347	        content = (
   348	            json.dumps(
   349	                self._manifest_dict(records),
   350	                ensure_ascii=False,
   351	                indent=2,
   352	                sort_keys=True,
   353	            )
   354	            + "\n"
   355	        ).encode("utf-8")
   356	        _durable_atomic_replace(self.manifest_path, content)
   357	
   358	    @classmethod
   359	    def load(cls, root: str | Path) -> "ArtifactStore":
   360	        root_path = Path(root)
   361	        manifest = root_path / "manifest.json"
   362	        if not manifest.is_file():
   363	            return cls(root_path)
   364	        payload = json.loads(manifest.read_text(encoding="utf-8"))
   365	        if not isinstance(payload, dict):
   366	            raise ValueError("artifact manifest root must be an object")
   367	        if set(payload) - {"schema_version", "content_addressing", "records"}:
   368	            raise ValueError("unknown artifact-manifest fields")
   369	        if str(payload.get("schema_version")) != "1.0":
   370	            raise ValueError("unsupported artifact-manifest schema")
   371	        if str(payload.get("content_addressing")) != "sha256":
   372	            raise ValueError("unsupported artifact addressing scheme")
   373	        store = cls(
   374	            root_path,
   375	            (ArtifactRecord.from_dict(item) for item in payload.get("records", [])),
   376	        )
   377	        verification = store.verify()
   378	        if not verification["valid"]:
   379	            raise ValueError("; ".join(verification["errors"]))
   380	        return store
   381	
   382	    def _add_record(self, record: ArtifactRecord) -> None:
   383	        self._add_record_to(self._records, record)
   384	
   385	    @staticmethod
   386	    def _add_record_to(
   387	        records: dict[str, ArtifactRecord],
   388	        record: ArtifactRecord,
   389	    ) -> None:
   390	        if record.artifact_id in records:
   391	            existing = records[record.artifact_id]
   392	            if existing.to_dict() != record.to_dict():
   393	                raise ValueError(f"conflicting artifact id: {record.artifact_id}")
   394	            return
   395	        if len(record.sha256) != 64:
   396	            raise ValueError(f"artifact {record.artifact_id} has invalid SHA-256")
   397	        records[record.artifact_id] = record
