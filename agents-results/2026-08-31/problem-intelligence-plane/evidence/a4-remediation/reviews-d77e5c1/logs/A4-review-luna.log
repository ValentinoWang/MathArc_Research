   479	@dataclass(frozen=True, slots=True)
   480	class TopicObservationBatch:
   481	    """A one-topic, explicitly cursor-bounded batch of source candidates."""
   482	
   483	    topic_id: str
   484	    cursor: str
   485	    next_cursor: str
   486	    inputs: tuple[TopicObservationInput, ...]
   487	    schema_version: str = _SCHEMA_VERSION
   488	
   489	    def __post_init__(self) -> None:
   490	        _require_nonempty(self.topic_id, "topic_id")
   491	        _require_nonempty(self.cursor, "cursor")
   492	        _require_nonempty(self.next_cursor, "next_cursor")
   493	        if self.cursor == self.next_cursor:
   494	            raise TopicObservationError("next_cursor must advance beyond cursor")
   495	        if not isinstance(self.inputs, tuple) or not self.inputs:
   496	            raise TopicObservationError("inputs must be a non-empty tuple")
   497	        if any(not isinstance(item, TopicObservationInput) for item in self.inputs):
   498	            raise TypeError("inputs must contain TopicObservationInput records")
   499	        identifiers = tuple(item.input_id for item in self.inputs)
   500	        if len(identifiers) != len(set(identifiers)) or tuple(sorted(identifiers)) != identifiers:
   501	            raise TopicObservationError("input ids must be sorted and unique")
   502	        if self.schema_version != _SCHEMA_VERSION:
   503	            raise TopicObservationError("unsupported topic-observation batch schema_version")
   504	
   505	    @property
   506	    def batch_digest_sha256(self) -> str:
   507	        return _batch_digest_from_fingerprints(
   508	            topic_id=self.topic_id,
   509	            cursor=self.cursor,
   510	            next_cursor=self.next_cursor,
   511	            input_fingerprints={
   512	                item.input_id: item.fingerprint_sha256 for item in self.inputs
   513	            },
   514	        )
