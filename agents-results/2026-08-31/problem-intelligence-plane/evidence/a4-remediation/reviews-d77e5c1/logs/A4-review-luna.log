  1149	    @contextmanager
  1150	    def _writer_lock(self) -> Iterator[None]:
  1151	        flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
  1152	        try:
  1153	            descriptor = os.open(self.lock_path, flags, _PRIVATE_FILE_MODE)
  1154	        except OSError as exc:
  1155	            raise TopicObservationError("topic observation lock is unreadable") from exc
  1156	        try:
  1157	            if not stat.S_ISREG(os.fstat(descriptor).st_mode):
  1158	                raise TopicObservationError("topic observation lock is not a regular file")
  1159	            lock_file = os.fdopen(descriptor, "a+", encoding="utf-8")
  1160	            descriptor = -1
  1161	        except Exception:
  1162	            if descriptor != -1:
  1163	                os.close(descriptor)
  1164	            raise
  1165	        owner_pid = os.getpid()
  1166	        with lock_file:
  1167	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
  1168	            try:
  1169	                yield
  1170	            finally:
  1171	                if os.getpid() == owner_pid:
  1172	                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
