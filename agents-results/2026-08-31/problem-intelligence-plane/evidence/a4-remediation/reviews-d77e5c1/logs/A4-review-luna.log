   173	def _read_verified_file(
   174	    path: Path,
   175	    *,
   176	    label: str,
   177	    expected_mode: int | None,
   178	    missing_ok: bool,
   179	) -> tuple[bytes, int] | None:
   180	    """Read one file through an identity-checked descriptor."""
   181	
   182	    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
   183	    try:
   184	        file_descriptor = os.open(path, flags)
   185	    except FileNotFoundError as exc:
   186	        if missing_ok:
   187	            return None
   188	        raise TopicObservationError(f"{label} is missing") from exc
   189	    except OSError as exc:
   190	        raise TopicObservationError(f"{label} is unreadable") from exc
   191	
   192	    open_descriptor = file_descriptor
   193	    try:
   194	        metadata = os.fstat(file_descriptor)
   195	        if not stat.S_ISREG(metadata.st_mode):
   196	            raise TopicObservationError(f"{label} is not a regular file")
   197	        mode = stat.S_IMODE(metadata.st_mode)
   198	        if expected_mode is not None and mode != expected_mode:
   199	            raise TopicObservationError(f"{label} must have mode {expected_mode:04o}")
   200	        with os.fdopen(file_descriptor, "rb") as file:
   201	            open_descriptor = -1
   202	            return file.read(), mode
   203	    except TopicObservationError:
   204	        raise
   205	    except OSError as exc:
   206	        raise TopicObservationError(f"{label} is unreadable") from exc
   207	    finally:
   208	        if open_descriptor != -1:
   209	            os.close(open_descriptor)
   210	
   211	
   212	def _encoded_file_snapshot(content: bytes, mode: int) -> dict[str, Any]:
   213	    return {
   214	        "sha256": hashlib.sha256(content).hexdigest(),
   215	        "size_bytes": len(content),
   216	        "mode": mode,
   217	        "content_b64": base64.b64encode(content).decode("ascii"),
   218	    }
   219	
   220	
   220	
   221	def _decode_file_snapshot(value: object, name: str) -> tuple[bytes, int]:
   222	    if not isinstance(value, dict):
   223	        raise TopicObservationError(f"{name} snapshot is malformed")
   224	    _require_fields(value, {"sha256", "size_bytes", "mode", "content_b64"}, f"{name} snapshot")
   225	    digest = _require_sha256(value["sha256"], f"{name} snapshot digest")
   226	    size_bytes = value["size_bytes"]
   227	    if isinstance(size_bytes, bool) or not isinstance(size_bytes, int) or size_bytes < 0:
   228	        raise TopicObservationError(f"{name} snapshot size is invalid")
   229	    mode = value["mode"]
   230	    if isinstance(mode, bool) or not isinstance(mode, int) or mode < 0 or mode > 0o7777:
   231	        raise TopicObservationError(f"{name} snapshot mode is invalid")
   232	    content_b64 = value["content_b64"]
   233	    if not isinstance(content_b64, str):
   234	        raise TopicObservationError(f"{name} snapshot content is invalid")
   235	    try:
   236	        content = base64.b64decode(content_b64.encode("ascii"), validate=True)
   237	    except (UnicodeEncodeError, binascii.Error, ValueError) as exc:
   238	        raise TopicObservationError(f"{name} snapshot content is invalid") from exc
   239	    if len(content) != size_bytes or hashlib.sha256(content).hexdigest() != digest:
   240	        raise TopicObservationError(f"{name} snapshot digest mismatch")
   241	    return content, mode
   242	
   243	
   244	def _validate_snapshot_path(value: object, name: str) -> str:
   245	    if not isinstance(value, str) or not value:
   246	        raise TopicObservationError(f"{name} snapshot path is invalid")
   247	    path = Path(value)
   248	    if path.is_absolute() or not path.parts or "." in path.parts or ".." in path.parts:
   249	        raise TopicObservationError(f"{name} snapshot path is invalid")
   250	    if "\x00" in value:
   251	        raise TopicObservationError(f"{name} snapshot path is invalid")
   252	    return path.as_posix()
