  1693	    def _restore_transaction_fence_fallback(
  1694	        self,
  1695	        journal_bytes: bytes,
  1696	        journal_mode: int,
  1697	    ) -> None:
  1698	        """Keep external writers fenced when normal retired-marker restoration fails."""
  1699	
  1700	        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
  1701	        try:
  1702	            descriptor = os.open(self.retired_transaction_path, flags, journal_mode)
  1703	        except FileExistsError:
  1704	            return
  1705	        except OSError as exc:
  1706	            raise TopicObservationError(
  1707	                "could not restore retired topic observation transaction fence"
  1708	            ) from exc
  1709	        try:
  1710	            view = memoryview(journal_bytes)
  1711	            while view:
  1712	                written = os.write(descriptor, view)
  1713	                if written <= 0:
  1714	                    raise OSError("short write while restoring transaction fence")
  1715	                view = view[written:]
  1716	            os.fsync(descriptor)
  1717	        finally:
  1718	            os.close(descriptor)
  1719	        try:
  1720	            _fsync_directory(self.root)
  1721	        except OSError as exc:
  1722	            # The marker remains visible in this runtime, and a crash can only
  1723	            # preserve either this restored marker or the failed prior unlink.
  1724	            raise TopicObservationError(
  1725	                "could not durably restore retired topic observation transaction fence"
  1726	            ) from exc
