    46	def _reap(pid: int, *, timeout: float = 3.0) -> int:
    47	    deadline = time.monotonic() + timeout
    48	    while time.monotonic() < deadline:
    49	        waited_pid, status = os.waitpid(pid, os.WNOHANG)
    50	        if waited_pid == pid:
    51	            return status
    52	        time.sleep(0.01)
    53	    os.kill(pid, signal.SIGKILL)
    54	    os.waitpid(pid, 0)
    55	    raise AssertionError(f"child process {pid} did not exit")
