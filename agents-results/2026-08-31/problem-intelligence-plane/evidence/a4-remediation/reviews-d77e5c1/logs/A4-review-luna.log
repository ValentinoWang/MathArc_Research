   999	    def _item_evidence(
  1000	        self,
  1001	        item: TopicObservationInput,
  1002	        result: TopicItemResult,
  1003	        basis: str,
  1004	        *,
  1005	        persisted: SourceObservation | None = None,
  1006	        manual_id: str | None = None,
  1007	        manual_reason: ManualReviewReason | None = None,
  1008	        import_disposition: ImportDisposition | None = None,
  1009	        prior_cursor: str | None = None,
  1010	        prior_input_id: str | None = None,
  1011	    ) -> dict[str, Any]:
  1012	        persisted_status = "ABSENT"
  1013	        persisted_observation_id = None
  1014	        persisted_content_digest = None
  1015	        persisted_artifact_id = None
  1016	        persisted_artifact_sha256 = None
  1017	        if persisted is not None:
  1018	            persisted_status = persisted.status.value
  1019	            persisted_observation_id = persisted.observation_id
  1020	            persisted_content_digest = persisted.content_digest_sha256
  1021	            if persisted.status is ObservationStatus.OBSERVED:
  1022	                if persisted.artifact_id is None:
  1023	                    raise TopicObservationError("observed literature evidence has no artifact")
  1024	                try:
  1025	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
  1026	                except KeyError as exc:
  1027	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
  1028	                persisted_artifact_id = artifact.artifact_id
  1029	                persisted_artifact_sha256 = artifact.sha256
  1030	        return {
  1031	            "basis": basis,
  1032	            "input_id": item.input_id,
  1033	            "input_observation_id": item.observation.observation_id,
  1034	            "input_idempotency_key": item.observation.idempotency_key,
  1035	            "input_content_digest_sha256": item.observation.content_digest_sha256,
  1036	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
  1037	            "input_content_size_bytes": len(item.content),
  1038	            "input_risk_flags": list(item.risk_flags),
  1039	            "observation_id": result.observation_id,
  1040	            "persisted_observation_id": persisted_observation_id,
  1041	            "persisted_observation_status": persisted_status,
  1042	            "persisted_content_digest_sha256": persisted_content_digest,
  1043	            "persisted_artifact_id": persisted_artifact_id,
  1044	            "persisted_artifact_sha256": persisted_artifact_sha256,
  1045	            "manual_id": manual_id,
  1046	            "manual_reason": manual_reason.value if manual_reason is not None else None,
  1047	            "prior_cursor": prior_cursor,
  1048	            "prior_input_id": prior_input_id,
