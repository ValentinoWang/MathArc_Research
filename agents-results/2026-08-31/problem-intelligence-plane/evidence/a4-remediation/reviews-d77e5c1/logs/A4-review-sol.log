 class ImportDisposition(str, Enum):
     IMPORTED = "IMPORTED"
     IDEMPOTENT = "IDEMPOTENT"
     PENDING = "PENDING"
     CONFLICT = "CONFLICT"
     REJECTED = "REJECTED"
 
 
