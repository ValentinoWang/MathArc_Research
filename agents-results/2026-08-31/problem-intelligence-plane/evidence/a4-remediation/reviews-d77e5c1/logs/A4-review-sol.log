    24	def _ensure_directory_durable(path: str | Path) -> None:
    25	    directory = Path(path)
    26	    if not directory.is_absolute():
    27	        directory = Path.cwd() / directory
    28	    missing: list[Path] = []
    29	    current = directory
    30	    while True:
    31	        try:
    32	            current.stat()
    33	        except FileNotFoundError:
    34	            missing.append(current)
    35	        else:
    36	            if not current.is_dir():
    37	                raise NotADirectoryError(f"directory path is not a directory: {current}")
    38	            break
    39	        parent = current.parent
    40	        if parent == current:
    41	            raise FileNotFoundError(f"could not find directory parent: {current}")
    42	        current = parent
    43	
    44	    for child in reversed(missing):
    45	        try:
    46	            child.mkdir()
    47	        except FileExistsError:
    48	            if not child.is_dir():
    49	                raise
    50	            continue
    51	        _fsync_directory(child.parent)
