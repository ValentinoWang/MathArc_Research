+def _ensure_directory_durable(path: str | Path) -> None:
+    directory = Path(path)
+    if not directory.is_absolute():
+        directory = Path.cwd() / directory
+    missing: list[Path] = []
+    current = directory
+    while True:
+        try:
+            current.stat()
+        except FileNotFoundError:
