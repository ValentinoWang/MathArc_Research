+                            with literature_writer_lock(root):
+                                os.write(write_fd, b"L")
+                        except BaseException:
+                            try:
+                                os.write(write_fd, b"E")
+                            finally:
+                                os._exit(1)
+                        os._exit(0)
+                    os.close(write_fd)
+                    write_fd = -1
+                    self.assertEqual(b"A", _read_with_timeout(read_fd, 1.0))
+                    self.assertIsNone(_read_with_timeout(read_fd, 0.1))
