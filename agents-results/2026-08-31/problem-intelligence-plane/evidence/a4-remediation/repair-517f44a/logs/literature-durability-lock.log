+            finally:
+                if write_fd != -1:
+                    os.close(write_fd)
+                os.close(read_fd)
+                if child_pid is not None and child_pid > 0:
+                    status = _reap(child_pid)
+                    self.assertTrue(os.WIFEXITED(status))
+                    self.assertEqual(0, os.WEXITSTATUS(status))
