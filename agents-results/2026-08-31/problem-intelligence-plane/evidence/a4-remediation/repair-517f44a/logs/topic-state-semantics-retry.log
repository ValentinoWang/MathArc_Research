    68	            self.assertEqual(TopicRunStatus.APPLIED, first.status)
    69	            self.assertEqual(TopicItemStatus.IMPORTED, first.item_results[0].status)
    70	            restarted = TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0")
    71	            replay = restarted.run(batch("c0", "c1", input_for("A")))
    72	            self.assertEqual(TopicRunStatus.REPLAYED, replay.status)
    73	            self.assertTrue(replay.replayed)
    74	            self.assertEqual("c1", restarted.next_cursor)
    75	            self.assertEqual(1, len(restarted.literature.observations))
