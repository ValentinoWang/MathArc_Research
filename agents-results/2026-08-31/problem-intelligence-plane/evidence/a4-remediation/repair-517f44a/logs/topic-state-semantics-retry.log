  1699	    def _verify_state_authentication(
  1700	        self,
  1701	        state: Mapping[str, Any],
  1702	        state_bytes: bytes,
  1703	    ) -> None:
  1704	        state_snapshot_sha256 = _require_sha256(
  1705	            state["literature_snapshot_sha256"],
  1706	            "topic observation literature snapshot",
  1707	        )
  1708	        snapshot_bytes = self._literature_snapshot_bytes()
  1709	        current_snapshot_sha256 = hashlib.sha256(snapshot_bytes).hexdigest()
  1710	        if state_snapshot_sha256 != current_snapshot_sha256:
  1711	            raise TopicObservationError(
  1712	                "topic observation state literature snapshot does not match current literature"
  1713	            )
  1714	        authentication = self._read_authentication()
  1715	        if authentication["schema_version"] != _STATE_AUTH_SCHEMA_VERSION:
  1716	            raise TopicObservationError("unsupported topic observation authentication schema")
  1717	        if authentication["state_schema_version"] != _STATE_SCHEMA_VERSION:
  1718	            raise TopicObservationError(
  1719	                "topic observation authentication state schema does not match current state"
  1720	            )
  1721	        state_sha256 = _require_sha256(
  1722	            authentication["state_sha256"],
  1723	            "authenticated topic observation state digest",
  1724	        )
  1725	        authenticated_snapshot_sha256 = _require_sha256(
  1726	            authentication["literature_snapshot_sha256"],
  1727	            "authenticated literature snapshot digest",
  1728	        )
  1729	        mac_sha256 = _require_sha256(
  1730	            authentication["mac_sha256"],
  1731	            "topic observation authentication MAC",
  1732	        )
  1733	        if state_sha256 != hashlib.sha256(state_bytes).hexdigest():
  1734	            raise TopicObservationError(
  1735	                "topic observation authentication state digest mismatch; "
  1736	                "persisted literature observations are not bound to the canonical "
  1737	                "state (canonical dogfood state replay must reject it)"
  1738	            )
  1739	        if authenticated_snapshot_sha256 != state_snapshot_sha256:
  1740	            raise TopicObservationError("topic observation authentication snapshot digest mismatch")
