   742	    def _rewrite_first_batch_to_b_and_second_to_duplicate(state: dict[str, Any]) -> None:
   743	        batches = state["batches"]
   744	        assert isinstance(batches, dict)
   745	        stored_a = batches["c0"]
   746	        stored_b = batches["c1"]
   747	        assert isinstance(stored_a, dict) and isinstance(stored_b, dict)
   748	        source_b = input_for("B")
   749	        swapped = TopicObservationInput("A", source_b.observation, source_b.content)
   750	        stored_a["input_projections"]["A"] = swapped.input_projection
   751	        stored_a["input_fingerprints"]["A"] = swapped.fingerprint_sha256
   752	        stored_a["input_observation_ids"]["A"] = source_b.observation.observation_id
   753	        evidence_a = dict(stored_b["disposition_evidence"]["B"])
   754	        evidence_a["input_id"] = "A"
   755	        stored_a["disposition_evidence"]["A"] = evidence_a
   756	        stored_a["result"]["item_results"][0]["observation_id"] = source_b.observation.observation_id
   757	        state["processed_input_ids"]["A"] = swapped.fingerprint_sha256
   758	        state["seen_observation_keys"] = [evidence_a["input_idempotency_key"]]
   759	        stored_a["batch_digest_sha256"] = batch("c0", "c1", swapped).batch_digest_sha256
   760	        stored_a["input_projection_digest_sha256"] = _input_projection_digest(
   761	            topic_id="integrity-topic",
   762	            cursor="c0",
   763	            next_cursor="c1",
   764	            batch_digest_sha256=stored_a["batch_digest_sha256"],
   765	            input_projections=stored_a["input_projections"],
   766	        )
   767	        evidence_a["input_projection_binding_sha256"] = _input_projection_binding_digest(
   768	            topic_id="integrity-topic",
   769	            cursor="c0",
   770	            next_cursor="c1",
   771	            batch_digest_sha256=stored_a["batch_digest_sha256"],
   772	            input_projection=swapped.input_projection,
   773	        )
   774	        stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
   775	        stored_b["result"]["item_results"][0]["status"] = TopicItemStatus.DUPLICATE.value
   776	        stored_b["disposition_evidence"]["B"]["basis"] = "SEEN_OBSERVATION_KEY"
   777	        stored_b["disposition_evidence"]["B"]["import_disposition"] = None
   778	        stored_b["result_digest_sha256"] = digest_json(stored_b["result"])
