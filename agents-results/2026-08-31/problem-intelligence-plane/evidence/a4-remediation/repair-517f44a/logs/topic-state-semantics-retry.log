  1434	    def _restore_private_snapshot(
  1435	        self,
  1436	        path: Path,
  1437	        value: object,
  1438	        *,
  1439	        name: str,
  1440	    ) -> None:
  1441	        if value is None:
  1442	            try:
  1443	                os.unlink(path)
  1444	            except FileNotFoundError:
  1445	                return
  1446	            except OSError as exc:
  1447	                raise TopicObservationError(f"could not remove {name}") from exc
  1448	            _fsync_directory(path.parent)
  1449	            return
  1450	        content, mode = _decode_file_snapshot(value, name)
  1451	        if mode != _PRIVATE_FILE_MODE:
  1452	            raise TopicObservationError(f"{name} must have mode 0600")
  1453	        _atomic_write_bytes(path, content, mode)
  1454	
  1455	    def _restore_literature_files(self, value: object) -> None:
  1456	        target = self._validated_literature_file_snapshots(value)
  1457	        literature_root = self.root / "literature"
  1458	        try:
  1459	            root_metadata = literature_root.lstat()
  1460	        except FileNotFoundError:
  1461	            literature_root.mkdir(parents=True, exist_ok=True)
  1462	            root_metadata = literature_root.lstat()
  1463	        except OSError as exc:
  1464	            raise TopicObservationError("topic observation literature root is unreadable") from exc
  1465	        if stat.S_ISLNK(root_metadata.st_mode) or not stat.S_ISDIR(root_metadata.st_mode):
  1466	            raise TopicObservationError("topic observation literature root is not a directory")
  1467	        current = self._literature_file_snapshots()
  1468	        target_paths = {item["path"] for item in target}
  1469	        for item in current:
  1470	            if item["path"] not in target_paths:
  1471	                path = literature_root / item["path"]
  1472	                try:
  1473	                    os.unlink(path)
  1474	                except FileNotFoundError:
  1475	                    continue
  1476	                except OSError as exc:
  1477	                    raise TopicObservationError("could not remove stale literature file") from exc
  1478	                _fsync_directory(path.parent)
  1479	        for item in target:
  1480	            relative_path = Path(item["path"])
  1481	            path = literature_root / relative_path
  1482	            parent_path = literature_root
  1483	            for component in relative_path.parts[:-1]:
  1484	                parent_path = parent_path / component
  1485	                try:
  1486	                    metadata = parent_path.lstat()
  1487	                except FileNotFoundError:
  1488	                    parent_path.mkdir()
  1489	                    metadata = parent_path.lstat()
  1490	                except OSError as exc:
  1491	                    raise TopicObservationError(
  1492	                        "topic observation literature parent is unreadable"
  1493	                    ) from exc
  1494	                if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
  1495	                    raise TopicObservationError("topic observation literature parent is not a directory")
  1496	            file_snapshot = dict(item)
  1497	            file_snapshot.pop("path")
  1498	            content, mode = _decode_file_snapshot(
  1499	                file_snapshot,
  1500	                "topic observation literature transaction",
  1501	            )
  1502	            _atomic_write_bytes(path, content, mode)
  1503	        _fsync_directory(literature_root)
