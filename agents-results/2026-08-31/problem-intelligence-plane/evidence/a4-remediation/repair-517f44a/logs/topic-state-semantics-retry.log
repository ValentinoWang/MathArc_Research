   140	    def test_crash_blocks_concurrent_literature_writer_until_recovery(self) -> None:
   141	        with tempfile.TemporaryDirectory() as directory:
   142	            root = Path(directory)
   143	            runner = TopicObservationRunner(root, topic_id="integrity-topic", initial_cursor="c0")
   144	            save_reached = threading.Event()
   145	            release_save = threading.Event()
   146	            writer_started = threading.Event()
   147	            writer_done = threading.Event()
   148	            runner_errors: list[BaseException] = []
   149	            writer_results: list[Any] = []
   150	
   151	            def interrupt_save(_state: Mapping[str, Any]) -> None:
   152	                save_reached.set()
   153	                if not release_save.wait(timeout=5):
   154	                    raise RuntimeError("test did not release interrupted save")
   155	                raise RuntimeError("simulated crash before topic state commit")
   156	
   157	            def run_topic_transaction() -> None:
   158	                try:
   159	                    runner.run(batch("c0", "c1", input_for("A")))
   160	                except BaseException as exc:
   161	                    runner_errors.append(exc)
   162	
   163	            external_input = input_for("EXTERNAL")
   164	
   165	            def run_external_writer() -> None:
   166	                writer_started.set()
   167	                writer_results.append(
   168	                    LiteratureBase(root / "literature").import_bytes(
   169	                        external_input.observation,
   170	                        external_input.content,
   171	                    )
   172	                )
   173	                writer_done.set()
   174	
   175	            runner._save_state = interrupt_save
   176	            runner_thread = threading.Thread(target=run_topic_transaction)
   177	            runner_thread.start()
   178	            self.assertTrue(save_reached.wait(timeout=5))
   179	
   180	            writer_thread = threading.Thread(target=run_external_writer)
   181	            writer_thread.start()
   182	            self.assertTrue(writer_started.wait(timeout=5))
   183	            self.assertFalse(writer_done.wait(timeout=0.2))
   184	
   185	            release_save.set()
   186	            runner_thread.join(timeout=5)
   187	            writer_thread.join(timeout=5)
   188	            self.assertFalse(runner_thread.is_alive())
   189	            self.assertFalse(writer_thread.is_alive())
   190	            self.assertEqual(1, len(runner_errors))
   191	            self.assertRegex(str(runner_errors[0]), "simulated crash")
   192	            self.assertEqual(1, len(writer_results))
   193	            self.assertEqual("REJECTED", writer_results[0].disposition.value)
   194	            self.assertEqual(
   195	                "topic observation transaction recovery is pending",
   196	                writer_results[0].reason,
   197	            )
   198	
   199	            recovered = TopicObservationRunner(
   200	                root,
   201	                topic_id="integrity-topic",
   202	                initial_cursor="c0",
   203	            )
   204	            self.assertEqual("c0", recovered.next_cursor)
   205	            retry = LiteratureBase(root / "literature").import_bytes(
   206	                external_input.observation,
   207	                external_input.content,
   208	            )
   209	            self.assertEqual("IMPORTED", retry.disposition.value)
   210	            restarted = TopicObservationRunner(
   211	                root,
   212	                topic_id="integrity-topic",
   213	                initial_cursor="c0",
   214	            )
   215	            self.assertEqual(
   216	                ["OBS-EXTERNAL"],
   217	                [item.observation_id for item in restarted.literature.observations],
   218	            )
   219	            self.assertFalse((root / ".topic-observation-transaction.json").exists())
