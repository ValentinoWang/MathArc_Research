  1391	    def _begin_transaction(self) -> dict[str, Any]:
  1392	        old_state = self._private_file_snapshot(
  1393	            self.state_path,
  1394	            label="topic observation state",
  1395	        )
  1396	        old_authentication = self._private_file_snapshot(
  1397	            self.authentication_path,
  1398	            label="topic observation authentication state",
  1399	        )
  1400	        current_key = _read_verified_file(
  1401	            self.signing_key_path,
  1402	            label="topic observation signing key",
  1403	            expected_mode=_PRIVATE_FILE_MODE,
  1404	            missing_ok=True,
  1405	        )
  1406	        old_key_sha256 = (
  1407	            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
  1408	        )
  1409	        old_literature_files = self._literature_file_snapshots()
  1410	        transaction = {
  1411	            "schema_version": _TRANSACTION_SCHEMA_VERSION,
  1412	            "recovery_contract": _TRANSACTION_RECOVERY_CONTRACT,
  1413	            "phase": _TRANSACTION_PREPARED,
  1414	            "old_key_sha256": old_key_sha256,
  1415	            "old_state": old_state,
  1416	            "old_authentication": old_authentication,
  1417	            "old_literature_files": old_literature_files,
  1418	            "old_literature_files_sha256": digest_json(old_literature_files),
  1419	        }
  1420	        if (old_state is None) != (old_authentication is None) or (
  1421	            old_state is None and old_key_sha256 is not None
  1422	        ) or (old_state is not None and old_key_sha256 is None):
  1423	            raise TopicObservationError("topic observation transaction source tuple is incomplete")
