  1283	    def _read_transaction(
  1284	        self,
  1285	        *,
  1286	        path: Path | None = None,
  1287	        label: str = "topic observation transaction journal",
  1288	    ) -> dict[str, Any] | None:
  1289	        transaction_path = self.transaction_path if path is None else path
  1290	        result = _read_verified_file(
  1291	            transaction_path,
  1292	            label=label,
  1293	            expected_mode=_PRIVATE_FILE_MODE,
  1294	            missing_ok=True,
  1295	        )
  1296	        if result is None:
  1297	            return None
  1298	        raw, _ = result
  1299	        try:
  1300	            payload = json.loads(raw.decode("utf-8"))
  1301	        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
  1302	            raise TopicObservationError("topic observation transaction journal is malformed") from exc
  1303	        if not isinstance(payload, dict):
  1304	            raise TopicObservationError("topic observation transaction journal must be an object")
  1305	        try:
  1306	            canonical_bytes = (canonical_json(payload) + "\n").encode("utf-8")
  1307	        except (TypeError, ValueError) as exc:
  1308	            raise TopicObservationError("topic observation transaction journal is not canonical") from exc
  1309	        if raw != canonical_bytes:
  1310	            raise TopicObservationError("topic observation transaction journal is not canonical")
  1311	
  1312	        phase = payload.get("phase")
  1313	        common_fields = {
  1314	            "schema_version",
  1315	            "recovery_contract",
  1316	            "phase",
  1317	            "old_key_sha256",
  1318	            "old_state",
  1319	            "old_authentication",
  1320	            "old_literature_files",
  1321	            "old_literature_files_sha256",
  1322	        }
  1323	        if phase == _TRANSACTION_PREPARED:
  1324	            _require_fields(payload, common_fields, "topic observation transaction journal")
  1325	        elif phase == _TRANSACTION_COMMIT_INTENT:
  1326	            _require_fields(
  1327	                payload,
  1328	                common_fields
  1329	                | {
  1330	                    "target_key_sha256",
  1331	                    "target_state",
  1332	                    "target_authentication",
  1333	                    "target_literature_files",
  1334	                    "target_literature_files_sha256",
  1335	                },
  1336	                "topic observation transaction journal",
  1337	            )
  1338	        else:
  1339	            raise TopicObservationError("topic observation transaction journal has an invalid phase")
  1340	        if payload["schema_version"] != _TRANSACTION_SCHEMA_VERSION:
  1341	            raise TopicObservationError("unsupported topic observation transaction schema")
  1342	        if payload["recovery_contract"] != _TRANSACTION_RECOVERY_CONTRACT:
  1343	            raise TopicObservationError("topic observation transaction recovery contract is invalid")
  1344	        old_key = payload["old_key_sha256"]
  1345	        if old_key is not None:
  1346	            _require_sha256(old_key, "old topic observation signing key digest")
  1347	        old_state = self._validated_private_snapshot(
  1348	            payload["old_state"], name="old topic observation state", required=False
  1349	        )
  1350	        old_authentication = self._validated_private_snapshot(
  1351	            payload["old_authentication"],
  1352	            name="old topic observation authentication",
  1353	            required=False,
  1354	        )
  1355	        old_literature_files = self._validated_literature_file_snapshots(
  1356	            payload["old_literature_files"]
  1357	        )
  1358	        if payload["old_literature_files_sha256"] != digest_json(old_literature_files):
  1359	            raise TopicObservationError("old topic observation literature transaction digest mismatch")
  1360	        if (old_state is None) != (old_authentication is None) or (
  1361	            old_state is None and old_key is not None
  1362	        ) or (old_state is not None and old_key is None):
  1363	            raise TopicObservationError("old topic observation transaction tuple is incomplete")
  1364	
  1365	        if phase == _TRANSACTION_COMMIT_INTENT:
  1366	            target_key = payload["target_key_sha256"]
  1367	            if not isinstance(target_key, str):
  1368	                raise TopicObservationError("target topic observation signing key digest is missing")
  1369	            _require_sha256(target_key, "target topic observation signing key digest")
  1370	            if target_key == old_key:
  1371	                raise TopicObservationError("topic observation transaction did not advance signing authority")
  1372	            target_state = self._validated_private_snapshot(
  1373	                payload["target_state"], name="target topic observation state", required=True
  1374	            )
  1375	            target_authentication = self._validated_private_snapshot(
  1376	                payload["target_authentication"],
  1377	                name="target topic observation authentication",
  1378	                required=True,
  1379	            )
  1380	            target_literature_files = self._validated_literature_file_snapshots(
  1381	                payload["target_literature_files"]
  1382	            )
  1383	            if payload["target_literature_files_sha256"] != digest_json(target_literature_files):
  1384	                raise TopicObservationError(
  1385	                    "target topic observation literature transaction digest mismatch"
  1386	                )
  1387	            if target_state is None or target_authentication is None:
  1388	                raise TopicObservationError("target topic observation transaction tuple is incomplete")
  1389	        return payload
