  1210	                relative_path = file_path.relative_to(literature_root).as_posix()
  1211	                if relative_path == ".observations.lock":
  1212	                    continue
  1213	                result = _read_verified_file(
  1214	                    file_path,
  1215	                    label=f"topic observation literature file {relative_path}",
  1216	                    expected_mode=None,
  1217	                    missing_ok=False,
  1218	                )
  1219	                if result is None:
  1220	                    raise TopicObservationError("topic observation literature file disappeared")
  1221	                content, mode = result
  1222	                snapshots.append(
  1223	                    {
  1224	                        "path": relative_path,
  1225	                        **_encoded_file_snapshot(content, mode),
  1226	                    }
  1227	                )
  1228	        snapshots.sort(key=lambda item: item["path"])
  1229	        return snapshots
