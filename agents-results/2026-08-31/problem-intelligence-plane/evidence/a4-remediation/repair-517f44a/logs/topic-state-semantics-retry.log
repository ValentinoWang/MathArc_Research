  1231	    @staticmethod
  1232	    def _validated_literature_file_snapshots(value: object) -> list[dict[str, Any]]:
  1233	        if not isinstance(value, list):
  1234	            raise TopicObservationError("topic observation literature transaction snapshot is malformed")
  1235	        validated: list[dict[str, Any]] = []
  1236	        paths: list[str] = []
  1237	        for item in value:
  1238	            if not isinstance(item, dict):
  1239	                raise TopicObservationError("topic observation literature transaction file is malformed")
  1240	            _require_fields(
  1241	                item,
  1242	                {"path", "sha256", "size_bytes", "mode", "content_b64"},
  1243	                "topic observation literature transaction file",
  1244	            )
  1245	            path = _validate_snapshot_path(item["path"], "topic observation literature")
  1246	            if path != item["path"] or path == ".observations.lock":
  1247	                raise TopicObservationError("topic observation literature transaction path is invalid")
  1248	            file_snapshot = dict(item)
  1249	            file_snapshot.pop("path")
  1250	            content, mode = _decode_file_snapshot(
  1251	                file_snapshot,
  1252	                "topic observation literature transaction",
  1253	            )
  1254	            validated.append(
  1255	                {
  1256	                    "path": path,
  1257	                    **_encoded_file_snapshot(content, mode),
  1258	                }
  1259	            )
  1260	            paths.append(path)
  1261	        if paths != sorted(paths) or len(paths) != len(set(paths)):
  1262	            raise TopicObservationError(
  1263	                "topic observation literature transaction paths must be sorted and unique"
  1264	            )
  1265	        return validated
