  1562	    def _remove_transaction(self) -> None:
  1563	        snapshot = _read_verified_file(
  1564	            self.transaction_path,
  1565	            label="topic observation transaction journal",
  1566	            expected_mode=_PRIVATE_FILE_MODE,
  1567	            missing_ok=True,
  1568	        )
  1569	        if snapshot is None:
  1570	            return
  1571	        journal_bytes, journal_mode = snapshot
  1572	        if _path_entry_exists(self.retired_transaction_path):
  1573	            raise TopicObservationError(
  1574	                "retired topic observation transaction journal already exists"
  1575	            )
  1576	        try:
  1577	            os.replace(self.transaction_path, self.retired_transaction_path)
  1578	        except FileNotFoundError:
  1579	            return
  1580	        except OSError as exc:
  1581	            raise TopicObservationError(
  1582	                "could not retire topic observation transaction journal"
  1583	            ) from exc
  1584	        try:
  1585	            _fsync_directory(self.root)
  1586	        except OSError as exc:
  1587	            raise TopicObservationError(
  1588	                "could not durably retire topic observation transaction journal"
  1589	            ) from exc
  1590	        self._remove_retired_transaction(
  1591	            journal_bytes=journal_bytes,
  1592	            journal_mode=journal_mode,
  1593	        )
