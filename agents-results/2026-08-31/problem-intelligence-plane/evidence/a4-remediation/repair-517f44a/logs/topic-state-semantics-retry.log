  1040	            if observation.observation_id == item.observation.observation_id
  1041	            or observation.idempotency_key == item.observation.idempotency_key
  1042	        ]
  1043	        if not candidates:
  1044	            return None
  1045	        status_order = {
  1046	            ObservationStatus.OBSERVED: 0,
  1047	            ObservationStatus.PENDING: 1,
  1048	            ObservationStatus.CONFLICT: 2,
  1049	            ObservationStatus.REJECTED: 3,
  1050	        }
  1051	        return min(
  1052	            candidates,
  1053	            key=lambda observation: (
  1054	                status_order[observation.status],
  1055	                observation.observation_id,
  1056	            ),
  1057	        )
