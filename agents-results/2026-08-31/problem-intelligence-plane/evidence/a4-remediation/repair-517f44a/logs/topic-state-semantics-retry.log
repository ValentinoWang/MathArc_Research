  1505	    def _recover_transaction_files(self) -> bool:
  1506	        payload = self._read_transaction()
  1507	        if payload is None:
  1508	            return False
  1509	        phase = payload["phase"]
  1510	        current_key = _read_verified_file(
  1511	            self.signing_key_path,
  1512	            label="topic observation signing key",
  1513	            expected_mode=_PRIVATE_FILE_MODE,
  1514	            missing_ok=True,
  1515	        )
  1516	        current_key_sha256 = (
  1517	            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
  1518	        )
  1519	        old_key_sha256 = payload["old_key_sha256"]
  1520	        use_target = False
  1521	        if phase == _TRANSACTION_PREPARED:
  1522	            if current_key_sha256 != old_key_sha256:
  1523	                raise TopicObservationError(
  1524	                    "topic observation transaction signing authority does not match prepared generation"
  1525	                )
  1526	        else:
  1527	            target_key_sha256 = payload["target_key_sha256"]
  1528	            if current_key_sha256 == target_key_sha256:
  1529	                use_target = True
  1530	            elif current_key_sha256 == old_key_sha256:
  1531	                if old_key_sha256 is None:
  1532	                    raise TopicObservationError(
  1533	                        "initial topic observation transaction has no signing "
  1534	                        "authority for the persisted generation"
  1535	                    )
  1536	            else:
  1537	                raise TopicObservationError(
  1538	                    "topic observation transaction signing authority is neither old nor committed generation"
  1539	                )
  1540	
  1541	        if use_target:
  1542	            literature_files = payload["target_literature_files"]
  1543	            state = payload["target_state"]
  1544	            authentication = payload["target_authentication"]
  1545	        else:
  1546	            literature_files = payload["old_literature_files"]
  1547	            state = payload["old_state"]
  1548	            authentication = payload["old_authentication"]
  1549	        self._restore_literature_files(literature_files)
  1550	        self._restore_private_snapshot(
  1551	            self.state_path,
  1552	            state,
  1553	            name="topic observation state",
  1554	        )
  1555	        self._restore_private_snapshot(
  1556	            self.authentication_path,
  1557	            authentication,
  1558	            name="topic observation authentication state",
  1559	        )
  1560	        return True
