  1427	    def _write_transaction(self, payload: Mapping[str, Any]) -> None:
  1428	        _atomic_write_bytes(
  1429	            self.transaction_path,
  1430	            (canonical_json(payload) + "\n").encode("utf-8"),
  1431	            _PRIVATE_FILE_MODE,
  1432	        )
