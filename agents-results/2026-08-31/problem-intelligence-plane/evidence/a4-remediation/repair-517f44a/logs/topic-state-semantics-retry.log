  1267	    @staticmethod
  1268	    def _validated_private_snapshot(
  1269	        value: object,
  1270	        *,
  1271	        name: str,
  1272	        required: bool,
  1273	    ) -> dict[str, Any] | None:
  1274	        if value is None:
  1275	            if required:
  1276	                raise TopicObservationError(f"{name} transaction snapshot is missing")
  1277	            return None
  1278	        content, mode = _decode_file_snapshot(value, name)
  1279	        if mode != _PRIVATE_FILE_MODE:
  1280	            raise TopicObservationError(f"{name} transaction snapshot must have mode 0600")
  1281	        return _encoded_file_snapshot(content, mode)
