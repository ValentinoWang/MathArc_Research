   362	def _canonical_input_projection(value: object) -> dict[str, Any]:
   363	    if not isinstance(value, dict):
   364	        raise TopicObservationError("stored input projection is malformed")
   365	    _require_fields(value, _INPUT_PROJECTION_FIELDS, "input projection")
   366	    input_id = _require_nonempty(value["input_id"], "stored input projection input_id")
   367	    observation_payload = value["observation"]
   368	    if not isinstance(observation_payload, dict):
   369	        raise TopicObservationError("stored input projection observation is malformed")
   370	    try:
   371	        observation = SourceObservation.from_dict(observation_payload)
   372	    except (KeyError, TypeError, ValueError) as exc:
   373	        raise TopicObservationError("stored input projection observation is invalid") from exc
   374	    content_sha256 = _require_sha256(
   375	        value["content_sha256"],
   376	        "stored input projection content digest",
   377	    )
   378	    content_size_bytes = value["content_size_bytes"]
   379	    if (
   380	        isinstance(content_size_bytes, bool)
   381	        or not isinstance(content_size_bytes, int)
   382	        or content_size_bytes < 0
   383	    ):
   384	        raise TopicObservationError("stored input projection content size is invalid")
   385	    risk_flags = value["risk_flags"]
   386	    if not isinstance(risk_flags, list):
   387	        raise TopicObservationError("stored input projection risk flags are invalid")
   388	    if any(not isinstance(flag, str) or not flag.strip() for flag in risk_flags):
   389	        raise TopicObservationError("stored input projection risk flags are invalid")
   390	    if risk_flags != sorted(set(risk_flags)):
   391	        raise TopicObservationError("stored input projection risk flags must be sorted and unique")
   392	    canonical = {
   393	        "input_id": input_id,
   394	        "observation": observation.to_dict(),
   395	        "content_sha256": content_sha256,
   396	        "content_size_bytes": content_size_bytes,
   397	        "risk_flags": risk_flags,
   398	    }
   399	    if value != canonical:
   400	        raise TopicObservationError("stored input projection is not canonical")
   401	    return canonical
