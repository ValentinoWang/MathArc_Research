   103	        except KeyError as exc:
   104	            raise KeyError(f"unknown artifact: {artifact_id}") from exc
   105	
   106	    def path_for(self, artifact_id: str) -> Path:
   107	        record = self.get(artifact_id)
   108	        path = (self.root / record.relative_path).resolve()
   109	        if self.root.resolve() not in path.parents:
   110	            raise ValueError(f"artifact path escapes store root: {record.relative_path}")
