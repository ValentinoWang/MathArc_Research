  2555	        target_key = secrets.token_bytes(_SIGNING_KEY_BYTES)
  2556	        state_sha256 = hashlib.sha256(state_bytes).hexdigest()
  2557	        mac_sha256 = hmac.new(
  2558	            target_key,
  2559	            _state_authentication_message(state_bytes, snapshot_bytes),
  2560	            hashlib.sha256,
  2561	        ).hexdigest()
  2562	        authentication = {
  2563	            "schema_version": _STATE_AUTH_SCHEMA_VERSION,
  2564	            "state_schema_version": _STATE_SCHEMA_VERSION,
  2565	            "state_sha256": state_sha256,
  2566	            "literature_snapshot_sha256": snapshot_sha256,
  2567	            "mac_sha256": mac_sha256,
  2568	        }
  2569	        target_literature_files = self._literature_file_snapshots()
  2570	        target_transaction = {
  2571	            **transaction,
  2572	            "phase": _TRANSACTION_COMMIT_INTENT,
  2573	            "target_key_sha256": hashlib.sha256(target_key).hexdigest(),
  2574	            "target_state": _encoded_file_snapshot(state_bytes, _PRIVATE_FILE_MODE),
  2575	            "target_authentication": _encoded_file_snapshot(
  2576	                (canonical_json(authentication) + "\n").encode("utf-8"),
  2577	                _PRIVATE_FILE_MODE,
  2578	            ),
  2579	            "target_literature_files": target_literature_files,
  2580	            "target_literature_files_sha256": digest_json(target_literature_files),
  2581	        }
  2582	        self._write_transaction(target_transaction)
  2583	        _atomic_write_bytes(self.state_path, state_bytes, _PRIVATE_FILE_MODE)
  2584	        _atomic_write_bytes(
  2585	            self.authentication_path,
  2586	            (canonical_json(authentication) + "\n").encode("utf-8"),
  2587	            _PRIVATE_FILE_MODE,
  2588	        )
  2589	        _atomic_write_bytes(self.signing_key_path, target_key, _PRIVATE_FILE_MODE)
