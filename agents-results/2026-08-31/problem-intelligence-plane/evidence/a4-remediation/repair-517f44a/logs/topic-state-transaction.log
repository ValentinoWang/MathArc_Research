   530	    def test_full_cross_batch_rewrite_cannot_reuse_a_successful_observation(self) -> None:
   531	        """A rewritten state must not turn one observed source into two imports."""
   532	        with tempfile.TemporaryDirectory() as directory:
   533	            runner = TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0")
   534	            runner.run(batch("c0", "c1", input_for("A")))
   535	            runner.run(batch("c1", "c2", input_for("B")))
   536	
   537	            state_path = Path(directory) / "topic-observation-state.json"
   538	            state = json.loads(state_path.read_text(encoding="utf-8"))
   539	            stored_a = state["batches"]["c0"]
   540	            stored_b = state["batches"]["c1"]
   541	            source_b = input_for("B")
   542	            swapped = TopicObservationInput("A", source_b.observation, source_b.content)
   543	
   544	            # Rewrite every digest-bearing field for batch c0 to be internally
   545	            # coherent with B. The cursor-ordered replay check must still reject
   546	            # the second successful import of B's idempotency key.
   547	            stored_a["input_projections"]["A"] = swapped.input_projection
   548	            stored_a["input_fingerprints"]["A"] = swapped.fingerprint_sha256
   549	            stored_a["input_observation_ids"]["A"] = source_b.observation.observation_id
   550	            evidence = dict(stored_b["disposition_evidence"]["B"])
   551	            evidence["input_id"] = "A"
   552	            stored_a["disposition_evidence"]["A"] = evidence
   553	            stored_a["result"]["item_results"][0]["observation_id"] = source_b.observation.observation_id
   554	            state["processed_input_ids"]["A"] = swapped.fingerprint_sha256
   555	            state["seen_observation_keys"] = [
   556	                stored_b["disposition_evidence"]["B"]["input_idempotency_key"]
   557	            ]
   558	            stored_a["batch_digest_sha256"] = batch("c0", "c1", swapped).batch_digest_sha256
   559	            stored_a["input_projection_digest_sha256"] = _input_projection_digest(
   560	                topic_id="union-closed",
   561	                cursor="c0",
   562	                next_cursor="c1",
   563	                batch_digest_sha256=stored_a["batch_digest_sha256"],
   564	                input_projections=stored_a["input_projections"],
   565	            )
   566	            evidence["input_projection_binding_sha256"] = _input_projection_binding_digest(
   567	                topic_id="union-closed",
   568	                cursor="c0",
   569	                next_cursor="c1",
   570	                batch_digest_sha256=stored_a["batch_digest_sha256"],
   571	                input_projection=swapped.input_projection,
   572	            )
   573	            stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
   574	            state_path.write_text(json.dumps(state), encoding="utf-8")
   575	
   576	            with self.assertRaisesRegex(TopicObservationError, "successful import repeats"):
   577	                TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0").next_cursor
