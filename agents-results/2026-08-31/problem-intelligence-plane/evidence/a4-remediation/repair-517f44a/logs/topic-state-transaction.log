  2546	    def _save_state(self, state: Mapping[str, Any]) -> None:
  2547	        transaction = self._active_transaction
  2548	        if transaction is None:
  2549	            raise TopicObservationError("topic observation state save requires an active transaction")
  2550	        persisted_state = dict(state)
  2551	        persisted_state["literature_snapshot_sha256"] = self._literature_snapshot_sha256()
  2552	        state_bytes = (canonical_json(persisted_state) + "\n").encode("utf-8")
  2553	        snapshot_bytes = self._literature_snapshot_bytes()
