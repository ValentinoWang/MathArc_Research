   221	def _decode_file_snapshot(value: object, name: str) -> tuple[bytes, int]:
   222	    if not isinstance(value, dict):
   223	        raise TopicObservationError(f"{name} snapshot is malformed")
   224	    _require_fields(value, {"sha256", "size_bytes", "mode", "content_b64"}, f"{name} snapshot")
   225	    digest = _require_sha256(value["sha256"], f"{name} snapshot digest")
   226	    size_bytes = value["size_bytes"]
   227	    if isinstance(size_bytes, bool) or not isinstance(size_bytes, int) or size_bytes < 0:
   228	        raise TopicObservationError(f"{name} snapshot size is invalid")
   229	    mode = value["mode"]
