   105	    def exhausted(self) -> bool:
   106	        if self.wall_seconds_limit is not None and self.spent_wall_seconds >= self.wall_seconds_limit:
   107	            return True
   108	        if self.input_token_limit is not None and self.spent_input_tokens >= self.input_token_limit:
   109	            return True
   110	        if (
   111	            self.output_token_limit is not None
   112	            and self.spent_output_tokens >= self.output_token_limit
   113	        ):
   114	            return True
   115	        if self.cost_usd_limit is not None and self.spent_cost_usd >= self.cost_usd_limit:
   116	            return True
   117	        return False
