   173	def _read_verified_file(
   174	    path: Path,
   175	    *,
   176	    label: str,
   177	    expected_mode: int | None,
   178	    missing_ok: bool,
   179	) -> tuple[bytes, int] | None:
   180	    """Read one file through an identity-checked descriptor."""
   181	
   182	    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
   183	    try:
   184	        file_descriptor = os.open(path, flags)
   185	    except FileNotFoundError as exc:
   186	        if missing_ok:
