   225	    def verify(self) -> dict[str, Any]:
   226	        errors: list[str] = []
   227	        verified = 0
   228	        for record in self._records.values():
   229	            try:
   230	                path = self.path_for(record.artifact_id)
   231	            except ValueError as exc:
   232	                errors.append(str(exc))
   233	                continue
   234	            if not path.is_file():
   235	                errors.append(f"artifact file is missing: {record.artifact_id}")
   236	                continue
   237	            content = path.read_bytes()
   238	            actual = hashlib.sha256(content).hexdigest()
   239	            if actual != record.sha256:
   240	                errors.append(f"artifact digest mismatch: {record.artifact_id}")
   241	                continue
   242	            if len(content) != record.size_bytes:
   243	                errors.append(f"artifact size mismatch: {record.artifact_id}")
   244	                continue
   245	            verified += 1
   246	        return {
   247	            "valid": not errors,
   248	            "errors": errors,
   249	            "artifact_count": len(self._records),
   250	            "verified_count": verified,
   251	            "manifest_digest_sha256": digest_json(self.to_dict()),
   252	        }
   253	
   254	    def to_dict(self) -> dict[str, Any]:
   255	        return {
   256	            "schema_version": "1.0",
   257	            "content_addressing": "sha256",
   258	            "records": [record.to_dict() for record in self.records],
   259	        }
   260	
   261	    def save_manifest(self) -> Path:
   262	        self.root.mkdir(parents=True, exist_ok=True)
   263	        temporary = self.manifest_path.with_suffix(".tmp")
   264	        temporary.write_text(
   265	            json.dumps(self.to_dict(), ensure_ascii=False, indent=2, sort_keys=True) + "\n",
   266	            encoding="utf-8",
   267	        )
   268	        os.replace(temporary, self.manifest_path)
   269	        return self.manifest_path
   270	
   271	    @classmethod
   272	    def load(cls, root: str | Path) -> "ArtifactStore":
   273	        root_path = Path(root)
   274	        manifest = root_path / "manifest.json"
   275	        if not manifest.is_file():
   276	            return cls(root_path)
   277	        payload = json.loads(manifest.read_text(encoding="utf-8"))
   278	        if not isinstance(payload, dict):
   279	            raise ValueError("artifact manifest root must be an object")
   280	        if set(payload) - {"schema_version", "content_addressing", "records"}:
   281	            raise ValueError("unknown artifact-manifest fields")
   282	        if str(payload.get("schema_version")) != "1.0":
   283	            raise ValueError("unsupported artifact-manifest schema")
   284	        if str(payload.get("content_addressing")) != "sha256":
   285	            raise ValueError("unsupported artifact addressing scheme")
   286	        store = cls(
   287	            root_path,
   288	            (ArtifactRecord.from_dict(item) for item in payload.get("records", [])),
   289	        )
   290	        verification = store.verify()
   291	        if not verification["valid"]:
   292	            raise ValueError("; ".join(verification["errors"]))
   293	        return store
   294	
   295	    def _add_record(self, record: ArtifactRecord) -> None:
   296	        if record.artifact_id in self._records:
   297	            existing = self._records[record.artifact_id]
   298	            if existing.to_dict() != record.to_dict():
   299	                raise ValueError(f"conflicting artifact id: {record.artifact_id}")
   300	            return
   301	        if len(record.sha256) != 64:
   302	            raise ValueError(f"artifact {record.artifact_id} has invalid SHA-256")
   303	        self._records[record.artifact_id] = record

