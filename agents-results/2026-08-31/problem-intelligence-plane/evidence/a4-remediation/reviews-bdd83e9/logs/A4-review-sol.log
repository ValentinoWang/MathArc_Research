    81	    """Content-addressed storage for certificates, logs, sources and reports."""
    82	
    83	    def __init__(
    84	        self,
    85	        root: str | Path,
    86	        records: Iterable[ArtifactRecord] = (),
    87	    ) -> None:
    88	        self.root = Path(root)
    89	        self.blob_root = self.root / "sha256"
    90	        self.manifest_path = self.root / "manifest.json"
    91	        self.blob_root.mkdir(parents=True, exist_ok=True)
