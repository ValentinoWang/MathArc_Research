+    def _write_transaction(self, payload: Mapping[str, Any]) -> None:
+        _atomic_write_bytes(
+            self.transaction_path,
+            (canonical_json(payload) + "\n").encode("utf-8"),
+            _PRIVATE_FILE_MODE,
+        )
