   169	            text.encode("utf-8"),
   170	            logical_role=logical_role,
   171	            producer=producer,
   172	            media_type=media_type,
   173	            linked_claim_ids=linked_claim_ids,
   174	            linked_tool_call_ids=linked_tool_call_ids,
