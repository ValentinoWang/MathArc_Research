   250	
   251	def _atomic_write_bytes(path: Path, content: bytes, mode: int) -> None:
   252	    temporary_name: str | None = None
   253	    try:
   254	        fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
   255	        open_fd = fd
   256	        try:
   257	            os.fchmod(open_fd, mode)
   258	            with os.fdopen(open_fd, "wb") as temporary_file:
   259	                open_fd = -1
   260	                temporary_file.write(content)
   261	                temporary_file.flush()
   262	                os.fsync(temporary_file.fileno())
   263	        finally:
   264	            if open_fd != -1:
   265	                os.close(open_fd)
   266	        os.replace(temporary_name, path)
   267	        temporary_name = None
   268	        _fsync_directory(path.parent)
   269	    finally:
   270	        if temporary_name is not None:
   271	            try:
   272	                os.unlink(temporary_name)
   273	            except FileNotFoundError:
   274	                pass
