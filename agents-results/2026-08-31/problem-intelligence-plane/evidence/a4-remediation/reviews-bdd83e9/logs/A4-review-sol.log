+    def _private_file_snapshot(
+        self,
+        path: Path,
+        *,
+        label: str,
+    ) -> dict[str, Any] | None:
+        result = _read_verified_file(
+            path,
+            label=label,
+            expected_mode=_PRIVATE_FILE_MODE,
+            missing_ok=True,
+        )
+        if result is None:
+            return None
+        content, mode = result
+        return _encoded_file_snapshot(content, mode)
