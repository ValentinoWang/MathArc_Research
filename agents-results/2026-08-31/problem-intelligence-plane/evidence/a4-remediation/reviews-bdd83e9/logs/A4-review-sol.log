   211	    ) -> ArtifactRecord:
   212	        path = Path(source)
   213	        guessed = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
   214	        return self.put_bytes(
   215	            artifact_id,
   216	            path.read_bytes(),
   217	            logical_role=logical_role,
   218	            producer=producer,
   219	            media_type=media_type or guessed,
   220	            linked_claim_ids=linked_claim_ids,
   221	            linked_tool_call_ids=linked_tool_call_ids,
