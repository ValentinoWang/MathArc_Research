   201	    def import_file(
   202	        self,
   203	        artifact_id: str,
   204	        source: str | Path,
   205	        *,
   206	        logical_role: str,
   207	        producer: str,
   208	        media_type: str | None = None,
   209	        linked_claim_ids: Iterable[str] = (),
