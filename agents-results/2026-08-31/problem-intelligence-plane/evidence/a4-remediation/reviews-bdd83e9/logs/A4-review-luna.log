    51	def read_json(path: Path, label: str) -> Any:
    52	    try:
    53	        return json.loads(path.read_text(encoding="utf-8"))
    54	    except (OSError, json.JSONDecodeError) as exc:
    55	        raise LocalStoreError(f"{label} is unreadable") from exc
