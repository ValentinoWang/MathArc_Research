   542	class TopicObservationRunner:
   543	    """Durably process one topic without granting status or proof authority."""
   544	
   545	    def __init__(
   546	        self,
   547	        root: str | Path,
   548	        *,
   549	        topic_id: str,
   550	        initial_cursor: str,
   551	        budget: BudgetLedger | None = None,
   552	    ) -> None:
   553	        self.root = external_root(root)
   554	        self.root.mkdir(parents=True, exist_ok=True)
   555	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   556	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   557	        if budget is not None and not isinstance(budget, BudgetLedger):
   558	            raise TypeError("budget must be a BudgetLedger or None")
   559	        self.budget = budget
   560	        self.state_path = self.root / "topic-observation-state.json"
   561	        # The key is a separate, non-JSON trust boundary. Data-path writers can
   562	        # rewrite state and literature JSON, but cannot mint a valid MAC without it.
   563	        # This does not protect against a fully compromised same-user host that
   564	        # can read the key and replace both the data and authentication files.
   565	        self.signing_key_path = self.root / ".topic-observation-signing.key"
   566	        self.authentication_path = self.root / ".topic-observation-state.auth.json"
   567	        self.lock_path = self.root / ".topic-observation.lock"
   568	        self.literature = LiteratureBase(self.root / "literature", budget=budget)
   569	
   570	    @property
   571	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   572	        state = self._load_state()
   573	        return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   574	
   575	    @property
   576	    def next_cursor(self) -> str:
   577	        return _require_nonempty(self._load_state()["next_cursor"], "next_cursor")
   578	
   579	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   580	        if not isinstance(batch, TopicObservationBatch):
   581	            raise TypeError("batch must be a TopicObservationBatch")
   582	        if batch.topic_id != self.topic_id:
   583	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   584	        with self._writer_lock():
   585	            self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
   586	            state = self._load_state()
   587	            batches = state["batches"]
   588	            previous = batches.get(batch.cursor)
   589	            if previous is not None:
   590	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   591	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   592	                manual = self._add_manual(
   593	                    state,
   594	                    cursor=batch.cursor,
   595	                    input_id="cursor",
   596	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   597	                    detail="A cursor was replayed with different batch content.",
   598	                )
   599	                self._record_manual_event(state, manual)
   600	                self._save_state(state)
   601	                return TopicBatchResult(
   602	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   603	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   604	                )
   605	            if batch.cursor != state["next_cursor"]:
   606	                manual = self._add_manual(
   607	                    state,
   608	                    cursor=batch.cursor,
   609	                    input_id="cursor",
   610	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   611	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   612	                )
   613	                self._record_manual_event(state, manual)
   614	                self._save_state(state)
   615	                return TopicBatchResult(
   616	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   617	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   618	                )
   619	
   620	            results: list[TopicItemResult] = []
   621	            disposition_evidence: dict[str, dict[str, Any]] = {}
   622	            batch_digest_sha256 = batch.batch_digest_sha256
   623	            for item in batch.inputs:
   624	                item_result, evidence = self._process_input(state, batch, item)
   625	                results.append(item_result)
   626	                disposition_evidence[item.input_id] = evidence
   627	            status = TopicRunStatus.MANUAL_REVIEW if any(
   628	                item.status is TopicItemStatus.MANUAL_REVIEW for item in results
   629	            ) else TopicRunStatus.APPLIED
   630	            batch_result = TopicBatchResult(
   631	                self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results)
   632	            )
   633	            input_projections = {
   634	                item.input_id: item.input_projection for item in batch.inputs
   635	            }
   636	            for input_id, evidence in disposition_evidence.items():
   637	                evidence["input_projection_binding_sha256"] = _input_projection_binding_digest(
   638	                    topic_id=batch.topic_id,
   639	                    cursor=batch.cursor,
   640	                    next_cursor=batch.next_cursor,
   641	                    batch_digest_sha256=batch_digest_sha256,
   642	                    input_projection=input_projections[input_id],
   643	                )
   644	            batches[batch.cursor] = {
   645	                "batch_digest_sha256": batch_digest_sha256,
   646	                "result_digest_sha256": digest_json(batch_result.to_dict()),
   647	                "input_fingerprints": {
   648	                    item.input_id: item.fingerprint_sha256 for item in batch.inputs
   649	                },
   650	                "input_projection_digest_sha256": _input_projection_digest(
   651	                    topic_id=batch.topic_id,
   652	                    cursor=batch.cursor,
   653	                    next_cursor=batch.next_cursor,
   654	                    batch_digest_sha256=batch_digest_sha256,
   655	                    input_projections=input_projections,
   656	                ),
   657	                "input_projections": input_projections,
   658	                "input_observation_ids": {
   659	                    item.input_id: item.observation_id for item in results
   660	                },
   661	                "disposition_evidence": disposition_evidence,
   662	                "result": batch_result.to_dict(),
   663	            }
   664	            state["next_cursor"] = batch.next_cursor
   665	            self._save_state(state)
   666	            return batch_result
   667	
   668	    def _process_input(
   669	        self,
   670	        state: dict[str, Any],
   671	        batch: TopicObservationBatch,
   672	        item: TopicObservationInput,
   673	    ) -> tuple[TopicItemResult, dict[str, Any]]:
   674	        prior = state["processed_input_ids"].get(item.input_id)
   675	        if prior is not None:
   676	            if prior == item.fingerprint_sha256:
   677	                result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   678	                return result, self._item_evidence(
   679	                    item,
   680	                    result,
   681	                    "PROCESSED_INPUT_REPLAY",
   682	                    persisted=self._persisted_observation_for_input(item),
   683	                    prior_cursor=self._prior_input_cursor(state, item.input_id, item.fingerprint_sha256),
   684	                    prior_input_id=item.input_id,
   685	                )
   686	            manual = self._add_manual(
   687	                state, cursor=batch.cursor, input_id=item.input_id,
   688	                reason=ManualReviewReason.INPUT_ID_CONFLICT,
   689	                detail="An input_id was reused with different source-observation content.",
   690	            )
   691	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   692	            return result, self._item_evidence(
   693	                item,
   694	                result,
   695	                "MANUAL_QUEUE",
   696	                persisted=self._persisted_observation_for_input(item),
   697	                manual_id=manual.manual_id,
   698	                manual_reason=ManualReviewReason.INPUT_ID_CONFLICT,
   699	            )
   700	        if item.is_high_risk:
   701	            manual = self._add_manual(
   702	                state, cursor=batch.cursor, input_id=item.input_id,
   703	                reason=ManualReviewReason.HIGH_RISK_EVENT,
   704	                detail="High-risk flags require human review: " + ", ".join(item.risk_flags),
   705	            )
   706	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   707	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   708	            return result, self._item_evidence(
   709	                item,
   710	                result,
   711	                "MANUAL_QUEUE",
   712	                persisted=self._persisted_observation_for_input(item),
   713	                manual_id=manual.manual_id,
   714	                manual_reason=ManualReviewReason.HIGH_RISK_EVENT,
   715	            )
   716	        if self.budget is not None and self.budget.exhausted():
   717	            manual = self._add_manual(
   718	                state, cursor=batch.cursor, input_id=item.input_id,
   719	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   720	                detail="The configured import budget is exhausted before topic observation.",
   721	            )
   722	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   723	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   724	            return result, self._item_evidence(
   725	                item,
   726	                result,
   727	                "MANUAL_QUEUE",
   728	                persisted=self._persisted_observation_for_input(item),
   729	                manual_id=manual.manual_id,
   730	                manual_reason=ManualReviewReason.BUDGET_EXHAUSTED,
   731	            )
   732	        if item.observation.idempotency_key in state["seen_observation_keys"]:
   733	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   734	            result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   735	            return result, self._item_evidence(
   736	                item,
   737	                result,
   738	                "SEEN_OBSERVATION_KEY",
   739	                persisted=self._persisted_observation_for_input(item),
   740	            )
   741	
   742	        imported = self.literature.import_bytes(item.observation, item.content)
   743	        if imported.disposition in {ImportDisposition.IMPORTED, ImportDisposition.IDEMPOTENT}:
   744	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   745	            state["seen_observation_keys"].append(item.observation.idempotency_key)
