   211	                topic_id="integrity-topic",
   212	                initial_cursor="c0",
   213	            )
   214	            self.assertEqual(
   215	                ["OBS-EXTERNAL"],
   216	                [item.observation_id for item in restarted.literature.observations],
   217	            )
   218	            self.assertFalse((root / ".topic-observation-transaction.json").exists())
