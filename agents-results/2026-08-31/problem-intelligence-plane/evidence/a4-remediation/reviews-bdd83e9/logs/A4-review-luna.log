   128	def _require_sha256(value: object, name: str) -> str:
   129	    if (
   130	        not isinstance(value, str)
   131	        or len(value) != 64
   132	        or any(character not in "0123456789abcdef" for character in value)
   133	    ):
   134	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   135	    return value
