   350	        if any(not isinstance(flag, str) or not flag.strip() for flag in self.risk_flags):
   351	            raise TopicObservationError("risk_flags must contain non-empty strings")
   352	        if tuple(sorted(self.risk_flags)) != self.risk_flags or len(set(self.risk_flags)) != len(self.risk_flags):
   353	            raise TopicObservationError("risk_flags must be sorted and unique")
