   136	@dataclass(slots=True)
   137	class TheoremContract:
   138	    contract_id: str
   139	    problem: str
   140	    target_claim_ids: tuple[str, ...]
   141	    scope: str
   142	    assumptions: tuple[str, ...] = ()
   143	    success_criteria: tuple[str, ...] = ()
   144	    non_claims: tuple[str, ...] = ()
   145	    source_refs: tuple[str, ...] = ()
   146	    created_at: str = field(default_factory=utc_now)
   147	
   148	    def to_dict(self) -> dict[str, Any]:
   149	        return {
   150	            "contract_id": self.contract_id,
   151	            "problem": self.problem,
   152	            "target_claim_ids": list(self.target_claim_ids),
   153	            "scope": self.scope,
   154	            "assumptions": list(self.assumptions),
   155	            "success_criteria": list(self.success_criteria),
   156	            "non_claims": list(self.non_claims),
   157	            "source_refs": list(self.source_refs),
   158	            "created_at": self.created_at,
   159	        }
   160	
   161	    @classmethod
   162	    def from_dict(cls, payload: Mapping[str, Any]) -> "TheoremContract":
   163	        _strict_payload(cls, payload)
   164	        return cls(
   165	            contract_id=str(payload["contract_id"]),
   166	            problem=str(payload["problem"]),
   167	            target_claim_ids=_tuple_of_str(payload["target_claim_ids"]),
   168	            scope=str(payload["scope"]),
   169	            assumptions=_tuple_of_str(payload.get("assumptions")),
   170	            success_criteria=_tuple_of_str(payload.get("success_criteria")),
