   980	    def _persisted_observation_for_input(
   981	        self,
   982	        item: TopicObservationInput,
   983	    ) -> SourceObservation | None:
   984	        candidates = [
   985	            observation
   986	            for observation in self.literature.observations
   987	            if observation.observation_id == item.observation.observation_id
   988	            or observation.idempotency_key == item.observation.idempotency_key
   989	        ]
   990	        if not candidates:
   991	            return None
   992	        status_order = {
   993	            ObservationStatus.OBSERVED: 0,
   994	            ObservationStatus.PENDING: 1,
   995	            ObservationStatus.CONFLICT: 2,
   996	            ObservationStatus.REJECTED: 3,
   997	        }
   998	        return min(
   999	            candidates,
  1000	            key=lambda observation: (
  1001	                status_order[observation.status],
  1002	                observation.observation_id,
  1003	            ),
  1004	        )
