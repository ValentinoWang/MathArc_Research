   867	                reason=ManualReviewReason.LITERATURE_CONFLICT,
   868	                detail=f"Literature import conflict: {imported.reason or 'unspecified conflict outcome'}",
   869	            )
   870	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   871	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   872	            return result, self._item_evidence(
   873	                item,
   874	                result,
   875	                "MANUAL_QUEUE",
   876	                persisted=imported.observation,
   877	                manual_id=manual.manual_id,
   878	                manual_reason=ManualReviewReason.LITERATURE_CONFLICT,
   879	                import_disposition=imported.disposition,
   880	            )
