   350	def _canonical_input_projection(value: object) -> dict[str, Any]:
   351	    if not isinstance(value, dict):
   352	        raise TopicObservationError("stored input projection is malformed")
   353	    _require_fields(value, _INPUT_PROJECTION_FIELDS, "input projection")
   354	    input_id = _require_nonempty(value["input_id"], "stored input projection input_id")
   355	    observation_payload = value["observation"]
   356	    if not isinstance(observation_payload, dict):
   357	        raise TopicObservationError("stored input projection observation is malformed")
   358	    try:
   359	        observation = SourceObservation.from_dict(observation_payload)
   360	    except (KeyError, TypeError, ValueError) as exc:
   361	        raise TopicObservationError("stored input projection observation is invalid") from exc
   362	    content_sha256 = _require_sha256(
   363	        value["content_sha256"],
   364	        "stored input projection content digest",
   365	    )
   366	    content_size_bytes = value["content_size_bytes"]
   367	    if (
   368	        isinstance(content_size_bytes, bool)
   369	        or not isinstance(content_size_bytes, int)
   370	        or content_size_bytes < 0
   371	    ):
   372	        raise TopicObservationError("stored input projection content size is invalid")
   373	    risk_flags = value["risk_flags"]
   374	    if not isinstance(risk_flags, list):
   375	        raise TopicObservationError("stored input projection risk flags are invalid")
   376	    if any(not isinstance(flag, str) or not flag.strip() for flag in risk_flags):
   377	        raise TopicObservationError("stored input projection risk flags are invalid")
   378	    if risk_flags != sorted(set(risk_flags)):
   379	        raise TopicObservationError("stored input projection risk flags must be sorted and unique")
   380	    canonical = {
   381	        "input_id": input_id,
   382	        "observation": observation.to_dict(),
   383	        "content_sha256": content_sha256,
   384	        "content_size_bytes": content_size_bytes,
   385	        "risk_flags": risk_flags,
   386	    }
   387	    if value != canonical:
   388	        raise TopicObservationError("stored input projection is not canonical")
   389	    return canonical
