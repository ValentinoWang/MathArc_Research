   167	def _atomic_write_bytes(path: Path, content: bytes, mode: int) -> None:
   168	    temporary_name: str | None = None
   169	    try:
   170	        fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
   171	        open_fd = fd
   172	        try:
   173	            os.fchmod(open_fd, mode)
   174	            with os.fdopen(open_fd, "wb") as temporary_file:
   175	                open_fd = -1
   176	                temporary_file.write(content)
   177	                temporary_file.flush()
   178	                os.fsync(temporary_file.fileno())
   179	        finally:
   180	            if open_fd != -1:
   181	                os.close(open_fd)
   182	        os.replace(temporary_name, path)
   183	        temporary_name = None
   184	        _fsync_directory(path.parent)
   185	    finally:
   186	        if temporary_name is not None:
   187	            try:
   188	                os.unlink(temporary_name)
   189	            except FileNotFoundError:
   190	                pass
