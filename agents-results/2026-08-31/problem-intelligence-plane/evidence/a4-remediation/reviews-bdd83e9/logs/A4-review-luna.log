   139	    def test_crash_blocks_concurrent_literature_writer_until_recovery(self) -> None:
   140	        with tempfile.TemporaryDirectory() as directory:
   141	            root = Path(directory)
   142	            runner = TopicObservationRunner(root, topic_id="integrity-topic", initial_cursor="c0")
   143	            save_reached = threading.Event()
   144	            release_save = threading.Event()
   145	            writer_started = threading.Event()
   146	            writer_done = threading.Event()
   147	            runner_errors: list[BaseException] = []
   148	            writer_results: list[Any] = []
   149	
   150	            def interrupt_save(_state: Mapping[str, Any]) -> None:
   151	                save_reached.set()
   152	                if not release_save.wait(timeout=5):
   153	                    raise RuntimeError("test did not release interrupted save")
   154	                raise RuntimeError("simulated crash before topic state commit")
   155	
   156	            def run_topic_transaction() -> None:
   157	                try:
   158	                    runner.run(batch("c0", "c1", input_for("A")))
   159	                except BaseException as exc:
   160	                    runner_errors.append(exc)
   161	
   162	            external_input = input_for("EXTERNAL")
   163	
   164	            def run_external_writer() -> None:
   165	                writer_started.set()
   166	                writer_results.append(
   167	                    LiteratureBase(root / "literature").import_bytes(
   168	                        external_input.observation,
   169	                        external_input.content,
   170	                    )
   171	                )
   172	                writer_done.set()
   173	
   174	            runner._save_state = interrupt_save
   175	            runner_thread = threading.Thread(target=run_topic_transaction)
   176	            runner_thread.start()
   177	            self.assertTrue(save_reached.wait(timeout=5))
   178	
   179	            writer_thread = threading.Thread(target=run_external_writer)
   180	            writer_thread.start()
   181	            self.assertTrue(writer_started.wait(timeout=5))
   182	            self.assertFalse(writer_done.wait(timeout=0.2))
   183	
   184	            release_save.set()
   185	            runner_thread.join(timeout=5)
   186	            writer_thread.join(timeout=5)
   187	            self.assertFalse(runner_thread.is_alive())
   188	            self.assertFalse(writer_thread.is_alive())
   189	            self.assertEqual(1, len(runner_errors))
   190	            self.assertRegex(str(runner_errors[0]), "simulated crash")
   191	            self.assertEqual(1, len(writer_results))
   192	            self.assertEqual("REJECTED", writer_results[0].disposition.value)
   193	            self.assertEqual(
   194	                "topic observation transaction recovery is pending",
   195	                writer_results[0].reason,
   196	            )
   197	
   198	            recovered = TopicObservationRunner(
   199	                root,
   200	                topic_id="integrity-topic",
   201	                initial_cursor="c0",
   202	            )
   203	            self.assertEqual("c0", recovered.next_cursor)
   204	            retry = LiteratureBase(root / "literature").import_bytes(
   205	                external_input.observation,
   206	                external_input.content,
   207	            )
   208	            self.assertEqual("IMPORTED", retry.disposition.value)
   209	            restarted = TopicObservationRunner(
   210	                root,
   211	                topic_id="integrity-topic",
   212	                initial_cursor="c0",
   213	            )
   214	            self.assertEqual(
   215	                ["OBS-EXTERNAL"],
   216	                [item.observation_id for item in restarted.literature.observations],
   217	            )
   218	            self.assertFalse((root / ".topic-observation-transaction.json").exists())
