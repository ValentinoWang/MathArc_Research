   249	    batch_digest_sha256: str,
   250	    input_projection: Mapping[str, Any],
   251	) -> str:
   252	    """Bind one disposition record to its immutable batch input projection."""
   253	
   254	    return digest_json(
   255	        {
   256	            "schema_version": _SCHEMA_VERSION,
   257	            "topic_id": topic_id,
   258	            "cursor": cursor,
   259	            "next_cursor": next_cursor,
   260	            "batch_digest_sha256": batch_digest_sha256,
   261	            "input_projection": input_projection,
   262	        }
   263	    )
