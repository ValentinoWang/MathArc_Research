   376	@dataclass(frozen=True, slots=True)
   377	class TopicObservationBatch:
   378	    """A one-topic, explicitly cursor-bounded batch of source candidates."""
   379	
   380	    topic_id: str
   381	    cursor: str
   382	    next_cursor: str
   383	    inputs: tuple[TopicObservationInput, ...]
   384	    schema_version: str = _SCHEMA_VERSION
   385	
   386	    def __post_init__(self) -> None:
   387	        _require_nonempty(self.topic_id, "topic_id")
   388	        _require_nonempty(self.cursor, "cursor")
   389	        _require_nonempty(self.next_cursor, "next_cursor")
   390	        if self.cursor == self.next_cursor:
   391	            raise TopicObservationError("next_cursor must advance beyond cursor")
   392	        if not isinstance(self.inputs, tuple) or not self.inputs:
   393	            raise TopicObservationError("inputs must be a non-empty tuple")
   394	        if any(not isinstance(item, TopicObservationInput) for item in self.inputs):
   395	            raise TypeError("inputs must contain TopicObservationInput records")
   396	        identifiers = tuple(item.input_id for item in self.inputs)
   397	        if len(identifiers) != len(set(identifiers)) or tuple(sorted(identifiers)) != identifiers:
   398	            raise TopicObservationError("input ids must be sorted and unique")
   399	        if self.schema_version != _SCHEMA_VERSION:
   400	            raise TopicObservationError("unsupported topic-observation batch schema_version")
   401	
   402	    @property
   403	    def batch_digest_sha256(self) -> str:
   404	        return _batch_digest_from_fingerprints(
   405	            topic_id=self.topic_id,
   406	            cursor=self.cursor,
   407	            next_cursor=self.next_cursor,
   408	            input_fingerprints={
   409	                item.input_id: item.fingerprint_sha256 for item in self.inputs
   410	            },
   411	        )
