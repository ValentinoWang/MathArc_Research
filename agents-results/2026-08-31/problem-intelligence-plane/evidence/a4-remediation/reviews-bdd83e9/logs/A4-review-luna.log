   265	
   266	def _canonical_input_projection(value: object) -> dict[str, Any]:
   267	    if not isinstance(value, dict):
   268	        raise TopicObservationError("stored input projection is malformed")
   269	    _require_fields(value, _INPUT_PROJECTION_FIELDS, "input projection")
   270	    input_id = _require_nonempty(value["input_id"], "stored input projection input_id")
   271	    observation_payload = value["observation"]
   272	    if not isinstance(observation_payload, dict):
   273	        raise TopicObservationError("stored input projection observation is malformed")
   274	    try:
   275	        observation = SourceObservation.from_dict(observation_payload)
   276	    except (KeyError, TypeError, ValueError) as exc:
   277	        raise TopicObservationError("stored input projection observation is invalid") from exc
   278	    content_sha256 = _require_sha256(
   279	        value["content_sha256"],
   280	        "stored input projection content digest",
   281	    )
   282	    content_size_bytes = value["content_size_bytes"]
   283	    if (
   284	        isinstance(content_size_bytes, bool)
   285	        or not isinstance(content_size_bytes, int)
   286	        or content_size_bytes < 0
   287	    ):
   288	        raise TopicObservationError("stored input projection content size is invalid")
   289	    risk_flags = value["risk_flags"]
   290	    if not isinstance(risk_flags, list):
   291	        raise TopicObservationError("stored input projection risk flags are invalid")
   292	    if any(not isinstance(flag, str) or not flag.strip() for flag in risk_flags):
   293	        raise TopicObservationError("stored input projection risk flags are invalid")
   294	    if risk_flags != sorted(set(risk_flags)):
   295	        raise TopicObservationError("stored input projection risk flags must be sorted and unique")
   296	    canonical = {
   297	        "input_id": input_id,
   298	        "observation": observation.to_dict(),
   299	        "content_sha256": content_sha256,
   300	        "content_size_bytes": content_size_bytes,
   301	        "risk_flags": risk_flags,
   302	    }
   303	    if value != canonical:
   304	        raise TopicObservationError("stored input projection is not canonical")
   305	    return canonical
   306	
   307	
   308	def _fingerprint_from_input_projection(
   309	    projection: Mapping[str, Any],
   310	) -> str:
   311	    return digest_json(
   312	        {
   313	            "input_id": projection["input_id"],
   314	            "observation": projection["observation"],
   315	            "content_sha256": projection["content_sha256"],
   316	            "risk_flags": projection["risk_flags"],
   317	        }
   318	    )
   319	
   320	
   321	def _manual_id_for(
   322	    *,
   323	    topic_id: str,
   324	    cursor: str,
   325	    input_id: str,
   326	    reason: ManualReviewReason,
   327	    detail: str,
   328	) -> str:
   329	    identity = f"{topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
   330	    return "manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
