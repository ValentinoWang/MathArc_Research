   882	            manual = self._add_manual(
   883	                state,
   884	                cursor=batch.cursor,
   885	                input_id=item.input_id,
   886	                reason=ManualReviewReason.LITERATURE_IMPORT_FAILURE,
   887	                detail=f"Literature import failure: {imported.reason or 'unspecified rejected outcome'}",
   888	            )
   889	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   890	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   891	            return result, self._item_evidence(
   892	                item,
   893	                result,
   894	                "MANUAL_QUEUE",
   895	                persisted=self._persisted_observation_for_input(item),
   896	                manual_id=manual.manual_id,
   897	                manual_reason=ManualReviewReason.LITERATURE_IMPORT_FAILURE,
   898	                import_disposition=imported.disposition,
   899	            )
   900	        if self.budget is not None and self.budget.exhausted():
   901	            manual = self._add_manual(
   902	                state, cursor=batch.cursor, input_id=item.input_id,
   903	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   904	                detail="The literature base stopped import because the configured budget is exhausted.",
   905	            )
   906	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   907	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   908	            return result, self._item_evidence(
   909	                item,
   910	                result,
   911	                "MANUAL_QUEUE",
   912	                persisted=imported.observation,
