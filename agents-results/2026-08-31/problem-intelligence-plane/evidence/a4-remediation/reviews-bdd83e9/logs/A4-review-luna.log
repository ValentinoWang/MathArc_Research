    51	def _normalize_uri_for_identity(value: str) -> str:
    52	    """Normalize URI authority without erasing case-sensitive resource paths."""
    53	
    54	    candidate = value.strip()
    55	    parsed = urlsplit(candidate)
    56	    scheme = parsed.scheme.lower()
    57	    if parsed.netloc:
    58	        authority = parsed.netloc
    59	        userinfo = ""
    60	        host_port = authority
    61	        if "@" in host_port:
    62	            userinfo, host_port = host_port.rsplit("@", 1)
    63	            userinfo += "@"
    64	        if host_port.startswith("["):
    65	            closing = host_port.find("]")
    66	            if closing <= 1:
    67	                raise ValueError("canonical_uri has an invalid IPv6 authority")
    68	            host_port = host_port[: closing + 1].lower() + host_port[closing + 1 :]
    69	        elif ":" in host_port:
    70	            host, port = host_port.rsplit(":", 1)
    71	            host_port = host.lower() + ":" + port
    72	        else:
    73	            host_port = host_port.lower()
    74	        normalized_netloc = userinfo + host_port
    75	    else:
    76	        normalized_netloc = parsed.netloc
    77	    return urlunsplit(
    78	        (
    79	            scheme,
    80	            normalized_netloc,
    81	            parsed.path.rstrip("/"),
    82	            parsed.query,
    83	            parsed.fragment,
    84	        )
    85	    )
