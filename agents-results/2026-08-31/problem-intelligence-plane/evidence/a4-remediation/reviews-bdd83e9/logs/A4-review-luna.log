   172	                writer_done.set()
   173	
   174	            runner._save_state = interrupt_save
   175	            runner_thread = threading.Thread(target=run_topic_transaction)
   176	            runner_thread.start()
   177	            self.assertTrue(save_reached.wait(timeout=5))
   178	
   179	            writer_thread = threading.Thread(target=run_external_writer)
   180	            writer_thread.start()
   181	            self.assertTrue(writer_started.wait(timeout=5))
   182	            self.assertFalse(writer_done.wait(timeout=0.2))
   183	
   184	            release_save.set()
   185	            runner_thread.join(timeout=5)
   186	            writer_thread.join(timeout=5)
   187	            self.assertFalse(runner_thread.is_alive())
   188	            self.assertFalse(writer_thread.is_alive())
   189	            self.assertEqual(1, len(runner_errors))
   190	            self.assertRegex(str(runner_errors[0]), "simulated crash")
   191	            self.assertEqual(1, len(writer_results))
   192	            self.assertEqual("REJECTED", writer_results[0].disposition.value)
   193	            self.assertEqual(
   194	                "topic observation transaction recovery is pending",
   195	                writer_results[0].reason,
   196	            )
   197	
   198	            recovered = TopicObservationRunner(
   199	                root,
   200	                topic_id="integrity-topic",
   201	                initial_cursor="c0",
   202	            )
   203	            self.assertEqual("c0", recovered.next_cursor)
   204	            retry = LiteratureBase(root / "literature").import_bytes(
   205	                external_input.observation,
   206	                external_input.content,
   207	            )
   208	            self.assertEqual("IMPORTED", retry.disposition.value)
   209	            restarted = TopicObservationRunner(
