   100	    def get(self, artifact_id: str) -> ArtifactRecord:
   101	        try:
   102	            return self._records[artifact_id]
   103	        except KeyError as exc:
   104	            raise KeyError(f"unknown artifact: {artifact_id}") from exc
   105	
   106	    def path_for(self, artifact_id: str) -> Path:
   107	        record = self.get(artifact_id)
