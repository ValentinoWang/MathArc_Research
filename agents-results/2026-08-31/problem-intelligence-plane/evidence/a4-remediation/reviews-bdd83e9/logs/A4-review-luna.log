    58	def write_json_atomic(path: Path, value: object) -> None:
    59	    path.parent.mkdir(parents=True, exist_ok=True)
    60	    temporary = path.with_suffix(path.suffix + ".tmp")
    61	    temporary.write_text(canonical_json(value) + "\n", encoding="utf-8")
    62	    os.replace(temporary, path)
