   119	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   120	    unknown = set(payload) - expected
   121	    missing = expected - set(payload)
   122	    if unknown:
   123	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   124	    if missing:
   125	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   126	
