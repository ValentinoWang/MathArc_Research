   774	    def _process_input(
   775	        self,
   776	        state: dict[str, Any],
   777	        batch: TopicObservationBatch,
   778	        item: TopicObservationInput,
   779	    ) -> tuple[TopicItemResult, dict[str, Any]]:
   780	        prior = state["processed_input_ids"].get(item.input_id)
   781	        if prior is not None:
   782	            if prior == item.fingerprint_sha256:
   783	                result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   784	                return result, self._item_evidence(
   785	                    item,
   786	                    result,
   787	                    "PROCESSED_INPUT_REPLAY",
   788	                    persisted=self._persisted_observation_for_input(item),
   789	                    prior_cursor=self._prior_input_cursor(state, item.input_id, item.fingerprint_sha256),
   790	                    prior_input_id=item.input_id,
   791	                )
   792	            manual = self._add_manual(
   793	                state, cursor=batch.cursor, input_id=item.input_id,
   794	                reason=ManualReviewReason.INPUT_ID_CONFLICT,
   795	                detail="An input_id was reused with different source-observation content.",
   796	            )
   797	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   798	            return result, self._item_evidence(
   799	                item,
   800	                result,
   801	                "MANUAL_QUEUE",
   802	                persisted=self._persisted_observation_for_input(item),
   803	                manual_id=manual.manual_id,
   804	                manual_reason=ManualReviewReason.INPUT_ID_CONFLICT,
   805	            )
   806	        if item.is_high_risk:
   807	            manual = self._add_manual(
   808	                state, cursor=batch.cursor, input_id=item.input_id,
   809	                reason=ManualReviewReason.HIGH_RISK_EVENT,
   810	                detail="High-risk flags require human review: " + ", ".join(item.risk_flags),
   811	            )
   812	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
