    65	@contextmanager
    66	def exclusive_lock(root: Path, name: str) -> Iterator[None]:
    67	    root.mkdir(parents=True, exist_ok=True)
    68	    lock_path = root / f".{name}.lock"
    69	    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    70	    try:
    71	        fcntl.flock(descriptor, fcntl.LOCK_EX)
    72	        yield
    73	    finally:
    74	        fcntl.flock(descriptor, fcntl.LOCK_UN)
    75	        os.close(descriptor)
