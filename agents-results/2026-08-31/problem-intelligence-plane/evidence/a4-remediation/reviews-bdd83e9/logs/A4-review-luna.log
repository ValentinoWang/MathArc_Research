   109	        if self.root.resolve() not in path.parents:
   110	            raise ValueError(f"artifact path escapes store root: {record.relative_path}")
   111	        return path
   112	
   113	    def put_bytes(
   114	        self,
   115	        artifact_id: str,
   116	        content: bytes,
   117	        *,
   118	        logical_role: str,
   119	        producer: str,
   120	        media_type: str = "application/octet-stream",
   121	        linked_claim_ids: Iterable[str] = (),
   122	        linked_tool_call_ids: Iterable[str] = (),
   123	        source_filename: str = "",
   124	    ) -> ArtifactRecord:
   125	        if artifact_id in self._records:
   126	            raise ValueError(f"duplicate artifact id: {artifact_id}")
   127	        sha256 = hashlib.sha256(content).hexdigest()
   128	        relative_path = Path("sha256") / sha256[:2] / sha256
   129	        target = self.root / relative_path
   130	        target.parent.mkdir(parents=True, exist_ok=True)
   131	        if target.exists():
   132	            existing = target.read_bytes()
   133	            if existing != content:
   134	                raise ValueError(f"content-address collision at {target}")
   135	        else:
   136	            temporary = target.with_suffix(".tmp")
   137	            temporary.write_bytes(content)
   138	            os.replace(temporary, target)
   139	        record = ArtifactRecord(
   140	            artifact_id=artifact_id,
   141	            sha256=sha256,
   142	            size_bytes=len(content),
   143	            media_type=media_type,
   144	            relative_path=relative_path.as_posix(),
   145	            logical_role=logical_role,
   146	            producer=producer,
   147	            linked_claim_ids=tuple(str(item) for item in linked_claim_ids),
   148	            linked_tool_call_ids=tuple(str(item) for item in linked_tool_call_ids),
   149	            source_filename=source_filename,
   150	        )
   151	        self._add_record(record)
   152	        self.save_manifest()
   153	        return record
