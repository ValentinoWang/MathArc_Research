   444	    @staticmethod
   445	    def _rewrite_first_batch_to_b_and_second_to_duplicate(state: dict[str, Any]) -> None:
   446	        batches = state["batches"]
   447	        assert isinstance(batches, dict)
   448	        stored_a = batches["c0"]
   449	        stored_b = batches["c1"]
   450	        assert isinstance(stored_a, dict) and isinstance(stored_b, dict)
   451	        source_b = input_for("B")
   452	        swapped = TopicObservationInput("A", source_b.observation, source_b.content)
