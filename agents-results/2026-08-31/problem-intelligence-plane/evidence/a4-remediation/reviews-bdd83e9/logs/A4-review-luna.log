    21	TOPIC_OBSERVATION_TRANSACTION_PATH_NAME = ".topic-observation-transaction.json"
    22	_WRITER_LOCK_STATE = threading.local()
    23	
    24	
    25	def _thread_lock_paths(name: str) -> set[str]:
    26	    paths = getattr(_WRITER_LOCK_STATE, name, None)
    27	    if paths is None:
    28	        paths = set()
    29	        setattr(_WRITER_LOCK_STATE, name, paths)
    30	    return paths
    31	
    32	
    33	def _literature_root_key(root: Path) -> str:
    34	    return str(root.resolve(strict=False))
    35	
    36	
    37	def _topic_transaction_pending(root: Path) -> bool:
    38	    try:
    39	        (root.parent / TOPIC_OBSERVATION_TRANSACTION_PATH_NAME).lstat()
    40	    except FileNotFoundError:
    41	        return False
    42	    except OSError:
    43	        return True
    44	    return True
    45	
    46	
    47	@contextmanager
    48	def literature_writer_lock(
    49	    root: str | Path,
    50	    *,
    51	    allow_topic_transaction: bool = False,
    52	) -> Iterator[None]:
    53	    """Serialize all writers, including a topic transaction spanning many imports."""
    54	
    55	    literature_root = Path(root)
    56	    literature_root.mkdir(parents=True, exist_ok=True)
    57	    root_key = _literature_root_key(literature_root)
    58	    held_paths = _thread_lock_paths("held_paths")
    59	    authorized_paths = _thread_lock_paths("authorized_paths")
    60	    if root_key in held_paths:
    61	        added_authority = allow_topic_transaction and root_key not in authorized_paths
    62	        if added_authority:
    63	            authorized_paths.add(root_key)
    64	        try:
    65	            yield
    66	        finally:
    67	            if added_authority:
    68	                authorized_paths.remove(root_key)
    69	        return
    70	
    71	    lock_path = literature_root / ".observations.lock"
    72	    lock_path.touch(exist_ok=True)
    73	    with lock_path.open("a+", encoding="utf-8") as lock_file:
    74	        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
    75	        held_paths.add(root_key)
    76	        if allow_topic_transaction:
    77	            authorized_paths.add(root_key)
    78	        try:
    79	            yield
    80	        finally:
    81	            authorized_paths.discard(root_key)
    82	            held_paths.remove(root_key)
    83	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
    84	
    85	
    86	def _topic_transaction_authorized(root: Path) -> bool:
    87	    return _literature_root_key(root) in _thread_lock_paths("authorized_paths")
