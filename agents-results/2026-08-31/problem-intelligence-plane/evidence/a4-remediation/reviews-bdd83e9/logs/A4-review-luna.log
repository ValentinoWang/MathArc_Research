   824	                state, cursor=batch.cursor, input_id=item.input_id,
   825	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   826	                detail="The configured import budget is exhausted before topic observation.",
   827	            )
   828	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   829	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   830	            return result, self._item_evidence(
   831	                item,
   832	                result,
   833	                "MANUAL_QUEUE",
   834	                persisted=self._persisted_observation_for_input(item),
   835	                manual_id=manual.manual_id,
   836	                manual_reason=ManualReviewReason.BUDGET_EXHAUSTED,
   837	            )
   838	        if item.observation.idempotency_key in state["seen_observation_keys"]:
   839	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   840	            result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   841	            return result, self._item_evidence(
   842	                item,
   843	                result,
   844	                "SEEN_OBSERVATION_KEY",
   845	                persisted=self._persisted_observation_for_input(item),
   846	            )
   847	
   848	        imported = self.literature.import_bytes(item.observation, item.content)
   849	        if imported.disposition in {ImportDisposition.IMPORTED, ImportDisposition.IDEMPOTENT}:
   850	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   851	            state["seen_observation_keys"].append(item.observation.idempotency_key)
   852	            state["seen_observation_keys"].sort()
   853	            status = TopicItemStatus.IMPORTED if imported.disposition is ImportDisposition.IMPORTED else TopicItemStatus.IDEMPOTENT
   854	            result = TopicItemResult(item.input_id, status, imported.observation.observation_id)
   855	            return result, self._item_evidence(
   856	                item,
   857	                result,
   858	                "NEW_IMPORT" if status is TopicItemStatus.IMPORTED else "EXISTING_OBSERVED",
   859	                persisted=imported.observation,
   860	                import_disposition=imported.disposition,
   861	            )
   862	        if imported.disposition is ImportDisposition.CONFLICT or imported.observation.status is ObservationStatus.CONFLICT:
   863	            manual = self._add_manual(
   864	                state,
   865	                cursor=batch.cursor,
