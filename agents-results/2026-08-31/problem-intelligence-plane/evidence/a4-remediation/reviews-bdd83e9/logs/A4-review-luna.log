   232	def _validate_snapshot_path(value: object, name: str) -> str:
   233	    if not isinstance(value, str) or not value:
   234	        raise TopicObservationError(f"{name} snapshot path is invalid")
   235	    path = Path(value)
   236	    if path.is_absolute() or not path.parts or "." in path.parts or ".." in path.parts:
   237	        raise TopicObservationError(f"{name} snapshot path is invalid")
   238	    if "\x00" in value:
   239	        raise TopicObservationError(f"{name} snapshot path is invalid")
   240	    return path.as_posix()
