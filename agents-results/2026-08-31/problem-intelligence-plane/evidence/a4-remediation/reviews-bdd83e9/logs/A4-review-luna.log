    88	@dataclass(frozen=True, slots=True)
    89	class SourceObservation:
    90	    """A versioned, content-addressed observation of source material."""
    91	
    92	    observation_id: str
    93	    canonical_uri: str
    94	    pinned_version: str
    95	    observed_at: str
    96	    license_status: LicenseStatus
    97	    license_basis: str
    98	    content_summary: str
    99	    summary_basis: str
   100	    media_type: str
   101	    content_digest_sha256: str = ""
   102	    artifact_id: str | None = None
   103	    status: ObservationStatus = ObservationStatus.PENDING
   104	
   105	    schema_version: str = "1.0"
   106	
   107	    def __post_init__(self) -> None:
   108	        if not isinstance(self.license_status, LicenseStatus):
   109	            raise TypeError("license_status must be a LicenseStatus")
   110	        if not isinstance(self.status, ObservationStatus):
   111	            raise TypeError("status must be an ObservationStatus")
   112	        if not self.observation_id.strip():
   113	            raise ValueError("observation_id must be non-empty")
   114	        if not self.canonical_uri.strip() or "://" not in self.canonical_uri and not self.canonical_uri.startswith("urn:"):
   115	            raise ValueError("canonical_uri must be an absolute URI or urn")
   116	        if not self.pinned_version.strip() or self.pinned_version.strip().lower() == "latest":
   117	            raise ValueError("pinned_version must be concrete, not latest")
   118	        if not self.observed_at.strip():
   119	            raise ValueError("observed_at must be non-empty")
   120	        try:
   121	            datetime.fromisoformat(self.observed_at)
   122	        except ValueError as exc:
   123	            raise ValueError("observed_at must be an ISO-8601 timestamp") from exc
   124	        if not self.license_basis.strip():
   125	            raise ValueError("license_basis must be non-empty")
   126	        if not self.content_summary.strip() or not self.summary_basis.strip():
   127	            raise ValueError("content summary and summary basis must be non-empty")
   128	        if self.media_type not in _MEDIA_TYPES:
   129	            raise ValueError(f"unsupported media_type: {self.media_type}")
   130	        if self.content_digest_sha256 and not _DIGEST_RE.fullmatch(self.content_digest_sha256):
   131	            raise ValueError("content_digest_sha256 must be a lowercase SHA-256 digest")
   132	        if self.status is ObservationStatus.OBSERVED and self.license_status is LicenseStatus.UNKNOWN:
   133	            raise ValueError("unknown license cannot produce an OBSERVED record")
   134	        if _STATUS_ASSERTION_LANGUAGE.search(self.content_summary):
   135	            raise ValueError("content_summary must remain descriptive, not proof/status language")
   136	
   137	    @property
   138	    def logical_identity(self) -> str:
   139	        return canonical_json(
   140	            {
   141	                "canonical_uri": _normalize_uri_for_identity(self.canonical_uri),
   142	                "pinned_version": self.pinned_version.strip(),
   143	            }
   144	        )
   145	
   146	    @property
   147	    def idempotency_key(self) -> str:
   148	        payload = canonical_json(
   149	            {
   150	                "content_digest_sha256": self.content_digest_sha256,
   151	                "logical_identity": self.logical_identity,
   152	            }
   153	        )
   154	        return hashlib.sha256(payload.encode("utf-8")).hexdigest()
   155	
   156	    def conflicts_with(self, other: "SourceObservation") -> bool:
   157	        return self.logical_identity == other.logical_identity and (
   158	            bool(self.content_digest_sha256)
   159	            and bool(other.content_digest_sha256)
   160	            and self.content_digest_sha256 != other.content_digest_sha256
   161	        )
   162	
   163	    def to_dict(self) -> dict[str, Any]:
   164	        return {
   165	            "schema_version": self.schema_version,
   166	            "observation_id": self.observation_id,
   167	            "canonical_uri": self.canonical_uri,
   168	            "pinned_version": self.pinned_version,
   169	            "observed_at": self.observed_at,
   170	            "license_status": self.license_status.value,
   171	            "license_basis": self.license_basis,
   172	            "content_summary": self.content_summary,
   173	            "summary_basis": self.summary_basis,
   174	            "media_type": self.media_type,
   175	            "content_digest_sha256": self.content_digest_sha256,
   176	            "artifact_id": self.artifact_id,
   177	            "status": self.status.value,
   178	        }
   179	
   180	    @classmethod
   181	    def from_dict(cls, payload: Mapping[str, Any]) -> "SourceObservation":
   182	        allowed = {
   183	            "schema_version", "observation_id", "canonical_uri", "pinned_version",
   184	            "observed_at", "license_status", "license_basis", "content_summary",
   185	            "summary_basis", "media_type", "content_digest_sha256", "artifact_id", "status",
   186	        }
   187	        unknown = set(payload) - allowed
   188	        if unknown:
   189	            raise ValueError(f"unknown source-observation fields: {sorted(unknown)}")
   190	        if str(payload.get("schema_version", "1.0")) != "1.0":
   191	            raise ValueError("unsupported source-observation schema_version")
   192	        return cls(
   193	            observation_id=str(payload["observation_id"]),
   194	            canonical_uri=str(payload["canonical_uri"]),
   195	            pinned_version=str(payload["pinned_version"]),
   196	            observed_at=str(payload["observed_at"]),
   197	            license_status=LicenseStatus(str(payload["license_status"])),
   198	            license_basis=str(payload["license_basis"]),
   199	            content_summary=str(payload["content_summary"]),
   200	            summary_basis=str(payload["summary_basis"]),
   201	            media_type=str(payload["media_type"]),
   202	            content_digest_sha256=str(payload.get("content_digest_sha256", "")),
   203	            artifact_id=(str(payload["artifact_id"]) if payload.get("artifact_id") is not None else None),
   204	            status=ObservationStatus(str(payload.get("status", ObservationStatus.PENDING.value))),
   205	            schema_version="1.0",
   206	        )
   207	
   208	
   209	def new_observation(**kwargs: Any) -> SourceObservation:
   210	    """Create an observation with the current UTC timestamp by default."""
   211	
   212	    kwargs.setdefault("observed_at", utc_now())
   213	    return SourceObservation(**kwargs)

