   108	def _strict_payload(cls: type[Any], payload: Mapping[str, Any]) -> None:
   109	    allowed = {item.name for item in fields(cls)}
   110	    unknown = set(payload) - allowed
   111	    forbidden = set(payload) & _FORBIDDEN_REASONING_KEYS
   112	    if forbidden:
   113	        raise ValueError(
   114	            "private token-by-token reasoning fields are forbidden; use the "
   115	            f"auditable public_reasoning schema instead: {sorted(forbidden)}"
   116	        )
   117	    if unknown:
   118	        raise ValueError(f"unknown fields for {cls.__name__}: {sorted(unknown)}")
