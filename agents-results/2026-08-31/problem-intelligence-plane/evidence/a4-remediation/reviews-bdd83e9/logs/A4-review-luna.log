   128	def _tuple_of_str(value: Any) -> tuple[str, ...]:
   129	    if value is None:
   130	        return ()
   131	    if isinstance(value, str):
   132	        raise ValueError("expected an array of strings, not a string")
   133	    return tuple(str(item) for item in value)
