    19	class LocalStoreError(ValueError):
    20	    """Raised for malformed, tampered, or incorrectly located local state."""
    21	
    22	
    23	def external_root(root: str | Path) -> Path:
    24	    """Resolve a local-store root and reject a research workspace or descendant."""
    25	
    26	    resolved = Path(root).resolve()
    27	    for candidate in (resolved, *resolved.parents):
    28	        if (candidate / "workspace.json").is_file():
    29	            raise LocalStoreError("local console state must be outside a research workspace")
    30	    return resolved
