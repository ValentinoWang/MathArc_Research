   333	@dataclass(frozen=True, slots=True)
   334	class TopicObservationInput:
   335	    """One bounded source candidate supplied by a topic synchronization run."""
   336	
   337	    input_id: str
   338	    observation: SourceObservation
   339	    content: bytes
   340	    risk_flags: tuple[str, ...] = ()
   341	
   342	    def __post_init__(self) -> None:
   343	        _require_nonempty(self.input_id, "input_id")
