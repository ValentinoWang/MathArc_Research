   139	    def test_crash_blocks_concurrent_literature_writer_until_recovery(self) -> None:
   140	        with tempfile.TemporaryDirectory() as directory:
   141	            root = Path(directory)
   142	            runner = TopicObservationRunner(root, topic_id="integrity-topic", initial_cursor="c0")
   143	            save_reached = threading.Event()
   144	            release_save = threading.Event()
   145	            writer_started = threading.Event()
   146	            writer_done = threading.Event()
   147	            runner_errors: list[BaseException] = []
   148	            writer_results: list[Any] = []
   149	
   150	            def interrupt_save(_state: Mapping[str, Any]) -> None:
   151	                save_reached.set()
   152	                if not release_save.wait(timeout=5):
   153	                    raise RuntimeError("test did not release interrupted save")
   154	                raise RuntimeError("simulated crash before topic state commit")
   155	
   156	            def run_topic_transaction() -> None:
   157	                try:
   158	                    runner.run(batch("c0", "c1", input_for("A")))
   159	                except BaseException as exc:
   160	                    runner_errors.append(exc)
   161	
   162	            external_input = input_for("EXTERNAL")
   163	
   164	            def run_external_writer() -> None:
   165	                writer_started.set()
   166	                writer_results.append(
