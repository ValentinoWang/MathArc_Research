    33	def require_digest(value: object, label: str) -> str:
    34	    if not isinstance(value, str) or len(value) != 64 or set(value) - set("0123456789abcdef"):
    35	        raise LocalStoreError(f"{label} must be a lowercase SHA-256 digest")
    36	    return value
    37	
    38	
    39	def strict_mapping(value: object, expected: set[str], label: str) -> Mapping[str, Any]:
    40	    if not isinstance(value, Mapping):
    41	        raise LocalStoreError(f"{label} must be an object")
    42	    unknown = set(value) - expected
    43	    missing = expected - set(value)
    44	    if unknown or missing:
    45	        raise LocalStoreError(
    46	            f"{label} fields mismatch: missing={sorted(missing)}, unknown={sorted(unknown)}"
    47	        )
    48	    return value
