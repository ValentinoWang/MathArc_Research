   959	            "basis": basis,
   960	            "input_id": item.input_id,
   961	            "input_observation_id": item.observation.observation_id,
   962	            "input_idempotency_key": item.observation.idempotency_key,
   963	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   964	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   965	            "input_content_size_bytes": len(item.content),
   966	            "input_risk_flags": list(item.risk_flags),
   967	            "observation_id": result.observation_id,
   968	            "persisted_observation_id": persisted_observation_id,
   969	            "persisted_observation_status": persisted_status,
