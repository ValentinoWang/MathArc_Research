    68	            host_port = host_port[: closing + 1].lower() + host_port[closing + 1 :]
    69	        elif ":" in host_port:
    70	            host, port = host_port.rsplit(":", 1)
    71	            host_port = host.lower() + ":" + port
    72	        else:
    73	            host_port = host_port.lower()
    74	        normalized_netloc = userinfo + host_port
    75	    else:
    76	        normalized_netloc = parsed.netloc
    77	    return urlunsplit(
    78	        (
    79	            scheme,
    80	            normalized_netloc,
    81	            parsed.path.rstrip("/"),
    82	            parsed.query,
    83	            parsed.fragment,
    84	        )
    85	    )
