   363	        return {
   364	            "input_id": self.input_id,
   365	            "observation": self.observation.to_dict(),
   366	            "content_sha256": hashlib.sha256(self.content).hexdigest(),
   367	            "content_size_bytes": len(self.content),
   368	            "risk_flags": list(self.risk_flags),
   369	        }
