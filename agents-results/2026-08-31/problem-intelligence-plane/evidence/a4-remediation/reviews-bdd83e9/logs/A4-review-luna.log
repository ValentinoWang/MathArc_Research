   814	            return result, self._item_evidence(
   815	                item,
   816	                result,
   817	                "MANUAL_QUEUE",
   818	                persisted=self._persisted_observation_for_input(item),
   819	                manual_id=manual.manual_id,
   820	                manual_reason=ManualReviewReason.HIGH_RISK_EVENT,
   821	            )
