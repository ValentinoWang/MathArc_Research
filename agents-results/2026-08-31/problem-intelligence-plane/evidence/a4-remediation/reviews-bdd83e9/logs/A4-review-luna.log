   225	    def verify(self) -> dict[str, Any]:
   226	        errors: list[str] = []
   227	        verified = 0
   228	        for record in self._records.values():
   229	            try:
   230	                path = self.path_for(record.artifact_id)
   231	            except ValueError as exc:
   232	                errors.append(str(exc))
   233	                continue
   234	            if not path.is_file():
   235	                errors.append(f"artifact file is missing: {record.artifact_id}")
   236	                continue
   237	            content = path.read_bytes()
   238	            actual = hashlib.sha256(content).hexdigest()
   239	            if actual != record.sha256:
   240	                errors.append(f"artifact digest mismatch: {record.artifact_id}")
   241	                continue
   242	            if len(content) != record.size_bytes:
   243	                errors.append(f"artifact size mismatch: {record.artifact_id}")
   244	                continue
   245	            verified += 1
   246	        return {
   247	            "valid": not errors,
   248	            "errors": errors,
   249	            "artifact_count": len(self._records),
   250	            "verified_count": verified,
   251	            "manifest_digest_sha256": digest_json(self.to_dict()),
   252	        }
   253	
   254	    def to_dict(self) -> dict[str, Any]:
   255	        return {
   256	            "schema_version": "1.0",
   257	            "content_addressing": "sha256",
   258	            "records": [record.to_dict() for record in self.records],
   259	        }
