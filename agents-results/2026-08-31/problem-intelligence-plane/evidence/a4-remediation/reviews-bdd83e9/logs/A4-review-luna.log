   626	class TopicObservationRunner:
   627	    """Durably process one topic without granting status or proof authority."""
   628	
   629	    def __init__(
   630	        self,
   631	        root: str | Path,
   632	        *,
   633	        topic_id: str,
   634	        initial_cursor: str,
   635	        budget: BudgetLedger | None = None,
   636	    ) -> None:
   637	        self.root = external_root(root)
   638	        self.root.mkdir(parents=True, exist_ok=True)
   639	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   640	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   641	        if budget is not None and not isinstance(budget, BudgetLedger):
   642	            raise TypeError("budget must be a BudgetLedger or None")
   643	        self.budget = budget
   644	        self.state_path = self.root / "topic-observation-state.json"
   645	        # The key is a separate, non-JSON trust boundary. Data-path writers can
   646	        # rewrite state and literature JSON, but cannot mint a valid MAC without it.
   647	        # This does not protect against a fully compromised same-user host that
   648	        # can read the key and replace both the data and authentication files.
   649	        self.signing_key_path = self.root / ".topic-observation-signing.key"
   650	        self.authentication_path = self.root / ".topic-observation-state.auth.json"
   651	        self.lock_path = self.root / ".topic-observation.lock"
   652	        self.transaction_path = self.root / _TRANSACTION_PATH_NAME
   653	        self._active_transaction: dict[str, Any] | None = None
   654	        with self._storage_lock():
   655	            self._prepare_locked()
   656	
   657	    @property
   658	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   659	        with self._storage_lock():
   660	            self._prepare_locked()
   661	            state = self._load_state()
   662	            return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   663	
   664	    @property
   665	    def next_cursor(self) -> str:
   666	        with self._storage_lock():
   667	            self._prepare_locked()
   668	            return _require_nonempty(self._load_state()["next_cursor"], "next_cursor")
   669	
   670	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   671	        if not isinstance(batch, TopicObservationBatch):
   672	            raise TypeError("batch must be a TopicObservationBatch")
   673	        if batch.topic_id != self.topic_id:
   674	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   675	        with self._storage_lock():
   676	            self._prepare_locked()
   677	            state = self._load_state()
   678	            batches = state["batches"]
   679	            previous = batches.get(batch.cursor)
   680	            if previous is not None:
   681	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   682	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   683	                manual = self._add_manual(
   684	                    state,
   685	                    cursor=batch.cursor,
   686	                    input_id="cursor",
   687	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   688	                    detail="A cursor was replayed with different batch content.",
   689	                )
   690	                self._record_manual_event(state, manual)
   691	                transaction = self._begin_transaction()
   692	                self._active_transaction = transaction
   693	                try:
   694	                    self._save_state(state)
   695	                    return TopicBatchResult(
   696	                        self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   697	                        (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   698	                    )
   699	                finally:
   700	                    self._active_transaction = None
   701	            if batch.cursor != state["next_cursor"]:
   702	                manual = self._add_manual(
   703	                    state,
   704	                    cursor=batch.cursor,
   705	                    input_id="cursor",
   706	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   707	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   708	                )
   709	                self._record_manual_event(state, manual)
   710	                transaction = self._begin_transaction()
   711	                self._active_transaction = transaction
   712	                try:
   713	                    self._save_state(state)
   714	                    return TopicBatchResult(
   715	                        self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   716	                        (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   717	                    )
   718	                finally:
   719	                    self._active_transaction = None
   720	
   721	            transaction = self._begin_transaction()
   722	            self._active_transaction = transaction
   723	            results: list[TopicItemResult] = []
   724	            disposition_evidence: dict[str, dict[str, Any]] = {}
   725	            try:
   726	                batch_digest_sha256 = batch.batch_digest_sha256
   727	                for item in batch.inputs:
   728	                    item_result, evidence = self._process_input(state, batch, item)
   729	                    results.append(item_result)
   730	                    disposition_evidence[item.input_id] = evidence
   731	                status = TopicRunStatus.MANUAL_REVIEW if any(
   732	                    item.status is TopicItemStatus.MANUAL_REVIEW for item in results
   733	                ) else TopicRunStatus.APPLIED
   734	                batch_result = TopicBatchResult(
   735	                    self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results)
   736	                )
   737	                input_projections = {
   738	                    item.input_id: item.input_projection for item in batch.inputs
   739	                }
   740	                for input_id, evidence in disposition_evidence.items():
   741	                    evidence["input_projection_binding_sha256"] = _input_projection_binding_digest(
   742	                        topic_id=batch.topic_id,
   743	                        cursor=batch.cursor,
   744	                        next_cursor=batch.next_cursor,
   745	                        batch_digest_sha256=batch_digest_sha256,
   746	                        input_projection=input_projections[input_id],
   747	                    )
   748	                batches[batch.cursor] = {
   749	                    "batch_digest_sha256": batch_digest_sha256,
   750	                    "result_digest_sha256": digest_json(batch_result.to_dict()),
   751	                    "input_fingerprints": {
   752	                        item.input_id: item.fingerprint_sha256 for item in batch.inputs
   753	                    },
   754	                    "input_projection_digest_sha256": _input_projection_digest(
   755	                        topic_id=batch.topic_id,
   756	                        cursor=batch.cursor,
   757	                        next_cursor=batch.next_cursor,
   758	                        batch_digest_sha256=batch_digest_sha256,
   759	                        input_projections=input_projections,
   760	                    ),
   761	                    "input_projections": input_projections,
   762	                    "input_observation_ids": {
   763	                        item.input_id: item.observation_id for item in results
   764	                    },
   765	                    "disposition_evidence": disposition_evidence,
   766	                    "result": batch_result.to_dict(),
   767	                }
   768	                state["next_cursor"] = batch.next_cursor
   769	                self._save_state(state)
   770	                return batch_result
   771	            finally:
   772	                self._active_transaction = None
