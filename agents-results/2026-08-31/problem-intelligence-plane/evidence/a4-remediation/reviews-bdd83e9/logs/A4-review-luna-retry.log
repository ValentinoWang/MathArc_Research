  1204	    def _read_transaction(self) -> dict[str, Any] | None:
  1205	        result = _read_verified_file(
  1206	            self.transaction_path,
  1207	            label="topic observation transaction journal",
  1208	            expected_mode=_PRIVATE_FILE_MODE,
  1209	            missing_ok=True,
  1210	        )
  1211	        if result is None:
  1212	            return None
  1213	        raw, _ = result
  1214	        try:
  1215	            payload = json.loads(raw.decode("utf-8"))
  1216	        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
  1217	            raise TopicObservationError("topic observation transaction journal is malformed") from exc
  1218	        if not isinstance(payload, dict):
  1219	            raise TopicObservationError("topic observation transaction journal must be an object")
  1220	        try:
  1221	            canonical_bytes = (canonical_json(payload) + "\n").encode("utf-8")
  1222	        except (TypeError, ValueError) as exc:
  1223	            raise TopicObservationError("topic observation transaction journal is not canonical") from exc
  1224	        if raw != canonical_bytes:
  1225	            raise TopicObservationError("topic observation transaction journal is not canonical")
  1226	
  1227	        phase = payload.get("phase")
  1228	        common_fields = {
  1229	            "schema_version",
  1230	            "recovery_contract",
  1231	            "phase",
  1232	            "old_key_sha256",
  1233	            "old_state",
  1234	            "old_authentication",
  1235	            "old_literature_files",
  1236	            "old_literature_files_sha256",
  1237	        }
  1238	        if phase == _TRANSACTION_PREPARED:
  1239	            _require_fields(payload, common_fields, "topic observation transaction journal")
  1240	        elif phase == _TRANSACTION_COMMIT_INTENT:
  1241	            _require_fields(
  1242	                payload,
  1243	                common_fields
  1244	                | {
  1245	                    "target_key_sha256",
  1246	                    "target_state",
  1247	                    "target_authentication",
  1248	                    "target_literature_files",
  1249	                    "target_literature_files_sha256",
  1250	                },
  1251	                "topic observation transaction journal",
  1252	            )
  1253	        else:
  1254	            raise TopicObservationError("topic observation transaction journal has an invalid phase")
  1255	        if payload["schema_version"] != _TRANSACTION_SCHEMA_VERSION:
  1256	            raise TopicObservationError("unsupported topic observation transaction schema")
  1257	        if payload["recovery_contract"] != _TRANSACTION_RECOVERY_CONTRACT:
  1258	            raise TopicObservationError("topic observation transaction recovery contract is invalid")
  1259	        old_key = payload["old_key_sha256"]
  1260	        if old_key is not None:
  1261	            _require_sha256(old_key, "old topic observation signing key digest")
  1262	        old_state = self._validated_private_snapshot(
  1263	            payload["old_state"], name="old topic observation state", required=False
  1264	        )
  1265	        old_authentication = self._validated_private_snapshot(
  1266	            payload["old_authentication"],
  1267	            name="old topic observation authentication",
  1268	            required=False,
  1269	        )
  1270	        old_literature_files = self._validated_literature_file_snapshots(
  1271	            payload["old_literature_files"]
  1272	        )
  1273	        if payload["old_literature_files_sha256"] != digest_json(old_literature_files):
  1274	            raise TopicObservationError("old topic observation literature transaction digest mismatch")
  1275	        if (old_state is None) != (old_authentication is None) or (
  1276	            old_state is None and old_key is not None
