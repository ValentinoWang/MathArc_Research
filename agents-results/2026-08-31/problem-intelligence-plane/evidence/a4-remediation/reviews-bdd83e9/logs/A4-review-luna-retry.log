   405	def _manual_id_for(
   406	    *,
   407	    topic_id: str,
   408	    cursor: str,
   409	    input_id: str,
   410	    reason: ManualReviewReason,
   411	    detail: str,
   412	) -> str:
   413	    identity = f"{topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
   414	    return "manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
