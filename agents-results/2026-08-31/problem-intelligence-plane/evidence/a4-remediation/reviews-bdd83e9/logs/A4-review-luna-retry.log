   125	def _require_nonempty(value: object, name: str) -> str:
   126	    if not isinstance(value, str) or not value.strip():
   127	        raise TopicObservationError(f"{name} must be non-empty")
   128	    return value
   129	
   130	
   131	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   132	    unknown = set(payload) - expected
   133	    missing = expected - set(payload)
   134	    if unknown:
   135	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   136	    if missing:
   137	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   138	
   139	
   140	def _require_sha256(value: object, name: str) -> str:
   141	    if (
   142	        not isinstance(value, str)
   143	        or len(value) != 64
   144	        or any(character not in "0123456789abcdef" for character in value)
   145	    ):
   146	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   147	    return value
   148	
   149	
   150	def _require_sha256_or_empty(value: object, name: str) -> str:
   151	    if value == "":
   152	        return ""
   153	    return _require_sha256(value, name)
   154	
   155	
   156	def _require_optional_sha256(value: object, name: str) -> None:
   157	    if value is not None:
   158	        _require_sha256(value, name)
