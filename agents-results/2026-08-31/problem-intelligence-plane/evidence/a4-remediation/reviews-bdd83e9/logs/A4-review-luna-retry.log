  1064	    @contextmanager
  1065	    def _writer_lock(self) -> Iterator[None]:
  1066	        self.lock_path.touch(exist_ok=True)
  1067	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
  1068	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
  1069	            try:
  1070	                yield
  1071	            finally:
  1072	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
  1073	
  1074	    @contextmanager
  1075	    def _storage_lock(self) -> Iterator[None]:
  1076	        with self._writer_lock():
  1077	            with literature_writer_lock(
  1078	                self.root / "literature",
  1079	                allow_topic_transaction=True,
  1080	            ):
  1081	                yield
  1082	
  1083	    def _prepare_locked(self) -> None:
  1084	        recovered = self._recover_transaction_files()
  1085	        self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
  1086	        if recovered:
  1087	            self._load_state()
  1088	            self._remove_transaction()
