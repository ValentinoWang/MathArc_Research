   318	        conflict_id = f"{observation.observation_id}-conflict-{identity_digest}"
   319	        conflict = SourceObservation.from_dict(
   320	            {
   321	                **observation.to_dict(),
   322	                "observation_id": conflict_id,
   323	                "status": ObservationStatus.CONFLICT.value,
   324	                "artifact_id": None,
   325	            }
   326	        )
   327	        existing = self._observations.get(conflict_id)
   328	        if existing is not None and existing.to_dict() != conflict.to_dict():
   329	            return None
   330	        return conflict
