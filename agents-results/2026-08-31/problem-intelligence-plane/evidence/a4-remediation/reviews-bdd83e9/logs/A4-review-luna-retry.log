  1370	    def _restore_literature_files(self, value: object) -> None:
  1371	        target = self._validated_literature_file_snapshots(value)
  1372	        literature_root = self.root / "literature"
  1373	        try:
  1374	            root_metadata = literature_root.lstat()
  1375	        except FileNotFoundError:
  1376	            literature_root.mkdir(parents=True, exist_ok=True)
  1377	            root_metadata = literature_root.lstat()
  1378	        except OSError as exc:
  1379	            raise TopicObservationError("topic observation literature root is unreadable") from exc
  1380	        if stat.S_ISLNK(root_metadata.st_mode) or not stat.S_ISDIR(root_metadata.st_mode):
  1381	            raise TopicObservationError("topic observation literature root is not a directory")
  1382	        current = self._literature_file_snapshots()
  1383	        target_paths = {item["path"] for item in target}
  1384	        for item in current:
  1385	            if item["path"] not in target_paths:
  1386	                path = literature_root / item["path"]
  1387	                try:
  1388	                    os.unlink(path)
  1389	                except FileNotFoundError:
  1390	                    continue
  1391	                except OSError as exc:
  1392	                    raise TopicObservationError("could not remove stale literature file") from exc
  1393	        for item in target:
  1394	            relative_path = Path(item["path"])
  1395	            path = literature_root / relative_path
  1396	            parent_path = literature_root
  1397	            for component in relative_path.parts[:-1]:
  1398	                parent_path = parent_path / component
  1399	                try:
  1400	                    metadata = parent_path.lstat()
  1401	                except FileNotFoundError:
  1402	                    parent_path.mkdir()
  1403	                    metadata = parent_path.lstat()
  1404	                except OSError as exc:
  1405	                    raise TopicObservationError(
  1406	                        "topic observation literature parent is unreadable"
  1407	                    ) from exc
  1408	                if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
  1409	                    raise TopicObservationError("topic observation literature parent is not a directory")
  1410	            file_snapshot = dict(item)
  1411	            file_snapshot.pop("path")
  1412	            content, mode = _decode_file_snapshot(
  1413	                file_snapshot,
  1414	                "topic observation literature transaction",
  1415	            )
  1416	            _atomic_write_bytes(path, content, mode)
  1417	        _fsync_directory(literature_root)
  1418	
  1419	    def _recover_transaction_files(self) -> bool:
  1420	        payload = self._read_transaction()
  1421	        if payload is None:
  1422	            return False
  1423	        phase = payload["phase"]
  1424	        current_key = _read_verified_file(
  1425	            self.signing_key_path,
  1426	            label="topic observation signing key",
  1427	            expected_mode=_PRIVATE_FILE_MODE,
  1428	            missing_ok=True,
  1429	        )
  1430	        current_key_sha256 = (
  1431	            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
  1432	        )
  1433	        old_key_sha256 = payload["old_key_sha256"]
  1434	        use_target = False
  1435	        if phase == _TRANSACTION_PREPARED:
  1436	            if current_key_sha256 != old_key_sha256:
  1437	                raise TopicObservationError(
  1438	                    "topic observation transaction signing authority does not match prepared generation"
  1439	                )
  1440	        else:
  1441	            target_key_sha256 = payload["target_key_sha256"]
  1442	            if current_key_sha256 == target_key_sha256:
  1443	                use_target = True
  1444	            elif current_key_sha256 != old_key_sha256:
  1445	                raise TopicObservationError(
  1446	                    "topic observation transaction signing authority is neither old nor committed generation"
  1447	                )
  1448	
  1449	        if use_target:
  1450	            literature_files = payload["target_literature_files"]
  1451	            state = payload["target_state"]
  1452	            authentication = payload["target_authentication"]
  1453	        else:
  1454	            literature_files = payload["old_literature_files"]
  1455	            state = payload["old_state"]
  1456	            authentication = payload["old_authentication"]
  1457	        self._restore_literature_files(literature_files)
  1458	        self._restore_private_snapshot(
  1459	            self.state_path,
  1460	            state,
  1461	            name="topic observation state",
  1462	        )
  1463	        self._restore_private_snapshot(
  1464	            self.authentication_path,
  1465	            authentication,
  1466	            name="topic observation authentication state",
  1467	        )
  1468	        return True
  1469	
  1470	    def _remove_transaction(self) -> None:
  1471	        try:
  1472	            os.unlink(self.transaction_path)
  1473	        except FileNotFoundError:
  1474	            return
  1475	        except OSError as exc:
  1476	            raise TopicObservationError("could not remove topic observation transaction journal") from exc
  1477	        _fsync_directory(self.root)
