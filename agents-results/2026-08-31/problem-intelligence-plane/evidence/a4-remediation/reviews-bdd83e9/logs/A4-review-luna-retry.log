  1544	    def _verify_state_authentication(
  1545	        self,
  1546	        state: Mapping[str, Any],
  1547	        state_bytes: bytes,
  1548	    ) -> None:
  1549	        state_snapshot_sha256 = _require_sha256(
  1550	            state["literature_snapshot_sha256"],
  1551	            "topic observation literature snapshot",
  1552	        )
  1553	        snapshot_bytes = self._literature_snapshot_bytes()
  1554	        current_snapshot_sha256 = hashlib.sha256(snapshot_bytes).hexdigest()
  1555	        if state_snapshot_sha256 != current_snapshot_sha256:
  1556	            raise TopicObservationError(
  1557	                "topic observation state literature snapshot does not match current literature"
  1558	            )
  1559	        authentication = self._read_authentication()
  1560	        if authentication["schema_version"] != _STATE_AUTH_SCHEMA_VERSION:
  1561	            raise TopicObservationError("unsupported topic observation authentication schema")
  1562	        if authentication["state_schema_version"] != _STATE_SCHEMA_VERSION:
  1563	            raise TopicObservationError(
  1564	                "topic observation authentication state schema does not match current state"
  1565	            )
  1566	        state_sha256 = _require_sha256(
  1567	            authentication["state_sha256"],
  1568	            "authenticated topic observation state digest",
  1569	        )
  1570	        authenticated_snapshot_sha256 = _require_sha256(
  1571	            authentication["literature_snapshot_sha256"],
  1572	            "authenticated literature snapshot digest",
  1573	        )
  1574	        mac_sha256 = _require_sha256(
  1575	            authentication["mac_sha256"],
  1576	            "topic observation authentication MAC",
  1577	        )
  1578	        if state_sha256 != hashlib.sha256(state_bytes).hexdigest():
  1579	            raise TopicObservationError(
  1580	                "topic observation authentication state digest mismatch; "
  1581	                "persisted literature observations are not bound to the canonical "
  1582	                "state (canonical dogfood state replay must reject it)"
  1583	            )
  1584	        if authenticated_snapshot_sha256 != state_snapshot_sha256:
  1585	            raise TopicObservationError("topic observation authentication snapshot digest mismatch")
  1586	        expected_mac = hmac.new(
  1587	            self._read_signing_key(),
  1588	            _state_authentication_message(state_bytes, snapshot_bytes),
  1589	            hashlib.sha256,
  1590	        ).hexdigest()
  1591	        if not hmac.compare_digest(expected_mac, mac_sha256):
  1592	            raise TopicObservationError("topic observation authentication MAC mismatch")
