   387	    def _verified_artifact(
   388	        self,
   389	        artifact_id: str,
   390	        expected_digest: str,
   391	        *,
   392	        expected_media_type: str | None = None,
   393	    ) -> ArtifactRecord:
   394	        artifact = self.artifacts.get(artifact_id)
   395	        path = self.artifacts.path_for(artifact_id)
   396	        if (
   397	            artifact.sha256 != expected_digest
   398	            or not path.is_file()
   399	            or artifact.logical_role != "literature-observation"
   400	            or artifact.producer != "matharc-literature-base"
   401	            or (expected_media_type is not None and artifact.media_type != expected_media_type)
   402	        ):
   403	            raise ValueError("artifact reference is not intact")
   404	        content = path.read_bytes()
   405	        if hashlib.sha256(content).hexdigest() != artifact.sha256:
   406	            raise ValueError("artifact blob digest mismatch")
   407	        if len(content) != artifact.size_bytes:
   408	            raise ValueError("artifact blob size mismatch")
   409	        return artifact
