  1308	            self.state_path,
  1309	            label="topic observation state",
  1310	        )
  1311	        old_authentication = self._private_file_snapshot(
  1312	            self.authentication_path,
  1313	            label="topic observation authentication state",
  1314	        )
  1315	        current_key = _read_verified_file(
  1316	            self.signing_key_path,
  1317	            label="topic observation signing key",
  1318	            expected_mode=_PRIVATE_FILE_MODE,
  1319	            missing_ok=True,
  1320	        )
  1321	        old_key_sha256 = (
  1322	            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
  1323	        )
  1324	        old_literature_files = self._literature_file_snapshots()
  1325	        transaction = {
  1326	            "schema_version": _TRANSACTION_SCHEMA_VERSION,
  1327	            "recovery_contract": _TRANSACTION_RECOVERY_CONTRACT,
  1328	            "phase": _TRANSACTION_PREPARED,
  1329	            "old_key_sha256": old_key_sha256,
  1330	            "old_state": old_state,
  1331	            "old_authentication": old_authentication,
