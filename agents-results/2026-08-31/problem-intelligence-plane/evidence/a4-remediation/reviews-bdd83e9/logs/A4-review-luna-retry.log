  1020	    @staticmethod
  1021	    def _record_manual_event(
  1022	        state: dict[str, Any],
  1023	        manual: ManualReviewItem,
  1024	    ) -> None:
  1025	        existing = {item["manual_id"] for item in state["manual_events"]}
  1026	        if manual.manual_id not in existing:
  1027	            state["manual_events"].append(
  1028	                {
  1029	                    "event_type": "CURSOR_CONFLICT",
  1030	                    "manual_id": manual.manual_id,
  1031	                }
  1032	            )
  1033	            state["manual_events"].sort(key=lambda item: item["manual_id"])
  1034	
  1035	    def _add_manual(
  1036	        self,
  1037	        state: dict[str, Any],
  1038	        *,
  1039	        cursor: str,
  1040	        input_id: str,
  1041	        reason: ManualReviewReason,
  1042	        detail: str,
  1043	    ) -> ManualReviewItem:
  1044	        manual = ManualReviewItem(
  1045	            manual_id=_manual_id_for(
  1046	                topic_id=self.topic_id,
  1047	                cursor=cursor,
  1048	                input_id=input_id,
  1049	                reason=reason,
  1050	                detail=detail,
  1051	            ),
  1052	            topic_id=self.topic_id,
  1053	            cursor=cursor,
  1054	            input_id=input_id,
  1055	            reason=reason,
  1056	            detail=detail,
  1057	        )
  1058	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
  1059	        if manual.manual_id not in existing:
  1060	            state["manual_queue"].append(manual.to_dict())
  1061	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
  1062	        return manual
