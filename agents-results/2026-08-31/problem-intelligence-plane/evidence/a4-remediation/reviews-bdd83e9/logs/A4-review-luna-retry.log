   417	@dataclass(frozen=True, slots=True)
   418	class TopicObservationInput:
   419	    """One bounded source candidate supplied by a topic synchronization run."""
   420	
   421	    input_id: str
   422	    observation: SourceObservation
   423	    content: bytes
   424	    risk_flags: tuple[str, ...] = ()
   425	
   426	    def __post_init__(self) -> None:
   427	        _require_nonempty(self.input_id, "input_id")
   428	        if not isinstance(self.observation, SourceObservation):
   429	            raise TypeError("observation must be a SourceObservation")
   430	        if not isinstance(self.content, bytes):
   431	            raise TypeError("content must be bytes")
   432	        if not isinstance(self.risk_flags, tuple):
   433	            raise TypeError("risk_flags must be a tuple")
   434	        if any(not isinstance(flag, str) or not flag.strip() for flag in self.risk_flags):
   435	            raise TopicObservationError("risk_flags must contain non-empty strings")
   436	        if tuple(sorted(self.risk_flags)) != self.risk_flags or len(set(self.risk_flags)) != len(self.risk_flags):
   437	            raise TopicObservationError("risk_flags must be sorted and unique")
   438	
   439	    @property
   440	    def fingerprint_sha256(self) -> str:
   441	        return _fingerprint_from_input_projection(self.input_projection)
   442	
   443	    @property
   444	    def input_projection(self) -> dict[str, Any]:
   445	        """Return the canonical, non-secret identity needed to replay this input."""
   446	
   447	        return {
   448	            "input_id": self.input_id,
   449	            "observation": self.observation.to_dict(),
   450	            "content_sha256": hashlib.sha256(self.content).hexdigest(),
   451	            "content_size_bytes": len(self.content),
   452	            "risk_flags": list(self.risk_flags),
   453	        }
   454	
   455	    @property
   456	    def is_high_risk(self) -> bool:
   457	        return bool(self.risk_flags)
