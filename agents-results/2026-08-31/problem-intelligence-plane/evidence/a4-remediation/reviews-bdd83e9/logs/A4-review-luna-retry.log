  1006	    @staticmethod
  1007	    def _prior_input_cursor(
  1008	        state: Mapping[str, Any],
  1009	        input_id: str,
  1010	        fingerprint: str,
  1011	    ) -> str | None:
  1012	        matches = [
  1013	            cursor
  1014	            for cursor, stored in state["batches"].items()
  1015	            if isinstance(stored, dict)
  1016	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
  1017	        ]
  1018	        return sorted(matches)[0] if matches else None
