   161	def _read_verified_file(
   162	    path: Path,
   163	    *,
   164	    label: str,
   165	    expected_mode: int | None,
   166	    missing_ok: bool,
   167	) -> tuple[bytes, int] | None:
   168	    """Read one file through an identity-checked descriptor."""
   169	
   170	    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
   171	    try:
   172	        file_descriptor = os.open(path, flags)
   173	    except FileNotFoundError as exc:
   174	        if missing_ok:
   175	            return None
   176	        raise TopicObservationError(f"{label} is missing") from exc
   177	    except OSError as exc:
   178	        raise TopicObservationError(f"{label} is unreadable") from exc
   179	
   180	    open_descriptor = file_descriptor
   181	    try:
   182	        metadata = os.fstat(file_descriptor)
   183	        if not stat.S_ISREG(metadata.st_mode):
   184	            raise TopicObservationError(f"{label} is not a regular file")
   185	        mode = stat.S_IMODE(metadata.st_mode)
   186	        if expected_mode is not None and mode != expected_mode:
   187	            raise TopicObservationError(f"{label} must have mode {expected_mode:04o}")
   188	        with os.fdopen(file_descriptor, "rb") as file:
   189	            open_descriptor = -1
   190	            return file.read(), mode
   191	    except TopicObservationError:
   192	        raise
   193	    except OSError as exc:
   194	        raise TopicObservationError(f"{label} is unreadable") from exc
   195	    finally:
   196	        if open_descriptor != -1:
   197	            os.close(open_descriptor)
