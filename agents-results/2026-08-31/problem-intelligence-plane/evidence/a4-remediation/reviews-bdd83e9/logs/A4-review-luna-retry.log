   328	def _input_projection_binding_digest(
   329	    *,
   330	    topic_id: str,
   331	    cursor: str,
   332	    next_cursor: str,
   333	    batch_digest_sha256: str,
   334	    input_projection: Mapping[str, Any],
   335	) -> str:
   336	    """Bind one disposition record to its immutable batch input projection."""
   337	
   338	    return digest_json(
   339	        {
   340	            "schema_version": _SCHEMA_VERSION,
   341	            "topic_id": topic_id,
   342	            "cursor": cursor,
   343	            "next_cursor": next_cursor,
