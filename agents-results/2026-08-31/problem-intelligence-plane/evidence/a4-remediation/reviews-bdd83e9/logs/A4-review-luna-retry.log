  1107	    def _literature_file_snapshots(self) -> list[dict[str, Any]]:
  1108	        literature_root = self.root / "literature"
  1109	        try:
  1110	            root_metadata = literature_root.lstat()
  1111	        except FileNotFoundError:
  1112	            return []
  1113	        except OSError as exc:
  1114	            raise TopicObservationError("topic observation literature root is unreadable") from exc
  1115	        if stat.S_ISLNK(root_metadata.st_mode) or not stat.S_ISDIR(root_metadata.st_mode):
  1116	            raise TopicObservationError("topic observation literature root is not a directory")
  1117	
  1118	        snapshots: list[dict[str, Any]] = []
  1119	        for current, directories, files in os.walk(literature_root, followlinks=False):
  1120	            current_path = Path(current)
  1121	            for directory_name in directories:
  1122	                directory_path = current_path / directory_name
  1123	                try:
  1124	                    metadata = directory_path.lstat()
  1125	                except OSError as exc:
  1126	                    raise TopicObservationError("topic observation literature directory is unreadable") from exc
  1127	                if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
  1128	                    raise TopicObservationError("topic observation literature directory is not regular")
  1129	            for file_name in files:
  1130	                file_path = current_path / file_name
  1131	                relative_path = file_path.relative_to(literature_root).as_posix()
  1132	                if relative_path == ".observations.lock":
  1133	                    continue
  1134	                result = _read_verified_file(
  1135	                    file_path,
  1136	                    label=f"topic observation literature file {relative_path}",
  1137	                    expected_mode=None,
  1138	                    missing_ok=False,
  1139	                )
  1140	                if result is None:
  1141	                    raise TopicObservationError("topic observation literature file disappeared")
  1142	                content, mode = result
  1143	                snapshots.append(
  1144	                    {
  1145	                        "path": relative_path,
  1146	                        **_encoded_file_snapshot(content, mode),
  1147	                    }
  1148	                )
  1149	        snapshots.sort(key=lambda item: item["path"])
  1150	        return snapshots
  1151	
  1152	    @staticmethod
  1153	    def _validated_literature_file_snapshots(value: object) -> list[dict[str, Any]]:
  1154	        if not isinstance(value, list):
  1155	            raise TopicObservationError("topic observation literature transaction snapshot is malformed")
  1156	        validated: list[dict[str, Any]] = []
  1157	        paths: list[str] = []
  1158	        for item in value:
  1159	            if not isinstance(item, dict):
  1160	                raise TopicObservationError("topic observation literature transaction file is malformed")
  1161	            _require_fields(
  1162	                item,
  1163	                {"path", "sha256", "size_bytes", "mode", "content_b64"},
  1164	                "topic observation literature transaction file",
  1165	            )
  1166	            path = _validate_snapshot_path(item["path"], "topic observation literature")
  1167	            if path != item["path"] or path == ".observations.lock":
  1168	                raise TopicObservationError("topic observation literature transaction path is invalid")
  1169	            file_snapshot = dict(item)
  1170	            file_snapshot.pop("path")
  1171	            content, mode = _decode_file_snapshot(
  1172	                file_snapshot,
  1173	                "topic observation literature transaction",
  1174	            )
  1175	            validated.append(
  1176	                {
  1177	                    "path": path,
  1178	                    **_encoded_file_snapshot(content, mode),
  1179	                }
  1180	            )
  1181	            paths.append(path)
  1182	        if paths != sorted(paths) or len(paths) != len(set(paths)):
  1183	            raise TopicObservationError(
  1184	                "topic observation literature transaction paths must be sorted and unique"
  1185	            )
  1186	        return validated
