  1090	    def _private_file_snapshot(
  1091	        self,
  1092	        path: Path,
  1093	        *,
  1094	        label: str,
  1095	    ) -> dict[str, Any] | None:
  1096	        result = _read_verified_file(
  1097	            path,
  1098	            label=label,
  1099	            expected_mode=_PRIVATE_FILE_MODE,
  1100	            missing_ok=True,
  1101	        )
  1102	        if result is None:
  1103	            return None
  1104	        content, mode = result
  1105	        return _encoded_file_snapshot(content, mode)
