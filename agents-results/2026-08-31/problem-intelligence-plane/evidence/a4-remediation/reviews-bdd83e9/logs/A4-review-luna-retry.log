  1342	    def _write_transaction(self, payload: Mapping[str, Any]) -> None:
  1343	        _atomic_write_bytes(
  1344	            self.transaction_path,
  1345	            (canonical_json(payload) + "\n").encode("utf-8"),
  1346	            _PRIVATE_FILE_MODE,
  1347	        )
