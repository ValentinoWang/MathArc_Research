   460	@dataclass(frozen=True, slots=True)
   461	class TopicObservationBatch:
   462	    """A one-topic, explicitly cursor-bounded batch of source candidates."""
   463	
   464	    topic_id: str
   465	    cursor: str
   466	    next_cursor: str
   467	    inputs: tuple[TopicObservationInput, ...]
   468	    schema_version: str = _SCHEMA_VERSION
   469	
   470	    def __post_init__(self) -> None:
   471	        _require_nonempty(self.topic_id, "topic_id")
   472	        _require_nonempty(self.cursor, "cursor")
   473	        _require_nonempty(self.next_cursor, "next_cursor")
   474	        if self.cursor == self.next_cursor:
   475	            raise TopicObservationError("next_cursor must advance beyond cursor")
   476	        if not isinstance(self.inputs, tuple) or not self.inputs:
   477	            raise TopicObservationError("inputs must be a non-empty tuple")
   478	        if any(not isinstance(item, TopicObservationInput) for item in self.inputs):
   479	            raise TypeError("inputs must contain TopicObservationInput records")
   480	        identifiers = tuple(item.input_id for item in self.inputs)
   481	        if len(identifiers) != len(set(identifiers)) or tuple(sorted(identifiers)) != identifiers:
   482	            raise TopicObservationError("input ids must be sorted and unique")
   483	        if self.schema_version != _SCHEMA_VERSION:
   484	            raise TopicObservationError("unsupported topic-observation batch schema_version")
   485	
   486	    @property
   487	    def batch_digest_sha256(self) -> str:
   488	        return _batch_digest_from_fingerprints(
   489	            topic_id=self.topic_id,
   490	            cursor=self.cursor,
   491	            next_cursor=self.next_cursor,
   492	            input_fingerprints={
   493	                item.input_id: item.fingerprint_sha256 for item in self.inputs
   494	            },
   495	        )
