   337	    def _reload_state(self) -> None:
   338	        self.artifacts = ArtifactStore.load(self.root / "artifacts")
   339	        self._observations = {}
   340	        if not self.manifest_path.is_file():
   341	            return
   342	        payload = json.loads(self.manifest_path.read_text(encoding="utf-8"))
   343	        if not isinstance(payload, dict) or set(payload) != {"schema_version", "observations"}:
   344	            raise ValueError("invalid literature observation manifest")
   345	        if payload["schema_version"] != "1.0":
   346	            raise ValueError("unsupported literature observation schema")
   347	        if not isinstance(payload["observations"], list):
   348	            raise ValueError("invalid literature observation manifest")
   349	        observation_keys: dict[str, str] = {}
   350	        for item in payload["observations"]:
   351	            observation = SourceObservation.from_dict(item)
   352	            if observation.observation_id in self._observations:
   353	                raise ValueError("duplicate observation id")
   354	            existing_observation_id = observation_keys.get(observation.idempotency_key)
   355	            if (
   356	                existing_observation_id is not None
   357	                and existing_observation_id != observation.observation_id
   358	            ):
   359	                raise ValueError("duplicate observation idempotency key")
   360	            observation_keys[observation.idempotency_key] = observation.observation_id
   361	            self._observations[observation.observation_id] = observation
   362	        self._validate_observed_artifacts()
   363	
   364	    def _record(self, observation: SourceObservation) -> None:
   365	        existing = self._observations.get(observation.observation_id)
   366	        if existing is not None and existing.to_dict() != observation.to_dict():
   367	            if (
   368	                existing.logical_identity != observation.logical_identity
   369	                or existing.status is not ObservationStatus.PENDING
   370	            ):
   371	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   372	        for existing in self._observations.values():
   373	            if (
   374	                existing.observation_id != observation.observation_id
   375	                and existing.idempotency_key == observation.idempotency_key
   376	            ):
   377	                raise ValueError("refusing to record duplicate observation idempotency key")
   378	        self._observations[observation.observation_id] = observation
   379	        payload = {
   380	            "schema_version": "1.0",
   381	            "observations": [item.to_dict() for item in self.observations],
   382	        }
   383	        temporary = self.manifest_path.with_suffix(".tmp")
   384	        temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   385	        os.replace(temporary, self.manifest_path)
   386	
   387	    def _verified_artifact(
   388	        self,
   389	        artifact_id: str,
   390	        expected_digest: str,
   391	        *,
   392	        expected_media_type: str | None = None,
   393	    ) -> ArtifactRecord:
   394	        artifact = self.artifacts.get(artifact_id)
   395	        path = self.artifacts.path_for(artifact_id)
   396	        if (
   397	            artifact.sha256 != expected_digest
   398	            or not path.is_file()
   399	            or artifact.logical_role != "literature-observation"
   400	            or artifact.producer != "matharc-literature-base"
   401	            or (expected_media_type is not None and artifact.media_type != expected_media_type)
   402	        ):
   403	            raise ValueError("artifact reference is not intact")
   404	        content = path.read_bytes()
   405	        if hashlib.sha256(content).hexdigest() != artifact.sha256:
   406	            raise ValueError("artifact blob digest mismatch")
   407	        if len(content) != artifact.size_bytes:
   408	            raise ValueError("artifact blob size mismatch")
   409	        return artifact
   410	
   411	    def _validate_observed_artifacts(self) -> None:
   412	        for observation in self._observations.values():
   413	            if observation.status is not ObservationStatus.OBSERVED:
   414	                continue
   415	            if not observation.artifact_id or not observation.content_digest_sha256:
   416	                raise ValueError(f"observed record has incomplete artifact reference: {observation.observation_id}")
   417	            try:
   418	                self._verified_artifact(
   419	                    observation.artifact_id,
   420	                    observation.content_digest_sha256,
   421	                    expected_media_type=observation.media_type,
   422	                )
   423	            except (KeyError, ValueError) as exc:
   424	                raise ValueError(f"invalid artifact for observed record {observation.observation_id}: {exc}") from exc
   425	
   426	    def _reuse_or_put_artifact(
   427	        self,
   428	        artifact_id: str,
   429	        content: bytes,
   430	        observation: SourceObservation,
   431	        source_filename: str,
   432	    ) -> ArtifactRecord:
   433	        try:
   434	            existing = self.artifacts.get(artifact_id)
   435	        except KeyError:
   436	            existing = None
   437	        actual_digest = hashlib.sha256(content).hexdigest()
   438	        if existing is not None:
   439	            if (
   440	                existing.sha256 != actual_digest
   441	                or existing.size_bytes != len(content)
   442	                or existing.logical_role != "literature-observation"
   443	                or existing.producer != "matharc-literature-base"
   444	                or existing.media_type != observation.media_type
   445	            ):
   446	                raise ValueError("existing artifact metadata conflicts with imported content")
   447	            self._verified_artifact(
   448	                artifact_id,
   449	                actual_digest,
   450	                expected_media_type=observation.media_type,
   451	            )
   452	            return existing
   453	        return self.artifacts.put_bytes(
   454	            artifact_id,
   455	            content,
   456	            logical_role="literature-observation",
   457	            producer="matharc-literature-base",
   458	            media_type=observation.media_type,
   459	            source_filename=source_filename,
   460	        )

