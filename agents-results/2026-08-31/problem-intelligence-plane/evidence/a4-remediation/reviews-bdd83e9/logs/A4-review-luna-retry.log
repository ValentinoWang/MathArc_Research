  1349	    def _restore_private_snapshot(
  1350	        self,
  1351	        path: Path,
  1352	        value: object,
  1353	        *,
  1354	        name: str,
  1355	    ) -> None:
  1356	        if value is None:
  1357	            try:
  1358	                os.unlink(path)
  1359	            except FileNotFoundError:
  1360	                return
  1361	            except OSError as exc:
  1362	                raise TopicObservationError(f"could not remove {name}") from exc
  1363	            _fsync_directory(path.parent)
  1364	            return
  1365	        content, mode = _decode_file_snapshot(value, name)
  1366	        if mode != _PRIVATE_FILE_MODE:
  1367	            raise TopicObservationError(f"{name} must have mode 0600")
  1368	        _atomic_write_bytes(path, content, mode)
