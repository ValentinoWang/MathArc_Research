  1188	    @staticmethod
  1189	    def _validated_private_snapshot(
  1190	        value: object,
  1191	        *,
  1192	        name: str,
  1193	        required: bool,
  1194	    ) -> dict[str, Any] | None:
  1195	        if value is None:
  1196	            if required:
  1197	                raise TopicObservationError(f"{name} transaction snapshot is missing")
  1198	            return None
  1199	        content, mode = _decode_file_snapshot(value, name)
  1200	        if mode != _PRIVATE_FILE_MODE:
  1201	            raise TopicObservationError(f"{name} transaction snapshot must have mode 0600")
  1202	        return _encoded_file_snapshot(content, mode)
