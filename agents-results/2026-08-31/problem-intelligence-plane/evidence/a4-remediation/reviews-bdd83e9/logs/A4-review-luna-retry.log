   364	    def _record(self, observation: SourceObservation) -> None:
   365	        existing = self._observations.get(observation.observation_id)
   366	        if existing is not None and existing.to_dict() != observation.to_dict():
   367	            if (
   368	                existing.logical_identity != observation.logical_identity
   369	                or existing.status is not ObservationStatus.PENDING
   370	            ):
   371	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   372	        for existing in self._observations.values():
   373	            if (
   374	                existing.observation_id != observation.observation_id
   375	                and existing.idempotency_key == observation.idempotency_key
   376	            ):
   377	                raise ValueError("refusing to record duplicate observation idempotency key")
   378	        self._observations[observation.observation_id] = observation
   379	        payload = {
   380	            "schema_version": "1.0",
   381	            "observations": [item.to_dict() for item in self.observations],
   382	        }
   383	        temporary = self.manifest_path.with_suffix(".tmp")
   384	        temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   385	        os.replace(temporary, self.manifest_path)
