   200	def _encoded_file_snapshot(content: bytes, mode: int) -> dict[str, Any]:
   201	    return {
   202	        "sha256": hashlib.sha256(content).hexdigest(),
   203	        "size_bytes": len(content),
   204	        "mode": mode,
   205	        "content_b64": base64.b64encode(content).decode("ascii"),
   206	    }
   207	
   208	
   209	def _decode_file_snapshot(value: object, name: str) -> tuple[bytes, int]:
   210	    if not isinstance(value, dict):
   211	        raise TopicObservationError(f"{name} snapshot is malformed")
   212	    _require_fields(value, {"sha256", "size_bytes", "mode", "content_b64"}, f"{name} snapshot")
   213	    digest = _require_sha256(value["sha256"], f"{name} snapshot digest")
   214	    size_bytes = value["size_bytes"]
   215	    if isinstance(size_bytes, bool) or not isinstance(size_bytes, int) or size_bytes < 0:
   216	        raise TopicObservationError(f"{name} snapshot size is invalid")
   217	    mode = value["mode"]
   218	    if isinstance(mode, bool) or not isinstance(mode, int) or mode < 0 or mode > 0o7777:
   219	        raise TopicObservationError(f"{name} snapshot mode is invalid")
   220	    content_b64 = value["content_b64"]
   221	    if not isinstance(content_b64, str):
   222	        raise TopicObservationError(f"{name} snapshot content is invalid")
   223	    try:
   224	        content = base64.b64decode(content_b64.encode("ascii"), validate=True)
   225	    except (UnicodeEncodeError, binascii.Error, ValueError) as exc:
   226	        raise TopicObservationError(f"{name} snapshot content is invalid") from exc
   227	    if len(content) != size_bytes or hashlib.sha256(content).hexdigest() != digest:
   228	        raise TopicObservationError(f"{name} snapshot digest mismatch")
   229	    return content, mode
