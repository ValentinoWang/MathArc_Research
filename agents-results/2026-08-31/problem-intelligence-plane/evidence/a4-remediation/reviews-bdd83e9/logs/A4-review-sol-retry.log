   927	    def _item_evidence(
   928	        self,
   929	        item: TopicObservationInput,
   930	        result: TopicItemResult,
   931	        basis: str,
   932	        *,
   933	        persisted: SourceObservation | None = None,
   934	        manual_id: str | None = None,
   935	        manual_reason: ManualReviewReason | None = None,
   936	        import_disposition: ImportDisposition | None = None,
   937	        prior_cursor: str | None = None,
   938	        prior_input_id: str | None = None,
   939	    ) -> dict[str, Any]:
   940	        persisted_status = "ABSENT"
   941	        persisted_observation_id = None
   942	        persisted_content_digest = None
   943	        persisted_artifact_id = None
   944	        persisted_artifact_sha256 = None
   945	        if persisted is not None:
   946	            persisted_status = persisted.status.value
   947	            persisted_observation_id = persisted.observation_id
   948	            persisted_content_digest = persisted.content_digest_sha256
   949	            if persisted.status is ObservationStatus.OBSERVED:
   950	                if persisted.artifact_id is None:
   951	                    raise TopicObservationError("observed literature evidence has no artifact")
   952	                try:
   953	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
   954	                except KeyError as exc:
   955	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
   956	                persisted_artifact_id = artifact.artifact_id
   957	                persisted_artifact_sha256 = artifact.sha256
   958	        return {
   959	            "basis": basis,
   960	            "input_id": item.input_id,
   961	            "input_observation_id": item.observation.observation_id,
   962	            "input_idempotency_key": item.observation.idempotency_key,
   963	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   964	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   965	            "input_content_size_bytes": len(item.content),
   966	            "input_risk_flags": list(item.risk_flags),
   967	            "observation_id": result.observation_id,
   968	            "persisted_observation_id": persisted_observation_id,
   969	            "persisted_observation_status": persisted_status,
   970	            "persisted_content_digest_sha256": persisted_content_digest,
   971	            "persisted_artifact_id": persisted_artifact_id,
   972	            "persisted_artifact_sha256": persisted_artifact_sha256,
   973	            "manual_id": manual_id,
   974	            "manual_reason": manual_reason.value if manual_reason is not None else None,
   975	            "prior_cursor": prior_cursor,
   976	            "prior_input_id": prior_input_id,
   977	            "import_disposition": import_disposition.value if import_disposition is not None else None,
   978	        }
