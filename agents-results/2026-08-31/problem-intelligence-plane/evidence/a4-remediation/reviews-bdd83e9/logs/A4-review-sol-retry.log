        stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
        stored_b["result"]["item_results"][0]["status"] = TopicItemStatus.DUPLICATE.value
        stored_b["disposition_evidence"]["B"]["basis"] = "SEEN_OBSERVATION_KEY"
