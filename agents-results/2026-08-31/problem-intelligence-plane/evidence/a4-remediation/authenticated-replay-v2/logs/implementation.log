   302	    def _verified_artifact(
   303	        self,
   304	        artifact_id: str,
   305	        expected_digest: str,
   306	        *,
   307	        expected_media_type: str | None = None,
   308	    ) -> ArtifactRecord:
   309	        artifact = self.artifacts.get(artifact_id)
   310	        path = self.artifacts.path_for(artifact_id)
   311	        if (
   312	            artifact.sha256 != expected_digest
   313	            or not path.is_file()
   314	            or artifact.logical_role != "literature-observation"
