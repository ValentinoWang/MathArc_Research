+            cursor="c0",
+            next_cursor="c1",
+            batch_digest_sha256=stored_a["batch_digest_sha256"],
+            input_projection=swapped.input_projection,
+        )
+        stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
+
+        original_a = input_for("A")
