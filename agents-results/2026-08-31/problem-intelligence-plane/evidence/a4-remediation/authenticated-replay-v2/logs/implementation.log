+
+            self.assertEqual(TopicItemStatus.IDEMPOTENT, first.item_results[0].status)
+            self.assertEqual(TopicItemStatus.IDEMPOTENT, second.item_results[0].status)
+            self.assertEqual("c2", second_runner.next_cursor)
+
