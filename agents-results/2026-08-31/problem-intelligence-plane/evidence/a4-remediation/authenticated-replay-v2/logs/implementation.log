   189	        batches = state["batches"]
   190	        assert isinstance(batches, dict)
   191	        stored_a = batches["c0"]
   192	        stored_b = batches["c1"]
   193	        assert isinstance(stored_a, dict) and isinstance(stored_b, dict)
   194	        source_b = input_for("B")
   195	        stored_a["input_projections"]["A"] = source_b.input_projection
   196	        stored_a["input_fingerprints"]["A"] = source_b.fingerprint_sha256
   197	        stored_a["input_observation_ids"]["A"] = source_b.observation.observation_id
   198	        evidence_a = dict(stored_b["disposition_evidence"]["B"])
   199	        evidence_a["input_id"] = "A"
   200	        stored_a["disposition_evidence"]["A"] = evidence_a
   201	        stored_a["result"]["item_results"][0]["observation_id"] = source_b.observation.observation_id
