   850	                persisted_artifact_id = artifact.artifact_id
   851	                persisted_artifact_sha256 = artifact.sha256
   852	        return {
   853	            "basis": basis,
   854	            "input_id": item.input_id,
   855	            "input_observation_id": item.observation.observation_id,
   856	            "input_idempotency_key": item.observation.idempotency_key,
   857	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   858	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   859	            "input_content_size_bytes": len(item.content),
   860	            "input_risk_flags": list(item.risk_flags),
   861	            "observation_id": result.observation_id,
   862	            "persisted_observation_id": persisted_observation_id,
   863	            "persisted_observation_status": persisted_status,
   864	            "persisted_content_digest_sha256": persisted_content_digest,
   865	            "persisted_artifact_id": persisted_artifact_id,
   866	            "persisted_artifact_sha256": persisted_artifact_sha256,
