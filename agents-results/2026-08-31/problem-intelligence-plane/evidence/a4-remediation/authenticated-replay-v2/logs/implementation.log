   242	    @contextmanager
   243	    def _writer_lock(self) -> Iterator[None]:
   244	        self.lock_path.touch(exist_ok=True)
   245	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   246	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   247	            try:
   248	                yield
   249	            finally:
   250	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
