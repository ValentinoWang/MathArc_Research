   900	    @staticmethod
   901	    def _prior_input_cursor(
   902	        state: Mapping[str, Any],
   903	        input_id: str,
   904	        fingerprint: str,
   905	    ) -> str | None:
   906	        matches = [
   907	            cursor
   908	            for cursor, stored in state["batches"].items()
   909	            if isinstance(stored, dict)
   910	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
   911	        ]
   912	        return sorted(matches)[0] if matches else None
