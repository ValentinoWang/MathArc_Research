   179	        self,
   180	        artifact_id: str,
   181	        value: Any,
   182	        *,
   183	        logical_role: str,
   184	        producer: str,
   185	        linked_claim_ids: Iterable[str] = (),
   186	        linked_tool_call_ids: Iterable[str] = (),
   187	        source_filename: str = "",
   188	    ) -> ArtifactRecord:
   189	        text = json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
   190	        return self.put_text(
   191	            artifact_id,
   192	            text,
