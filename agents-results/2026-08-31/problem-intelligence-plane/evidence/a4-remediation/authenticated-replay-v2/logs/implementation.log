   318	            raise ValueError("artifact reference is not intact")
   319	        content = path.read_bytes()
   320	        if hashlib.sha256(content).hexdigest() != artifact.sha256:
   321	            raise ValueError("artifact blob digest mismatch")
   322	        if len(content) != artifact.size_bytes:
   323	            raise ValueError("artifact blob size mismatch")
   324	        return artifact
