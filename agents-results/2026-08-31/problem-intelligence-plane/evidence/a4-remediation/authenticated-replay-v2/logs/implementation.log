+def _atomic_write_bytes(path: Path, content: bytes, mode: int) -> None:
+    temporary_name: str | None = None
+    try:
+        fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
+        open_fd = fd
