+                "state_sha256",
+                "literature_snapshot_sha256",
+                "mac_sha256",
+            },
+            "topic-observation authentication state",
+        )
+        return payload
+
+    def _verify_state_authentication(
+        self,
+        state: Mapping[str, Any],
+        state_bytes: bytes,
+    ) -> None:
+        state_snapshot_sha256 = _require_sha256(
