   252	    def _reload_state(self) -> None:
   253	        self.artifacts = ArtifactStore.load(self.root / "artifacts")
   254	        self._observations = {}
   255	        if not self.manifest_path.is_file():
   256	            return
   257	        payload = json.loads(self.manifest_path.read_text(encoding="utf-8"))
   258	        if not isinstance(payload, dict) or set(payload) != {"schema_version", "observations"}:
   259	            raise ValueError("invalid literature observation manifest")
   260	        if payload["schema_version"] != "1.0":
   261	            raise ValueError("unsupported literature observation schema")
   262	        if not isinstance(payload["observations"], list):
   263	            raise ValueError("invalid literature observation manifest")
   264	        observation_keys: dict[str, str] = {}
   265	        for item in payload["observations"]:
   266	            observation = SourceObservation.from_dict(item)
   267	            if observation.observation_id in self._observations:
   268	                raise ValueError("duplicate observation id")
   269	            existing_observation_id = observation_keys.get(observation.idempotency_key)
   270	            if (
   271	                existing_observation_id is not None
   272	                and existing_observation_id != observation.observation_id
   273	            ):
   274	                raise ValueError("duplicate observation idempotency key")
   275	            observation_keys[observation.idempotency_key] = observation.observation_id
   276	            self._observations[observation.observation_id] = observation
   277	        self._validate_observed_artifacts()
   278	
   279	    def _record(self, observation: SourceObservation) -> None:
   280	        existing = self._observations.get(observation.observation_id)
   281	        if existing is not None and existing.to_dict() != observation.to_dict():
   282	            if (
   283	                existing.logical_identity != observation.logical_identity
   284	                or existing.status is not ObservationStatus.PENDING
   285	            ):
   286	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   287	        for existing in self._observations.values():
   288	            if (
   289	                existing.observation_id != observation.observation_id
   290	                and existing.idempotency_key == observation.idempotency_key
   291	            ):
   292	                raise ValueError("refusing to record duplicate observation idempotency key")
   293	        self._observations[observation.observation_id] = observation
   294	        payload = {
   295	            "schema_version": "1.0",
   296	            "observations": [item.to_dict() for item in self.observations],
   297	        }
   298	        temporary = self.manifest_path.with_suffix(".tmp")
   299	        temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   300	        os.replace(temporary, self.manifest_path)
