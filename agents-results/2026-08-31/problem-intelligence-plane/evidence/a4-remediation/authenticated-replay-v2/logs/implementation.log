+    @staticmethod
+    def _rewrite_first_batch_to_b_and_second_to_duplicate(state: dict[str, object]) -> None:
+        batches = state["batches"]
+        assert isinstance(batches, dict)
+        stored_a = batches["c0"]
+        stored_b = batches["c1"]
+        assert isinstance(stored_a, dict) and isinstance(stored_b, dict)
