   222	    def _conflict(self, observation: SourceObservation) -> SourceObservation | None:
   223	        """Build a deterministic conflict ID without replacing any stored record."""
   224	
   225	        identity_digest = hashlib.sha256(
   226	            f"{observation.logical_identity}|{observation.content_digest_sha256}".encode("utf-8")
   227	        ).hexdigest()
   228	        conflict_id = f"{observation.observation_id}-conflict-{identity_digest}"
   229	        conflict = SourceObservation.from_dict(
   230	            {
   231	                **observation.to_dict(),
   232	                "observation_id": conflict_id,
   233	                "status": ObservationStatus.CONFLICT.value,
   234	                "artifact_id": None,
   235	            }
   236	        )
   237	        existing = self._observations.get(conflict_id)
   238	        if existing is not None and existing.to_dict() != conflict.to_dict():
   239	            return None
   240	        return conflict
