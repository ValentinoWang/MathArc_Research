    52	    def test_single_topic_batch_replays_after_restart_without_second_import(self) -> None:
    53	        with tempfile.TemporaryDirectory() as directory:
    54	            first_runner = TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0")
    55	            first = first_runner.run(batch("c0", "c1", input_for("A")))
    56	            self.assertEqual(TopicRunStatus.APPLIED, first.status)
    57	            self.assertEqual(TopicItemStatus.IMPORTED, first.item_results[0].status)
    58	            restarted = TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0")
    59	            replay = restarted.run(batch("c0", "c1", input_for("A")))
    60	            self.assertEqual(TopicRunStatus.REPLAYED, replay.status)
    61	            self.assertTrue(replay.replayed)
    62	            self.assertEqual("c1", restarted.next_cursor)
    63	            self.assertEqual(1, len(restarted.literature.observations))
