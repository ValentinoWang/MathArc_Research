+    def _literature_snapshot_payload(self) -> dict[str, Any]:
+        return {
+            "schema_version": _SCHEMA_VERSION,
+            "observations": [
+                observation.to_dict() for observation in self.literature.observations
+            ],
+            "artifacts": [
