    29	class LiteratureBaseIntegrityTests(unittest.TestCase):
    30	    def test_distinct_input_id_can_replay_one_observed_record_idempotently(self) -> None:
    31	        content = b"same logical source"
    32	        digest = hashlib.sha256(content).hexdigest()
    33	        first = observation("OBS-A", digest)
    34	        alternate = observation("OBS-B", digest)
    35	        with tempfile.TemporaryDirectory() as directory:
    36	            base = LiteratureBase(directory)
    37	            self.assertEqual(ImportDisposition.IMPORTED, base.import_bytes(first, content).disposition)
    38	            result = base.import_bytes(alternate, content)
    39	            self.assertEqual(ImportDisposition.IDEMPOTENT, result.disposition)
    40	            self.assertEqual(1, len(base.observations))
    41	
    42	    def test_persisted_distinct_records_cannot_reuse_idempotency_key(self) -> None:
    43	        content = b"duplicate logical identity"
    44	        digest = hashlib.sha256(content).hexdigest()
    45	        first = observation("OBS-A", digest)
    46	        with tempfile.TemporaryDirectory() as directory:
