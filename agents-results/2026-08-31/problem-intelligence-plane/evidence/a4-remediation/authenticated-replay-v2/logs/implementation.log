+                temporary_file.flush()
+                os.fsync(temporary_file.fileno())
+        finally:
+            if open_fd != -1:
+                os.close(open_fd)
+        os.replace(temporary_name, path)
+        temporary_name = None
+        _fsync_directory(path.parent)
+    finally:
+        if temporary_name is not None:
+            try:
+                os.unlink(temporary_name)
+            except FileNotFoundError:
+                pass
+
