+        evidence_a["input_projection_binding_sha256"] = _input_projection_binding_digest(
+            topic_id="integrity-topic",
+            cursor="c0",
+            next_cursor="c1",
+            batch_digest_sha256=stored_a["batch_digest_sha256"],
+            input_projection=swapped.input_projection,
