+        )
+        snapshot_bytes = self._literature_snapshot_bytes()
+        current_snapshot_sha256 = hashlib.sha256(snapshot_bytes).hexdigest()
+        if state_snapshot_sha256 != current_snapshot_sha256:
+            raise TopicObservationError(
