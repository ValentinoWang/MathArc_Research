+                with os.fdopen(open_fd, "wb") as temporary_file:
+                    open_fd = -1
+                    temporary_file.write(secrets.token_bytes(_SIGNING_KEY_BYTES))
+                    temporary_file.flush()
+                    os.fsync(temporary_file.fileno())
+            finally:
