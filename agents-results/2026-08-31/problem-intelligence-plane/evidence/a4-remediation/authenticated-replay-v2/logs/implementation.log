   837	        persisted_artifact_id = None
   838	        persisted_artifact_sha256 = None
   839	        if persisted is not None:
   840	            persisted_status = persisted.status.value
   841	            persisted_observation_id = persisted.observation_id
   842	            persisted_content_digest = persisted.content_digest_sha256
   843	            if persisted.status is ObservationStatus.OBSERVED:
   844	                if persisted.artifact_id is None:
   845	                    raise TopicObservationError("observed literature evidence has no artifact")
