   217	    def _rejected(self, observation: SourceObservation) -> SourceObservation:
   218	        return SourceObservation.from_dict(
   219	            {**observation.to_dict(), "status": ObservationStatus.REJECTED.value, "artifact_id": None}
   220	        )
