+                item for item in literature["observations"] if item["observation_id"] == "OBS-B"
+            ]
+            literature_path.write_text(json.dumps(literature), encoding="utf-8")
+            artifact_path = Path(directory) / "literature" / "artifacts" / "manifest.json"
