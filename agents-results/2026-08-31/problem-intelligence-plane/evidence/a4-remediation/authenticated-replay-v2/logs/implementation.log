+def _path_present(path: Path) -> bool:
+    try:
+        path.lstat()
+    except FileNotFoundError:
+        return False
+    except OSError as exc:
+        raise TopicObservationError(f"cannot inspect authentication path: {path.name}") from exc
+    return True
