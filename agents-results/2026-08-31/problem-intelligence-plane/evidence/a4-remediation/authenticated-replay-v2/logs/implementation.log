   305	        expected_digest: str,
   306	        *,
   307	        expected_media_type: str | None = None,
   308	    ) -> ArtifactRecord:
   309	        artifact = self.artifacts.get(artifact_id)
   310	        path = self.artifacts.path_for(artifact_id)
   311	        if (
   312	            artifact.sha256 != expected_digest
   313	            or not path.is_file()
   314	            or artifact.logical_role != "literature-observation"
   315	            or artifact.producer != "matharc-literature-base"
   316	            or (expected_media_type is not None and artifact.media_type != expected_media_type)
   317	        ):
   318	            raise ValueError("artifact reference is not intact")
   319	        content = path.read_bytes()
   320	        if hashlib.sha256(content).hexdigest() != artifact.sha256:
   321	            raise ValueError("artifact blob digest mismatch")
   322	        if len(content) != artifact.size_bytes:
   323	            raise ValueError("artifact blob size mismatch")
   324	        return artifact
   325	
   326	    def _validate_observed_artifacts(self) -> None:
   327	        for observation in self._observations.values():
   328	            if observation.status is not ObservationStatus.OBSERVED:
   329	                continue
   330	            if not observation.artifact_id or not observation.content_digest_sha256:
   331	                raise ValueError(f"observed record has incomplete artifact reference: {observation.observation_id}")
   332	            try:
   333	                self._verified_artifact(
   334	                    observation.artifact_id,
   335	                    observation.content_digest_sha256,
   336	                    expected_media_type=observation.media_type,
   337	                )
   338	            except (KeyError, ValueError) as exc:
   339	                raise ValueError(f"invalid artifact for observed record {observation.observation_id}: {exc}") from exc
   340	
   341	    def _reuse_or_put_artifact(
   342	        self,
   343	        artifact_id: str,
   344	        content: bytes,
   345	        observation: SourceObservation,
   346	        source_filename: str,
   347	    ) -> ArtifactRecord:
   348	        try:
   349	            existing = self.artifacts.get(artifact_id)
   350	        except KeyError:
   351	            existing = None
   352	        actual_digest = hashlib.sha256(content).hexdigest()
   353	        if existing is not None:
   354	            if (
   355	                existing.sha256 != actual_digest
   356	                or existing.size_bytes != len(content)
   357	                or existing.logical_role != "literature-observation"
   358	                or existing.producer != "matharc-literature-base"
   359	                or existing.media_type != observation.media_type
   360	            ):
   361	                raise ValueError("existing artifact metadata conflicts with imported content")
   362	            self._verified_artifact(
   363	                artifact_id,
   364	                actual_digest,
   365	                expected_media_type=observation.media_type,
   366	            )
   367	            return existing
   368	        return self.artifacts.put_bytes(
   369	            artifact_id,
   370	            content,
   371	            logical_role="literature-observation",
   372	            producer="matharc-literature-base",
   373	            media_type=observation.media_type,
   374	            source_filename=source_filename,
   375	        )

