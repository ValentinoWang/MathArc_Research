+    path = Path(value)
+    if path.is_absolute() or not path.parts or "." in path.parts or ".." in path.parts:
+        raise TopicObservationError(f"{name} snapshot path is invalid")
+    if "\x00" in value:
+        raise TopicObservationError(f"{name} snapshot path is invalid")
+    return path.as_posix()
