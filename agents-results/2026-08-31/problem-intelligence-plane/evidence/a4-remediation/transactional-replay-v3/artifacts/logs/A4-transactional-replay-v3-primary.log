   360	    def input_projection(self) -> dict[str, Any]:
   361	        """Return the canonical, non-secret identity needed to replay this input."""
   362	
   363	        return {
   364	            "input_id": self.input_id,
   365	            "observation": self.observation.to_dict(),
   366	            "content_sha256": hashlib.sha256(self.content).hexdigest(),
   367	            "content_size_bytes": len(self.content),
   368	            "risk_flags": list(self.risk_flags),
   369	        }
   370	
   371	    @property
   372	    def is_high_risk(self) -> bool:
   373	        return bool(self.risk_flags)
