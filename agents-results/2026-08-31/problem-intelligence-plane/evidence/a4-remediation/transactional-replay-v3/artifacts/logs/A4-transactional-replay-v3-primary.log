   254	    @contextmanager
   255	    def _writer_lock(self) -> Iterator[None]:
   256	        self.lock_path.touch(exist_ok=True)
   257	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   258	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   259	            try:
   260	                yield
   261	            finally:
   262	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
   263	
   264	    def _reload_state(self) -> None:
   265	        self.artifacts = ArtifactStore.load(self.root / "artifacts")
   266	        self._observations = {}
   267	        if not self.manifest_path.is_file():
   268	            return
   269	        payload = json.loads(self.manifest_path.read_text(encoding="utf-8"))
   270	        if not isinstance(payload, dict) or set(payload) != {"schema_version", "observations"}:
   271	            raise ValueError("invalid literature observation manifest")
   272	        if payload["schema_version"] != "1.0":
   273	            raise ValueError("unsupported literature observation schema")
   274	        if not isinstance(payload["observations"], list):
   275	            raise ValueError("invalid literature observation manifest")
   276	        observation_keys: dict[str, str] = {}
   277	        for item in payload["observations"]:
   278	            observation = SourceObservation.from_dict(item)
   279	            if observation.observation_id in self._observations:
   280	                raise ValueError("duplicate observation id")
   281	            existing_observation_id = observation_keys.get(observation.idempotency_key)
   282	            if (
   283	                existing_observation_id is not None
   284	                and existing_observation_id != observation.observation_id
   285	            ):
   286	                raise ValueError("duplicate observation idempotency key")
   287	            observation_keys[observation.idempotency_key] = observation.observation_id
   288	            self._observations[observation.observation_id] = observation
   289	        self._validate_observed_artifacts()
   290	
   291	    def _record(self, observation: SourceObservation) -> None:
   292	        existing = self._observations.get(observation.observation_id)
   293	        if existing is not None and existing.to_dict() != observation.to_dict():
   294	            if (
   295	                existing.logical_identity != observation.logical_identity
   296	                or existing.status is not ObservationStatus.PENDING
   297	            ):
   298	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   299	        for existing in self._observations.values():
   300	            if (
   301	                existing.observation_id != observation.observation_id
   302	                and existing.idempotency_key == observation.idempotency_key
   303	            ):
   304	                raise ValueError("refusing to record duplicate observation idempotency key")
   305	        self._observations[observation.observation_id] = observation
   306	        payload = {
   307	            "schema_version": "1.0",
   308	            "observations": [item.to_dict() for item in self.observations],
   309	        }
   310	        temporary = self.manifest_path.with_suffix(".tmp")
   311	        temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   312	        os.replace(temporary, self.manifest_path)
   313	
   314	    def _verified_artifact(
   315	        self,
   316	        artifact_id: str,
   317	        expected_digest: str,
   318	        *,
   319	        expected_media_type: str | None = None,
   320	    ) -> ArtifactRecord:
   321	        artifact = self.artifacts.get(artifact_id)
   322	        path = self.artifacts.path_for(artifact_id)
   323	        if (
   324	            artifact.sha256 != expected_digest
   325	            or not path.is_file()
   326	            or artifact.logical_role != "literature-observation"
   327	            or artifact.producer != "matharc-literature-base"
   328	            or (expected_media_type is not None and artifact.media_type != expected_media_type)
   329	        ):
   330	            raise ValueError("artifact reference is not intact")
   331	        content = path.read_bytes()
   332	        if hashlib.sha256(content).hexdigest() != artifact.sha256:
   333	            raise ValueError("artifact blob digest mismatch")
   334	        if len(content) != artifact.size_bytes:
   335	            raise ValueError("artifact blob size mismatch")
   336	        return artifact
   337	
   338	    def _validate_observed_artifacts(self) -> None:
   339	        for observation in self._observations.values():
   340	            if observation.status is not ObservationStatus.OBSERVED:
   341	                continue
   342	            if not observation.artifact_id or not observation.content_digest_sha256:
   343	                raise ValueError(f"observed record has incomplete artifact reference: {observation.observation_id}")
   344	            try:
   345	                self._verified_artifact(
   346	                    observation.artifact_id,
   347	                    observation.content_digest_sha256,
   348	                    expected_media_type=observation.media_type,
   349	                )
   350	            except (KeyError, ValueError) as exc:
   351	                raise ValueError(f"invalid artifact for observed record {observation.observation_id}: {exc}") from exc
   352	
   353	    def _reuse_or_put_artifact(
   354	        self,
   355	        artifact_id: str,
   356	        content: bytes,
   357	        observation: SourceObservation,
   358	        source_filename: str,
   359	    ) -> ArtifactRecord:
   360	        try:
   361	            existing = self.artifacts.get(artifact_id)
   362	        except KeyError:
   363	            existing = None
   364	        actual_digest = hashlib.sha256(content).hexdigest()
   365	        if existing is not None:
   366	            if (
   367	                existing.sha256 != actual_digest
   368	                or existing.size_bytes != len(content)
   369	                or existing.logical_role != "literature-observation"
   370	                or existing.producer != "matharc-literature-base"
   371	                or existing.media_type != observation.media_type
   372	            ):
   373	                raise ValueError("existing artifact metadata conflicts with imported content")
   374	            self._verified_artifact(
   375	                artifact_id,
   376	                actual_digest,
   377	                expected_media_type=observation.media_type,
   378	            )
   379	            return existing
   380	        return self.artifacts.put_bytes(
   381	            artifact_id,
   382	            content,
   383	            logical_role="literature-observation",
   384	            producer="matharc-literature-base",
   385	            media_type=observation.media_type,
   386	            source_filename=source_filename,
   387	        )

