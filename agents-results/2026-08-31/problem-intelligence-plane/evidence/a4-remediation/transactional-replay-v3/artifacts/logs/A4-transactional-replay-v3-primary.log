+        raise TopicObservationError(f"{name} snapshot content is invalid") from exc
+    if len(content) != size_bytes or hashlib.sha256(content).hexdigest() != digest:
+        raise TopicObservationError(f"{name} snapshot digest mismatch")
+    return content, mode
+
