   228	        for record in self._records.values():
   229	            try:
   230	                path = self.path_for(record.artifact_id)
   231	            except ValueError as exc:
   232	                errors.append(str(exc))
   233	                continue
   234	            if not path.is_file():
   235	                errors.append(f"artifact file is missing: {record.artifact_id}")
   236	                continue
   237	            content = path.read_bytes()
   238	            actual = hashlib.sha256(content).hexdigest()
   239	            if actual != record.sha256:
   240	                errors.append(f"artifact digest mismatch: {record.artifact_id}")
   241	                continue
   242	            if len(content) != record.size_bytes:
   243	                errors.append(f"artifact size mismatch: {record.artifact_id}")
   244	                continue
   245	            verified += 1
   246	        return {
   247	            "valid": not errors,
   248	            "errors": errors,
   249	            "artifact_count": len(self._records),
   250	            "verified_count": verified,
   251	            "manifest_digest_sha256": digest_json(self.to_dict()),
   252	        }
   253	
   254	    def to_dict(self) -> dict[str, Any]:
   255	        return {
   256	            "schema_version": "1.0",
   257	            "content_addressing": "sha256",
   258	            "records": [record.to_dict() for record in self.records],
   259	        }
   260	
   261	    def save_manifest(self) -> Path:
   262	        self.root.mkdir(parents=True, exist_ok=True)
   263	        temporary = self.manifest_path.with_suffix(".tmp")
   264	        temporary.write_text(
   265	            json.dumps(self.to_dict(), ensure_ascii=False, indent=2, sort_keys=True) + "\n",
   266	            encoding="utf-8",
   267	        )
   268	        os.replace(temporary, self.manifest_path)
   269	        return self.manifest_path
   270	
   271	    @classmethod
   272	    def load(cls, root: str | Path) -> "ArtifactStore":
   273	        root_path = Path(root)
   274	        manifest = root_path / "manifest.json"
   275	        if not manifest.is_file():
   276	            return cls(root_path)
   277	        payload = json.loads(manifest.read_text(encoding="utf-8"))
   278	        if not isinstance(payload, dict):
   279	            raise ValueError("artifact manifest root must be an object")
   280	        if set(payload) - {"schema_version", "content_addressing", "records"}:
   281	            raise ValueError("unknown artifact-manifest fields")
   282	        if str(payload.get("schema_version")) != "1.0":
   283	            raise ValueError("unsupported artifact-manifest schema")
   284	        if str(payload.get("content_addressing")) != "sha256":
   285	            raise ValueError("unsupported artifact addressing scheme")
   286	        store = cls(
   287	            root_path,
   288	            (ArtifactRecord.from_dict(item) for item in payload.get("records", [])),
   289	        )
   290	        verification = store.verify()
   291	        if not verification["valid"]:
   292	            raise ValueError("; ".join(verification["errors"]))
   293	        return store
   294	
   295	    def _add_record(self, record: ArtifactRecord) -> None:
   296	        if record.artifact_id in self._records:
   297	            existing = self._records[record.artifact_id]
   298	            if existing.to_dict() != record.to_dict():
   299	                raise ValueError(f"conflicting artifact id: {record.artifact_id}")
   300	            return
   301	        if len(record.sha256) != 64:
   302	            raise ValueError(f"artifact {record.artifact_id} has invalid SHA-256")
   303	        self._records[record.artifact_id] = record
     1	"""A metered, consumable budget for one campaign run.
     2	
     3	This is the metering half of the improvement plan's cheap-vs-precise
     4	scheduler (docs/IMPROVEMENT_PLAN_V03.md, W1-3): usage is accrued from real
     5	ToolCallRecord timestamps and reported model usage rather than trusted
     6	purely on a worker's self-report.  The full tier-ordered escalation
     7	scheduler (VALIDITY/FAST/PRECISE/ACCEPTANCE, Kendall-tau ranking fidelity)
     8	is a larger, separate effort this ledger is designed to plug into later; on
     9	its own it gives a campaign a hard, honest stop condition.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	from dataclasses import dataclass, field
    15	from datetime import datetime
    16	from typing import Any, Mapping
    17	
    18	from .schema import ToolCallRecord
    19	
    20	
    21	def _parse_iso(value: str) -> datetime:
    22	    return datetime.fromisoformat(value)
    23	
    24	
    25	@dataclass(slots=True)
    26	class BudgetLedger:
    27	    wall_seconds_limit: float | None = None
    28	    input_token_limit: int | None = None
    29	    output_token_limit: int | None = None
    30	    cost_usd_limit: float | None = None
    31	
    32	    spent_wall_seconds: float = 0.0
    33	    spent_input_tokens: int = 0
    34	    spent_output_tokens: int = 0
    35	    spent_cost_usd: float = 0.0
    36	    tool_call_count: int = 0
    37	    model_call_count: int = 0
    38	    divergent_usage_reports: list[dict[str, Any]] = field(default_factory=list)
    39	
    40	    def charge_tool_call(self, record: ToolCallRecord) -> None:
    41	        try:
    42	            started = _parse_iso(record.started_at)
    43	            ended = _parse_iso(record.ended_at)
    44	            self.spent_wall_seconds += max(0.0, (ended - started).total_seconds())
    45	        except ValueError:
    46	            pass
    47	        self.tool_call_count += 1
    48	
    49	    def charge_model_usage(self, usage: Mapping[str, Any]) -> None:
    50	        raw_input_tokens = usage.get("input_tokens", 0)
    51	        raw_output_tokens = usage.get("output_tokens", 0)
    52	        input_tokens = int(raw_input_tokens or 0)
    53	        output_tokens = int(raw_output_tokens or 0)
    54	        cost_usd = usage.get("cost_usd")
    55	        if (
    56	            input_tokens < 0
    57	            or output_tokens < 0
    58	            or isinstance(raw_input_tokens, (int, float)) and raw_input_tokens < 0
    59	            or isinstance(raw_output_tokens, (int, float)) and raw_output_tokens < 0
    60	        ):
    61	            raise ValueError("model usage tokens cannot be negative")
    62	        if isinstance(cost_usd, bool) or (cost_usd is not None and not isinstance(cost_usd, (int, float))):
    63	            raise ValueError("cost_usd must be a number when provided")
    64	        if isinstance(cost_usd, (int, float)) and cost_usd < 0:
    65	            raise ValueError("model usage cost_usd cannot be negative")
    66	        self.spent_input_tokens += input_tokens
    67	        self.spent_output_tokens += output_tokens
    68	        if isinstance(cost_usd, (int, float)):
    69	            self.spent_cost_usd += float(cost_usd)
    70	        self.model_call_count += 1
    71	
    72	    def reconcile_self_report(
    73	        self,
    74	        *,
    75	        source: str,
    76	        reported: Mapping[str, Any],
    77	        metered: Mapping[str, Any],
    78	        tolerance: float = 0.2,
    79	    ) -> bool:
    80	        """Flag a worker's self-reported usage that diverges from metered usage.
    81	
    82	        Returns True if the report was accepted as consistent, False if it was
    83	        flagged into divergent_usage_reports.  A worker that consistently
    84	        under-reports usage should not be trusted for budget accounting even
    85	        though the metered ledger, not the self-report, is authoritative.
    86	        """
    87	
    88	        for key in ("input_tokens", "output_tokens"):
    89	            reported_value = float(reported.get(key, 0) or 0)
    90	            metered_value = float(metered.get(key, 0) or 0)
    91	            if metered_value <= 0:
    92	                continue
    93	            if abs(reported_value - metered_value) / metered_value > tolerance:
    94	                self.divergent_usage_reports.append(
    95	                    {
    96	                        "source": source,
    97	                        "field": key,
    98	                        "reported": reported_value,
    99	                        "metered": metered_value,
   100	                    }
   101	                )
   102	                return False
   103	        return True
   104	
   105	    def exhausted(self) -> bool:
   106	        if self.wall_seconds_limit is not None and self.spent_wall_seconds >= self.wall_seconds_limit:
   107	            return True
   108	        if self.input_token_limit is not None and self.spent_input_tokens >= self.input_token_limit:
   109	            return True
   110	        if (
   111	            self.output_token_limit is not None
   112	            and self.spent_output_tokens >= self.output_token_limit
   113	        ):
   114	            return True
   115	        if self.cost_usd_limit is not None and self.spent_cost_usd >= self.cost_usd_limit:
   116	            return True
   117	        return False
   118	
   119	    def to_dict(self) -> dict[str, Any]:
   120	        return {
   121	            "limits": {
   122	                "wall_seconds": self.wall_seconds_limit,
   123	                "input_tokens": self.input_token_limit,
   124	                "output_tokens": self.output_token_limit,
   125	                "cost_usd": self.cost_usd_limit,
   126	            },
   127	            "spent": {
   128	                "wall_seconds": self.spent_wall_seconds,
   129	                "input_tokens": self.spent_input_tokens,
   130	                "output_tokens": self.spent_output_tokens,
   131	                "cost_usd": self.spent_cost_usd,
   132	                "tool_calls": self.tool_call_count,
   133	                "model_calls": self.model_call_count,
   134	            },
   135	            "divergent_usage_reports": list(self.divergent_usage_reports),
   136	            "exhausted": self.exhausted(),
   137	        }

