+    def _recover_transaction_files(self) -> bool:
+        payload = self._read_transaction()
+        if payload is None:
+            return False
+        phase = payload["phase"]
+        current_key = _read_verified_file(
+            self.signing_key_path,
+            label="topic observation signing key",
+            expected_mode=_PRIVATE_FILE_MODE,
+            missing_ok=True,
