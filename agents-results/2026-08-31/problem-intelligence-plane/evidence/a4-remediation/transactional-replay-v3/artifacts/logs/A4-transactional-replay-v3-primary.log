   234	    def _conflict(self, observation: SourceObservation) -> SourceObservation | None:
   235	        """Build a deterministic conflict ID without replacing any stored record."""
   236	
   237	        identity_digest = hashlib.sha256(
   238	            f"{observation.logical_identity}|{observation.content_digest_sha256}".encode("utf-8")
   239	        ).hexdigest()
   240	        conflict_id = f"{observation.observation_id}-conflict-{identity_digest}"
