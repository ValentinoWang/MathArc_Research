+def _encoded_file_snapshot(content: bytes, mode: int) -> dict[str, Any]:
+    return {
+        "sha256": hashlib.sha256(content).hexdigest(),
+        "size_bytes": len(content),
+        "mode": mode,
+        "content_b64": base64.b64encode(content).decode("ascii"),
