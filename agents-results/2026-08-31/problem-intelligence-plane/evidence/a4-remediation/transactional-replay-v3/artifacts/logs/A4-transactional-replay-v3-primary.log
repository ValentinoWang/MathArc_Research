+        literature_root = self.root / "literature"
+        literature_root.mkdir(parents=True, exist_ok=True)
+        current = self._literature_file_snapshots()
+        target_paths = {item["path"] for item in target}
+        for item in current:
+            if item["path"] not in target_paths:
