    38	class LiteratureBaseIntegrityTests(unittest.TestCase):
    39	    def test_distinct_input_id_can_replay_one_observed_record_idempotently(self) -> None:
    40	        content = b"same logical source"
    41	        digest = hashlib.sha256(content).hexdigest()
    42	        first = observation("OBS-A", digest)
    43	        alternate = observation("OBS-B", digest)
    44	        with tempfile.TemporaryDirectory() as directory:
    45	            base = LiteratureBase(directory)
    46	            self.assertEqual(ImportDisposition.IMPORTED, base.import_bytes(first, content).disposition)
    47	            result = base.import_bytes(alternate, content)
    48	            self.assertEqual(ImportDisposition.IDEMPOTENT, result.disposition)
    49	            self.assertEqual(1, len(base.observations))
    50	
    51	    def test_persisted_distinct_records_cannot_reuse_idempotency_key(self) -> None:
    52	        content = b"duplicate logical identity"
    53	        digest = hashlib.sha256(content).hexdigest()
    54	        first = observation("OBS-A", digest)
    55	        with tempfile.TemporaryDirectory() as directory:
    56	            base = LiteratureBase(directory)
    57	            self.assertEqual(ImportDisposition.IMPORTED, base.import_bytes(first, content).disposition)
    58	            manifest_path = Path(directory) / "observations.json"
    59	            payload = json.loads(manifest_path.read_text(encoding="utf-8"))
    60	            duplicate = dict(payload["observations"][0])
    61	            duplicate["observation_id"] = "OBS-C"
    62	            payload["observations"].append(duplicate)
    63	            manifest_path.write_text(json.dumps(payload), encoding="utf-8")
    64	
    65	            with self.assertRaisesRegex(ValueError, "idempotency key"):
    66	                LiteratureBase(directory)
    67	
    68	    def test_distinct_pending_record_with_same_idempotency_key_is_rejected(self) -> None:
    69	        content = b"pending duplicate logical identity"
    70	        digest = hashlib.sha256(content).hexdigest()
    71	        first = observation("OBS-A", digest)
    72	        alternate = observation("OBS-B", digest)
    73	        first = SourceObservation.from_dict(
    74	            {
    75	                **first.to_dict(),
    76	                "license_status": LicenseStatus.RESTRICTED.value,
    77	                "status": ObservationStatus.PENDING.value,
    78	            }
    79	        )
    80	        with tempfile.TemporaryDirectory() as directory:
    81	            base = LiteratureBase(directory)
    82	            self.assertEqual(ImportDisposition.PENDING, base.import_bytes(first, content).disposition)
    83	            result = base.import_bytes(alternate, content)
    84	            self.assertEqual(ImportDisposition.REJECTED, result.disposition)
    85	            self.assertIn("idempotency key", result.reason)
    86	            self.assertEqual(1, len(base.observations))
