+            expected_mode=_PRIVATE_FILE_MODE,
+            missing_ok=True,
+        )
+        current_key_sha256 = (
+            hashlib.sha256(current_key[0]).hexdigest() if current_key is not None else None
+        )
+        old_key_sha256 = payload["old_key_sha256"]
