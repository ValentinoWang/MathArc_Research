   208	            artifact = self._reuse_or_put_artifact(
   209	                artifact_id,
   210	                content,
   211	                observation,
   212	                source_filename,
   213	            )
   214	        except (KeyError, ValueError) as exc:
   215	            pending = self._pending(observation)
   216	            self._record(pending)
   217	            return ImportResult(ImportDisposition.PENDING, pending, reason=f"artifact persistence failed: {exc}")
