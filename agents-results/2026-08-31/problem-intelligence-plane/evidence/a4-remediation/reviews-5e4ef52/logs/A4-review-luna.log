  1073	    @staticmethod
  1074	    def _record_manual_event(
  1075	        state: dict[str, Any],
  1076	        manual: ManualReviewItem,
  1077	    ) -> None:
  1078	        existing = {item["manual_id"] for item in state["manual_events"]}
  1079	        if manual.manual_id not in existing:
  1080	            state["manual_events"].append(
  1081	                {
  1082	                    "event_type": "CURSOR_CONFLICT",
  1083	                    "manual_id": manual.manual_id,
  1084	                }
  1085	            )
  1086	            state["manual_events"].sort(key=lambda item: item["manual_id"])
