   437	class TopicObservationInput:
   438	    """One bounded source candidate supplied by a topic synchronization run."""
   439	
   440	    input_id: str
   441	    observation: SourceObservation
   442	    content: bytes
   443	    risk_flags: tuple[str, ...] = ()
   444	
   445	    def __post_init__(self) -> None:
   446	        _require_nonempty(self.input_id, "input_id")
   447	        if not isinstance(self.observation, SourceObservation):
   448	            raise TypeError("observation must be a SourceObservation")
   449	        if not isinstance(self.content, bytes):
   450	            raise TypeError("content must be bytes")
   451	        if not isinstance(self.risk_flags, tuple):
   452	            raise TypeError("risk_flags must be a tuple")
   453	        if any(not isinstance(flag, str) or not flag.strip() for flag in self.risk_flags):
   454	            raise TopicObservationError("risk_flags must contain non-empty strings")
   455	        if tuple(sorted(self.risk_flags)) != self.risk_flags or len(set(self.risk_flags)) != len(self.risk_flags):
   456	            raise TopicObservationError("risk_flags must be sorted and unique")
   457	
   458	    @property
   459	    def fingerprint_sha256(self) -> str:
   460	        return _fingerprint_from_input_projection(self.input_projection)
   461	
   462	    @property
   463	    def input_projection(self) -> dict[str, Any]:
   464	        """Return the canonical, non-secret identity needed to replay this input."""
   465	
   466	        return {
   467	            "input_id": self.input_id,
   468	            "observation": self.observation.to_dict(),
   469	            "content_sha256": hashlib.sha256(self.content).hexdigest(),
   470	            "content_size_bytes": len(self.content),
   471	            "risk_flags": list(self.risk_flags),
   472	        }
   473	
   474	    @property
   475	    def is_high_risk(self) -> bool:
   476	        return bool(self.risk_flags)
