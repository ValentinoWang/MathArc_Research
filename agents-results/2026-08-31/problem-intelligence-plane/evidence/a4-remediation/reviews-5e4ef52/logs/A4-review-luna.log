   400	            external = input_for("EXTERNAL")
   401	            blocked = LiteratureBase(root / "literature").import_bytes(
   402	                external.observation,
   403	                external.content,
   404	            )
   405	            self.assertEqual("REJECTED", blocked.disposition.value)
   406	
   407	            recovered = TopicObservationRunner(
