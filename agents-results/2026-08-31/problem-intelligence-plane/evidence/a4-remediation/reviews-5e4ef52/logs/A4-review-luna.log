  1749	    def _new_state(self) -> dict[str, Any]:
  1750	        return {
  1751	            "schema_version": _STATE_SCHEMA_VERSION,
  1752	            "recovery_contract": _STATE_RECOVERY_CONTRACT,
  1753	            "topic_id": self.topic_id,
