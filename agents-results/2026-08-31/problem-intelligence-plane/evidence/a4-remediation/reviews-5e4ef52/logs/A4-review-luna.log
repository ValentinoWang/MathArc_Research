   127	def _require_nonempty(value: object, name: str) -> str:
   128	    if not isinstance(value, str) or not value.strip():
   129	        raise TopicObservationError(f"{name} must be non-empty")
   130	    return value
   131	
   132	
   133	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   134	    unknown = set(payload) - expected
   135	    missing = expected - set(payload)
   136	    if unknown:
   137	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   138	    if missing:
   139	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   140	
   141	
   142	def _require_sha256(value: object, name: str) -> str:
   143	    if (
   144	        not isinstance(value, str)
   145	        or len(value) != 64
   146	        or any(character not in "0123456789abcdef" for character in value)
   147	    ):
   148	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   149	    return value
   150	
   151	
   152	def _require_sha256_or_empty(value: object, name: str) -> str:
   153	    if value == "":
   154	        return ""
   155	    return _require_sha256(value, name)
