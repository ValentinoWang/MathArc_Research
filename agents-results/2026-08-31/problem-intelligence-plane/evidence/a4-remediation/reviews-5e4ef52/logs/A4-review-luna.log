   792	        )
   793	        stored_a["input_projections"]["A"] = swapped.input_projection
   794	        stored_a["input_fingerprints"]["A"] = swapped.fingerprint_sha256
   795	        stored_a["input_observation_ids"]["A"] = "OBS-B"
   796	        evidence_a = dict(stored_b["disposition_evidence"]["B"])
   797	        evidence_a["input_id"] = "A"
   798	        stored_a["disposition_evidence"]["A"] = evidence_a
   799	        stored_a["result"]["item_results"][0]["observation_id"] = "OBS-B"
   800	        state["processed_input_ids"]["A"] = swapped.fingerprint_sha256
   801	        state["seen_observation_keys"] = [evidence_a["input_idempotency_key"]]
   802	        stored_a["batch_digest_sha256"] = batch("c0", "c1", swapped).batch_digest_sha256
