   980	    def _item_evidence(
   981	        self,
   982	        item: TopicObservationInput,
   983	        result: TopicItemResult,
   984	        basis: str,
   985	        *,
   986	        persisted: SourceObservation | None = None,
   987	        manual_id: str | None = None,
   988	        manual_reason: ManualReviewReason | None = None,
   989	        import_disposition: ImportDisposition | None = None,
   990	        prior_cursor: str | None = None,
   991	        prior_input_id: str | None = None,
   992	    ) -> dict[str, Any]:
   993	        persisted_status = "ABSENT"
   994	        persisted_observation_id = None
   995	        persisted_content_digest = None
   996	        persisted_artifact_id = None
   997	        persisted_artifact_sha256 = None
   998	        if persisted is not None:
   999	            persisted_status = persisted.status.value
  1000	            persisted_observation_id = persisted.observation_id
  1001	            persisted_content_digest = persisted.content_digest_sha256
  1002	            if persisted.status is ObservationStatus.OBSERVED:
  1003	                if persisted.artifact_id is None:
  1004	                    raise TopicObservationError("observed literature evidence has no artifact")
  1005	                try:
  1006	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
  1007	                except KeyError as exc:
  1008	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
  1009	                persisted_artifact_id = artifact.artifact_id
  1010	                persisted_artifact_sha256 = artifact.sha256
  1011	        return {
  1012	            "basis": basis,
  1013	            "input_id": item.input_id,
  1014	            "input_observation_id": item.observation.observation_id,
  1015	            "input_idempotency_key": item.observation.idempotency_key,
  1016	            "input_content_digest_sha256": item.observation.content_digest_sha256,
  1017	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
  1018	            "input_content_size_bytes": len(item.content),
  1019	            "input_risk_flags": list(item.risk_flags),
  1020	            "observation_id": result.observation_id,
  1021	            "persisted_observation_id": persisted_observation_id,
  1022	            "persisted_observation_status": persisted_status,
  1023	            "persisted_content_digest_sha256": persisted_content_digest,
  1024	            "persisted_artifact_id": persisted_artifact_id,
  1025	            "persisted_artifact_sha256": persisted_artifact_sha256,
  1026	            "manual_id": manual_id,
  1027	            "manual_reason": manual_reason.value if manual_reason is not None else None,
  1028	            "prior_cursor": prior_cursor,
  1029	            "prior_input_id": prior_input_id,
  1030	            "import_disposition": import_disposition.value if import_disposition is not None else None,
  1031	        }
