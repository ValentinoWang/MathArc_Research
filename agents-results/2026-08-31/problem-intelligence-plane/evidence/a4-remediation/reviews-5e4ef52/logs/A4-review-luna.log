     def _restore_private_snapshot(
         self,
         path: Path,
         value: object,
         *,
         name: str,
     ) -> None:
         if value is None:
             try:
                 os.unlink(path)
             except FileNotFoundError:
                 return
             except OSError as exc:
                 raise TopicObservationError(f"could not remove {name}") from exc
             _fsync_directory(path.parent)
