   386	                    failed = True
   387	                    raise OSError("simulated retirement fsync failure")
   388	                original_fsync_directory(path)
   389	
   390	            with patch.object(
   391	                topic_observation_module,
   392	                "_fsync_directory",
   393	                side_effect=fail_retirement_once,
