  1117	    @contextmanager
  1118	    def _writer_lock(self) -> Iterator[None]:
  1119	        flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
  1120	        try:
  1121	            descriptor = os.open(self.lock_path, flags, _PRIVATE_FILE_MODE)
  1122	        except OSError as exc:
  1123	            raise TopicObservationError("topic observation lock is unreadable") from exc
  1124	        try:
  1125	            if not stat.S_ISREG(os.fstat(descriptor).st_mode):
  1126	                raise TopicObservationError("topic observation lock is not a regular file")
  1127	            lock_file = os.fdopen(descriptor, "a+", encoding="utf-8")
  1128	            descriptor = -1
  1129	        except Exception:
  1130	            if descriptor != -1:
  1131	                os.close(descriptor)
  1132	            raise
  1133	        with lock_file:
  1134	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
  1135	            try:
  1136	                yield
  1137	            finally:
  1138	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
