                         self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
                         (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
                     )
                 finally:
                     self._active_transaction = None
