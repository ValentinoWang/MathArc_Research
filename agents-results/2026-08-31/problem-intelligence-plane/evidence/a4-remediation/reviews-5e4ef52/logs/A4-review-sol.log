         return cls(
             topic_id=payload["topic_id"],
             cursor=payload["cursor"],
             next_cursor=payload["next_cursor"],
             status=TopicRunStatus(payload["status"]),
             item_results=tuple(TopicItemResult.from_dict(item) for item in items),
