             return None
         content, mode = _decode_file_snapshot(value, name)
         if mode != _PRIVATE_FILE_MODE:
             raise TopicObservationError(f"{name} transaction snapshot must have mode 0600")
         return _encoded_file_snapshot(content, mode)
 
