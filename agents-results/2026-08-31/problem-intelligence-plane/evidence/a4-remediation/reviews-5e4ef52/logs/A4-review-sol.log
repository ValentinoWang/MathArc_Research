   369	    def _reload_state(self) -> None:
   370	        self.artifacts = ArtifactStore.load(self.root / "artifacts")
   371	        self._observations = {}
   372	        if not self.manifest_path.is_file():
   373	            return
   374	        payload = json.loads(self.manifest_path.read_text(encoding="utf-8"))
   375	        if not isinstance(payload, dict) or set(payload) != {"schema_version", "observations"}:
   376	            raise ValueError("invalid literature observation manifest")
   377	        if payload["schema_version"] != "1.0":
   378	            raise ValueError("unsupported literature observation schema")
   379	        if not isinstance(payload["observations"], list):
   380	            raise ValueError("invalid literature observation manifest")
   381	        observation_keys: dict[str, str] = {}
   382	        for item in payload["observations"]:
   383	            observation = SourceObservation.from_dict(item)
   384	            if observation.observation_id in self._observations:
   385	                raise ValueError("duplicate observation id")
   386	            existing_observation_id = observation_keys.get(observation.idempotency_key)
   387	            if (
   388	                existing_observation_id is not None
   389	                and existing_observation_id != observation.observation_id
   390	            ):
   391	                raise ValueError("duplicate observation idempotency key")
   392	            observation_keys[observation.idempotency_key] = observation.observation_id
   393	            self._observations[observation.observation_id] = observation
   394	        self._validate_observed_artifacts()
