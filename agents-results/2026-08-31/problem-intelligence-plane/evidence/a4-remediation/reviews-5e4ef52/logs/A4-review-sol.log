   980	    def _item_evidence(
   981	        self,
   982	        item: TopicObservationInput,
   983	        result: TopicItemResult,
   984	        basis: str,
   985	        *,
   986	        persisted: SourceObservation | None = None,
   987	        manual_id: str | None = None,
   988	        manual_reason: ManualReviewReason | None = None,
   989	        import_disposition: ImportDisposition | None = None,
   990	        prior_cursor: str | None = None,
   991	        prior_input_id: str | None = None,
   992	    ) -> dict[str, Any]:
