  1064	    ) -> str | None:
  1065	        matches = [
  1066	            cursor
  1067	            for cursor, stored in state["batches"].items()
  1068	            if isinstance(stored, dict)
  1069	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
  1070	        ]
  1071	        return sorted(matches)[0] if matches else None
