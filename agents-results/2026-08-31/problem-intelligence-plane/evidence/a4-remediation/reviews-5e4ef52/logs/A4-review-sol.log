  1009	                persisted_artifact_id = artifact.artifact_id
  1010	                persisted_artifact_sha256 = artifact.sha256
  1011	        return {
  1012	            "basis": basis,
  1013	            "input_id": item.input_id,
  1014	            "input_observation_id": item.observation.observation_id,
  1015	            "input_idempotency_key": item.observation.idempotency_key,
  1016	            "input_content_digest_sha256": item.observation.content_digest_sha256,
  1017	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
  1018	            "input_content_size_bytes": len(item.content),
  1019	            "input_risk_flags": list(item.risk_flags),
