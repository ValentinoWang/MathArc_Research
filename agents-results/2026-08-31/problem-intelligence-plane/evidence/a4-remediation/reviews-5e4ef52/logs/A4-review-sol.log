   396	    def _record(self, observation: SourceObservation) -> None:
   397	        existing = self._observations.get(observation.observation_id)
   398	        if existing is not None and existing.to_dict() != observation.to_dict():
   399	            if (
   400	                existing.logical_identity != observation.logical_identity
   401	                or existing.status is not ObservationStatus.PENDING
   402	            ):
   403	                raise ValueError(f"refusing to overwrite observation id: {observation.observation_id}")
   404	        for existing in self._observations.values():
   405	            if (
   406	                existing.observation_id != observation.observation_id
   407	                and existing.idempotency_key == observation.idempotency_key
   408	            ):
   409	                raise ValueError("refusing to record duplicate observation idempotency key")
   410	        self._observations[observation.observation_id] = observation
   411	        payload = {
   412	            "schema_version": "1.0",
   413	            "observations": [item.to_dict() for item in self.observations],
   414	        }
   415	        temporary = self.manifest_path.with_suffix(".tmp")
   416	        temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   417	        os.replace(temporary, self.manifest_path)
