         return {
             "input_id": self.input_id,
             "observation": self.observation.to_dict(),
             "content_sha256": hashlib.sha256(self.content).hexdigest(),
             "content_size_bytes": len(self.content),
             "risk_flags": list(self.risk_flags),
         }
 
