class ClaimRecord:
    claim_id: str
    statement: str
    scope: str
    status: ClaimStatus = ClaimStatus.OPEN
    dependencies: tuple[str, ...] = ()
    evidence_ids: tuple[str, ...] = ()
    route_ids: tuple[str, ...] = ()
