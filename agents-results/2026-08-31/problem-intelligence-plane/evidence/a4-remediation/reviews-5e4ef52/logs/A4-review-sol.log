   344	    def _conflict(self, observation: SourceObservation) -> SourceObservation | None:
   345	        """Build a deterministic conflict ID without replacing any stored record."""
   346	
   347	        identity_digest = hashlib.sha256(
   348	            f"{observation.logical_identity}|{observation.content_digest_sha256}".encode("utf-8")
   349	        ).hexdigest()
   350	        conflict_id = f"{observation.observation_id}-conflict-{identity_digest}"
   351	        conflict = SourceObservation.from_dict(
   352	            {
   353	                **observation.to_dict(),
   354	                "observation_id": conflict_id,
   355	                "status": ObservationStatus.CONFLICT.value,
   356	                "artifact_id": None,
   357	            }
   358	        )
   359	        existing = self._observations.get(conflict_id)
   360	        if existing is not None and existing.to_dict() != conflict.to_dict():
   361	            return None
   362	        return conflict
