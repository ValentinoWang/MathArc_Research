   406	
   407	            recovered = TopicObservationRunner(
   408	                root,
   409	                topic_id="integrity-topic",
   410	                initial_cursor="c0",
   411	            )
   412	            self.assertEqual("c1", recovered.next_cursor)
   413	            self.assertFalse(runner.retired_transaction_path.exists())
