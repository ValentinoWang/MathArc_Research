   997	        persisted_artifact_sha256 = None
   998	        if persisted is not None:
   999	            persisted_status = persisted.status.value
  1000	            persisted_observation_id = persisted.observation_id
  1001	            persisted_content_digest = persisted.content_digest_sha256
  1002	            if persisted.status is ObservationStatus.OBSERVED:
  1003	                if persisted.artifact_id is None:
  1004	                    raise TopicObservationError("observed literature evidence has no artifact")
  1005	                try:
