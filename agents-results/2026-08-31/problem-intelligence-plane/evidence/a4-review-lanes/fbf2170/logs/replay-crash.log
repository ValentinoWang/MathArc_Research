  1009	    def _ensure_signing_key(self) -> None:
  1010	        if _path_present(self.signing_key_path):
  1011	            self._read_signing_key()
  1012	            return
  1013	        temporary_name: str | None = None
  1014	        try:
  1015	            fd, temporary_name = tempfile.mkstemp(
  1016	                prefix=".topic-observation-signing-key.",
  1017	                dir=self.root,
  1018	            )
  1019	            open_fd = fd
  1020	            try:
  1021	                os.fchmod(open_fd, _PRIVATE_FILE_MODE)
  1022	                with os.fdopen(open_fd, "wb") as temporary_file:
  1023	                    open_fd = -1
  1024	                    temporary_file.write(secrets.token_bytes(_SIGNING_KEY_BYTES))
  1025	                    temporary_file.flush()
  1026	                    os.fsync(temporary_file.fileno())
  1027	            finally:
  1028	                if open_fd != -1:
  1029	                    os.close(open_fd)
  1030	            try:
  1031	                os.link(temporary_name, self.signing_key_path)
  1032	            except FileExistsError:
  1033	                pass
  1034	            else:
  1035	                _fsync_directory(self.root)
  1036	        except OSError as exc:
  1037	            raise TopicObservationError("could not create topic observation signing key") from exc
  1038	        finally:
  1039	            if temporary_name is not None:
  1040	                try:
  1041	                    os.unlink(temporary_name)
  1042	                except FileNotFoundError:
  1043	                    pass
  1044	        self._read_signing_key()
