   914	    @staticmethod
   915	    def _record_manual_event(
   916	        state: dict[str, Any],
   917	        manual: ManualReviewItem,
   918	    ) -> None:
   919	        existing = {item["manual_id"] for item in state["manual_events"]}
   920	        if manual.manual_id not in existing:
   921	            state["manual_events"].append(
   922	                {
   923	                    "event_type": "CURSOR_CONFLICT",
   924	                    "manual_id": manual.manual_id,
   925	                }
   926	            )
   927	            state["manual_events"].sort(key=lambda item: item["manual_id"])
