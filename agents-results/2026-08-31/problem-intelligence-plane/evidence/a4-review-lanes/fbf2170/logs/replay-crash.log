        print(\"fresh_next_cursor=\", TopicObservationRunner(root, topic_id=\"cache-topic\", initial_cursor=\"c0\").next_cursor)
    except Exception as exc:
        print(\"fresh_reader=REJECTED\", type(exc).__name__, str(exc))
