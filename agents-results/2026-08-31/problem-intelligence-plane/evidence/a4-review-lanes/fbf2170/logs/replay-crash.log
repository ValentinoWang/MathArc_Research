from matharc.v02.literature_base import LiteratureBase
from matharc.v02.source_observation import LicenseStatus, new_observation
from matharc.v02.topic_observation import TopicObservationBatch, TopicObservationInput, TopicObservationRunner

def make(name: str) -> TopicObservationInput:
    content = f\"cached reader probe {name}\".encode()
    return TopicObservationInput(
        input_id=name,
        observation=new_observation(
            observation_id=f\"OBS-{name}\",
            canonical_uri=f\"https://cache.example/{name}\",
            pinned_version=\"v1\",
            license_status=LicenseStatus.OPEN,
            license_basis=\"probe\",
            content_summary=\"Descriptive probe metadata.\",
            summary_basis=\"probe\",
            media_type=\"text/plain\",
            content_digest_sha256=hashlib.sha256(content).hexdigest(),
            observed_at=\"2026-09-02T08:00:00+00:00\",
        ),
        content=content,
    )

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    writer = TopicObservationRunner(root, topic_id=\"cache-topic\", initial_cursor=\"c0\")
    writer.run(TopicObservationBatch(\"cache-topic\", \"c0\", \"c1\", (make(\"A\"),)))
    reader = TopicObservationRunner(root, topic_id=\"cache-topic\", initial_cursor=\"c0\")
    external = LiteratureBase(root / \"literature\")
