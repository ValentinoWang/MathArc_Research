+        runner.run(batch("c0", "c1", input_for("A")))
+        prior_state = runner.state_path.read_bytes()
+        prior_auth = runner.authentication_path.read_bytes()
+        real_write = topic_module._atomic_write_bytes
+
+        def fail_auth(path, content, mode):
