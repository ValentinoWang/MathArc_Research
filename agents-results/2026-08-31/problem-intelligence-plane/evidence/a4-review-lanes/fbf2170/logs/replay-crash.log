+                type(exc).__name__, exc
+            ))
+
+    with tempfile.TemporaryDirectory() as directory:
+        runner = TopicObservationRunner(directory, topic_id="integrity-topic", initial_cursor="c0")
+        runner.run(batch("c0", "c1", input_for("A")))
