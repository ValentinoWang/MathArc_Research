   874	    def _persisted_observation_for_input(
   875	        self,
   876	        item: TopicObservationInput,
   877	    ) -> SourceObservation | None:
   878	        candidates = [
   879	            observation
   880	            for observation in self.literature.observations
   881	            if observation.observation_id == item.observation.observation_id
   882	            or observation.idempotency_key == item.observation.idempotency_key
   883	        ]
   884	        if not candidates:
   885	            return None
   886	        status_order = {
   887	            ObservationStatus.OBSERVED: 0,
   888	            ObservationStatus.PENDING: 1,
   889	            ObservationStatus.CONFLICT: 2,
   890	            ObservationStatus.REJECTED: 3,
   891	        }
   892	        return min(
   893	            candidates,
   894	            key=lambda observation: (
   895	                status_order[observation.status],
   896	                observation.observation_id,
   897	            ),
   898	        )
