   990	    def _read_signing_key(self) -> bytes:
   991	        try:
   992	            metadata = self.signing_key_path.lstat()
   993	        except FileNotFoundError as exc:
   994	            raise TopicObservationError("topic observation signing key is missing") from exc
   995	        except OSError as exc:
   996	            raise TopicObservationError("topic observation signing key is unreadable") from exc
   997	        if not stat.S_ISREG(metadata.st_mode):
   998	            raise TopicObservationError("topic observation signing key is not a regular file")
   999	        if stat.S_IMODE(metadata.st_mode) != _PRIVATE_FILE_MODE:
  1000	            raise TopicObservationError("topic observation signing key must have mode 0600")
  1001	        try:
  1002	            key = self.signing_key_path.read_bytes()
  1003	        except OSError as exc:
  1004	            raise TopicObservationError("topic observation signing key is unreadable") from exc
  1005	        if len(key) != _SIGNING_KEY_BYTES:
  1006	            raise TopicObservationError("topic observation signing key is malformed")
  1007	        return key
