from pathlib import Path
from matharc.v02.source_observation import LicenseStatus, new_observation
from matharc.v02.topic_observation import TopicObservationBatch, TopicObservationInput, TopicObservationRunner, TopicObservationError

def make(observation_id: str, content: bytes) -> TopicObservationInput:
    return TopicObservationInput(
        input_id=\"input-B\",
        observation=new_observation(
            observation_id=observation_id,
            canonical_uri=\"https://same.example/paper\",
            pinned_version=\"v1\",
            license_status=LicenseStatus.OPEN,
            license_basis=\"probe\",
