   958	    @contextmanager
   959	    def _writer_lock(self) -> Iterator[None]:
   960	        self.lock_path.touch(exist_ok=True)
   961	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   962	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   963	            try:
   964	                yield
   965	            finally:
   966	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
