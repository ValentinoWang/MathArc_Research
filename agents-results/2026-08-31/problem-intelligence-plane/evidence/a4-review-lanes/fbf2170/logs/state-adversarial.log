   821	    def _item_evidence(
   822	        self,
   823	        item: TopicObservationInput,
   824	        result: TopicItemResult,
   825	        basis: str,
   826	        *,
   827	        persisted: SourceObservation | None = None,
   828	        manual_id: str | None = None,
   829	        manual_reason: ManualReviewReason | None = None,
   830	        import_disposition: ImportDisposition | None = None,
   831	        prior_cursor: str | None = None,
   832	        prior_input_id: str | None = None,
   833	    ) -> dict[str, Any]:
   834	        persisted_status = "ABSENT"
   835	        persisted_observation_id = None
   836	        persisted_content_digest = None
   837	        persisted_artifact_id = None
   838	        persisted_artifact_sha256 = None
   839	        if persisted is not None:
   840	            persisted_status = persisted.status.value
   841	            persisted_observation_id = persisted.observation_id
   842	            persisted_content_digest = persisted.content_digest_sha256
   843	            if persisted.status is ObservationStatus.OBSERVED:
   844	                if persisted.artifact_id is None:
   845	                    raise TopicObservationError("observed literature evidence has no artifact")
   846	                try:
   847	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
   848	                except KeyError as exc:
   849	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
   850	                persisted_artifact_id = artifact.artifact_id
   851	                persisted_artifact_sha256 = artifact.sha256
   852	        return {
   853	            "basis": basis,
   854	            "input_id": item.input_id,
   855	            "input_observation_id": item.observation.observation_id,
   856	            "input_idempotency_key": item.observation.idempotency_key,
   857	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   858	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   859	            "input_content_size_bytes": len(item.content),
   860	            "input_risk_flags": list(item.risk_flags),
   861	            "observation_id": result.observation_id,
   862	            "persisted_observation_id": persisted_observation_id,
   863	            "persisted_observation_status": persisted_status,
   864	            "persisted_content_digest_sha256": persisted_content_digest,
   865	            "persisted_artifact_id": persisted_artifact_id,
   866	            "persisted_artifact_sha256": persisted_artifact_sha256,
   867	            "manual_id": manual_id,
   868	            "manual_reason": manual_reason.value if manual_reason is not None else None,
   869	            "prior_cursor": prior_cursor,
   870	            "prior_input_id": prior_input_id,
   871	            "import_disposition": import_disposition.value if import_disposition is not None else None,
   872	        }
