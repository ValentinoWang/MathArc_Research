   460	@dataclass(frozen=True, slots=True)
   461	class SpawnRequest:
   462	    """A worker's declarative request for one governed child descriptor."""
   463	
   464	    request_id: str
   465	    brief: str
   466	    role: str
   467	    budget: float
   468	    depth: int = 1
   469	
   470	    def __post_init__(self) -> None:
   471	        if not isinstance(self.request_id, str) or not self.request_id.strip():
   472	            raise ValueError("spawn request_id must be non-empty")
   473	        if not isinstance(self.brief, str) or not self.brief.strip():
   474	            raise ValueError("spawn brief must be non-empty")
   475	        if not isinstance(self.role, str) or not self.role.strip():
   476	            raise ValueError("spawn role must be non-empty")
   477	        if isinstance(self.budget, bool) or not isinstance(self.budget, (int, float)):
   478	            raise ValueError("spawn budget must be a finite positive number")
   479	        budget = float(self.budget)
   480	        if not math.isfinite(budget) or budget <= 0.0:
   481	            raise ValueError("spawn budget must be a finite positive number")
   482	        if isinstance(self.depth, bool) or not isinstance(self.depth, int):
   483	            raise ValueError("spawn depth must be an integer")
   484	        if self.depth < 0:
   485	            raise ValueError("spawn depth cannot be negative")
   486	        object.__setattr__(self, "request_id", self.request_id.strip())
   487	        object.__setattr__(self, "brief", self.brief.strip())
   488	        object.__setattr__(self, "role", self.role.strip())
   489	        object.__setattr__(self, "budget", budget)
   490	
   491	    @property
   492	    def requested_budget(self) -> float:
   493	        return self.budget
   494	
   495	    def to_dict(self) -> dict[str, Any]:
   496	        return {
   497	            "request_id": self.request_id,
   498	            "brief": self.brief,
   499	            "role": self.role,
   500	            "budget": self.budget,
   501	            "depth": self.depth,
   502	        }
   503	
   504	    @classmethod
   505	    def from_dict(cls, payload: Mapping[str, Any]) -> "SpawnRequest":
   506	        if not isinstance(payload, Mapping):
   507	            raise ValueError("spawn request must be an object")
   508	        normalized = dict(payload)
   509	        if "spawn_id" in normalized:
   510	            if "request_id" in normalized:
   511	                raise ValueError("spawn request cannot provide both request_id and spawn_id")
   512	            normalized["request_id"] = normalized.pop("spawn_id")
   513	        if "requested_budget" in normalized:
   514	            if "budget" in normalized:
   515	                raise ValueError(
   516	                    "spawn request cannot provide both budget and requested_budget"
   517	                )
   518	            normalized["budget"] = normalized.pop("requested_budget")
   519	        _strict_payload(cls, normalized)
   520	        return cls(
   521	            request_id=normalized["request_id"],
   522	            brief=normalized["brief"],
   523	            role=normalized["role"],
   524	            budget=normalized["budget"],
   525	            depth=normalized.get("depth", 1),
   526	        )
   527	
