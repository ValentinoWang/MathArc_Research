from __future__ import annotations

import hashlib
import hmac
import json
import os
import tempfile
from pathlib import Path

from matharc.v02.literature_base import LiteratureBase
from matharc.v02.source_observation import LicenseStatus, new_observation
from matharc.v02.topic_observation import (
    TopicObservationBatch,
    TopicObservationError,
    TopicObservationInput,
    TopicObservationRunner,
    _state_authentication_message,
)


def item(label: str) -> TopicObservationInput:
    content = f\"probe-{label}\".encode()
    observation = new_observation(
        observation_id=f\"OBS-{label}\",
        canonical_uri=f\"https://probe.example/{label}\",
        pinned_version=\"v1\",
        observed_at=\"2026-09-02T08:00:00+00:00\",
        license_status=LicenseStatus.OPEN,
        license_basis=\"probe\",
        content_summary=\"Descriptive probe metadata.\",
        summary_basis=\"probe\",
        media_type=\"text/plain\",
        content_digest_sha256=hashlib.sha256(content).hexdigest(),
    )
    return TopicObservationInput(label, observation, content)


def batch(cursor: str, next_cursor: str, entry: TopicObservationInput) -> TopicObservationBatch:
    return TopicObservationBatch(\"probe-topic\", cursor, next_cursor, (entry,))


def error_for(callable_):
    try:
        value = callable_()
    except Exception as exc:
        return f\"{type(exc).__name__}:{exc}\"
    return f\"ACCEPTED:{value}\"

# Independently verify the exact state bytes and canonical snapshot bytes against the sidecar MAC.
with tempfile.TemporaryDirectory() as directory:
    runner = TopicObservationRunner(directory, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    state_bytes = runner.state_path.read_bytes()
    snapshot_bytes = runner._literature_snapshot_bytes()
    auth = json.loads(runner.authentication_path.read_text())
    exact_state = hashlib.sha256(state_bytes).hexdigest() == auth[\"state_sha256\"]
    exact_snapshot = hashlib.sha256(snapshot_bytes).hexdigest() == auth[\"literature_snapshot_sha256\"]
    exact_mac = hmac.compare_digest(
        hmac.new(runner.signing_key_path.read_bytes(), _state_authentication_message(state_bytes, snapshot_bytes), hashlib.sha256).hexdigest(),
        auth[\"mac_sha256\"],
    )
    print(f\"MAC_BINDING state={exact_state} snapshot={exact_snapshot} mac={exact_mac}\")

# Restore a prior valid state/auth/literature tuple without reading or using the key.
with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    paths = [
        root / \"topic-observation-state.json\",
        root / \".topic-observation-state.auth.json\",
        root / \"literature\" / \"observations.json\",
        root / \"literature\" / \"artifacts\" / \"manifest.json\",
    ]
    prior = {path: path.read_bytes() for path in paths}
    runner.run(batch(\"c1\", \"c2\", item(\"B\")))
    before = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\").next_cursor
    for path, content in prior.items():
        path.write_bytes(content)
    after = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\").next_cursor
    print(f\"ROLLBACK before={before} after={after} accepted={after == 'c1'} key_read_or_used=False\")

# A runner constructed before a legitimate concurrent LiteratureBase write validates a stale snapshot.
with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    owner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    owner.run(batch(\"c0\", \"c1\", item(\"A\")))
    stale = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    b = item(\"B\")
    external = LiteratureBase(root / \"literature\").import_bytes(b.observation, b.content)
    stale_result = error_for(lambda: stale.next_cursor)
    fresh_result = error_for(lambda: TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\").next_cursor)
    print(f\"STALE_SNAPSHOT external={external.disposition.value} stale={stale_result} fresh={fresh_result}\")

# Simulate interruption after LiteratureBase persistence but before state/auth persistence.
with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    def interrupted(_state):
        raise RuntimeError(\"simulated interruption before state save\")
    runner._save_state = interrupted
    interrupted_result = error_for(lambda: runner.run(batch(\"c1\", \"c2\", item(\"B\"))))
    restart_result = error_for(lambda: TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\").next_cursor)
    print(f\"INTERRUPTED_SAVE run={interrupted_result} restart={restart_result}\")

# State path is not subject to the key/auth regular-file and mode checks.
with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    backing = root / \"state.backing\"
    runner.state_path.rename(backing)
    runner.state_path.symlink_to(backing)
    print(f\"STATE_SYMLINK is_symlink={runner.state_path.is_symlink()} result={error_for(lambda: TopicObservationRunner(root, topic_id='probe-topic', initial_cursor='c0').next_cursor)}\")

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    os.chmod(runner.state_path, 0o666)
    print(f\"STATE_MODE mode={oct(runner.state_path.stat().st_mode & 0o777)} result={error_for(lambda: TopicObservationRunner(root, topic_id='probe-topic', initial_cursor='c0').next_cursor)}\")

for which in (\"authentication\", \"key\"):
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
        runner.run(batch(\"c0\", \"c1\", item(\"A\")))
        path = runner.authentication_path if which == \"authentication\" else runner.signing_key_path
        backing = path.with_name(path.name + \".backing\")
        path.rename(backing)
        path.symlink_to(backing)
        print(f\"{which.upper()}_SYMLINK result={error_for(lambda: TopicObservationRunner(root, topic_id='probe-topic', initial_cursor='c0').next_cursor)}\")

for which in (\"authentication\", \"key\"):
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
        runner.run(batch(\"c0\", \"c1\", item(\"A\")))
        path = runner.authentication_path if which == \"authentication\" else runner.signing_key_path
        os.chmod(path, 0o644)
        print(f\"{which.upper()}_MODE result={error_for(lambda: TopicObservationRunner(root, topic_id='probe-topic', initial_cursor='c0').next_cursor)}\")

# The explicitly excluded artifact created_at field can change without invalidating authentication.
with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    runner = TopicObservationRunner(root, topic_id=\"probe-topic\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    manifest = root / \"literature\" / \"artifacts\" / \"manifest.json\"
    payload = json.loads(manifest.read_text())
    payload[\"records\"][0][\"created_at\"] = \"1900-01-01T00:00:00+00:00\"
    manifest.write_text(json.dumps(payload))
    print(f\"CREATED_AT_MUTATION result={error_for(lambda: TopicObservationRunner(root, topic_id='probe-topic', initial_cursor='c0').next_cursor)}\")
