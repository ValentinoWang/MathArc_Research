   929	    def _add_manual(
   930	        self,
   931	        state: dict[str, Any],
   932	        *,
   933	        cursor: str,
   934	        input_id: str,
   935	        reason: ManualReviewReason,
   936	        detail: str,
   937	    ) -> ManualReviewItem:
   938	        manual = ManualReviewItem(
   939	            manual_id=_manual_id_for(
   940	                topic_id=self.topic_id,
   941	                cursor=cursor,
   942	                input_id=input_id,
   943	                reason=reason,
   944	                detail=detail,
   945	            ),
   946	            topic_id=self.topic_id,
   947	            cursor=cursor,
   948	            input_id=input_id,
   949	            reason=reason,
   950	            detail=detail,
   951	        )
   952	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
   953	        if manual.manual_id not in existing:
   954	            state["manual_queue"].append(manual.to_dict())
   955	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
   956	        return manual
