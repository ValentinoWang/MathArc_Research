from __future__ import annotations

import hashlib
import json
import multiprocessing as mp
import tempfile
from pathlib import Path

from matharc.v02.literature_base import LiteratureBase
from matharc.v02.source_observation import LicenseStatus, ObservationStatus, SourceObservation, new_observation

CONTENT = b\"same-key-concurrency\"
DIGEST = hashlib.sha256(CONTENT).hexdigest()


def observation(observation_id: str, *, license_status: LicenseStatus = LicenseStatus.OPEN, uri: str = \"https://probe.example/paper\", version: str = \"v1\"):
    return new_observation(
        observation_id=observation_id,
        canonical_uri=uri,
        pinned_version=version,
        observed_at=\"2026-09-02T08:00:00+00:00\",
        license_status=license_status,
        license_basis=\"probe\",
        content_summary=\"Descriptive probe metadata.\",
        summary_basis=\"probe\",
        media_type=\"text/plain\",
        content_digest_sha256=DIGEST,
    )


def worker(root: str, observation_id: str, barrier, queue) -> None:
    base = LiteratureBase(root)
    barrier.wait()
    result = base.import_bytes(observation(observation_id), CONTENT)
    queue.put((observation_id, result.disposition.value, result.observation.observation_id))

with tempfile.TemporaryDirectory() as directory:
    base = LiteratureBase(directory)
    first = base.import_bytes(observation(\"OBS-A\"), CONTENT)
    replay = base.import_bytes(observation(\"OBS-B\"), CONTENT)
    print(f\"OBSERVED_IMPORT first={first.disposition.value} alternate={replay.disposition.value} returned={replay.observation.observation_id} persisted={[item.observation_id for item in LiteratureBase(directory).observations]}\")

with tempfile.TemporaryDirectory() as directory:
    base = LiteratureBase(directory)
    pending_a = observation(\"OBS-A\", license_status=LicenseStatus.RESTRICTED)
    pending_b = observation(\"OBS-B\", license_status=LicenseStatus.RESTRICTED)
    first = base.import_bytes(pending_a, CONTENT)
    second = base.import_bytes(pending_b, CONTENT)
    print(f\"PENDING_IMPORT first={first.disposition.value} alternate={second.disposition.value} persisted={[item.observation_id for item in LiteratureBase(directory).observations]}\")

with tempfile.TemporaryDirectory() as directory:
    base = LiteratureBase(directory)
    base.import_bytes(observation(\"OBS-A\"), CONTENT)
    manifest = Path(directory) / \"observations.json\"
    payload = json.loads(manifest.read_text())
    duplicate = dict(payload[\"observations\"][0])
    duplicate[\"observation_id\"] = \"OBS-C\"
    payload[\"observations\"].append(duplicate)
    manifest.write_text(json.dumps(payload))
    try:
        LiteratureBase(directory)
    except Exception as exc:
        print(f\"RELOAD_DUPLICATE rejected={type(exc).__name__}:{exc}\")
    else:
        print(\"RELOAD_DUPLICATE accepted\")

ctx = mp.get_context(\"fork\")
with tempfile.TemporaryDirectory() as directory:
    barrier = ctx.Barrier(2)
    queue = ctx.Queue()
    processes = [ctx.Process(target=worker, args=(directory, oid, barrier, queue)) for oid in (\"OBS-A\", \"OBS-B\")]
    for process in processes:
        process.start()
    results = [queue.get(timeout=10) for _ in processes]
    for process in processes:
        process.join(10)
    restored = LiteratureBase(directory)
    print(f\"CONCURRENT_OBSERVED results={sorted(results)} exits={[process.exitcode for process in processes]} persisted={[item.observation_id for item in restored.observations]} keys={len({item.idempotency_key for item in restored.observations})}\")

# Valid case-sensitive URI paths collapse because logical_identity lowercases the full URI.
with tempfile.TemporaryDirectory() as directory:
    upper = observation(\"OBS-UPPER\", uri=\"https://probe.example/Paper\")
    lower = observation(\"OBS-LOWER\", uri=\"https://probe.example/paper\")
    base = LiteratureBase(directory)
    first = base.import_bytes(upper, CONTENT)
    second = base.import_bytes(lower, CONTENT)
    print(f\"URI_CASE_COLLISION identities_equal={upper.logical_identity == lower.logical_identity} keys_equal={upper.idempotency_key == lower.idempotency_key} first={first.disposition.value} second={second.disposition.value} returned={second.observation.observation_id}\")

# The unescaped identity delimiter also admits two field tuples with one key.
with tempfile.TemporaryDirectory() as directory:
    left = observation(\"OBS-LEFT\", uri=\"https://probe.example/a|b\", version=\"c\")
    right = observation(\"OBS-RIGHT\", uri=\"https://probe.example/a\", version=\"b|c\")
    base = LiteratureBase(directory)
    first = base.import_bytes(left, CONTENT)
    second = base.import_bytes(right, CONTENT)
    print(f\"DELIMITER_COLLISION identities_equal={left.logical_identity == right.logical_identity} keys_equal={left.idempotency_key == right.idempotency_key} first={first.disposition.value} second={second.disposition.value} returned={second.observation.observation_id}\")
