   140	@dataclass(frozen=True, slots=True)
   141	class TopicObservationBatch:
   142	    """A one-topic, explicitly cursor-bounded batch of source candidates."""
   143	
   144	    topic_id: str
   145	    cursor: str
   146	    next_cursor: str
   147	    inputs: tuple[TopicObservationInput, ...]
   148	    schema_version: str = _SCHEMA_VERSION
   149	
   150	    def __post_init__(self) -> None:
   151	        _require_nonempty(self.topic_id, "topic_id")
   152	        _require_nonempty(self.cursor, "cursor")
   153	        _require_nonempty(self.next_cursor, "next_cursor")
   154	        if self.cursor == self.next_cursor:
   155	            raise TopicObservationError("next_cursor must advance beyond cursor")
   156	        if not isinstance(self.inputs, tuple) or not self.inputs:
   157	            raise TopicObservationError("inputs must be a non-empty tuple")
   158	        if any(not isinstance(item, TopicObservationInput) for item in self.inputs):
   159	            raise TypeError("inputs must contain TopicObservationInput records")
   160	        identifiers = tuple(item.input_id for item in self.inputs)
   161	        if len(identifiers) != len(set(identifiers)) or tuple(sorted(identifiers)) != identifiers:
   162	            raise TopicObservationError("input ids must be sorted and unique")
   163	        if self.schema_version != _SCHEMA_VERSION:
   164	            raise TopicObservationError("unsupported topic-observation batch schema_version")
   165	
   166	    @property
   167	    def batch_digest_sha256(self) -> str:
   168	        return _batch_digest_from_fingerprints(
   169	            topic_id=self.topic_id,
   170	            cursor=self.cursor,
   171	            next_cursor=self.next_cursor,
   172	            input_fingerprints={
   173	                item.input_id: item.fingerprint_sha256 for item in self.inputs
   174	            },
   175	        )
