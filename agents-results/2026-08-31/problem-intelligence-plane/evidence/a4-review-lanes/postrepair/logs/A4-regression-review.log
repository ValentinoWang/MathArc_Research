   304	class TopicObservationRunner:
   305	    """Durably process one topic without granting status or proof authority."""
   306	
   307	    def __init__(
   308	        self,
   309	        root: str | Path,
   310	        *,
   311	        topic_id: str,
   312	        initial_cursor: str,
   313	        budget: BudgetLedger | None = None,
   314	    ) -> None:
   315	        self.root = Path(root)
   316	        self.root.mkdir(parents=True, exist_ok=True)
   317	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   318	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   319	        if budget is not None and not isinstance(budget, BudgetLedger):
   320	            raise TypeError("budget must be a BudgetLedger or None")
   321	        self.budget = budget
   322	        self.state_path = self.root / "topic-observation-state.json"
   323	        self.lock_path = self.root / ".topic-observation.lock"
   324	        self.literature = LiteratureBase(self.root / "literature", budget=budget)
   325	
   326	    @property
   327	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   328	        state = self._load_state()
   329	        return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   330	
   331	    @property
   332	    def next_cursor(self) -> str:
   333	        return self._load_state()["next_cursor"]
   334	
   335	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   336	        if not isinstance(batch, TopicObservationBatch):
   337	            raise TypeError("batch must be a TopicObservationBatch")
   338	        if batch.topic_id != self.topic_id:
   339	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   340	        with self._writer_lock():
   341	            state = self._load_state()
   342	            self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
   343	            batches = state["batches"]
   344	            previous = batches.get(batch.cursor)
   345	            if previous is not None:
   346	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   347	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   348	                manual = self._add_manual(
   349	                    state,
   350	                    cursor=batch.cursor,
   351	                    input_id="cursor",
   352	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   353	                    detail="A cursor was replayed with different batch content.",
   354	                )
   355	                self._save_state(state)
   356	                return TopicBatchResult(
   357	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   358	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   359	                )
   360	            if batch.cursor != state["next_cursor"]:
   361	                manual = self._add_manual(
   362	                    state,
   363	                    cursor=batch.cursor,
   364	                    input_id="cursor",
   365	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   366	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   367	                )
   368	                self._save_state(state)
   369	                return TopicBatchResult(
   370	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   371	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   372	                )
   373	
   374	            results: list[TopicItemResult] = []
   375	            for item in batch.inputs:
   376	                results.append(self._process_input(state, batch, item))
   377	            status = TopicRunStatus.MANUAL_REVIEW if any(
   378	                item.status is TopicItemStatus.MANUAL_REVIEW for item in results
   379	            ) else TopicRunStatus.APPLIED
   380	            result = TopicBatchResult(self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results))
   381	            batches[batch.cursor] = {
   382	                "batch_digest_sha256": batch.batch_digest_sha256,
   383	                "result_digest_sha256": digest_json(result.to_dict()),
   384	                "input_fingerprints": {
   385	                    item.input_id: item.fingerprint_sha256 for item in batch.inputs
   386	                },
   387	                "input_observation_ids": {
   388	                    item.input_id: item.observation_id for item in results
   389	                },
   390	                "result": result.to_dict(),
   391	            }
   392	            state["next_cursor"] = batch.next_cursor
   393	            self._save_state(state)
   394	            return result
   395	
   396	    def _process_input(
   397	        self,
   398	        state: dict[str, Any],
   399	        batch: TopicObservationBatch,
   400	        item: TopicObservationInput,
   401	    ) -> TopicItemResult:
   402	        prior = state["processed_input_ids"].get(item.input_id)
   403	        if prior is not None:
   404	            if prior == item.fingerprint_sha256:
   405	                return TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   406	            manual = self._add_manual(
   407	                state, cursor=batch.cursor, input_id=item.input_id,
   408	                reason=ManualReviewReason.INPUT_ID_CONFLICT,
   409	                detail="An input_id was reused with different source-observation content.",
   410	            )
   411	            return TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   412	        if item.is_high_risk:
   413	            manual = self._add_manual(
   414	                state, cursor=batch.cursor, input_id=item.input_id,
   415	                reason=ManualReviewReason.HIGH_RISK_EVENT,
   416	                detail="High-risk flags require human review: " + ", ".join(item.risk_flags),
   417	            )
   418	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   419	            return TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   420	        if self.budget is not None and self.budget.exhausted():
   421	            manual = self._add_manual(
   422	                state, cursor=batch.cursor, input_id=item.input_id,
   423	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   424	                detail="The configured import budget is exhausted before topic observation.",
   425	            )
   426	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   427	            return TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   428	        if item.observation.idempotency_key in state["seen_observation_keys"]:
   429	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   430	            return TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   431	
   432	        imported = self.literature.import_bytes(item.observation, item.content)
   433	        if imported.disposition in {ImportDisposition.IMPORTED, ImportDisposition.IDEMPOTENT}:
   434	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   435	            state["seen_observation_keys"].append(item.observation.idempotency_key)
   436	            state["seen_observation_keys"].sort()
   437	            status = TopicItemStatus.IMPORTED if imported.disposition is ImportDisposition.IMPORTED else TopicItemStatus.IDEMPOTENT
   438	            return TopicItemResult(item.input_id, status, imported.observation.observation_id)
   439	        if imported.disposition is ImportDisposition.CONFLICT or imported.observation.status is ObservationStatus.CONFLICT:
   440	            manual = self._add_manual(
   441	                state,
   442	                cursor=batch.cursor,
   443	                input_id=item.input_id,
   444	                reason=ManualReviewReason.LITERATURE_CONFLICT,
   445	                detail=f"Literature import conflict: {imported.reason or 'unspecified conflict outcome'}",
   446	            )
   447	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   448	            return TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   449	        if imported.disposition is ImportDisposition.REJECTED or imported.reason.startswith("artifact persistence failed:"):
   450	            manual = self._add_manual(
   451	                state,
   452	                cursor=batch.cursor,
   453	                input_id=item.input_id,
   454	                reason=ManualReviewReason.LITERATURE_IMPORT_FAILURE,
   455	                detail=f"Literature import failure: {imported.reason or 'unspecified rejected outcome'}",
   456	            )
   457	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   458	            return TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   459	        if self.budget is not None and self.budget.exhausted():
   460	            manual = self._add_manual(
   461	                state, cursor=batch.cursor, input_id=item.input_id,
   462	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   463	                detail="The literature base stopped import because the configured budget is exhausted.",
   464	            )
   465	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   466	            return TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   467	        state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   468	        return TopicItemResult(item.input_id, TopicItemStatus.PENDING, imported.observation.observation_id)
   469	
   470	    def _add_manual(
   471	        self,
   472	        state: dict[str, Any],
   473	        *,
   474	        cursor: str,
   475	        input_id: str,
   476	        reason: ManualReviewReason,
   477	        detail: str,
   478	    ) -> ManualReviewItem:
   479	        identity = f"{self.topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
   480	        manual = ManualReviewItem(
   481	            manual_id="manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24],
   482	            topic_id=self.topic_id,
   483	            cursor=cursor,
   484	            input_id=input_id,
   485	            reason=reason,
   486	            detail=detail,
   487	        )
   488	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
   489	        if manual.manual_id not in existing:
   490	            state["manual_queue"].append(manual.to_dict())
   491	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
   492	        return manual
   493	
   494	    @contextmanager
   495	    def _writer_lock(self) -> Iterator[None]:
   496	        self.lock_path.touch(exist_ok=True)
   497	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   498	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   499	            try:
   500	                yield
   501	            finally:
   502	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
   503	
   504	    def _new_state(self) -> dict[str, Any]:
   505	        return {
   506	            "schema_version": _STATE_SCHEMA_VERSION,
   507	            "topic_id": self.topic_id,
   508	            "next_cursor": self.initial_cursor,
   509	            "batches": {},
   510	            "processed_input_ids": {},
   511	            "seen_observation_keys": [],
   512	            "manual_queue": [],
   513	        }
   514	
   515	    def _load_state(self) -> dict[str, Any]:
   516	        if not self.state_path.exists():
   517	            return self._new_state()
   518	        try:
   519	            payload = json.loads(self.state_path.read_text(encoding="utf-8"))
   520	        except (OSError, json.JSONDecodeError) as exc:
   521	            raise TopicObservationError("topic observation state is unreadable") from exc
   522	        if not isinstance(payload, dict):
   523	            raise TopicObservationError("topic observation state must be an object")
   524	        expected = {"schema_version", "topic_id", "next_cursor", "batches", "processed_input_ids", "seen_observation_keys", "manual_queue"}
   525	        _require_fields(payload, expected, "topic-observation-state")
   526	        if payload["schema_version"] != _STATE_SCHEMA_VERSION or payload["topic_id"] != self.topic_id:
   527	            raise TopicObservationError("topic observation state does not match runner")
   528	        if not isinstance(payload["next_cursor"], str) or not payload["next_cursor"]:
   529	            raise TopicObservationError("topic observation state has invalid next_cursor")
   530	        if not isinstance(payload["batches"], dict) or not isinstance(payload["processed_input_ids"], dict):
   531	            raise TopicObservationError("topic observation state has invalid mappings")
   532	        if not isinstance(payload["seen_observation_keys"], list) or not isinstance(payload["manual_queue"], list):
   533	            raise TopicObservationError("topic observation state has invalid collections")
   534	        if payload["seen_observation_keys"] != sorted(set(payload["seen_observation_keys"])):
   535	            raise TopicObservationError("seen_observation_keys must be sorted and unique")
   536	        for input_id, fingerprint in payload["processed_input_ids"].items():
   537	            _require_nonempty(input_id, "processed input id")
   538	            _require_sha256(fingerprint, "processed input fingerprint")
   539	
   540	        validated_batches: dict[str, TopicBatchResult] = {}
   541	        batch_input_ids: set[str] = set()
   542	        for cursor, stored in payload["batches"].items():
   543	            _require_nonempty(cursor, "stored cursor")
   544	            if not isinstance(stored, dict) or set(stored) != {
   545	                "batch_digest_sha256",
   546	                "result_digest_sha256",
   547	                "input_fingerprints",
   548	                "input_observation_ids",
   549	                "result",
   550	            }:
   551	                raise TopicObservationError("stored batch is malformed")
   552	            _require_sha256(stored["batch_digest_sha256"], "stored batch digest")
   553	            _require_sha256(stored["result_digest_sha256"], "stored batch result digest")
   554	            input_fingerprints = stored["input_fingerprints"]
   555	            if not isinstance(input_fingerprints, dict) or not input_fingerprints:
   556	                raise TopicObservationError("stored batch input fingerprints are malformed")
   557	            for input_id, fingerprint in input_fingerprints.items():
   558	                _require_nonempty(input_id, "stored batch input id")
   559	                _require_sha256(fingerprint, "stored batch input fingerprint")
   560	            input_observation_ids = stored["input_observation_ids"]
   561	            if not isinstance(input_observation_ids, dict) or set(input_observation_ids) != set(input_fingerprints):
   562	                raise TopicObservationError("stored batch input observations are malformed")
   563	            for input_id, observation_id in input_observation_ids.items():
   564	                _require_nonempty(input_id, "stored batch observation input id")
   565	                _require_nonempty(observation_id, "stored batch observation id")
   566	            if not isinstance(stored["result"], dict):
   567	                raise TopicObservationError("stored batch result is malformed")
   568	            if stored["result_digest_sha256"] != digest_json(stored["result"]):
   569	                raise TopicObservationError("stored batch result digest mismatch")
   570	            result = TopicBatchResult.from_dict(stored["result"])
   571	            if result.replayed:
   572	                raise TopicObservationError("stored batch result cannot be marked replayed")
   573	            if result.topic_id != payload["topic_id"]:
   574	                raise TopicObservationError("stored batch result topic_id conflicts with state")
   575	            if result.cursor != cursor:
   576	                raise TopicObservationError("stored batch result cursor conflicts with state")
   577	            if result.cursor == result.next_cursor:
   578	                raise TopicObservationError("stored batch result must advance its cursor")
   579	            result_input_ids = tuple(item.input_id for item in result.item_results)
   580	            expected_input_ids = tuple(sorted(input_fingerprints))
   581	            if result_input_ids != expected_input_ids:
   582	                raise TopicObservationError("stored batch result items do not match batch inputs")
   583	            if any(
   584	                item.observation_id != input_observation_ids[item.input_id]
   585	                for item in result.item_results
   586	            ):
   587	                raise TopicObservationError("stored batch result observations do not match batch inputs")
   588	            for input_id, fingerprint in input_fingerprints.items():
   589	                persisted_fingerprint = payload["processed_input_ids"].get(input_id)
   590	                if persisted_fingerprint is None:
