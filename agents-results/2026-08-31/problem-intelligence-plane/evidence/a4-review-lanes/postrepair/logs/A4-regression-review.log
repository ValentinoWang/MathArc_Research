   102	@dataclass(frozen=True, slots=True)
   103	class TopicObservationInput:
   104	    """One bounded source candidate supplied by a topic synchronization run."""
   105	
   106	    input_id: str
   107	    observation: SourceObservation
   108	    content: bytes
   109	    risk_flags: tuple[str, ...] = ()
   110	
   111	    def __post_init__(self) -> None:
   112	        _require_nonempty(self.input_id, "input_id")
   113	        if not isinstance(self.observation, SourceObservation):
   114	            raise TypeError("observation must be a SourceObservation")
   115	        if not isinstance(self.content, bytes):
   116	            raise TypeError("content must be bytes")
   117	        if not isinstance(self.risk_flags, tuple):
   118	            raise TypeError("risk_flags must be a tuple")
   119	        if any(not isinstance(flag, str) or not flag.strip() for flag in self.risk_flags):
   120	            raise TopicObservationError("risk_flags must contain non-empty strings")
   121	        if tuple(sorted(self.risk_flags)) != self.risk_flags or len(set(self.risk_flags)) != len(self.risk_flags):
   122	            raise TopicObservationError("risk_flags must be sorted and unique")
   123	
   124	    @property
   125	    def fingerprint_sha256(self) -> str:
   126	        return digest_json(
   127	            {
   128	                "input_id": self.input_id,
   129	                "observation": self.observation.to_dict(),
   130	                "content_sha256": hashlib.sha256(self.content).hexdigest(),
   131	                "risk_flags": list(self.risk_flags),
   132	            }
   133	        )
   134	
   135	    @property
   136	    def is_high_risk(self) -> bool:
   137	        return bool(self.risk_flags)
