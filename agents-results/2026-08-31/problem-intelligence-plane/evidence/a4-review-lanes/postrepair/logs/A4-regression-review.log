    65	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
    66	    unknown = set(payload) - expected
    67	    missing = expected - set(payload)
    68	    if unknown:
    69	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
    70	    if missing:
    71	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
    72	
    73	
    74	def _require_sha256(value: object, name: str) -> str:
    75	    if (
    76	        not isinstance(value, str)
    77	        or len(value) != 64
    78	        or any(character not in "0123456789abcdef" for character in value)
    79	    ):
    80	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
    81	    return value
