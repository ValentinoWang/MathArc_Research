   233	    def _assert_contract_results(self, result: Mapping[str, Any]) -> None:
   234	        cases = {case["problem_id"]: case for case in result["cases"]}
   235	        for expected in self.contract["cases"]:
   236	            actual = cases.get(expected["problem_id"])
   237	            if actual is None:
   238	                raise DogfoodArchiveError("persisted result is missing a contract case")
   239	            checks = {
   240	                "case_role": expected["case_role"],
   241	                "topic_status": expected["expected_topic_status"],
   242	                "promotion_allowed": expected["expected_promotion_allowed"],
   243	                "manual_reason": expected["expected_manual_reason"],
   244	            }
   245	            for field, value in checks.items():
   246	                if actual.get(field) != value:
   247	                    raise DogfoodArchiveError(f"contract expected {field}={value!r}, got {actual.get(field)!r}")
   248	            if actual["status"]["reported_status"] != expected["expected_problem_status"]:
   249	                raise DogfoodArchiveError("contract expected problem status drift")
   250	            novelty_status = actual["novelty"]["authorization_status"] if actual["novelty"] else None
   251	            if novelty_status != expected["expected_novelty_status"]:
   252	                raise DogfoodArchiveError("contract expected novelty status drift")
