   190	        _require_nonempty(self.cursor, "cursor")
   191	        _require_nonempty(self.input_id, "input_id")
   192	        if not isinstance(self.reason, ManualReviewReason):
   193	            raise TypeError("reason must be a ManualReviewReason")
   194	        _require_nonempty(self.detail, "detail")
   195	
   196	    def to_dict(self) -> dict[str, str]:
   197	        return {
   198	            "manual_id": self.manual_id,
   199	            "topic_id": self.topic_id,
   200	            "cursor": self.cursor,
   201	            "input_id": self.input_id,
   202	            "reason": self.reason.value,
   203	            "detail": self.detail,
   204	        }
   205	
   206	    @classmethod
   207	    def from_dict(cls, payload: Mapping[str, Any]) -> "ManualReviewItem":
   208	        expected = {"manual_id", "topic_id", "cursor", "input_id", "reason", "detail"}
