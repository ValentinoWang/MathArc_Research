    65	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
    66	    unknown = set(payload) - expected
    67	    missing = expected - set(payload)
    68	    if unknown:
    69	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
    70	    if missing:
    71	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
