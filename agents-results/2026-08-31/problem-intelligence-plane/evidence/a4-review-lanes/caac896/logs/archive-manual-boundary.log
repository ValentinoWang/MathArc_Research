   900	    def _new_state(self) -> dict[str, Any]:
   901	        return {
   902	            "schema_version": _STATE_SCHEMA_VERSION,
   903	            "recovery_contract": _STATE_RECOVERY_CONTRACT,
   904	            "topic_id": self.topic_id,
   905	            "next_cursor": self.initial_cursor,
   906	            "batches": {},
   907	            "processed_input_ids": {},
   908	            "seen_observation_keys": [],
   909	            "manual_queue": [],
   910	            "manual_events": [],
