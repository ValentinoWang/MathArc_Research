   890	    @contextmanager
   891	    def _writer_lock(self) -> Iterator[None]:
   892	        self.lock_path.touch(exist_ok=True)
   893	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   894	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   895	            try:
   896	                yield
   897	            finally:
   898	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
