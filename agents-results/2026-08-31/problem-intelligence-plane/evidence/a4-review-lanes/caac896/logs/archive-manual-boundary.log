   913	    def _load_state(self) -> dict[str, Any]:
   914	        if not self.state_path.exists():
   915	            return self._new_state()
   916	        try:
   917	            payload = json.loads(self.state_path.read_text(encoding="utf-8"))
   918	        except (OSError, json.JSONDecodeError) as exc:
   919	            raise TopicObservationError("topic observation state is unreadable") from exc
   920	        if not isinstance(payload, dict):
   921	            raise TopicObservationError("topic observation state must be an object")
   922	        schema_version = payload.get("schema_version")
   923	        if schema_version in _LEGACY_STATE_SCHEMA_VERSIONS:
   924	            raise TopicObservationError(
   925	                f"topic observation state schema_version {schema_version!r} is legacy; "
   926	                f"recovery contract {_STATE_RECOVERY_CONTRACT!r} requires preserving the "
   927	                "legacy state and replaying its authoritative source batches into a new "
   928	                "state root"
   929	            )
   930	        if schema_version != _STATE_SCHEMA_VERSION:
   931	            raise TopicObservationError(
   932	                f"unsupported topic observation state schema_version {schema_version!r}; "
   933	                f"recovery contract {_STATE_RECOVERY_CONTRACT!r} requires an explicit "
   934	                "operator migration"
   935	            )
   936	        expected = {
   937	            "schema_version",
   938	            "recovery_contract",
   939	            "topic_id",
   940	            "next_cursor",
   941	            "batches",
   942	            "processed_input_ids",
   943	            "seen_observation_keys",
   944	            "manual_queue",
   945	            "manual_events",
   946	        }
   947	        _require_fields(payload, expected, "topic-observation-state")
   948	        if payload["recovery_contract"] != _STATE_RECOVERY_CONTRACT:
   949	            raise TopicObservationError(
   950	                "topic observation state recovery contract does not match the current "
   951	                "state schema"
   952	            )
   953	        if payload["topic_id"] != self.topic_id:
   954	            raise TopicObservationError("topic observation state does not match runner")
   955	        if not isinstance(payload["next_cursor"], str) or not payload["next_cursor"]:
   956	            raise TopicObservationError("topic observation state has invalid next_cursor")
   957	        if not isinstance(payload["batches"], dict) or not isinstance(payload["processed_input_ids"], dict):
   958	            raise TopicObservationError("topic observation state has invalid mappings")
   959	        if not isinstance(payload["seen_observation_keys"], list):
   960	            raise TopicObservationError("topic observation state has invalid collections")
