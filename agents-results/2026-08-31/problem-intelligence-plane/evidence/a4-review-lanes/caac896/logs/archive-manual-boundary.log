T2 = ROOT / 'agents-results/2026-08-31/problem-intelligence-plane/evidence/t2-fixtures/three-real-archives.json'

results = []

def record(name, passed, detail):
    results.append((name, passed, detail))

# 1. Try to convert a normal high-risk batch item/manual into CURSOR_CONFLICT,
# updating all directly linked IDs and the result digest.
with tempfile.TemporaryDirectory() as directory:
    runner = TopicObservationRunner(directory, topic_id='union-closed', initial_cursor='c0')
    runner.run(batch('c0', 'c1', input_for('A', risk_flags=('possible-resolution',))))
    path = Path(directory) / 'topic-observation-state.json'
    state = json.loads(path.read_text(encoding='utf-8'))
    entry = state['manual_queue'][0]
    entry['reason'] = ManualReviewReason.CURSOR_CONFLICT.value
    entry['detail'] = 'A cursor was replayed with different batch content.'
    identity = '|'.join(entry[k] for k in ('topic_id', 'cursor', 'input_id', 'reason', 'detail'))
    entry['manual_id'] = 'manual-' + hashlib.sha256(identity.encode()).hexdigest()[:24]
    stored = state['batches']['c0']
    stored['result']['item_results'][0]['manual_id'] = entry['manual_id']
    stored['disposition_evidence']['A']['manual_id'] = entry['manual_id']
    stored['disposition_evidence']['A']['manual_reason'] = entry['reason']
    stored['result_digest_sha256'] = digest_json(stored['result'])
    path.write_text(json.dumps(state), encoding='utf-8')
    try:
        TopicObservationRunner(directory, topic_id='union-closed', initial_cursor='c0').next_cursor
        record('cursor_conflict_attached_to_batch', False, 'accepted forged batch attachment')
    except ManualQueueObservationError as exc:
        record('cursor_conflict_attached_to_batch', 'cannot be attached' in str(exc), f'{type(exc).__name__}: {exc}')

# 2. Rewrite the first successful batch so two different input IDs claim the same
# successful observation key, coherently updating all local digests.
with tempfile.TemporaryDirectory() as directory:
    runner = TopicObservationRunner(directory, topic_id='union-closed', initial_cursor='c0')
    runner.run(batch('c0', 'c1', input_for('A')))
    runner.run(batch('c1', 'c2', input_for('B')))
    path = Path(directory) / 'topic-observation-state.json'
    state = json.loads(path.read_text(encoding='utf-8'))
    a = state['batches']['c0']
    b = state['batches']['c1']
    source_b = input_for('B')
    swapped = TopicObservationInput('A', source_b.observation, source_b.content)
    a['input_projections']['A'] = swapped.input_projection
    a['input_fingerprints']['A'] = swapped.fingerprint_sha256
    a['input_observation_ids']['A'] = source_b.observation.observation_id
    evidence = dict(b['disposition_evidence']['B'])
    evidence['input_id'] = 'A'
    a['disposition_evidence']['A'] = evidence
    a['result']['item_results'][0]['observation_id'] = source_b.observation.observation_id
    state['processed_input_ids']['A'] = swapped.fingerprint_sha256
    state['seen_observation_keys'] = [evidence['input_idempotency_key']]
    a['batch_digest_sha256'] = batch('c0', 'c1', swapped).batch_digest_sha256
    a['input_projection_digest_sha256'] = _input_projection_digest(
        topic_id='union-closed', cursor='c0', next_cursor='c1',
        batch_digest_sha256=a['batch_digest_sha256'], input_projections=a['input_projections'])
    evidence['input_projection_binding_sha256'] = _input_projection_binding_digest(
        topic_id='union-closed', cursor='c0', next_cursor='c1',
        batch_digest_sha256=a['batch_digest_sha256'], input_projection=swapped.input_projection)
    a['result_digest_sha256'] = digest_json(a['result'])
    path.write_text(json.dumps(state), encoding='utf-8')
    try:
        TopicObservationRunner(directory, topic_id='union-closed', initial_cursor='c0').next_cursor
        record('successful_observation_key_reuse', False, 'accepted repeated successful observation key')
    except TopicObservationError as exc:
        record('successful_observation_key_reuse', 'successful import repeats' in str(exc), f'{type(exc).__name__}: {exc}')

# 3. Make an archived manual result look imported while recomputing its batch result digest.
with tempfile.TemporaryDirectory() as directory:
    DogfoodArchiveRunner(directory, S1).run()
    path = Path(directory) / 'topic-observation' / 'topic-observation-state.json'
    state = json.loads(path.read_text(encoding='utf-8'))
    stored = state['batches']['dogfood-c2']
    stored['result']['item_results'][0]['status'] = TopicItemStatus.IMPORTED.value
    stored['result']['item_results'][0]['manual_id'] = None
    stored['result']['status'] = TopicRunStatus.APPLIED.value
    stored['result_digest_sha256'] = digest_json(stored['result'])
    path.write_text(json.dumps(state), encoding='utf-8')
    try:
        DogfoodArchiveRunner(directory, S1).run()
        record('archive_manual_result_binding', False, 'accepted forged imported manual result')
    except DogfoodArchiveError as exc:
        record('archive_manual_result_binding', 'state is missing or invalid' in str(exc), f'{type(exc).__name__}: {exc}')

# 4. Verify clean result boundary and attempt a contract-level public-claim rewrite.
with tempfile.TemporaryDirectory() as directory:
    clean_root = Path(directory) / 'clean'
    result = DogfoodArchiveRunner(clean_root, S1).run()
    clean_ok = (
        result['no_claim_or_trace_created'] is True
        and all(case['promotion_allowed'] is False for case in result['cases'])
        and all(case['claim_created'] is False and case['trace_created'] is False for case in result['cases'])
        and not (clean_root / 'claims.json').exists()
        and not (clean_root / 'research-trace.json').exists()
    )
    fixture_root = Path(directory) / 's1-fixtures'
    fixture_root.mkdir()
    for source in S1.glob('*.json'):
        shutil.copy2(source, fixture_root / source.name)
    contract_root = Path(directory) / 't2-fixtures'
    contract_root.mkdir()
    contract = json.loads(T2.read_text(encoding='utf-8'))
    contract['non_claim_boundary'] = 'authorizes public mathematical claims'
    (contract_root / T2.name).write_text(json.dumps(contract), encoding='utf-8')
    shutil.copytree(T2.parent / 'sources', contract_root / 'sources')
    try:
        DogfoodArchiveRunner(Path(directory) / 'forged', fixture_root).run()
        record('offline_nonproof_nonpublic_boundary', False, 'accepted rewritten public-claim boundary')
    except DogfoodArchiveError as exc:
        record('offline_nonproof_nonpublic_boundary', clean_ok and 'non-claim boundary identity drift' in str(exc), f'clean_boundary={clean_ok}; {type(exc).__name__}: {exc}')

for name, passed, detail in results:
    print(f'{name}: {\"PASS\" if passed else \"FAIL\"} | {detail}')
if not all(passed for _, passed, _ in results):
    raise SystemExit(1)
