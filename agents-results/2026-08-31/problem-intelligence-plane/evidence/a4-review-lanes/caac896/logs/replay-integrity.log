   110	
   111	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   112	    unknown = set(payload) - expected
   113	    missing = expected - set(payload)
   114	    if unknown:
   115	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   116	    if missing:
   117	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   118	
   119	
   120	def _require_sha256(value: object, name: str) -> str:
   121	    if (
   122	        not isinstance(value, str)
   123	        or len(value) != 64
   124	        or any(character not in "0123456789abcdef" for character in value)
   125	    ):
   126	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   127	    return value
   128	
   129	
   130	def _require_sha256_or_empty(value: object, name: str) -> str:
   131	    if value == "":
   132	        return ""
   133	    return _require_sha256(value, name)
