   271	@dataclass(frozen=True, slots=True)
   272	class TopicObservationInput:
   273	    """One bounded source candidate supplied by a topic synchronization run."""
   274	
   275	    input_id: str
   276	    observation: SourceObservation
   277	    content: bytes
   278	    risk_flags: tuple[str, ...] = ()
   279	
   280	    def __post_init__(self) -> None:
   281	        _require_nonempty(self.input_id, "input_id")
   282	        if not isinstance(self.observation, SourceObservation):
   283	            raise TypeError("observation must be a SourceObservation")
   284	        if not isinstance(self.content, bytes):
   285	            raise TypeError("content must be bytes")
   286	        if not isinstance(self.risk_flags, tuple):
   287	            raise TypeError("risk_flags must be a tuple")
   288	        if any(not isinstance(flag, str) or not flag.strip() for flag in self.risk_flags):
   289	            raise TopicObservationError("risk_flags must contain non-empty strings")
   290	        if tuple(sorted(self.risk_flags)) != self.risk_flags or len(set(self.risk_flags)) != len(self.risk_flags):
   291	            raise TopicObservationError("risk_flags must be sorted and unique")
   292	
   293	    @property
   294	    def fingerprint_sha256(self) -> str:
   295	        return _fingerprint_from_input_projection(self.input_projection)
   296	
   297	    @property
   298	    def input_projection(self) -> dict[str, Any]:
   299	        """Return the canonical, non-secret identity needed to replay this input."""
   300	
   301	        return {
   302	            "input_id": self.input_id,
   303	            "observation": self.observation.to_dict(),
   304	            "content_sha256": hashlib.sha256(self.content).hexdigest(),
   305	            "content_size_bytes": len(self.content),
   306	            "risk_flags": list(self.risk_flags),
   307	        }
   308	
   309	    @property
   310	    def is_high_risk(self) -> bool:
   311	        return bool(self.risk_flags)
