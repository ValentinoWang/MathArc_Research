   795	            "persisted_observation_status": persisted_status,
   796	            "persisted_content_digest_sha256": persisted_content_digest,
   797	            "persisted_artifact_id": persisted_artifact_id,
   798	            "persisted_artifact_sha256": persisted_artifact_sha256,
