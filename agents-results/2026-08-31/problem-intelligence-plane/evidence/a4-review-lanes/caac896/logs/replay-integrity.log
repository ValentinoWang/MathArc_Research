    88	        if not self.content_summary.strip() or not self.summary_basis.strip():
    89	            raise ValueError("content summary and summary basis must be non-empty")
    90	        if self.media_type not in _MEDIA_TYPES:
    91	            raise ValueError(f"unsupported media_type: {self.media_type}")
    92	        if self.content_digest_sha256 and not _DIGEST_RE.fullmatch(self.content_digest_sha256):
    93	            raise ValueError("content_digest_sha256 must be a lowercase SHA-256 digest")
    94	        if self.status is ObservationStatus.OBSERVED and self.license_status is LicenseStatus.UNKNOWN:
    95	            raise ValueError("unknown license cannot produce an OBSERVED record")
    96	        if _STATUS_ASSERTION_LANGUAGE.search(self.content_summary):
    97	            raise ValueError("content_summary must remain descriptive, not proof/status language")
