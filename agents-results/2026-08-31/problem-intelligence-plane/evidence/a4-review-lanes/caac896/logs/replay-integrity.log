   259	def _manual_id_for(
   260	    *,
   261	    topic_id: str,
   262	    cursor: str,
   263	    input_id: str,
   264	    reason: ManualReviewReason,
   265	    detail: str,
   266	) -> str:
   267	    identity = f"{topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
   268	    return "manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
