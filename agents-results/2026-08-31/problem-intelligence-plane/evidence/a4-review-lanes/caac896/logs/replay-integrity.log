from pathlib import Path
from matharc.v02.source_observation import LicenseStatus, new_observation
from matharc.v02.topic_observation import TopicObservationBatch, TopicObservationInput, TopicObservationRunner

def item(input_id, *, same_as=None):
    if same_as is None:
        content = f\"source bytes for {input_id}\".encode()
        observation_id = f\"OBS-{input_id}\"
        uri = f\"https://example.test/{input_id}\"
    else:
        content = same_as.content
        observation_id = same_as.observation.observation_id
        uri = same_as.observation.canonical_uri
    return TopicObservationInput(
        input_id,
        new_observation(
            observation_id=observation_id, canonical_uri=uri, pinned_version=\"v1\",
            license_status=LicenseStatus.OPEN, license_basis=\"fixture\",
            content_summary=\"Fixture bibliographic metadata.\", summary_basis=\"fixture\",
            media_type=\"text/plain\", content_digest_sha256=hashlib.sha256(content).hexdigest(),
            observed_at=\"2026-08-31T08:00:00+00:00\",
        ), content,
    )
def batch(c, n, *xs):
    return TopicObservationBatch(\"union-closed\", c, n, tuple(xs))

with tempfile.TemporaryDirectory() as d:
    a = item(\"A\")
    runner = TopicObservationRunner(d, topic_id=\"union-closed\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", a))
    replayed_input = runner.run(batch(\"c1\", \"c2\", item(\"A\", same_as=a)))
    state = json.loads((Path(d) / \"topic-observation-state.json\").read_text())
    print(\"same_input_status=\", replayed_input.item_results[0].status.value)
    print(\"same_input_basis=\", state[\"batches\"][\"c1\"][\"disposition_evidence\"][\"A\"][\"basis\"])
    print(\"same_input_prior_cursor=\", state[\"batches\"][\"c1\"][\"disposition_evidence\"][\"A\"][\"prior_cursor\"])
    print(\"same_input_literature_count=\", len(runner.literature.observations))

with tempfile.TemporaryDirectory() as d:
    a = item(\"A\")
    runner = TopicObservationRunner(d, topic_id=\"union-closed\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", a))
    duplicate_key = runner.run(batch(\"c1\", \"c2\", item(\"B\", same_as=a)))
    state = json.loads((Path(d) / \"topic-observation-state.json\").read_text())
    print(\"duplicate_key_status=\", duplicate_key.item_results[0].status.value)
    print(\"duplicate_key_basis=\", state[\"batches\"][\"c1\"][\"disposition_evidence\"][\"B\"][\"basis\"])
    print(\"duplicate_key_literature_count=\", len(runner.literature.observations))

with tempfile.TemporaryDirectory() as d:
    runner = TopicObservationRunner(d, topic_id=\"union-closed\", initial_cursor=\"c0\")
    runner.run(batch(\"c0\", \"c1\", item(\"A\")))
    runner.run(batch(\"c1\", \"c2\", item(\"B\")))
    path = Path(d) / \"topic-observation-state.json\"
    before = hashlib.sha256(path.read_bytes()).hexdigest()
    r1 = TopicObservationRunner(d, topic_id=\"union-closed\", initial_cursor=\"c0\").run(batch(\"c1\", \"c2\", item(\"B\")))
    r2 = TopicObservationRunner(d, topic_id=\"union-closed\", initial_cursor=\"c0\").run(batch(\"c1\", \"c2\", item(\"B\")))
    after = hashlib.sha256(path.read_bytes()).hexdigest()
    print(\"deterministic_statuses=\", r1.status.value, r2.status.value)
    print(\"deterministic_replayed_flags=\", r1.replayed, r2.replayed)
    print(\"deterministic_result_equal=\", r1.to_dict() == r2.to_dict())
    print(\"deterministic_state_unchanged=\", before == after)
