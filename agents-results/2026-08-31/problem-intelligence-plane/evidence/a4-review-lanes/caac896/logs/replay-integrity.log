   846	    @staticmethod
   847	    def _record_manual_event(
   848	        state: dict[str, Any],
   849	        manual: ManualReviewItem,
   850	    ) -> None:
   851	        existing = {item["manual_id"] for item in state["manual_events"]}
   852	        if manual.manual_id not in existing:
   853	            state["manual_events"].append(
   854	                {
   855	                    "event_type": "CURSOR_CONFLICT",
   856	                    "manual_id": manual.manual_id,
   857	                }
   858	            )
   859	            state["manual_events"].sort(key=lambda item: item["manual_id"])
