   204	def _canonical_input_projection(value: object) -> dict[str, Any]:
   205	    if not isinstance(value, dict):
   206	        raise TopicObservationError("stored input projection is malformed")
   207	    _require_fields(value, _INPUT_PROJECTION_FIELDS, "input projection")
   208	    input_id = _require_nonempty(value["input_id"], "stored input projection input_id")
   209	    observation_payload = value["observation"]
   210	    if not isinstance(observation_payload, dict):
   211	        raise TopicObservationError("stored input projection observation is malformed")
   212	    try:
   213	        observation = SourceObservation.from_dict(observation_payload)
   214	    except (KeyError, TypeError, ValueError) as exc:
   215	        raise TopicObservationError("stored input projection observation is invalid") from exc
   216	    content_sha256 = _require_sha256(
   217	        value["content_sha256"],
   218	        "stored input projection content digest",
   219	    )
   220	    content_size_bytes = value["content_size_bytes"]
   221	    if (
   222	        isinstance(content_size_bytes, bool)
   223	        or not isinstance(content_size_bytes, int)
   224	        or content_size_bytes < 0
   225	    ):
   226	        raise TopicObservationError("stored input projection content size is invalid")
   227	    risk_flags = value["risk_flags"]
   228	    if not isinstance(risk_flags, list):
   229	        raise TopicObservationError("stored input projection risk flags are invalid")
   230	    if any(not isinstance(flag, str) or not flag.strip() for flag in risk_flags):
   231	        raise TopicObservationError("stored input projection risk flags are invalid")
   232	    if risk_flags != sorted(set(risk_flags)):
   233	        raise TopicObservationError("stored input projection risk flags must be sorted and unique")
   234	    canonical = {
   235	        "input_id": input_id,
   236	        "observation": observation.to_dict(),
   237	        "content_sha256": content_sha256,
   238	        "content_size_bytes": content_size_bytes,
   239	        "risk_flags": risk_flags,
   240	    }
   241	    if value != canonical:
   242	        raise TopicObservationError("stored input projection is not canonical")
   243	    return canonical
   244	
   245	
   246	def _fingerprint_from_input_projection(
   247	    projection: Mapping[str, Any],
   248	) -> str:
   249	    return digest_json(
   250	        {
   251	            "input_id": projection["input_id"],
   252	            "observation": projection["observation"],
   253	            "content_sha256": projection["content_sha256"],
   254	            "risk_flags": projection["risk_flags"],
   255	        }
   256	    )
   257	
