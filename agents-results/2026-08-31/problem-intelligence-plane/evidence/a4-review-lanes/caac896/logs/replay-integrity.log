   832	    @staticmethod
   833	    def _prior_input_cursor(
   834	        state: Mapping[str, Any],
   835	        input_id: str,
   836	        fingerprint: str,
   837	    ) -> str | None:
   838	        matches = [
   839	            cursor
   840	            for cursor, stored in state["batches"].items()
   841	            if isinstance(stored, dict)
   842	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
   843	        ]
   844	        return sorted(matches)[0] if matches else None
