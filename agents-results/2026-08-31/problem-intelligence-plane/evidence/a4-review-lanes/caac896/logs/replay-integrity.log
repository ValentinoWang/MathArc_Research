   871	            manual_id=_manual_id_for(
   872	                topic_id=self.topic_id,
   873	                cursor=cursor,
   874	                input_id=input_id,
   875	                reason=reason,
   876	                detail=detail,
   877	            ),
   878	            topic_id=self.topic_id,
   879	            cursor=cursor,
   880	            input_id=input_id,
   881	            reason=reason,
   882	            detail=detail,
   883	        )
   884	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
   885	        if manual.manual_id not in existing:
   886	            state["manual_queue"].append(manual.to_dict())
   887	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
   888	        return manual
