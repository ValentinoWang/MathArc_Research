   753	    def _item_evidence(
   754	        self,
   755	        item: TopicObservationInput,
   756	        result: TopicItemResult,
   757	        basis: str,
   758	        *,
   759	        persisted: SourceObservation | None = None,
   760	        manual_id: str | None = None,
   761	        manual_reason: ManualReviewReason | None = None,
   762	        import_disposition: ImportDisposition | None = None,
   763	        prior_cursor: str | None = None,
   764	        prior_input_id: str | None = None,
   765	    ) -> dict[str, Any]:
   766	        persisted_status = "ABSENT"
   767	        persisted_observation_id = None
   768	        persisted_content_digest = None
   769	        persisted_artifact_id = None
   770	        persisted_artifact_sha256 = None
   771	        if persisted is not None:
   772	            persisted_status = persisted.status.value
   773	            persisted_observation_id = persisted.observation_id
   774	            persisted_content_digest = persisted.content_digest_sha256
   775	            if persisted.status is ObservationStatus.OBSERVED:
   776	                if persisted.artifact_id is None:
   777	                    raise TopicObservationError("observed literature evidence has no artifact")
   778	                try:
   779	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
   780	                except KeyError as exc:
   781	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
   782	                persisted_artifact_id = artifact.artifact_id
   783	                persisted_artifact_sha256 = artifact.sha256
   784	        return {
   785	            "basis": basis,
   786	            "input_id": item.input_id,
   787	            "input_observation_id": item.observation.observation_id,
   788	            "input_idempotency_key": item.observation.idempotency_key,
   789	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   790	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   791	            "input_content_size_bytes": len(item.content),
   792	            "input_risk_flags": list(item.risk_flags),
   793	            "observation_id": result.observation_id,
   794	            "persisted_observation_id": persisted_observation_id,
   795	            "persisted_observation_status": persisted_status,
   796	            "persisted_content_digest_sha256": persisted_content_digest,
   797	            "persisted_artifact_id": persisted_artifact_id,
   798	            "persisted_artifact_sha256": persisted_artifact_sha256,
   799	            "manual_id": manual_id,
   800	            "manual_reason": manual_reason.value if manual_reason is not None else None,
   801	            "prior_cursor": prior_cursor,
   802	            "prior_input_id": prior_input_id,
   803	            "import_disposition": import_disposition.value if import_disposition is not None else None,
   804	        }
