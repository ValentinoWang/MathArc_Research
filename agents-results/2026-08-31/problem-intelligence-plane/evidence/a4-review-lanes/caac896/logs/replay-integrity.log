   480	class TopicObservationRunner:
   481	    """Durably process one topic without granting status or proof authority."""
   482	
   483	    def __init__(
   484	        self,
   485	        root: str | Path,
   486	        *,
   487	        topic_id: str,
   488	        initial_cursor: str,
   489	        budget: BudgetLedger | None = None,
   490	    ) -> None:
   491	        self.root = external_root(root)
   492	        self.root.mkdir(parents=True, exist_ok=True)
   493	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   494	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   495	        if budget is not None and not isinstance(budget, BudgetLedger):
   496	            raise TypeError("budget must be a BudgetLedger or None")
   497	        self.budget = budget
   498	        self.state_path = self.root / "topic-observation-state.json"
   499	        self.lock_path = self.root / ".topic-observation.lock"
   500	        self.literature = LiteratureBase(self.root / "literature", budget=budget)
   501	
   502	    @property
   503	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   504	        state = self._load_state()
   505	        return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   506	
   507	    @property
   508	    def next_cursor(self) -> str:
   509	        return _require_nonempty(self._load_state()["next_cursor"], "next_cursor")
   510	
   511	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   512	        if not isinstance(batch, TopicObservationBatch):
   513	            raise TypeError("batch must be a TopicObservationBatch")
   514	        if batch.topic_id != self.topic_id:
   515	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   516	        with self._writer_lock():
   517	            self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
   518	            state = self._load_state()
   519	            batches = state["batches"]
   520	            previous = batches.get(batch.cursor)
   521	            if previous is not None:
   522	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   523	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   524	                manual = self._add_manual(
   525	                    state,
   526	                    cursor=batch.cursor,
   527	                    input_id="cursor",
   528	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   529	                    detail="A cursor was replayed with different batch content.",
   530	                )
   531	                self._record_manual_event(state, manual)
   532	                self._save_state(state)
   533	                return TopicBatchResult(
   534	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   535	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   536	                )
   537	            if batch.cursor != state["next_cursor"]:
   538	                manual = self._add_manual(
   539	                    state,
   540	                    cursor=batch.cursor,
   541	                    input_id="cursor",
   542	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   543	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   544	                )
   545	                self._record_manual_event(state, manual)
   546	                self._save_state(state)
   547	                return TopicBatchResult(
   548	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   549	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   550	                )
   551	
   552	            results: list[TopicItemResult] = []
   553	            disposition_evidence: dict[str, dict[str, Any]] = {}
   554	            batch_digest_sha256 = batch.batch_digest_sha256
   555	            for item in batch.inputs:
   556	                item_result, evidence = self._process_input(state, batch, item)
   557	                results.append(item_result)
   558	                disposition_evidence[item.input_id] = evidence
   559	            status = TopicRunStatus.MANUAL_REVIEW if any(
   560	                item.status is TopicItemStatus.MANUAL_REVIEW for item in results
   561	            ) else TopicRunStatus.APPLIED
   562	            batch_result = TopicBatchResult(
   563	                self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results)
   564	            )
   565	            input_projections = {
   566	                item.input_id: item.input_projection for item in batch.inputs
   567	            }
   568	            for input_id, evidence in disposition_evidence.items():
   569	                evidence["input_projection_binding_sha256"] = _input_projection_binding_digest(
   570	                    topic_id=batch.topic_id,
   571	                    cursor=batch.cursor,
   572	                    next_cursor=batch.next_cursor,
   573	                    batch_digest_sha256=batch_digest_sha256,
   574	                    input_projection=input_projections[input_id],
   575	                )
   576	            batches[batch.cursor] = {
   577	                "batch_digest_sha256": batch_digest_sha256,
   578	                "result_digest_sha256": digest_json(batch_result.to_dict()),
   579	                "input_fingerprints": {
   580	                    item.input_id: item.fingerprint_sha256 for item in batch.inputs
   581	                },
   582	                "input_projection_digest_sha256": _input_projection_digest(
   583	                    topic_id=batch.topic_id,
   584	                    cursor=batch.cursor,
   585	                    next_cursor=batch.next_cursor,
   586	                    batch_digest_sha256=batch_digest_sha256,
   587	                    input_projections=input_projections,
   588	                ),
   589	                "input_projections": input_projections,
   590	                "input_observation_ids": {
   591	                    item.input_id: item.observation_id for item in results
   592	                },
   593	                "disposition_evidence": disposition_evidence,
   594	                "result": batch_result.to_dict(),
   595	            }
   596	            state["next_cursor"] = batch.next_cursor
   597	            self._save_state(state)
   598	            return batch_result
   599	
   600	    def _process_input(
   601	        self,
   602	        state: dict[str, Any],
   603	        batch: TopicObservationBatch,
   604	        item: TopicObservationInput,
   605	    ) -> tuple[TopicItemResult, dict[str, Any]]:
   606	        prior = state["processed_input_ids"].get(item.input_id)
   607	        if prior is not None:
   608	            if prior == item.fingerprint_sha256:
   609	                result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   610	                return result, self._item_evidence(
   611	                    item,
   612	                    result,
   613	                    "PROCESSED_INPUT_REPLAY",
   614	                    persisted=self._persisted_observation_for_input(item),
   615	                    prior_cursor=self._prior_input_cursor(state, item.input_id, item.fingerprint_sha256),
   616	                    prior_input_id=item.input_id,
   617	                )
   618	            manual = self._add_manual(
   619	                state, cursor=batch.cursor, input_id=item.input_id,
   620	                reason=ManualReviewReason.INPUT_ID_CONFLICT,
   621	                detail="An input_id was reused with different source-observation content.",
   622	            )
   623	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   624	            return result, self._item_evidence(
   625	                item,
   626	                result,
   627	                "MANUAL_QUEUE",
   628	                persisted=self._persisted_observation_for_input(item),
   629	                manual_id=manual.manual_id,
   630	                manual_reason=ManualReviewReason.INPUT_ID_CONFLICT,
   631	            )
   632	        if item.is_high_risk:
   633	            manual = self._add_manual(
   634	                state, cursor=batch.cursor, input_id=item.input_id,
   635	                reason=ManualReviewReason.HIGH_RISK_EVENT,
   636	                detail="High-risk flags require human review: " + ", ".join(item.risk_flags),
   637	            )
   638	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   639	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   640	            return result, self._item_evidence(
   641	                item,
   642	                result,
   643	                "MANUAL_QUEUE",
   644	                persisted=self._persisted_observation_for_input(item),
   645	                manual_id=manual.manual_id,
   646	                manual_reason=ManualReviewReason.HIGH_RISK_EVENT,
   647	            )
   648	        if self.budget is not None and self.budget.exhausted():
   649	            manual = self._add_manual(
   650	                state, cursor=batch.cursor, input_id=item.input_id,
   651	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   652	                detail="The configured import budget is exhausted before topic observation.",
   653	            )
   654	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   655	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   656	            return result, self._item_evidence(
   657	                item,
   658	                result,
   659	                "MANUAL_QUEUE",
   660	                persisted=self._persisted_observation_for_input(item),
   661	                manual_id=manual.manual_id,
   662	                manual_reason=ManualReviewReason.BUDGET_EXHAUSTED,
   663	            )
   664	        if item.observation.idempotency_key in state["seen_observation_keys"]:
   665	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   666	            result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   667	            return result, self._item_evidence(
   668	                item,
   669	                result,
   670	                "SEEN_OBSERVATION_KEY",
   671	                persisted=self._persisted_observation_for_input(item),
   672	            )
   673	
   674	        imported = self.literature.import_bytes(item.observation, item.content)
   675	        if imported.disposition in {ImportDisposition.IMPORTED, ImportDisposition.IDEMPOTENT}:
   676	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   677	            state["seen_observation_keys"].append(item.observation.idempotency_key)
   678	            state["seen_observation_keys"].sort()
   679	            status = TopicItemStatus.IMPORTED if imported.disposition is ImportDisposition.IMPORTED else TopicItemStatus.IDEMPOTENT
   680	            result = TopicItemResult(item.input_id, status, imported.observation.observation_id)
   681	            return result, self._item_evidence(
   682	                item,
   683	                result,
   684	                "NEW_IMPORT" if status is TopicItemStatus.IMPORTED else "EXISTING_OBSERVED",
   685	                persisted=imported.observation,
   686	                import_disposition=imported.disposition,
   687	            )
   688	        if imported.disposition is ImportDisposition.CONFLICT or imported.observation.status is ObservationStatus.CONFLICT:
   689	            manual = self._add_manual(
   690	                state,
   691	                cursor=batch.cursor,
   692	                input_id=item.input_id,
   693	                reason=ManualReviewReason.LITERATURE_CONFLICT,
   694	                detail=f"Literature import conflict: {imported.reason or 'unspecified conflict outcome'}",
   695	            )
   696	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   697	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   698	            return result, self._item_evidence(
   699	                item,
   700	                result,
