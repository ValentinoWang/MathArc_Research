   315	class TopicObservationBatch:
   316	    """A one-topic, explicitly cursor-bounded batch of source candidates."""
   317	
   318	    topic_id: str
   319	    cursor: str
   320	    next_cursor: str
   321	    inputs: tuple[TopicObservationInput, ...]
   322	    schema_version: str = _SCHEMA_VERSION
   323	
   324	    def __post_init__(self) -> None:
   325	        _require_nonempty(self.topic_id, "topic_id")
   326	        _require_nonempty(self.cursor, "cursor")
   327	        _require_nonempty(self.next_cursor, "next_cursor")
   328	        if self.cursor == self.next_cursor:
   329	            raise TopicObservationError("next_cursor must advance beyond cursor")
   330	        if not isinstance(self.inputs, tuple) or not self.inputs:
   331	            raise TopicObservationError("inputs must be a non-empty tuple")
   332	        if any(not isinstance(item, TopicObservationInput) for item in self.inputs):
   333	            raise TypeError("inputs must contain TopicObservationInput records")
   334	        identifiers = tuple(item.input_id for item in self.inputs)
   335	        if len(identifiers) != len(set(identifiers)) or tuple(sorted(identifiers)) != identifiers:
   336	            raise TopicObservationError("input ids must be sorted and unique")
   337	        if self.schema_version != _SCHEMA_VERSION:
   338	            raise TopicObservationError("unsupported topic-observation batch schema_version")
   339	
   340	    @property
   341	    def batch_digest_sha256(self) -> str:
   342	        return _batch_digest_from_fingerprints(
   343	            topic_id=self.topic_id,
   344	            cursor=self.cursor,
   345	            next_cursor=self.next_cursor,
   346	            input_fingerprints={
   347	                item.input_id: item.fingerprint_sha256 for item in self.inputs
   348	            },
   349	        )
