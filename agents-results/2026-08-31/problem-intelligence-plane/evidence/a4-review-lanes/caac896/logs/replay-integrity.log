   806	    def _persisted_observation_for_input(
   807	        self,
   808	        item: TopicObservationInput,
   809	    ) -> SourceObservation | None:
   810	        candidates = [
   811	            observation
   812	            for observation in self.literature.observations
   813	            if observation.observation_id == item.observation.observation_id
   814	            or observation.idempotency_key == item.observation.idempotency_key
   815	        ]
   816	        if not candidates:
   817	            return None
   818	        status_order = {
   819	            ObservationStatus.OBSERVED: 0,
   820	            ObservationStatus.PENDING: 1,
   821	            ObservationStatus.CONFLICT: 2,
   822	            ObservationStatus.REJECTED: 3,
   823	        }
   824	        return min(
   825	            candidates,
   826	            key=lambda observation: (
   827	                status_order[observation.status],
   828	                observation.observation_id,
   829	            ),
   830	        )
