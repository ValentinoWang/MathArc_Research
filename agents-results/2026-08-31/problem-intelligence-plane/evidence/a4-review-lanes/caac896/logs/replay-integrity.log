   109	    def conflicts_with(self, other: "SourceObservation") -> bool:
   110	        return self.logical_identity == other.logical_identity and (
   111	            bool(self.content_digest_sha256)
   112	            and bool(other.content_digest_sha256)
   113	            and self.content_digest_sha256 != other.content_digest_sha256
   114	        )
   115	
   116	    def to_dict(self) -> dict[str, Any]:
   117	        return {
   118	            "schema_version": self.schema_version,
   119	            "observation_id": self.observation_id,
   120	            "canonical_uri": self.canonical_uri,
   121	            "pinned_version": self.pinned_version,
   122	            "observed_at": self.observed_at,
   123	            "license_status": self.license_status.value,
   124	            "license_basis": self.license_basis,
   125	            "content_summary": self.content_summary,
   126	            "summary_basis": self.summary_basis,
   127	            "media_type": self.media_type,
   128	            "content_digest_sha256": self.content_digest_sha256,
   129	            "artifact_id": self.artifact_id,
   130	            "status": self.status.value,
   131	        }
