   133	    @classmethod
   134	    def from_dict(cls, payload: Mapping[str, Any]) -> "SourceObservation":
   135	        allowed = {
   136	            "schema_version", "observation_id", "canonical_uri", "pinned_version",
   137	            "observed_at", "license_status", "license_basis", "content_summary",
   138	            "summary_basis", "media_type", "content_digest_sha256", "artifact_id", "status",
   139	        }
   140	        unknown = set(payload) - allowed
   141	        if unknown:
   142	            raise ValueError(f"unknown source-observation fields: {sorted(unknown)}")
   143	        if str(payload.get("schema_version", "1.0")) != "1.0":
   144	            raise ValueError("unsupported source-observation schema_version")
   145	        return cls(
   146	            observation_id=str(payload["observation_id"]),
   147	            canonical_uri=str(payload["canonical_uri"]),
   148	            pinned_version=str(payload["pinned_version"]),
   149	            observed_at=str(payload["observed_at"]),
   150	            license_status=LicenseStatus(str(payload["license_status"])),
   151	            license_basis=str(payload["license_basis"]),
   152	            content_summary=str(payload["content_summary"]),
   153	            summary_basis=str(payload["summary_basis"]),
   154	            media_type=str(payload["media_type"]),
   155	            content_digest_sha256=str(payload.get("content_digest_sha256", "")),
   156	            artifact_id=(str(payload["artifact_id"]) if payload.get("artifact_id") is not None else None),
   157	            status=ObservationStatus(str(payload.get("status", ObservationStatus.PENDING.value))),
   158	            schema_version="1.0",
   159	        )
