47:    def _load_contract(self) -> dict[str, Any]:
48:        try: contract = json.loads(self.contract_path.read_text(encoding="utf-8"))
49:        except (OSError, json.JSONDecodeError) as exc: raise DogfoodArchiveError("T2 contract is unreadable") from exc
50:        if not isinstance(contract, dict): raise DogfoodArchiveError("T2 contract must be an object")
