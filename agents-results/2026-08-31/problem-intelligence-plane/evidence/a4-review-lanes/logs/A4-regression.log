40:    def run(self) -> dict[str, Any]:
41:        self.contract = self._load_contract()
42:        fixtures = self._load_s1_fixtures()
43:        specs = self._load_source_specs()
44:        if self.result_path.exists(): return self._replay(specs)
45:        return self._execute(fixtures, specs)
