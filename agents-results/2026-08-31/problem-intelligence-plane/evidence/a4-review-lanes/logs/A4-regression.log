79:    def _load_s1_fixtures(self) -> dict[str, dict[str, Any]]:
80:        paths = sorted(self.fixture_root.glob("*.json"))
81:        if tuple(path.name for path in paths) != tuple(sorted(_S1_NAMES)): raise DogfoodArchiveError("S1 fixture directory must contain exactly the three named fixtures")
82:        values = {}
83:        for path in paths:
