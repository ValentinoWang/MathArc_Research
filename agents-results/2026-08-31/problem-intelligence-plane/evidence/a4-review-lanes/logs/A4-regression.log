53:        if not isinstance(contract["cases"], list) or len(contract["cases"]) != 3: raise DogfoodArchiveError("T2 contract must define exactly three cases")
54:        case_fields = {"problem_id", "case_role", "expected_topic_status", "expected_problem_status", "expected_manual_reason", "expected_novelty_status", "expected_promotion_allowed"}
55:        ids = []
56:        for case in contract["cases"]:
57:            if not isinstance(case, dict): raise DogfoodArchiveError("T2 contract case must be an object")
58:            _fields(case, case_fields, "T2 contract case")
59:            problem_id = _text(case["problem_id"], "contract problem_id")
60:            if problem_id not in _ROLES or case["case_role"] != _ROLES[problem_id]: raise DogfoodArchiveError("unknown or mismatched contract case")
61:            if case["expected_promotion_allowed"] is not False: raise DogfoodArchiveError("dogfood promotion must remain disabled")
62:            ids.append(problem_id)
63:        if tuple(ids) != _CASE_ORDER: raise DogfoodArchiveError("contract case order or identity drift")
64:        if set(contract["fixture_sha256"]) != set(_S1_NAMES) or any(not isinstance(value, str) or len(value) != 64 for value in contract["fixture_sha256"].values()):
65:            raise DogfoodArchiveError("fixture_sha256 must cover exactly the three S1 fixtures")
66:        if contract["expected_budget_snapshot"] != self._new_residual_budget().to_dict():
67:            raise DogfoodArchiveError("T2 contract budget identity is incompatible")
68:        if contract["expected_budget_digest_sha256"] != digest_json(contract["expected_budget_snapshot"]):
69:            raise DogfoodArchiveError("T2 contract budget digest mismatch")
70:        if not isinstance(contract["source_artifacts"], dict): raise DogfoodArchiveError("source_artifacts must be an object")
71:        return contract
