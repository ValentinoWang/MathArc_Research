86:            if expected_sha != actual_sha: raise DogfoodArchiveError(f"S1 fixture digest mismatch: {path.name}")
87:            try: payload = json.loads(path.read_text(encoding="utf-8"))
88:            except (OSError, json.JSONDecodeError) as exc: raise DogfoodArchiveError(f"fixture is unreadable: {path.name}") from exc
89:            if not isinstance(payload, dict): raise DogfoodArchiveError(f"fixture must be an object: {path.name}")
90:            problem_id = _text(payload.get("problem_id"), "problem_id")
91:            if problem_id not in _ROLES or payload.get("case_role") != _ROLES[problem_id]: raise DogfoodArchiveError("unknown or mismatched S1 case")
92:            for field in ("statement", "source_assertions", "expected_report_status", "limitations"):
