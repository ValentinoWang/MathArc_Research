221:    def _assert_contract_results(self, result: Mapping[str, Any]) -> None:
222:        cases = {case["problem_id"]: case for case in result["cases"]}
223:        for expected in self.contract["cases"]:
224:            actual = cases.get(expected["problem_id"])
225:            if actual is None:
226:                raise DogfoodArchiveError("persisted result is missing a contract case")
227:            checks = {
228:                "case_role": expected["case_role"],
229:                "topic_status": expected["expected_topic_status"],
230:                "promotion_allowed": expected["expected_promotion_allowed"],
231:                "manual_reason": expected["expected_manual_reason"],
232:            }
233:            for field, value in checks.items():
234:                if actual.get(field) != value:
235:                    raise DogfoodArchiveError(f"contract expected {field}={value!r}, got {actual.get(field)!r}")
236:            if actual["status"]["reported_status"] != expected["expected_problem_status"]:
237:                raise DogfoodArchiveError("contract expected problem status drift")
238:            novelty_status = actual["novelty"]["authorization_status"] if actual["novelty"] else None
239:            if novelty_status != expected["expected_novelty_status"]:
240:                raise DogfoodArchiveError("contract expected novelty status drift")
