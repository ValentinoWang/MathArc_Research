31:class DogfoodArchiveRunner:
32:    """Run and replay exactly three checked-in, provenance-bound archives."""
33:    def __init__(self, root: str | Path, fixture_root: str | Path) -> None:
34:        self.root, self.fixture_root = Path(root), Path(fixture_root)
35:        self.root.mkdir(parents=True, exist_ok=True)
36:        self.contract_path = self.fixture_root / "three-real-archives.json"
37:        if not self.contract_path.exists(): self.contract_path = self.fixture_root.parent / "t2-fixtures" / "three-real-archives.json"
38:        self.result_path, self.contract = self.root / "dogfood-archives.json", {}
