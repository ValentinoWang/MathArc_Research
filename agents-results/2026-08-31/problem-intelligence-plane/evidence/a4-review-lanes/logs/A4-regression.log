199:    def _replay(self, specs):
200:        payload = self._load_result()
201:        if payload["contract_digest_sha256"] != self._contract_digest() or payload["fixture_identity_digest_sha256"] != digest_json(self.contract["fixture_sha256"]) or payload["source_identity_digest_sha256"] != digest_json(specs): raise DogfoodArchiveError("contract or source identity drift on replay")
202:        main = TopicObservationRunner(self.root / "topic-observation", topic_id=_TOPIC_ID, initial_cursor="dogfood-c0")
203:        residual_budget = self._new_residual_budget()
204:        residual = TopicObservationRunner(self.root / "residual-budget", topic_id=_TOPIC_ID, initial_cursor="budget-c0", budget=residual_budget)
205:        if not (main.next_cursor == "dogfood-c4" and residual.next_cursor == "budget-c1"):
206:            raise DogfoodArchiveError("topic observation state is missing or has invalid cursor")
207:        manual_ids = sorted(item.manual_id for item in (*main.manual_queue, *residual.manual_queue))
208:        if manual_ids != sorted(payload["blocking_manual_ids"]):
209:            raise DogfoodArchiveError("topic observation manual queue does not match persisted archive")
210:        if len(main.literature.observations) != 4 or len(residual.literature.observations) != 0:
211:            raise DogfoodArchiveError("topic observation ArtifactStore state is missing or inconsistent")
212:        reconstructed_budget = residual_budget.to_dict()
213:        if self.contract["expected_budget_snapshot"] != reconstructed_budget:
214:            raise DogfoodArchiveError("reconstructed residual budget does not match T2 contract")
215:        if payload["budget_snapshot"] != reconstructed_budget:
216:            raise DogfoodArchiveError("persisted budget snapshot does not match reconstructed residual budget")
217:        if not payload["no_claim_or_trace_created"] or not self._no_claim_or_trace_created(): raise DogfoodArchiveError("claim or trace artifact is forbidden on replay")
218:        self._assert_contract_results(payload)
219:        payload["replayed"] = True; self._save(payload); return payload
