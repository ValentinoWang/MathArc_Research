98:                required = {"source_kind", "assertion"} | ({"source_path"} if problem_id != _CASE_ORDER[1] else set())
99:                if problem_id == _CASE_ORDER[1]:
100:                    if not required.issubset(assertion): raise DogfoodArchiveError("missing S1 source assertion fields")
101:                else:
