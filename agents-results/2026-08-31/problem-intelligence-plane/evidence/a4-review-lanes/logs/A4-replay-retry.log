   435	    def _add_manual(
   436	        self,
   437	        state: dict[str, Any],
   438	        *,
   439	        cursor: str,
   440	        input_id: str,
   441	        reason: ManualReviewReason,
   442	        detail: str,
   443	    ) -> ManualReviewItem:
   444	        identity = f"{self.topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
   445	        manual = ManualReviewItem(
   446	            manual_id="manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24],
   447	            topic_id=self.topic_id,
   448	            cursor=cursor,
   449	            input_id=input_id,
   450	            reason=reason,
   451	            detail=detail,
   452	        )
   453	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
   454	        if manual.manual_id not in existing:
   455	            state["manual_queue"].append(manual.to_dict())
   456	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
   457	        return manual
   458	
   459	    @contextmanager
   460	    def _writer_lock(self) -> Iterator[None]:
   461	        self.lock_path.touch(exist_ok=True)
   462	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   463	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   464	            try:
   465	                yield
   466	            finally:
   467	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
   468	
   469	    def _new_state(self) -> dict[str, Any]:
   470	        return {
   471	            "schema_version": _SCHEMA_VERSION,
   472	            "topic_id": self.topic_id,
   473	            "next_cursor": self.initial_cursor,
   474	            "batches": {},
   475	            "processed_input_ids": {},
   476	            "seen_observation_keys": [],
   477	            "manual_queue": [],
   478	        }
   479	
   480	    def _load_state(self) -> dict[str, Any]:
   481	        if not self.state_path.exists():
   482	            return self._new_state()
   483	        try:
   484	            payload = json.loads(self.state_path.read_text(encoding="utf-8"))
   485	        except (OSError, json.JSONDecodeError) as exc:
   486	            raise TopicObservationError("topic observation state is unreadable") from exc
   487	        if not isinstance(payload, dict):
   488	            raise TopicObservationError("topic observation state must be an object")
   489	        expected = {"schema_version", "topic_id", "next_cursor", "batches", "processed_input_ids", "seen_observation_keys", "manual_queue"}
   490	        _require_fields(payload, expected, "topic-observation-state")
   491	        if payload["schema_version"] != _SCHEMA_VERSION or payload["topic_id"] != self.topic_id:
   492	            raise TopicObservationError("topic observation state does not match runner")
   493	        if not isinstance(payload["next_cursor"], str) or not payload["next_cursor"]:
   494	            raise TopicObservationError("topic observation state has invalid next_cursor")
   495	        if not isinstance(payload["batches"], dict) or not isinstance(payload["processed_input_ids"], dict):
   496	            raise TopicObservationError("topic observation state has invalid mappings")
   497	        if not isinstance(payload["seen_observation_keys"], list) or not isinstance(payload["manual_queue"], list):
   498	            raise TopicObservationError("topic observation state has invalid collections")
   499	        if payload["seen_observation_keys"] != sorted(set(payload["seen_observation_keys"])):
   500	            raise TopicObservationError("seen_observation_keys must be sorted and unique")
   501	        for cursor, stored in payload["batches"].items():
   502	            _require_nonempty(cursor, "stored cursor")
   503	            if not isinstance(stored, dict) or set(stored) != {"batch_digest_sha256", "result"}:
   504	                raise TopicObservationError("stored batch is malformed")
   505	            if not isinstance(stored["result"], dict):
   506	                raise TopicObservationError("stored batch result is malformed")
   507	            TopicBatchResult.from_dict(stored["result"])
   508	        for item in payload["manual_queue"]:
   509	            if not isinstance(item, dict):
   510	                raise TopicObservationError("manual queue entry is malformed")
   511	            ManualReviewItem.from_dict(item)
   512	        return payload
   513	
   514	    def _save_state(self, state: Mapping[str, Any]) -> None:
   515	        temporary = self.state_path.with_suffix(".tmp")
   516	        temporary.write_text(canonical_json(state) + "\n", encoding="utf-8")
   517	        os.replace(temporary, self.state_path)

