            runner.run()
            source = contract_root / "sources" / "engineering-progress.md"
            source.write_text(source.read_text(encoding="utf-8") + "tampered\n", encoding="utf-8")
            with self.assertRaisesRegex(DogfoodArchiveError, "digest mismatch"):
