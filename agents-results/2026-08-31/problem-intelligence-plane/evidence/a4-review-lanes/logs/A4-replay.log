class ManualReviewReason(str, Enum):
    BUDGET_EXHAUSTED = "BUDGET_EXHAUSTED"
    HIGH_RISK_EVENT = "HIGH_RISK_EVENT"
    CURSOR_CONFLICT = "CURSOR_CONFLICT"
