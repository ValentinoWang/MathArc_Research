     def _validate_item_evidence(
         self,
         evidence: Mapping[str, Any],
         result: TopicItemResult,
         fingerprint: str,
         persisted_result_observation_id: str,
         input_projection: Mapping[str, Any],
         *,
         cursor: str,
         next_cursor: str,
         batch_digest_sha256: str,
