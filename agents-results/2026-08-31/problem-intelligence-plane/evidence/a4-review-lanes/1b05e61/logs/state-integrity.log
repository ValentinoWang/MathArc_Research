exec
/bin/zsh -lc "PYTHONDONTWRITEBYTECODE=1 .venv/bin/python - <<'PY'
import json
import tempfile
from pathlib import Path

from matharc.v02.schema import digest_json
from matharc.v02.topic_observation import TopicItemStatus, TopicObservationError, TopicObservationRunner
from tests.test_v02_topic_observation import batch, input_for

print('PROBE=preexisting-partial-reconciliation')
with tempfile.TemporaryDirectory() as directory:
    runner = TopicObservationRunner(directory, topic_id='union-closed', initial_cursor='c0')
    for name in ('A', 'B'):
        item = input_for(name)
        imported = runner.literature.import_bytes(item.observation, item.content)
        print(f'preimport_{name}={imported.disposition.value}')
    first = runner.run(batch('c0', 'c1', input_for('A')))
    print(f'first_status={first.item_results[0].status.value}')
    try:
        runner.run(batch('c1', 'c2', input_for('B')))
    except TopicObservationError as exc:
        print(f'second_status=REJECTED:{exc}')
    else:
        print('second_status=ACCEPTED')

print('PROBE=new-import-to-existing-observed-rewrite')
with tempfile.TemporaryDirectory() as directory:
    runner = TopicObservationRunner(directory, topic_id='union-closed', initial_cursor='c0')
    runner.run(batch('c0', 'c1', input_for('A')))
    state_path = Path(directory) / 'topic-observation-state.json'
    state = json.loads(state_path.read_text(encoding='utf-8'))
    stored = state['batches']['c0']
    stored['result']['item_results'][0]['status'] = TopicItemStatus.IDEMPOTENT.value
    evidence = stored['disposition_evidence']['A']
    evidence['basis'] = 'EXISTING_OBSERVED'
    evidence['import_disposition'] = 'IDEMPOTENT'
    stored['result_digest_sha256'] = digest_json(stored['result'])
