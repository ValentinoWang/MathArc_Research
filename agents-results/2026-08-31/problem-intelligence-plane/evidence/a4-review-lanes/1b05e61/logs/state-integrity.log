+   568	                cursor="c0",
+   569	                next_cursor="c1",
+   570	                batch_digest_sha256=stored_a["batch_digest_sha256"],
+   571	                input_projection=swapped.input_projection,
+   572	            )
+   573	            stored_a["result_digest_sha256"] = digest_json(stored_a["result"])
+   574	            state_path.write_text(json.dumps(state), encoding="utf-8")
+   575	
+   576	            with self.assertRaisesRegex(TopicObservationError, "successful import repeats"):
+   577	                TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0").next_cursor
