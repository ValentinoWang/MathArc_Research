        ".card",
        ".grid2",
        ".chain",
        ".li"
      ],
      "signature_requirement": "Canonicalize the captured view DOM structure and record selector presence and structure without substituting screenshot text for DOM evidence."
    },
    "computed_style_samples": {
      "required_fields": [
        "evidence_ref",
        "sha256",
        "font_families",
        "color_tokens",
        "card"
      ],
      "font_family_requirement": "Record computed font-family values for the representative sans, serif, and mono roles present in the captured view.",
      "color_token_requirement": "Record the resolved visual authority tokens used by the captured view, including surface, ink, line, accent, and applicable semantic status colors.",
