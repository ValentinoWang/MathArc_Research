    43	def _fields(value: Mapping[str, Any], expected: set[str], label: str) -> None:
    44	    unknown = set(value) - expected
    45	    missing = expected - set(value)
    46	    if unknown or missing:
    47	        raise RegressionValidationError(f"{label} fields mismatch: missing={sorted(missing)}, unknown={sorted(unknown)}")
    48
    49
    50	def _text(value: object, label: str) -> str:
    51	    if not isinstance(value, str) or not value.strip():
    52	        raise RegressionValidationError(f"{label} must be non-empty text")
    53	    return value
    54
    55
    56	def _sha(value: object, label: str) -> str:
    57	    if not isinstance(value, str) or not _SHA256.fullmatch(value):
    58	        raise RegressionValidationError(f"{label} must be a SHA-256 digest")
    59	    return value
    60
    61
    62	def _git_sha(value: object, label: str) -> str:
    63	    if not isinstance(value, str) or not _GIT_SHA.fullmatch(value):
    64	        raise RegressionValidationError(f"{label} must be a Git object ID")
    65	    return value
    66
    67
    68	def _string_list(value: object, label: str, *, allow_empty: bool = False) -> tuple[str, ...]:
    69	    if not isinstance(value, list) or (not value and not allow_empty):
    70	        raise RegressionValidationError(f"{label} must be a non-empty array")
    71	    if any(not isinstance(item, str) or not item.strip() for item in value):
    72	        raise RegressionValidationError(f"{label} must contain non-empty text")
    73	    result = tuple(value)
    74	    if len(result) != len(set(result)) or result != tuple(sorted(result)):
    75	        raise RegressionValidationError(f"{label} must be unique and sorted")
    76	    return result
