    for i, route in enumerate(payload['route_order']):
        without = set().union(*(route_sets[:i] + route_sets[i + 1:]))
        rows.append({
            'route': route,
            'incremental': sorted(route_sets[i] - without),
            'leave_one_out_loss': sorted(full - without),
        })
    independent.append({
