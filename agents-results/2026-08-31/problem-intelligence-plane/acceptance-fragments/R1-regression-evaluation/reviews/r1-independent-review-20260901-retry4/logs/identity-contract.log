             lambda p: p["cases"][0].update({"expected_status": "PROVED"}),
             lambda p: p.update({"topic_id": "foreign-topic"}),
             lambda p: p["cases"][0]["routes"][0]["queries"].__setitem__(0, "tampered query"),
