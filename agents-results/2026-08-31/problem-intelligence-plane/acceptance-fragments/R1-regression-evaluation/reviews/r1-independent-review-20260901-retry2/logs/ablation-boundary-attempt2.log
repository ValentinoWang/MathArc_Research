  2114	   306	    def evaluate(self) -> RegressionEvaluation:
  2115	   307	        evaluated: list[CaseEvaluation] = []
  2116	   308	        for case in self.cases:
  2117	   309	            route_sets = tuple(set(route.hit_ids) for route in case.routes)
  2118	   310	            full = set().union(*route_sets)
  2119	   311	            ablations = []
  2120	   312	            for index, route in enumerate(case.routes):
  2121	   313	                without = set().union(*(route_sets[:index] + route_sets[index + 1:]))
  2122	   314	                incremental = tuple(sorted(route_sets[index] - without))
  2123	   315	                ablations.append(RouteAblation(route.route, incremental, tuple(sorted(full - without))))
  2124	   316	            evaluated.append(CaseEvaluation(
  2125	   317	                case_id=case.case_id,
  2126	   318	                full_hit_ids=tuple(sorted(full)),
  2127	   319	                outcome_labels=case.outcome_labels,
  2128	   320	                manual_minutes=float(case.manual_minutes),
  2129	   321	                routes=tuple(ablations),
  2130	   322	            ))
  2131	   323	        return RegressionEvaluation(_CASE_IDS, tuple(evaluated))
