    26	    def test_three_cases_four_routes_and_deterministic_ablation(self) -> None:
    27	        payload, suite = self.load()
    28	        result = suite.evaluate()
    29	        self.assertEqual(payload["case_ids"], list(result.case_ids))
    30	        self.assertEqual(3, len(result.cases))
    31	        for case in result.cases:
    32	            self.assertEqual(4, len(case.routes))
    33	            self.assertEqual(set(payload["route_order"]), set(case.route_names))
    34	            self.assertEqual(case, suite.evaluate().case_by_id(case.case_id))
    35	        self.assertEqual(result.digest_sha256, suite.evaluate().digest_sha256)
    36	        self.assertTrue(any(item.incremental_hits == () for case in result.cases for item in case.routes))
    37
    38	    def test_expected_outcomes_are_only_hits_misses_and_gaps(self) -> None:
    39	        _, suite = self.load()
    40	        result = suite.evaluate()
    41	        allowed = {"hit", "miss", "gap"}
    42	        for case in result.cases:
    43	            self.assertTrue(set(case.outcome_labels) <= allowed)
