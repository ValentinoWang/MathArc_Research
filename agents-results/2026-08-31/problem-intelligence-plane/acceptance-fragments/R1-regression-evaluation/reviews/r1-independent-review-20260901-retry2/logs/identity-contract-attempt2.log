  1945	     def test_three_cases_four_routes_and_deterministic_ablation(self) -> None:
  1946	         payload, suite = self.load()
  1947	         result = suite.evaluate()
  1948	         self.assertEqual(payload["case_ids"], list(result.case_ids))
  1949	         self.assertEqual(3, len(result.cases))
  1950	         for case in result.cases:
  1951	             self.assertEqual(4, len(case.routes))
  1952	             self.assertEqual(set(payload["route_order"]), set(case.route_names))
  1953	             self.assertEqual(case, suite.evaluate().case_by_id(case.case_id))
  1954	         self.assertEqual(result.digest_sha256, suite.evaluate().digest_sha256)
  1955	         self.assertTrue(any(item.incremental_hits == () for case in result.cases for item in case.routes))
  1956
  1957	     def test_expected_outcomes_are_only_hits_misses_and_gaps(self) -> None:
  1958	         _, suite = self.load()
  1959	         result = suite.evaluate()
  1960	         allowed = {"hit", "miss", "gap"}
  1961	         for case in result.cases:
  1962	             self.assertTrue(set(case.outcome_labels) <= allowed)
  1963	             self.assertGreaterEqual(case.manual_minutes, 0)
  1964	             self.assertLessEqual(case.manual_minutes, 240)
  1965	             self.assertEqual(case.full_hit_ids, tuple(sorted(case.full_hit_ids)))
  1966	             for route in case.routes:
  1967	                 self.assertEqual(route.incremental_hits, tuple(sorted(route.incremental_hits)))
