  1977	             lambda p: p.update({"topic_id": "foreign-topic"}),
  1978	             lambda p: p["cases"][0]["routes"][0]["queries"].__setitem__(0, "tampered query"),
  1979	             lambda p: p["cases"][0]["routes"][0]["source_ids"].__setitem__(0, "tampered-source"),
  1980	             lambda p: p["cases"][0]["routes"][0]["hits"].__setitem__(0, "tampered-hit"),
  1981	             lambda p: p["cases"][0]["routes"][0]["unresolved"].append("tampered gap"),
