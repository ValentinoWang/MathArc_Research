    38	    def test_expected_outcomes_are_only_hits_misses_and_gaps(self) -> None:
    39	        _, suite = self.load()
    40	        result = suite.evaluate()
    41	        allowed = {"hit", "miss", "gap"}
    42	        for case in result.cases:
    43	            self.assertTrue(set(case.outcome_labels) <= allowed)
    44	            self.assertGreaterEqual(case.manual_minutes, 0)
    45	            self.assertLessEqual(case.manual_minutes, 240)
    46	            self.assertEqual(case.full_hit_ids, tuple(sorted(case.full_hit_ids)))
    47	            for route in case.routes:
    48	                self.assertEqual(route.incremental_hits, tuple(sorted(route.incremental_hits)))
