   183	            expected_status=_text(value["expected_status"], "expected_status"),
   184	            manual_minutes=value["manual_minutes"],
   185	            outcome_labels=outcomes,
   186	            routes=tuple(RouteResult.from_dict(item) for item in value["routes"]),
