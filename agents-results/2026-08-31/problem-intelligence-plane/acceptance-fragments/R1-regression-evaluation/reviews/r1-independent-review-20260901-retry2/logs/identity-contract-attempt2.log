    61	            lambda p: p["cases"][0]["routes"][0]["hits"].__setitem__(0, "tampered-hit"),
    62	            lambda p: p["cases"][0]["routes"][0]["unresolved"].append("tampered gap"),
    63	            lambda p: p["cases"][0].update({"manual_minutes": 13}),
