    68	def _string_list(value: object, label: str, *, allow_empty: bool = False) -> tuple[str, ...]:
    69	    if not isinstance(value, list) or (not value and not allow_empty):
    70	        raise RegressionValidationError(f"{label} must be a non-empty array")
    71	    if any(not isinstance(item, str) or not item.strip() for item in value):
