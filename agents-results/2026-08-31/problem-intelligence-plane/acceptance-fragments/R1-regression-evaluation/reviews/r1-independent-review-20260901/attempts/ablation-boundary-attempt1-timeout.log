   136	    def __post_init__(self) -> None:
   137	        if self.case_id not in _CASE_IDS:
   138	            raise RegressionValidationError("unknown case_id")
   139	        _text(self.expected_status, "expected_status")
   140	        if self.expected_status != _EXPECTED_STATUS_BY_CASE[self.case_id]:
   141	            raise RegressionValidationError("expected_status does not match the accepted A4 case")
   142	        if not isinstance(self.manual_minutes, (int, float)) or isinstance(self.manual_minutes, bool):
   143	            raise RegressionValidationError("manual_minutes must be numeric")
   144	        if not math.isfinite(self.manual_minutes) or not 0 <= self.manual_minutes <= 240:
   145	            raise RegressionValidationError("manual_minutes must be finite and within the R1 bound")
   146	        if not self.outcome_labels or set(self.outcome_labels) - _OUTCOMES:
   147	            raise RegressionValidationError("expected_outcomes must be drawn from hit, miss, gap")
   148	        if tuple(sorted(self.outcome_labels)) != self.outcome_labels:
   149	            raise RegressionValidationError("expected_outcomes must be sorted")
   150	        if len(self.routes) != len(_ROUTES) or tuple(route.route for route in self.routes) != _ROUTES:
   151	            raise RegressionValidationError("each case must retain exactly the four ordered routes")
   152	        scopes = tuple(_normalized(route.query_scope) for route in self.routes)
   153	        queries = tuple(_normalized(query) for route in self.routes for query in route.queries)
   154	        source_ids = tuple(source_id for route in self.routes for source_id in route.source_ids)
   155	        if (
   156	            len(scopes) != len(set(scopes))
   157	            or len(queries) != len(set(queries))
   158	            or len(source_ids) != len(set(source_ids))
