   253
   254	    @classmethod
   255	    def from_dict(cls, value: Mapping[str, Any]) -> "RegressionSuite":
   256	        _fields(value, {
   257	            "fixture_kind", "schema_version", "topic_id", "a4_evidence_id", "a4_evidence_digest",
   258	            "a4_source_head", "t2_fixture_sha256", "fixture_content_sha256", "route_order", "case_ids", "cases",
   259	        }, "suite")
   260	        if value["fixture_kind"] != "r1-four-route-regression" or value["schema_version"] != "1.0":
   261	            raise RegressionValidationError("unsupported regression fixture")
   262	        if value["route_order"] != list(_ROUTES):
   263	            raise RegressionValidationError("route_order must match the R1 contract")
   264	        if value["case_ids"] != list(_CASE_IDS):
   265	            raise RegressionValidationError("case_ids must match the accepted A4 archive order")
   266	        if not isinstance(value["cases"], list) or any(not isinstance(item, Mapping) for item in value["cases"]):
   267	            raise RegressionValidationError("cases must be an array of objects")
   268	        cases = tuple(RegressionCase.from_dict(item) for item in value["cases"])
   269	        if tuple(case.case_id for case in cases) != _CASE_IDS:
   270	            raise RegressionValidationError("cases must match the accepted A4 archive order")
   271	        declared_content_digest = _sha(value["fixture_content_sha256"], "fixture_content_sha256")
   272	        content = dict(value)
   273	        content.pop("fixture_content_sha256")
   274	        if (
   275	            declared_content_digest != _FIXTURE_CONTENT_DIGEST
   276	            or digest_json(content) != declared_content_digest
   277	        ):
   278	            raise RegressionValidationError("fixed regression fixture content drift")
   279	        suite = cls(
   280	            topic_id=_text(value["topic_id"], "topic_id"),
   281	            a4_evidence_id=_text(value["a4_evidence_id"], "a4_evidence_id"),
   282	            a4_evidence_digest=_sha(value["a4_evidence_digest"], "a4_evidence_digest"),
   283	            a4_source_head=_git_sha(value["a4_source_head"], "a4_source_head"),
   284	            t2_fixture_sha256=_sha(value["t2_fixture_sha256"], "t2_fixture_sha256"),
   285	            cases=cases,
   286	        )
   287	        if (
   288	            suite.topic_id != "union-closed"
   289	            or
   290	            suite.a4_evidence_id != _A4_EVIDENCE_ID
   291	            or suite.a4_evidence_digest != _A4_EVIDENCE_DIGEST
   292	            or suite.a4_source_head != _A4_SOURCE_HEAD
   293	            or suite.t2_fixture_sha256 != _T2_FIXTURE_DIGEST
   294	        ):
   295	            raise RegressionValidationError("accepted A4, T2, or topic identity drift")
   296	        source_ids = tuple(
   297	            source_id
   298	            for case in cases
   299	            for route in case.routes
   300	            for source_id in route.source_ids
   301	        )
   302	        if len(source_ids) != len(set(source_ids)):
   303	            raise RegressionValidationError("route source identities must be unique across the R1 fixture")
   304	        return suite
   305
   306	    def evaluate(self) -> RegressionEvaluation:
   307	        evaluated: list[CaseEvaluation] = []
   308	        for case in self.cases:
   309	            route_sets = tuple(set(route.hit_ids) for route in case.routes)
   310	            full = set().union(*route_sets)
   311	            ablations = []
   312	            for index, route in enumerate(case.routes):
   313	                without = set().union(*(route_sets[:index] + route_sets[index + 1:]))
   314	                incremental = tuple(sorted(route_sets[index] - without))
   315	                ablations.append(RouteAblation(route.route, incremental, tuple(sorted(full - without))))
   316	            evaluated.append(CaseEvaluation(
   317	                case_id=case.case_id,
   318	                full_hit_ids=tuple(sorted(full)),
   319	                outcome_labels=case.outcome_labels,
   320	                manual_minutes=float(case.manual_minutes),
   321	                routes=tuple(ablations),
   322	            ))
   323	        return RegressionEvaluation(_CASE_IDS, tuple(evaluated))

