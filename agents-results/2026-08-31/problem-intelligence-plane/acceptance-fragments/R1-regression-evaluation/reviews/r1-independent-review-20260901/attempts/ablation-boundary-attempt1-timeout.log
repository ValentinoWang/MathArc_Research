    43	def _fields(value: Mapping[str, Any], expected: set[str], label: str) -> None:
    44	    unknown = set(value) - expected
    45	    missing = expected - set(value)
    46	    if unknown or missing:
    47	        raise RegressionValidationError(f"{label} fields mismatch: missing={sorted(missing)}, unknown={sorted(unknown)}")
