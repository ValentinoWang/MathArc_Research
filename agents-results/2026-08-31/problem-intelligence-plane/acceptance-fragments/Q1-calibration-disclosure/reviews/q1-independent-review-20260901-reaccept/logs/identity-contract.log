    62	def _fields(value: Mapping[str, Any], expected: set[str], label: str) -> None:
    63	    unknown = set(value) - expected
    64	    missing = expected - set(value)
    65	    if unknown or missing:
    66	        raise CalibrationDisclosureError(
    67	            f"{label} fields mismatch: missing={sorted(missing)}, unknown={sorted(unknown)}"
    68	        )
    69	
    70	
    71	def _text(value: object, label: str) -> str:
    72	    if not isinstance(value, str) or not value.strip():
    73	        raise CalibrationDisclosureError(f"{label} must be non-empty text")
    74	    return value
    75	
    76	
    77	def _sha256(value: object, label: str) -> str:
    78	    if not isinstance(value, str) or not _SHA256.fullmatch(value):
    79	        raise CalibrationDisclosureError(f"{label} must be a lowercase SHA-256 digest")
    80	    return value
    81	
    82	
    83	def _string_list(value: object, label: str) -> tuple[str, ...]:
    84	    if not isinstance(value, list) or any(not isinstance(item, str) or not item for item in value):
    85	        raise CalibrationDisclosureError(f"{label} must be a text array")
    86	    result = tuple(value)
    87	    if result != tuple(sorted(result)) or len(result) != len(set(result)):
    88	        raise CalibrationDisclosureError(f"{label} must be unique and sorted")
    89	    return result
    90	
