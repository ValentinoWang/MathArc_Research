    92	def _enum(value: object, enum_type: type[_EnumValue], label: str) -> _EnumValue:
    93	    try:
    94	        return enum_type(value)
    95	    except (TypeError, ValueError) as exc:
    96	        raise CalibrationDisclosureError(f"{label} has an unsupported value") from exc
