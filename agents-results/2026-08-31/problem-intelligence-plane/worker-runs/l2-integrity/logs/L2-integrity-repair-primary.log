    50	@dataclass(frozen=True, slots=True)
    51	class SourceObservation:
    52	    """A versioned, content-addressed observation of source material."""
    53	
    54	    observation_id: str
    55	    canonical_uri: str
    56	    pinned_version: str
    57	    observed_at: str
    58	    license_status: LicenseStatus
    59	    license_basis: str
    60	    content_summary: str
    61	    summary_basis: str
    62	    media_type: str
    63	    content_digest_sha256: str = ""
    64	    artifact_id: str | None = None
    65	    status: ObservationStatus = ObservationStatus.PENDING
    66	
    67	    schema_version: str = "1.0"
    68	
    69	    def __post_init__(self) -> None:
    70	        if not isinstance(self.license_status, LicenseStatus):
    71	            raise TypeError("license_status must be a LicenseStatus")
    72	        if not isinstance(self.status, ObservationStatus):
    73	            raise TypeError("status must be an ObservationStatus")
    74	        if not self.observation_id.strip():
    75	            raise ValueError("observation_id must be non-empty")
    76	        if not self.canonical_uri.strip() or "://" not in self.canonical_uri and not self.canonical_uri.startswith("urn:"):
    77	            raise ValueError("canonical_uri must be an absolute URI or urn")
    78	        if not self.pinned_version.strip() or self.pinned_version.strip().lower() == "latest":
    79	            raise ValueError("pinned_version must be concrete, not latest")
    80	        if not self.observed_at.strip():
    81	            raise ValueError("observed_at must be non-empty")
    82	        try:
    83	            datetime.fromisoformat(self.observed_at)
    84	        except ValueError as exc:
    85	            raise ValueError("observed_at must be an ISO-8601 timestamp") from exc
    86	        if not self.license_basis.strip():
    87	            raise ValueError("license_basis must be non-empty")
    88	        if not self.content_summary.strip() or not self.summary_basis.strip():
    89	            raise ValueError("content summary and summary basis must be non-empty")
    90	        if self.media_type not in _MEDIA_TYPES:
    91	            raise ValueError(f"unsupported media_type: {self.media_type}")
    92	        if self.content_digest_sha256 and not _DIGEST_RE.fullmatch(self.content_digest_sha256):
    93	            raise ValueError("content_digest_sha256 must be a lowercase SHA-256 digest")
    94	        if self.status is ObservationStatus.OBSERVED and self.license_status is LicenseStatus.UNKNOWN:
    95	            raise ValueError("unknown license cannot produce an OBSERVED record")
    96	        if _STATUS_ASSERTION_LANGUAGE.search(self.content_summary):
    97	            raise ValueError("content_summary must remain descriptive, not proof/status language")
    98	
    99	    @property
   100	    def logical_identity(self) -> str:
   101	        normalized_uri = self.canonical_uri.strip().rstrip("/").lower()
   102	        return f"{normalized_uri}|{self.pinned_version.strip()}"
   103	
   104	    @property
   105	    def idempotency_key(self) -> str:
   106	        payload = f"{self.logical_identity}|{self.content_digest_sha256}"
   107	        return hashlib.sha256(payload.encode("utf-8")).hexdigest()
   108	
   109	    def conflicts_with(self, other: "SourceObservation") -> bool:
   110	        return self.logical_identity == other.logical_identity and (
   111	            bool(self.content_digest_sha256)
   112	            and bool(other.content_digest_sha256)
   113	            and self.content_digest_sha256 != other.content_digest_sha256
   114	        )
   115	
   116	    def to_dict(self) -> dict[str, Any]:
   117	        return {
   118	            "schema_version": self.schema_version,
   119	            "observation_id": self.observation_id,
   120	            "canonical_uri": self.canonical_uri,
   121	            "pinned_version": self.pinned_version,
   122	            "observed_at": self.observed_at,
   123	            "license_status": self.license_status.value,
   124	            "license_basis": self.license_basis,
   125	            "content_summary": self.content_summary,
   126	            "summary_basis": self.summary_basis,
   127	            "media_type": self.media_type,
   128	            "content_digest_sha256": self.content_digest_sha256,
   129	            "artifact_id": self.artifact_id,
   130	            "status": self.status.value,
   131	        }
   132	
   133	    @classmethod
   134	    def from_dict(cls, payload: Mapping[str, Any]) -> "SourceObservation":
   135	        allowed = {
   136	            "schema_version", "observation_id", "canonical_uri", "pinned_version",
   137	            "observed_at", "license_status", "license_basis", "content_summary",
   138	            "summary_basis", "media_type", "content_digest_sha256", "artifact_id", "status",
   139	        }
   140	        unknown = set(payload) - allowed
   141	        if unknown:
   142	            raise ValueError(f"unknown source-observation fields: {sorted(unknown)}")
   143	        if str(payload.get("schema_version", "1.0")) != "1.0":
   144	            raise ValueError("unsupported source-observation schema_version")
   145	        return cls(
   146	            observation_id=str(payload["observation_id"]),
   147	            canonical_uri=str(payload["canonical_uri"]),
   148	            pinned_version=str(payload["pinned_version"]),
   149	            observed_at=str(payload["observed_at"]),
   150	            license_status=LicenseStatus(str(payload["license_status"])),
   151	            license_basis=str(payload["license_basis"]),
   152	            content_summary=str(payload["content_summary"]),
   153	            summary_basis=str(payload["summary_basis"]),
   154	            media_type=str(payload["media_type"]),
   155	            content_digest_sha256=str(payload.get("content_digest_sha256", "")),
   156	            artifact_id=(str(payload["artifact_id"]) if payload.get("artifact_id") is not None else None),
   157	            status=ObservationStatus(str(payload.get("status", ObservationStatus.PENDING.value))),
   158	            schema_version="1.0",
   159	        )
   160	
   161	
   162	def new_observation(**kwargs: Any) -> SourceObservation:
   163	    """Create an observation with the current UTC timestamp by default."""
   164	
   165	    kwargs.setdefault("observed_at", utc_now())
   166	    return SourceObservation(**kwargs)

