    31	
    32	_DIGEST_RE = re.compile(r"^[0-9a-f]{64}$")
    33	_STATUS_ASSERTION_LANGUAGE = re.compile(
    34	    r"\b(?:proved|proof|solved|novel)\b|"
    35	    r"\b(?:open|closed)\s+(?:problem|question|conjecture)\b|"
    36	    r"\b(?:remains?|is|was)\s+(?:provably\s+)?open\b",
    37	    re.I,
    38	)
    39	_MEDIA_TYPES = frozenset(
    40	    {
    41	        "application/json",
    42	        "application/pdf",
    43	        "application/octet-stream",
    44	        "text/html",
    45	        "text/plain",
    46	    }
