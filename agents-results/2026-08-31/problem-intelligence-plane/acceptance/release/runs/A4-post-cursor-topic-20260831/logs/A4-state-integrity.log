+            "schema_version": _SCHEMA_VERSION,
+            "topic_id": topic_id,
+            "cursor": cursor,
+            "next_cursor": next_cursor,
+            "inputs": [input_fingerprints[input_id] for input_id in sorted(input_fingerprints)],
+        }
+    )
