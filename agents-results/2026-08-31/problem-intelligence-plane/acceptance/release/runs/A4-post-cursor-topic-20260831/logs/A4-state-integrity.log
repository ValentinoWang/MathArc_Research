+def _require_sha256_or_empty(value: object, name: str) -> str:
+    if value == "":
+        return ""
+    return _require_sha256(value, name)
+
+
+def _require_optional_sha256(value: object, name: str) -> None:
+    if value is not None:
+        _require_sha256(value, name)
