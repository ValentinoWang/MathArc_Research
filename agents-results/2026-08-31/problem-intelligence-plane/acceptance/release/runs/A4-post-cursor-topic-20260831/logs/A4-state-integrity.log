+    *,
+    topic_id: str,
+    cursor: str,
+    input_id: str,
+    reason: ManualReviewReason,
+    detail: str,
+) -> str:
+    identity = f"{topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
+    return "manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
