    50	    def test_single_topic_batch_replays_after_restart_without_second_import(self) -> None:
    51	        with tempfile.TemporaryDirectory() as directory:
    52	            first_runner = TopicObservationRunner(directory, topic_id="union-closed", initial_cursor="c0")
