   102	
   103	def _require_nonempty(value: object, name: str) -> str:
   104	    if not isinstance(value, str) or not value.strip():
   105	        raise TopicObservationError(f"{name} must be non-empty")
   106	    return value
   107	
   108	
   109	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   110	    unknown = set(payload) - expected
   111	    missing = expected - set(payload)
   112	    if unknown:
   113	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   114	    if missing:
   115	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   116	
   117	
   118	def _require_sha256(value: object, name: str) -> str:
   119	    if (
   120	        not isinstance(value, str)
   121	        or len(value) != 64
   122	        or any(character not in "0123456789abcdef" for character in value)
   123	    ):
   124	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   125	    return value
   126	
   127	
   128	def _require_sha256_or_empty(value: object, name: str) -> str:
   129	    if value == "":
   130	        return ""
   131	    return _require_sha256(value, name)
   132	
   133	
   134	def _require_optional_sha256(value: object, name: str) -> None:
   135	    if value is not None:
   136	        _require_sha256(value, name)
   137	
   138	
   139	def _batch_digest_from_fingerprints(
   140	    *,
   141	    topic_id: str,
   142	    cursor: str,
   143	    next_cursor: str,
   144	    input_fingerprints: Mapping[str, str],
   145	) -> str:
   146	    return digest_json(
   147	        {
   148	            "schema_version": _SCHEMA_VERSION,
   149	            "topic_id": topic_id,
   150	            "cursor": cursor,
   151	            "next_cursor": next_cursor,
   152	            "inputs": [input_fingerprints[input_id] for input_id in sorted(input_fingerprints)],
   153	        }
   154	    )
   155	
   156	
   157	def _input_projection_digest(
   158	    *,
   159	    topic_id: str,
   160	    cursor: str,
   161	    next_cursor: str,
   162	    batch_digest_sha256: str,
   163	    input_projections: Mapping[str, Mapping[str, Any]],
   164	) -> str:
   165	    return digest_json(
   166	        {
   167	            "schema_version": _SCHEMA_VERSION,
   168	            "topic_id": topic_id,
   169	            "cursor": cursor,
   170	            "next_cursor": next_cursor,
   171	            "batch_digest_sha256": batch_digest_sha256,
   172	            "inputs": [
   173	                input_projections[input_id]
   174	                for input_id in sorted(input_projections)
   175	            ],
   176	        }
   177	    )
   178	
   179	
   180	def _canonical_input_projection(value: object) -> dict[str, Any]:
   181	    if not isinstance(value, dict):
   182	        raise TopicObservationError("stored input projection is malformed")
   183	    _require_fields(value, _INPUT_PROJECTION_FIELDS, "input projection")
   184	    input_id = _require_nonempty(value["input_id"], "stored input projection input_id")
   185	    observation_payload = value["observation"]
   186	    if not isinstance(observation_payload, dict):
   187	        raise TopicObservationError("stored input projection observation is malformed")
   188	    try:
   189	        observation = SourceObservation.from_dict(observation_payload)
   190	    except (KeyError, TypeError, ValueError) as exc:
   191	        raise TopicObservationError("stored input projection observation is invalid") from exc
   192	    content_sha256 = _require_sha256(
   193	        value["content_sha256"],
   194	        "stored input projection content digest",
   195	    )
   196	    content_size_bytes = value["content_size_bytes"]
   197	    if (
   198	        isinstance(content_size_bytes, bool)
   199	        or not isinstance(content_size_bytes, int)
   200	        or content_size_bytes < 0
   201	    ):
   202	        raise TopicObservationError("stored input projection content size is invalid")
   203	    risk_flags = value["risk_flags"]
   204	    if not isinstance(risk_flags, list):
   205	        raise TopicObservationError("stored input projection risk flags are invalid")
   206	    if any(not isinstance(flag, str) or not flag.strip() for flag in risk_flags):
   207	        raise TopicObservationError("stored input projection risk flags are invalid")
   208	    if risk_flags != sorted(set(risk_flags)):
   209	        raise TopicObservationError("stored input projection risk flags must be sorted and unique")
   210	    canonical = {
   211	        "input_id": input_id,
   212	        "observation": observation.to_dict(),
   213	        "content_sha256": content_sha256,
   214	        "content_size_bytes": content_size_bytes,
   215	        "risk_flags": risk_flags,
   216	    }
   217	    if value != canonical:
   218	        raise TopicObservationError("stored input projection is not canonical")
   219	    return canonical
