   438	    def _assert_contract_results(self, result: Mapping[str, Any]) -> None:
   439	        raw_cases = result.get("cases")
   440	        expected_ids = tuple(case["problem_id"] for case in self.contract["cases"])
   441	        if (
   442	            not isinstance(raw_cases, list)
   443	            or any(not isinstance(case, dict) or not isinstance(case.get("problem_id"), str) for case in raw_cases)
   444	        ):
   445	            raise DogfoodArchiveError(
   446	                "persisted result must contain exactly the contract case IDs once each"
   447	            )
   448	        case_ids = [case["problem_id"] for case in raw_cases]
   449	        if (
   450	            len(case_ids) != len(expected_ids)
   451	            or len(set(case_ids)) != len(case_ids)
   452	            or set(case_ids) != set(expected_ids)
   453	        ):
   454	            raise DogfoodArchiveError(
   455	                "persisted result must contain exactly the contract case IDs once each"
   456	            )
   457	        cases = {case["problem_id"]: case for case in raw_cases}
   458	        for expected in self.contract["cases"]:
   459	            actual = cases.get(expected["problem_id"])
   460	            if actual is None:
   461	                raise DogfoodArchiveError("persisted result is missing a contract case")
   462	            self._validate_case_shape(actual)
   463	            for field in ("promotion_allowed", "claim_created", "trace_created"):
