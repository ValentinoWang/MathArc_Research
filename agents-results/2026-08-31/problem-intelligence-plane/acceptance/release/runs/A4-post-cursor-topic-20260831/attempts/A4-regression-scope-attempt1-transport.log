   300	    def __post_init__(self) -> None:
   301	        _require_nonempty(self.topic_id, "topic_id")
   302	        _require_nonempty(self.cursor, "cursor")
   303	        _require_nonempty(self.next_cursor, "next_cursor")
   304	        if self.cursor == self.next_cursor:
   305	            raise TopicObservationError("next_cursor must advance beyond cursor")
   306	        if not isinstance(self.inputs, tuple) or not self.inputs:
   307	            raise TopicObservationError("inputs must be a non-empty tuple")
   308	        if any(not isinstance(item, TopicObservationInput) for item in self.inputs):
   309	            raise TypeError("inputs must contain TopicObservationInput records")
   310	        identifiers = tuple(item.input_id for item in self.inputs)
   311	        if len(identifiers) != len(set(identifiers)) or tuple(sorted(identifiers)) != identifiers:
   312	            raise TopicObservationError("input ids must be sorted and unique")
   313	        if self.schema_version != _SCHEMA_VERSION:
   314	            raise TopicObservationError("unsupported topic-observation batch schema_version")
   315	
   316	    @property
   317	    def batch_digest_sha256(self) -> str:
   318	        return _batch_digest_from_fingerprints(
   319	            topic_id=self.topic_id,
   320	            cursor=self.cursor,
   321	            next_cursor=self.next_cursor,
   322	            input_fingerprints={
   323	                item.input_id: item.fingerprint_sha256 for item in self.inputs
   324	            },
   325	        )
