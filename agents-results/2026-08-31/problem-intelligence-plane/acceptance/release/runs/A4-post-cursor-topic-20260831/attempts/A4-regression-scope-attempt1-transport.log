   363	    @staticmethod
   364	    def _read_json_object(path: Path, name: str) -> dict[str, Any]:
   365	        try:
   366	            payload = json.loads(path.read_text(encoding="utf-8"))
   367	        except (OSError, json.JSONDecodeError) as exc:
   368	            raise DogfoodArchiveError(f"{name} is unreadable") from exc
   369	        if not isinstance(payload, dict):
   370	            raise DogfoodArchiveError(f"{name} must be an object")
   371	        return payload
