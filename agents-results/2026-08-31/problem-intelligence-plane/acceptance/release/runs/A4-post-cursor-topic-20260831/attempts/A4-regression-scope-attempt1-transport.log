   433	        expected_archive, expected_states = self._canonical_expected_execution(fixtures, specs)
   434	        self._assert_contract_results(payload)
   435	        self._assert_canonical_execution(payload, expected_archive, expected_states)
   436	        payload["replayed"] = True; self._save(payload); return payload
