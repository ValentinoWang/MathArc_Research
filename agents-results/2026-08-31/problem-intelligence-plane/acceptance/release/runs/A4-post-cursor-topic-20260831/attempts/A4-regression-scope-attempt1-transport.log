   276	        for field in (
   277	            "problem_id", "case_role", "topic_status", "replay_status", "review_boundary",
   278	        ):
   279	            _text(case[field], f"persisted case {field}")
   280	        if case["manual_reason"] is not None:
   281	            _text(case["manual_reason"], "persisted case manual_reason")
   282	        for field in ("promotion_allowed", "claim_created", "trace_created"):
   283	            cls._require_bool(case[field], f"persisted case {field}")
