   392	    def _assert_canonical_execution(
   393	        self,
   394	        payload: Mapping[str, Any],
   395	        expected_archive: Mapping[str, Any],
   396	        expected_states: Mapping[str, Mapping[str, Any]],
   397	    ) -> None:
   398	        for relative, expected_state in expected_states.items():
   399	            actual_state = self._read_json_object(self.root / relative, f"persisted {relative}")
   400	            if actual_state != expected_state:
   401	                raise DogfoodArchiveError(
   402	                    "persisted topic observation state does not match canonical dogfood state"
   403	                )
   404	        if (
   405	            self._archive_body(payload) != self._archive_body(expected_archive)
   406	            or payload["archive_digest_sha256"] != expected_archive["archive_digest_sha256"]
   407	        ):
