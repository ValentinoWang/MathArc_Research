   487	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   488	        if not isinstance(batch, TopicObservationBatch):
   489	            raise TypeError("batch must be a TopicObservationBatch")
   490	        if batch.topic_id != self.topic_id:
   491	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   492	        with self._writer_lock():
   493	            self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
   494	            state = self._load_state()
   495	            batches = state["batches"]
   496	            previous = batches.get(batch.cursor)
   497	            if previous is not None:
   498	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   499	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   500	                manual = self._add_manual(
   501	                    state,
   502	                    cursor=batch.cursor,
   503	                    input_id="cursor",
   504	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   505	                    detail="A cursor was replayed with different batch content.",
   506	                )
   507	                self._record_manual_event(state, manual)
   508	                self._save_state(state)
   509	                return TopicBatchResult(
   510	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   511	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   512	                )
   513	            if batch.cursor != state["next_cursor"]:
   514	                manual = self._add_manual(
   515	                    state,
   516	                    cursor=batch.cursor,
   517	                    input_id="cursor",
   518	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   519	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   520	                )
   521	                self._record_manual_event(state, manual)
   522	                self._save_state(state)
   523	                return TopicBatchResult(
   524	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   525	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   526	                )
   527	
   528	            results: list[TopicItemResult] = []
   529	            disposition_evidence: dict[str, dict[str, Any]] = {}
   530	            for item in batch.inputs:
   531	                result, evidence = self._process_input(state, batch, item)
   532	                results.append(result)
   533	                disposition_evidence[item.input_id] = evidence
   534	            status = TopicRunStatus.MANUAL_REVIEW if any(
   535	                item.status is TopicItemStatus.MANUAL_REVIEW for item in results
   536	            ) else TopicRunStatus.APPLIED
   537	            result = TopicBatchResult(self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results))
