   330	    @classmethod
   331	    def _validate_archive_shape(cls, payload: Mapping[str, Any]) -> None:
   332	        _fields(payload, _ARCHIVE_FIELDS, "persisted archive")
   333	        for field in (
   334	            "schema_version", "recovery_contract", "topic_id", "contract_digest_sha256",
   335	            "fixture_identity_digest_sha256", "source_identity_digest_sha256", "budget_digest_sha256",
   336	            "archive_digest_sha256",
   337	        ):
   338	            _text(payload[field], f"persisted archive {field}")
   339	        for field in (
   340	            "contract_digest_sha256", "fixture_identity_digest_sha256", "source_identity_digest_sha256",
   341	            "budget_digest_sha256", "archive_digest_sha256",
   342	        ):
   343	            value = payload[field]
   344	            if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
   345	                raise DogfoodArchiveError(f"persisted archive {field} must be a lowercase SHA-256 digest")
   346	        cls._require_bool(payload["replayed"], "persisted archive replayed")
   347	        cls._require_bool(payload["archive_blocked"], "persisted archive archive_blocked")
   348	        cls._require_bool(payload["no_claim_or_trace_created"], "persisted archive no_claim_or_trace_created")
   349	        if not isinstance(payload["fixture_files"], list) or any(
   350	            not isinstance(item, str) for item in payload["fixture_files"]
   351	        ):
   352	            raise DogfoodArchiveError("persisted archive fixture_files must be an array of strings")
   353	        cls._require_string_list(payload["blocking_manual_ids"], "persisted archive blocking_manual_ids")
   354	        if not isinstance(payload["blocking_manual_queue"], list):
   355	            raise DogfoodArchiveError("persisted archive blocking_manual_queue must be an array")
   356	        if not isinstance(payload["cases"], list):
   357	            raise DogfoodArchiveError("persisted archive cases must be an array")
   358	        for case in payload["cases"]:
   359	            cls._validate_case_shape(case)
   360	        if not isinstance(payload["budget_snapshot"], dict):
   361	            raise DogfoodArchiveError("persisted archive budget_snapshot must be an object")
