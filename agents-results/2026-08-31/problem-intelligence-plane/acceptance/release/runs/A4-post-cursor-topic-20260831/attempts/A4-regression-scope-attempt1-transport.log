   416	        residual_budget = self._new_residual_budget()
   417	        residual = TopicObservationRunner(self.root / "residual-budget", topic_id=_TOPIC_ID, initial_cursor="budget-c0", budget=residual_budget)
   418	        if not (main.next_cursor == "dogfood-c4" and residual.next_cursor == "budget-c1"):
   419	            raise DogfoodArchiveError("topic observation state is missing or has invalid cursor")
   420	        blocking_entries = self._manual_queue_entries(main, residual)
   421	        manual_ids = [item["manual_id"] for item in blocking_entries]
   422	        if manual_ids != payload["blocking_manual_ids"] or digest_json(blocking_entries) != digest_json(payload["blocking_manual_queue"]):
   423	            raise DogfoodArchiveError("topic observation manual queue does not match persisted archive")
   424	        if len(main.literature.observations) != 4 or len(residual.literature.observations) != 0:
   425	            raise DogfoodArchiveError("topic observation ArtifactStore state is missing or inconsistent")
   426	        reconstructed_budget = residual_budget.to_dict()
   427	        if self.contract["expected_budget_snapshot"] != reconstructed_budget:
   428	            raise DogfoodArchiveError("reconstructed residual budget does not match T2 contract")
   429	        if payload["budget_snapshot"] != reconstructed_budget:
   430	            raise DogfoodArchiveError("persisted budget snapshot does not match reconstructed residual budget")
   431	        if not payload["no_claim_or_trace_created"] or not self._no_claim_or_trace_created(): raise DogfoodArchiveError("claim or trace artifact is forbidden on replay")
