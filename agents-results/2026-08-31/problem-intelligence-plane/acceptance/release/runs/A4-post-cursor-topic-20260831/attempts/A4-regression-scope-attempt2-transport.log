    68	    def run(self) -> dict[str, Any]:
    69	        self.contract = self._load_contract()
    70	        fixtures = self._load_s1_fixtures()
    71	        specs = self._load_source_specs()
    72	        try:
    73	            if self.result_path.exists(): return self._replay(specs)
