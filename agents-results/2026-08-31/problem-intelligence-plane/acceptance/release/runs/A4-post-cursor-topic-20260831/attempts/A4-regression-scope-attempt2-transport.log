   630	        if item.observation.idempotency_key in state["seen_observation_keys"]:
   631	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   632	            result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   633	            return result, self._item_evidence(
   634	                item,
