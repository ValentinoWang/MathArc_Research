   154	    def _load_source_specs(self) -> dict[str, list[dict[str, str]]]:
   155	        raw, specs = self.contract["source_artifacts"], {}
   156	        required = {"path", "sha256", "canonical_uri", "pinned_version", "locator"}
   157	        for problem_id in _CASE_ORDER:
   158	            if problem_id not in raw: raise DogfoodArchiveError(f"missing source_artifacts for {problem_id}")
   159	            entries = raw[problem_id] if isinstance(raw[problem_id], list) else [raw[problem_id]]
   160	            specs[problem_id] = []
   161	            for item in entries:
   162	                if not isinstance(item, dict): raise DogfoodArchiveError("source artifact spec must be an object")
   163	                _fields(item, required | ({"source_kind", "reported_status"} if problem_id == _CASE_ORDER[1] else set()), "source artifact spec")
   164	                path = self.contract_path.parent / item["path"]
   165	                if not path.is_file(): raise DogfoodArchiveError(f"missing source artifact: {item['path']}")
   166	                content = path.read_bytes()
   167	                if hashlib.sha256(content).hexdigest() != item["sha256"]: raise DogfoodArchiveError(f"source artifact digest mismatch: {item['path']}")
   168	                for field in required: _text(item[field], field)
   169	                specs[problem_id].append(dict(item))
   170	        return specs
