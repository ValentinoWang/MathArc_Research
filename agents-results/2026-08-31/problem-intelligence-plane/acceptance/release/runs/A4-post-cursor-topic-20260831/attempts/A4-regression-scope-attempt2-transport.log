   856	    @contextmanager
   857	    def _writer_lock(self) -> Iterator[None]:
   858	        self.lock_path.touch(exist_ok=True)
   859	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   860	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   861	            try:
   862	                yield
   863	            finally:
   864	                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
