   111	    missing = expected - set(payload)
   112	    if unknown:
   113	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   114	    if missing:
   115	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
