   179	
   180	def _canonical_input_projection(value: object) -> dict[str, Any]:
   181	    if not isinstance(value, dict):
   182	        raise TopicObservationError("stored input projection is malformed")
   183	    _require_fields(value, _INPUT_PROJECTION_FIELDS, "input projection")
   184	    input_id = _require_nonempty(value["input_id"], "stored input projection input_id")
   185	    observation_payload = value["observation"]
   186	    if not isinstance(observation_payload, dict):
   187	        raise TopicObservationError("stored input projection observation is malformed")
   188	    try:
   189	        observation = SourceObservation.from_dict(observation_payload)
   190	    except (KeyError, TypeError, ValueError) as exc:
   191	        raise TopicObservationError("stored input projection observation is invalid") from exc
   192	    content_sha256 = _require_sha256(
   193	        value["content_sha256"],
   194	        "stored input projection content digest",
   195	    )
   196	    content_size_bytes = value["content_size_bytes"]
   197	    if (
   198	        isinstance(content_size_bytes, bool)
   199	        or not isinstance(content_size_bytes, int)
   200	        or content_size_bytes < 0
   201	    ):
   202	        raise TopicObservationError("stored input projection content size is invalid")
   203	    risk_flags = value["risk_flags"]
   204	    if not isinstance(risk_flags, list):
   205	        raise TopicObservationError("stored input projection risk flags are invalid")
   206	    if any(not isinstance(flag, str) or not flag.strip() for flag in risk_flags):
   207	        raise TopicObservationError("stored input projection risk flags are invalid")
   208	    if risk_flags != sorted(set(risk_flags)):
   209	        raise TopicObservationError("stored input projection risk flags must be sorted and unique")
   210	    canonical = {
   211	        "input_id": input_id,
   212	        "observation": observation.to_dict(),
   213	        "content_sha256": content_sha256,
   214	        "content_size_bytes": content_size_bytes,
   215	        "risk_flags": risk_flags,
   216	    }
   217	    if value != canonical:
   218	        raise TopicObservationError("stored input projection is not canonical")
   219	    return canonical
   220	
