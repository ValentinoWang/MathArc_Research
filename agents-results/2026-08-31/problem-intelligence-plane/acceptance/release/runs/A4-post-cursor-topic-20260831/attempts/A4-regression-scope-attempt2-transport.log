    76	            raise
    77	        except ManualQueueObservationError as exc:
    78	            raise DogfoodArchiveError(
    79	                f"topic observation manual queue does not match persisted archive: {exc}"
    80	            ) from exc
    81	        except TopicObservationError as exc:
    82	            raise DogfoodArchiveError(
    83	                f"topic observation state is missing or invalid: {exc}"
    84	            ) from exc
    85	        except (KeyError, TypeError, ValueError, OSError) as exc:
    86	            raise DogfoodArchiveError(
    87	                f"topic observation state is missing or invalid: {exc}"
    88	            ) from exc
