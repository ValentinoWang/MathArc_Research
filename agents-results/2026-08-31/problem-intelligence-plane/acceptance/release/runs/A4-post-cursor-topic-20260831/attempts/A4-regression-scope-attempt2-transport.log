    90	    def _load_contract(self) -> dict[str, Any]:
    91	        try: contract = json.loads(self.contract_path.read_text(encoding="utf-8"))
    92	        except (OSError, json.JSONDecodeError) as exc: raise DogfoodArchiveError("T2 contract is unreadable") from exc
    93	        if not isinstance(contract, dict): raise DogfoodArchiveError("T2 contract must be an object")
    94	        _fields(contract, {"fixture_kind", "topic_id", "source_fixture_directory", "fixture_sha256", "source_artifacts", "expected_budget_snapshot", "expected_budget_digest_sha256", "non_claim_boundary", "cases"}, "T2 contract")
    95	        if contract["fixture_kind"] != "t2-dogfood-archive-contract" or contract["topic_id"] != _TOPIC_ID: raise DogfoodArchiveError("incompatible T2 contract identity")
    96	        if not isinstance(contract["cases"], list) or len(contract["cases"]) != 3: raise DogfoodArchiveError("T2 contract must define exactly three cases")
    97	        case_fields = {"problem_id", "case_role", "expected_topic_status", "expected_problem_status", "expected_manual_reason", "expected_novelty_status", "expected_promotion_allowed"}
    98	        ids = []
    99	        for case in contract["cases"]:
   100	            if not isinstance(case, dict): raise DogfoodArchiveError("T2 contract case must be an object")
   101	            _fields(case, case_fields, "T2 contract case")
   102	            problem_id = _text(case["problem_id"], "contract problem_id")
   103	            if problem_id not in _ROLES or case["case_role"] != _ROLES[problem_id]: raise DogfoodArchiveError("unknown or mismatched contract case")
   104	            if case["expected_promotion_allowed"] is not False: raise DogfoodArchiveError("dogfood promotion must remain disabled")
   105	            ids.append(problem_id)
   106	        if tuple(ids) != _CASE_ORDER: raise DogfoodArchiveError("contract case order or identity drift")
   107	        if set(contract["fixture_sha256"]) != set(_S1_NAMES) or any(not isinstance(value, str) or len(value) != 64 for value in contract["fixture_sha256"].values()):
   108	            raise DogfoodArchiveError("fixture_sha256 must cover exactly the three S1 fixtures")
   109	        if contract["expected_budget_snapshot"] != self._new_residual_budget().to_dict():
   110	            raise DogfoodArchiveError("T2 contract budget identity is incompatible")
   111	        if contract["expected_budget_digest_sha256"] != digest_json(contract["expected_budget_snapshot"]):
   112	            raise DogfoodArchiveError("T2 contract budget digest mismatch")
   113	        if not isinstance(contract["source_artifacts"], dict): raise DogfoodArchiveError("source_artifacts must be an object")
   114	        return contract
