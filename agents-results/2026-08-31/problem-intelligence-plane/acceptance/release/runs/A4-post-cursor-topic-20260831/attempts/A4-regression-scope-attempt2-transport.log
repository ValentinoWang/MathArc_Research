   222	def _fingerprint_from_input_projection(
   223	    projection: Mapping[str, Any],
   224	) -> str:
   225	    return digest_json(
   226	        {
   227	            "input_id": projection["input_id"],
   228	            "observation": projection["observation"],
   229	            "content_sha256": projection["content_sha256"],
   230	            "risk_flags": projection["risk_flags"],
   231	        }
   232	    )
