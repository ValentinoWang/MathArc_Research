    61	    def __init__(self, root: str | Path, fixture_root: str | Path) -> None:
    62	        self.root, self.fixture_root = Path(root), Path(fixture_root)
    63	        self.root.mkdir(parents=True, exist_ok=True)
    64	        self.contract_path = self.fixture_root / "three-real-archives.json"
    65	        if not self.contract_path.exists(): self.contract_path = self.fixture_root.parent / "t2-fixtures" / "three-real-archives.json"
