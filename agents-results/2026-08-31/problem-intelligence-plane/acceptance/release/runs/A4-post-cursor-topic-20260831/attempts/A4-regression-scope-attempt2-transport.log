   719	    def _item_evidence(
   720	        self,
   721	        item: TopicObservationInput,
   722	        result: TopicItemResult,
   723	        basis: str,
   724	        *,
   725	        persisted: SourceObservation | None = None,
   726	        manual_id: str | None = None,
   727	        manual_reason: ManualReviewReason | None = None,
   728	        import_disposition: ImportDisposition | None = None,
   729	        prior_cursor: str | None = None,
   730	        prior_input_id: str | None = None,
   731	    ) -> dict[str, Any]:
   732	        persisted_status = "ABSENT"
   733	        persisted_observation_id = None
   734	        persisted_content_digest = None
   735	        persisted_artifact_id = None
   736	        persisted_artifact_sha256 = None
   737	        if persisted is not None:
   738	            persisted_status = persisted.status.value
   739	            persisted_observation_id = persisted.observation_id
   740	            persisted_content_digest = persisted.content_digest_sha256
   741	            if persisted.status is ObservationStatus.OBSERVED:
   742	                if persisted.artifact_id is None:
   743	                    raise TopicObservationError("observed literature evidence has no artifact")
   744	                try:
   745	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
   746	                except KeyError as exc:
   747	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
   748	                persisted_artifact_id = artifact.artifact_id
   749	                persisted_artifact_sha256 = artifact.sha256
   750	        return {
   751	            "basis": basis,
   752	            "input_id": item.input_id,
   753	            "input_observation_id": item.observation.observation_id,
   754	            "input_idempotency_key": item.observation.idempotency_key,
   755	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   756	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   757	            "input_content_size_bytes": len(item.content),
   758	            "input_risk_flags": list(item.risk_flags),
   759	            "observation_id": result.observation_id,
   760	            "persisted_observation_id": persisted_observation_id,
   761	            "persisted_observation_status": persisted_status,
   762	            "persisted_content_digest_sha256": persisted_content_digest,
   763	            "persisted_artifact_id": persisted_artifact_id,
   764	            "persisted_artifact_sha256": persisted_artifact_sha256,
   765	            "manual_id": manual_id,
   766	            "manual_reason": manual_reason.value if manual_reason is not None else None,
   767	            "prior_cursor": prior_cursor,
   768	            "prior_input_id": prior_input_id,
   769	            "import_disposition": import_disposition.value if import_disposition is not None else None,
   770	        }
