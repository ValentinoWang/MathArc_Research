   772	    def _persisted_observation_for_input(
   773	        self,
   774	        item: TopicObservationInput,
   775	    ) -> SourceObservation | None:
   776	        candidates = [
   777	            observation
   778	            for observation in self.literature.observations
   779	            if observation.observation_id == item.observation.observation_id
   780	            or observation.idempotency_key == item.observation.idempotency_key
   781	        ]
   782	        if not candidates:
   783	            return None
   784	        status_order = {
   785	            ObservationStatus.OBSERVED: 0,
   786	            ObservationStatus.PENDING: 1,
   787	            ObservationStatus.CONFLICT: 2,
   788	            ObservationStatus.REJECTED: 3,
   789	        }
   790	        return min(
   791	            candidates,
   792	            key=lambda observation: (
   793	                status_order[observation.status],
   794	                observation.observation_id,
   795	            ),
   796	        )
   797	
   798	    @staticmethod
   799	    def _prior_input_cursor(
   800	        state: Mapping[str, Any],
   801	        input_id: str,
   802	        fingerprint: str,
   803	    ) -> str | None:
   804	        matches = [
   805	            cursor
   806	            for cursor, stored in state["batches"].items()
   807	            if isinstance(stored, dict)
   808	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
   809	        ]
   810	        return sorted(matches)[0] if matches else None
   811	
   812	    @staticmethod
   813	    def _record_manual_event(
   814	        state: dict[str, Any],
   815	        manual: ManualReviewItem,
   816	    ) -> None:
   817	        existing = {item["manual_id"] for item in state["manual_events"]}
   818	        if manual.manual_id not in existing:
   819	            state["manual_events"].append(
   820	                {
   821	                    "event_type": "CURSOR_CONFLICT",
   822	                    "manual_id": manual.manual_id,
   823	                }
   824	            )
   825	            state["manual_events"].sort(key=lambda item: item["manual_id"])
   826	
   827	    def _add_manual(
   828	        self,
   829	        state: dict[str, Any],
   830	        *,
   831	        cursor: str,
   832	        input_id: str,
   833	        reason: ManualReviewReason,
   834	        detail: str,
   835	    ) -> ManualReviewItem:
   836	        manual = ManualReviewItem(
   837	            manual_id=_manual_id_for(
   838	                topic_id=self.topic_id,
   839	                cursor=cursor,
   840	                input_id=input_id,
   841	                reason=reason,
   842	                detail=detail,
   843	            ),
   844	            topic_id=self.topic_id,
   845	            cursor=cursor,
   846	            input_id=input_id,
   847	            reason=reason,
   848	            detail=detail,
   849	        )
   850	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
   851	        if manual.manual_id not in existing:
   852	            state["manual_queue"].append(manual.to_dict())
   853	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
   854	        return manual
