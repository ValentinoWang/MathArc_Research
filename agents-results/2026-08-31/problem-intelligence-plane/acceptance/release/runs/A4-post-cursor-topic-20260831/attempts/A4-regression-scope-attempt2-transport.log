   213	    def _reported_status(self, fixture, provenance, observations, runner):
   214	        statement = StatementVersion(fixture["problem_id"], fixture["statement_version"], fixture["statement"])
   215	        cert = OpenStatusCertificate(f"status-{fixture['problem_id']}", fixture["problem_id"], fixture["statement_version"], statement.statement_version_id, statement.statement_digest_sha256, tuple(ObservationDigestRef.from_observation(observations[key]) for key in sorted({p["source_id"] for p in provenance})), ProblemStatus(fixture["expected_report_status"]), tuple(fixture["limitations"]), "dogfood-status-reporter", "2026-08-31T11:15:00+00:00", "2026-09-30T00:00:00+00:00")
   216	        dossier = ProblemDossierSnapshot(f"dossier-{fixture['problem_id']}", fixture["problem_id"], fixture["statement_version"], statement, cert, "2026-08-31T11:20:00+00:00")
   217	        validation = dossier.validate(observations, as_of="2026-08-31T12:00:00+00:00", artifacts=runner.literature.artifacts)
   218	        if validation.status is not cert.status: raise DogfoodArchiveError("source readback status mismatch")
