   638	            )
   639	
   640	        imported = self.literature.import_bytes(item.observation, item.content)
   641	        if imported.disposition in {ImportDisposition.IMPORTED, ImportDisposition.IDEMPOTENT}:
   642	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   643	            state["seen_observation_keys"].append(item.observation.idempotency_key)
   644	            state["seen_observation_keys"].sort()
   645	            status = TopicItemStatus.IMPORTED if imported.disposition is ImportDisposition.IMPORTED else TopicItemStatus.IDEMPOTENT
   646	            result = TopicItemResult(item.input_id, status, imported.observation.observation_id)
   647	            return result, self._item_evidence(
   648	                item,
   649	                result,
   650	                "NEW_IMPORT" if status is TopicItemStatus.IMPORTED else "EXISTING_OBSERVED",
   651	                persisted=imported.observation,
