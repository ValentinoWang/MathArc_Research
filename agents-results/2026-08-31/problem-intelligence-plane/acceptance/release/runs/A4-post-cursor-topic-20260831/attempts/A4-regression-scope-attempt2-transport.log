   235	def _manual_id_for(
   236	    *,
   237	    topic_id: str,
   238	    cursor: str,
   239	    input_id: str,
   240	    reason: ManualReviewReason,
   241	    detail: str,
   242	) -> str:
   243	    identity = f"{topic_id}|{cursor}|{input_id}|{reason.value}|{detail}"
   244	    return "manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
