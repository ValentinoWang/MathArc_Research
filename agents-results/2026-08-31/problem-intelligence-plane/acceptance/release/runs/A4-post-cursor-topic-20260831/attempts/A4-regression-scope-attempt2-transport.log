   684	                item,
   685	                result,
   686	                "MANUAL_QUEUE",
   687	                persisted=self._persisted_observation_for_input(item),
   688	                manual_id=manual.manual_id,
   689	                manual_reason=ManualReviewReason.LITERATURE_IMPORT_FAILURE,
   690	                import_disposition=imported.disposition,
