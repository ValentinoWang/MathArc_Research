   157	def _input_projection_digest(
   158	    *,
   159	    topic_id: str,
   160	    cursor: str,
   161	    next_cursor: str,
   162	    batch_digest_sha256: str,
   163	    input_projections: Mapping[str, Mapping[str, Any]],
   164	) -> str:
   165	    return digest_json(
   166	        {
   167	            "schema_version": _SCHEMA_VERSION,
   168	            "topic_id": topic_id,
   169	            "cursor": cursor,
   170	            "next_cursor": next_cursor,
   171	            "batch_digest_sha256": batch_digest_sha256,
   172	            "inputs": [
