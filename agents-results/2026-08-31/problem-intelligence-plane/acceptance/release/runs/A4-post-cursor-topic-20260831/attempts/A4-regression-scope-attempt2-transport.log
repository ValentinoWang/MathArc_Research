   172	    def _inputs_for(self, fixture: Mapping[str, Any], specs: list[dict[str, str]]) -> tuple[tuple[TopicObservationInput, ...], list[dict[str, str]]]:
   173	        inputs, provenance = [], []
   174	        for index, spec in enumerate(specs):
