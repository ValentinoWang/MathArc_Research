   222	        statement = StatementVersion(fixture["problem_id"], fixture["statement_version"], fixture["statement"])
   223	        cert = OpenStatusCertificate(f"status-{fixture['problem_id']}-budget", fixture["problem_id"], fixture["statement_version"], statement.statement_version_id, statement.statement_digest_sha256, (ObservationDigestRef.from_observation(observation),), ProblemStatus(fixture["expected_report_status"]), tuple(fixture["limitations"]), "dogfood-status-reporter", "2026-08-31T11:15:00+00:00", "2026-09-30T00:00:00+00:00")
