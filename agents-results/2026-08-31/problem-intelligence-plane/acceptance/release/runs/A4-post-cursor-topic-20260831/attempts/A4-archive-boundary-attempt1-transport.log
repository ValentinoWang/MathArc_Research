   882	        try:
   883	            payload = json.loads(self.state_path.read_text(encoding="utf-8"))
   884	        except (OSError, json.JSONDecodeError) as exc:
   885	            raise TopicObservationError("topic observation state is unreadable") from exc
   886	        if not isinstance(payload, dict):
   887	            raise TopicObservationError("topic observation state must be an object")
   888	        schema_version = payload.get("schema_version")
   889	        if schema_version in _LEGACY_STATE_SCHEMA_VERSIONS:
   890	            raise TopicObservationError(
   891	                f"topic observation state schema_version {schema_version!r} is legacy; "
   892	                f"recovery contract {_STATE_RECOVERY_CONTRACT!r} requires preserving the "
   893	                "legacy state and replaying its authoritative source batches into a new "
   894	                "state root"
   895	            )
   896	        if schema_version != _STATE_SCHEMA_VERSION:
   897	            raise TopicObservationError(
   898	                f"unsupported topic observation state schema_version {schema_version!r}; "
   899	                f"recovery contract {_STATE_RECOVERY_CONTRACT!r} requires an explicit "
   900	                "operator migration"
   901	            )
