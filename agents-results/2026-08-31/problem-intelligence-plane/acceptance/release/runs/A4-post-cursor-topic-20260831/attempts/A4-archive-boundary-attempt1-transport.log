   908	            "processed_input_ids",
   909	            "seen_observation_keys",
   910	            "manual_queue",
   911	            "manual_events",
   912	        }
   913	        _require_fields(payload, expected, "topic-observation-state")
   914	        if payload["recovery_contract"] != _STATE_RECOVERY_CONTRACT:
   915	            raise TopicObservationError(
   916	                "topic observation state recovery contract does not match the current "
   917	                "state schema"
   918	            )
   919	        if payload["topic_id"] != self.topic_id:
