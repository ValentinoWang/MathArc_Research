   456	class TopicObservationRunner:
   457	    """Durably process one topic without granting status or proof authority."""
   458	
   459	    def __init__(
   460	        self,
   461	        root: str | Path,
   462	        *,
   463	        topic_id: str,
   464	        initial_cursor: str,
   465	        budget: BudgetLedger | None = None,
   466	    ) -> None:
   467	        self.root = Path(root)
   468	        self.root.mkdir(parents=True, exist_ok=True)
   469	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   470	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   471	        if budget is not None and not isinstance(budget, BudgetLedger):
   472	            raise TypeError("budget must be a BudgetLedger or None")
   473	        self.budget = budget
   474	        self.state_path = self.root / "topic-observation-state.json"
   475	        self.lock_path = self.root / ".topic-observation.lock"
   476	        self.literature = LiteratureBase(self.root / "literature", budget=budget)
   477	
   478	    @property
   479	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   480	        state = self._load_state()
   481	        return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   482	
   483	    @property
   484	    def next_cursor(self) -> str:
   485	        return self._load_state()["next_cursor"]
   486	
   487	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   488	        if not isinstance(batch, TopicObservationBatch):
   489	            raise TypeError("batch must be a TopicObservationBatch")
   490	        if batch.topic_id != self.topic_id:
   491	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   492	        with self._writer_lock():
   493	            self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
   494	            state = self._load_state()
   495	            batches = state["batches"]
   496	            previous = batches.get(batch.cursor)
   497	            if previous is not None:
   498	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   499	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   500	                manual = self._add_manual(
   501	                    state,
   502	                    cursor=batch.cursor,
   503	                    input_id="cursor",
   504	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   505	                    detail="A cursor was replayed with different batch content.",
   506	                )
   507	                self._record_manual_event(state, manual)
   508	                self._save_state(state)
