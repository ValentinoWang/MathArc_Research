   103	def _require_nonempty(value: object, name: str) -> str:
   104	    if not isinstance(value, str) or not value.strip():
   105	        raise TopicObservationError(f"{name} must be non-empty")
   106	    return value
   107	
   108	
   109	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   110	    unknown = set(payload) - expected
   111	    missing = expected - set(payload)
   112	    if unknown:
   113	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   114	    if missing:
   115	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   116	
   117	
   118	def _require_sha256(value: object, name: str) -> str:
   119	    if (
   120	        not isinstance(value, str)
   121	        or len(value) != 64
   122	        or any(character not in "0123456789abcdef" for character in value)
   123	    ):
   124	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   125	    return value
   126	
   127	
   128	def _require_sha256_or_empty(value: object, name: str) -> str:
   129	    if value == "":
   130	        return ""
   131	    return _require_sha256(value, name)
   132	
   133	
   134	def _require_optional_sha256(value: object, name: str) -> None:
   135	    if value is not None:
   136	        _require_sha256(value, name)
