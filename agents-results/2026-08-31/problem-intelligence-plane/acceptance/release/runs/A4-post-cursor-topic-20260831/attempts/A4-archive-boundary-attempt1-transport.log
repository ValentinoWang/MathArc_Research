    50	def _text(value: object, field: str) -> str:
    51	    if not isinstance(value, str) or not value.strip(): raise DogfoodArchiveError(f"{field} must be non-empty")
    52	    return value
    53	
    54	def _fields(value: Mapping[str, Any], expected: set[str], name: str) -> None:
    55	    unknown, missing = set(value) - expected, expected - set(value)
    56	    if unknown: raise DogfoodArchiveError(f"unknown {name} fields: {sorted(unknown)}")
    57	    if missing: raise DogfoodArchiveError(f"missing {name} fields: {sorted(missing)}")
