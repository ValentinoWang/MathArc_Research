   109	
   110	def _require_fields(payload: Mapping[str, Any], expected: set[str], name: str) -> None:
   111	    unknown = set(payload) - expected
   112	    missing = expected - set(payload)
   113	    if unknown:
   114	        raise TopicObservationError(f"unknown {name} fields: {sorted(unknown)}")
   115	    if missing:
   116	        raise TopicObservationError(f"missing {name} fields: {sorted(missing)}")
   117	
   118	
   119	def _require_sha256(value: object, name: str) -> str:
   120	    if (
   121	        not isinstance(value, str)
   122	        or len(value) != 64
   123	        or any(character not in "0123456789abcdef" for character in value)
   124	    ):
   125	        raise TopicObservationError(f"{name} must be a lowercase SHA-256 digest")
   126	    return value
   127	
   128	
   129	def _require_sha256_or_empty(value: object, name: str) -> str:
   130	    if value == "":
   131	        return ""
   132	    return _require_sha256(value, name)
   133	
   134	
   135	def _require_optional_sha256(value: object, name: str) -> None:
   136	    if value is not None:
   137	        _require_sha256(value, name)
