   542	            raise DogfoodArchiveError(
   543	                f"unsupported persisted archive schema_version {schema_version!r}; "
   544	                f"recovery contract {_RECOVERY_CONTRACT!r} requires an explicit "
   545	                "operator recovery"
   546	            )
