   599	    def _process_input(
   600	        self,
   601	        state: dict[str, Any],
   602	        batch: TopicObservationBatch,
   603	        item: TopicObservationInput,
   604	    ) -> tuple[TopicItemResult, dict[str, Any]]:
   605	        prior = state["processed_input_ids"].get(item.input_id)
   606	        if prior is not None:
   607	            if prior == item.fingerprint_sha256:
   608	                result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   609	                return result, self._item_evidence(
   610	                    item,
   611	                    result,
   612	                    "PROCESSED_INPUT_REPLAY",
   613	                    persisted=self._persisted_observation_for_input(item),
   614	                    prior_cursor=self._prior_input_cursor(state, item.input_id, item.fingerprint_sha256),
   615	                    prior_input_id=item.input_id,
   616	                )
   617	            manual = self._add_manual(
   618	                state, cursor=batch.cursor, input_id=item.input_id,
   619	                reason=ManualReviewReason.INPUT_ID_CONFLICT,
   620	                detail="An input_id was reused with different source-observation content.",
   621	            )
   622	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   623	            return result, self._item_evidence(
   624	                item,
   625	                result,
   626	                "MANUAL_QUEUE",
   627	                persisted=self._persisted_observation_for_input(item),
   628	                manual_id=manual.manual_id,
   629	                manual_reason=ManualReviewReason.INPUT_ID_CONFLICT,
   630	            )
   631	        if item.is_high_risk:
   632	            manual = self._add_manual(
   633	                state, cursor=batch.cursor, input_id=item.input_id,
   634	                reason=ManualReviewReason.HIGH_RISK_EVENT,
   635	                detail="High-risk flags require human review: " + ", ".join(item.risk_flags),
   636	            )
   637	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   638	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   639	            return result, self._item_evidence(
   640	                item,
   641	                result,
   642	                "MANUAL_QUEUE",
   643	                persisted=self._persisted_observation_for_input(item),
   644	                manual_id=manual.manual_id,
   645	                manual_reason=ManualReviewReason.HIGH_RISK_EVENT,
   646	            )
   647	        if self.budget is not None and self.budget.exhausted():
   648	            manual = self._add_manual(
   649	                state, cursor=batch.cursor, input_id=item.input_id,
   650	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   651	                detail="The configured import budget is exhausted before topic observation.",
   652	            )
   653	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   654	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, item.observation.observation_id, manual.manual_id)
   655	            return result, self._item_evidence(
   656	                item,
   657	                result,
   658	                "MANUAL_QUEUE",
   659	                persisted=self._persisted_observation_for_input(item),
   660	                manual_id=manual.manual_id,
   661	                manual_reason=ManualReviewReason.BUDGET_EXHAUSTED,
   662	            )
   663	        if item.observation.idempotency_key in state["seen_observation_keys"]:
   664	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   665	            result = TopicItemResult(item.input_id, TopicItemStatus.DUPLICATE, item.observation.observation_id)
   666	            return result, self._item_evidence(
   667	                item,
   668	                result,
   669	                "SEEN_OBSERVATION_KEY",
   670	                persisted=self._persisted_observation_for_input(item),
   671	            )
   672	
   673	        imported = self.literature.import_bytes(item.observation, item.content)
   674	        if imported.disposition in {ImportDisposition.IMPORTED, ImportDisposition.IDEMPOTENT}:
   675	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   676	            state["seen_observation_keys"].append(item.observation.idempotency_key)
   677	            state["seen_observation_keys"].sort()
   678	            status = TopicItemStatus.IMPORTED if imported.disposition is ImportDisposition.IMPORTED else TopicItemStatus.IDEMPOTENT
   679	            result = TopicItemResult(item.input_id, status, imported.observation.observation_id)
   680	            return result, self._item_evidence(
   681	                item,
   682	                result,
   683	                "NEW_IMPORT" if status is TopicItemStatus.IMPORTED else "EXISTING_OBSERVED",
   684	                persisted=imported.observation,
   685	                import_disposition=imported.disposition,
   686	            )
   687	        if imported.disposition is ImportDisposition.CONFLICT or imported.observation.status is ObservationStatus.CONFLICT:
   688	            manual = self._add_manual(
   689	                state,
   690	                cursor=batch.cursor,
   691	                input_id=item.input_id,
   692	                reason=ManualReviewReason.LITERATURE_CONFLICT,
   693	                detail=f"Literature import conflict: {imported.reason or 'unspecified conflict outcome'}",
   694	            )
   695	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   696	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   697	            return result, self._item_evidence(
   698	                item,
   699	                result,
   700	                "MANUAL_QUEUE",
   701	                persisted=imported.observation,
   702	                manual_id=manual.manual_id,
   703	                manual_reason=ManualReviewReason.LITERATURE_CONFLICT,
   704	                import_disposition=imported.disposition,
   705	            )
   706	        if imported.disposition is ImportDisposition.REJECTED or imported.reason.startswith("artifact persistence failed:"):
   707	            manual = self._add_manual(
   708	                state,
   709	                cursor=batch.cursor,
   710	                input_id=item.input_id,
   711	                reason=ManualReviewReason.LITERATURE_IMPORT_FAILURE,
   712	                detail=f"Literature import failure: {imported.reason or 'unspecified rejected outcome'}",
   713	            )
   714	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   715	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   716	            return result, self._item_evidence(
   717	                item,
   718	                result,
   719	                "MANUAL_QUEUE",
   720	                persisted=self._persisted_observation_for_input(item),
   721	                manual_id=manual.manual_id,
   722	                manual_reason=ManualReviewReason.LITERATURE_IMPORT_FAILURE,
   723	                import_disposition=imported.disposition,
   724	            )
   725	        if self.budget is not None and self.budget.exhausted():
   726	            manual = self._add_manual(
   727	                state, cursor=batch.cursor, input_id=item.input_id,
   728	                reason=ManualReviewReason.BUDGET_EXHAUSTED,
   729	                detail="The literature base stopped import because the configured budget is exhausted.",
   730	            )
   731	            state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   732	            result = TopicItemResult(item.input_id, TopicItemStatus.MANUAL_REVIEW, imported.observation.observation_id, manual.manual_id)
   733	            return result, self._item_evidence(
   734	                item,
   735	                result,
   736	                "MANUAL_QUEUE",
   737	                persisted=imported.observation,
   738	                manual_id=manual.manual_id,
   739	                manual_reason=ManualReviewReason.BUDGET_EXHAUSTED,
   740	                import_disposition=imported.disposition,
   741	            )
   742	        state["processed_input_ids"][item.input_id] = item.fingerprint_sha256
   743	        result = TopicItemResult(item.input_id, TopicItemStatus.PENDING, imported.observation.observation_id)
   744	        return result, self._item_evidence(
   745	            item,
   746	            result,
   747	            "PENDING_OBSERVATION",
   748	            persisted=imported.observation,
   749	            import_disposition=imported.disposition,
   750	        )
   751	
   752	    def _item_evidence(
   753	        self,
   754	        item: TopicObservationInput,
   755	        result: TopicItemResult,
   756	        basis: str,
   757	        *,
   758	        persisted: SourceObservation | None = None,
   759	        manual_id: str | None = None,
   760	        manual_reason: ManualReviewReason | None = None,
   761	        import_disposition: ImportDisposition | None = None,
   762	        prior_cursor: str | None = None,
   763	        prior_input_id: str | None = None,
   764	    ) -> dict[str, Any]:
   765	        persisted_status = "ABSENT"
   766	        persisted_observation_id = None
   767	        persisted_content_digest = None
   768	        persisted_artifact_id = None
   769	        persisted_artifact_sha256 = None
   770	        if persisted is not None:
   771	            persisted_status = persisted.status.value
   772	            persisted_observation_id = persisted.observation_id
   773	            persisted_content_digest = persisted.content_digest_sha256
   774	            if persisted.status is ObservationStatus.OBSERVED:
   775	                if persisted.artifact_id is None:
   776	                    raise TopicObservationError("observed literature evidence has no artifact")
   777	                try:
   778	                    artifact = self.literature.artifacts.get(persisted.artifact_id)
   779	                except KeyError as exc:
   780	                    raise TopicObservationError("observed literature evidence has no persisted artifact") from exc
   781	                persisted_artifact_id = artifact.artifact_id
   782	                persisted_artifact_sha256 = artifact.sha256
   783	        return {
   784	            "basis": basis,
   785	            "input_id": item.input_id,
   786	            "input_observation_id": item.observation.observation_id,
   787	            "input_idempotency_key": item.observation.idempotency_key,
   788	            "input_content_digest_sha256": item.observation.content_digest_sha256,
   789	            "input_content_sha256": hashlib.sha256(item.content).hexdigest(),
   790	            "input_content_size_bytes": len(item.content),
   791	            "input_risk_flags": list(item.risk_flags),
   792	            "observation_id": result.observation_id,
   793	            "persisted_observation_id": persisted_observation_id,
   794	            "persisted_observation_status": persisted_status,
   795	            "persisted_content_digest_sha256": persisted_content_digest,
   796	            "persisted_artifact_id": persisted_artifact_id,
   797	            "persisted_artifact_sha256": persisted_artifact_sha256,
   798	            "manual_id": manual_id,
   799	            "manual_reason": manual_reason.value if manual_reason is not None else None,
   800	            "prior_cursor": prior_cursor,
   801	            "prior_input_id": prior_input_id,
   802	            "import_disposition": import_disposition.value if import_disposition is not None else None,
   803	        }
   804	
   805	    def _persisted_observation_for_input(
   806	        self,
   807	        item: TopicObservationInput,
   808	    ) -> SourceObservation | None:
   809	        candidates = [
   810	            observation
   811	            for observation in self.literature.observations
   812	            if observation.observation_id == item.observation.observation_id
   813	            or observation.idempotency_key == item.observation.idempotency_key
   814	        ]
   815	        if not candidates:
   816	            return None
   817	        status_order = {
   818	            ObservationStatus.OBSERVED: 0,
   819	            ObservationStatus.PENDING: 1,
   820	            ObservationStatus.CONFLICT: 2,
   821	            ObservationStatus.REJECTED: 3,
   822	        }
   823	        return min(
   824	            candidates,
   825	            key=lambda observation: (
   826	                status_order[observation.status],
   827	                observation.observation_id,
   828	            ),
   829	        )
   830	
   831	    @staticmethod
   832	    def _prior_input_cursor(
   833	        state: Mapping[str, Any],
   834	        input_id: str,
   835	        fingerprint: str,
   836	    ) -> str | None:
   837	        matches = [
   838	            cursor
   839	            for cursor, stored in state["batches"].items()
   840	            if isinstance(stored, dict)
   841	            and stored.get("input_fingerprints", {}).get(input_id) == fingerprint
   842	        ]
   843	        return sorted(matches)[0] if matches else None
   844	
   845	    @staticmethod
   846	    def _record_manual_event(
   847	        state: dict[str, Any],
   848	        manual: ManualReviewItem,
   849	    ) -> None:
   850	        existing = {item["manual_id"] for item in state["manual_events"]}
   851	        if manual.manual_id not in existing:
   852	            state["manual_events"].append(
   853	                {
   854	                    "event_type": "CURSOR_CONFLICT",
   855	                    "manual_id": manual.manual_id,
   856	                }
   857	            )
   858	            state["manual_events"].sort(key=lambda item: item["manual_id"])
   859	
   860	    def _add_manual(
   861	        self,
   862	        state: dict[str, Any],
   863	        *,
   864	        cursor: str,
   865	        input_id: str,
   866	        reason: ManualReviewReason,
   867	        detail: str,
   868	    ) -> ManualReviewItem:
   869	        manual = ManualReviewItem(
   870	            manual_id=_manual_id_for(
   871	                topic_id=self.topic_id,
   872	                cursor=cursor,
   873	                input_id=input_id,
   874	                reason=reason,
   875	                detail=detail,
   876	            ),
   877	            topic_id=self.topic_id,
   878	            cursor=cursor,
   879	            input_id=input_id,
   880	            reason=reason,
   881	            detail=detail,
   882	        )
   883	        existing = {item["manual_id"]: item for item in state["manual_queue"]}
   884	        if manual.manual_id not in existing:
   885	            state["manual_queue"].append(manual.to_dict())
   886	            state["manual_queue"].sort(key=lambda item: item["manual_id"])
   887	        return manual
   888	
   889	    @contextmanager
   890	    def _writer_lock(self) -> Iterator[None]:
   891	        self.lock_path.touch(exist_ok=True)
   892	        with self.lock_path.open("a+", encoding="utf-8") as lock_file:
   893	            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
   894	            try:
   895	                yield
   896	            finally:
