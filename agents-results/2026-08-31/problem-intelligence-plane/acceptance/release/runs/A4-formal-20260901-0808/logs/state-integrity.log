   321	            raise DogfoodArchiveError("persisted archive case must be an object")
   322	        _fields(case, _CASE_FIELDS, "persisted archive case")
   323	        for field in (
   324	            "problem_id", "case_role", "topic_status", "replay_status", "review_boundary",
   325	        ):
   326	            _text(case[field], f"persisted case {field}")
   327	        if case["manual_reason"] is not None:
   328	            _text(case["manual_reason"], "persisted case manual_reason")
   329	        for field in ("promotion_allowed", "claim_created", "trace_created"):
   330	            cls._require_bool(case[field], f"persisted case {field}")
   331	
   332	        provenance = case["provenance"]
   333	        if not isinstance(provenance, list) or not provenance:
   334	            raise DogfoodArchiveError("persisted case provenance must be a non-empty array")
   335	        for source in provenance:
   336	            if not isinstance(source, dict) or set(source) not in (
   337	                _PROVENANCE_FIELDS, _PROVENANCE_FIELDS_WITH_STATUS,
   338	            ):
   339	                raise DogfoodArchiveError("persisted case provenance has invalid fields")
   340	            for field in (
   341	                "source_id", "source_kind", "canonical_uri", "pinned_version", "locator", "artifact_path",
   342	            ):
   343	                _text(source[field], f"persisted provenance {field}")
   344	            if not isinstance(source["content_sha256"], str) or len(source["content_sha256"]) != 64:
   345	                raise DogfoodArchiveError("persisted provenance content_sha256 must be a SHA-256 digest")
   346	            if "reported_status" in source:
   347	                _text(source["reported_status"], "persisted provenance reported_status")
