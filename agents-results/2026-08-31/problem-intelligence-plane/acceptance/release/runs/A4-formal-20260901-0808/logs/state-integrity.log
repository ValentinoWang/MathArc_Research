   459	    def _replay(self, specs: Mapping[str, list[dict[str, str]]]) -> dict[str, Any]:
   460	        payload = self._load_result()
   461	        if payload["contract_digest_sha256"] != self._contract_digest() or payload["fixture_identity_digest_sha256"] != digest_json(self.contract["fixture_sha256"]) or payload["source_identity_digest_sha256"] != digest_json(specs): raise DogfoodArchiveError("contract or source identity drift on replay")
   462	        main = TopicObservationRunner(self.root / "topic-observation", topic_id=_TOPIC_ID, initial_cursor="dogfood-c0")
   463	        residual_budget = self._new_residual_budget()
   464	        residual = TopicObservationRunner(self.root / "residual-budget", topic_id=_TOPIC_ID, initial_cursor="budget-c0", budget=residual_budget)
   465	        if not (main.next_cursor == "dogfood-c4" and residual.next_cursor == "budget-c1"):
   466	            raise DogfoodArchiveError("topic observation state is missing or has invalid cursor")
   467	        blocking_entries = self._manual_queue_entries(main, residual)
   468	        manual_ids = [item["manual_id"] for item in blocking_entries]
   469	        if manual_ids != payload["blocking_manual_ids"] or digest_json(blocking_entries) != digest_json(payload["blocking_manual_queue"]):
   470	            raise DogfoodArchiveError("topic observation manual queue does not match persisted archive")
   471	        if len(main.literature.observations) != 4 or len(residual.literature.observations) != 0:
   472	            raise DogfoodArchiveError("topic observation ArtifactStore state is missing or inconsistent")
   473	        reconstructed_budget = residual_budget.to_dict()
   474	        if self.contract["expected_budget_snapshot"] != reconstructed_budget:
   475	            raise DogfoodArchiveError("reconstructed residual budget does not match T2 contract")
   476	        if payload["budget_snapshot"] != reconstructed_budget:
   477	            raise DogfoodArchiveError("persisted budget snapshot does not match reconstructed residual budget")
   478	        if not payload["no_claim_or_trace_created"] or not self._no_claim_or_trace_created(): raise DogfoodArchiveError("claim or trace artifact is forbidden on replay")
   479	        fixtures = self._load_s1_fixtures()
   480	        expected_archive, expected_states = self._canonical_expected_execution(fixtures, specs)
   481	        self._assert_contract_results(payload)
   482	        self._assert_canonical_execution(payload, expected_archive, expected_states)
   483	        payload["replayed"] = True; self._save(payload); return payload
