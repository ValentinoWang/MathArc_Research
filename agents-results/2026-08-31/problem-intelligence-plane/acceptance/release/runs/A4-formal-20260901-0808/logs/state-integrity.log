   439	    def _assert_canonical_execution(
   440	        self,
   441	        payload: Mapping[str, Any],
   442	        expected_archive: Mapping[str, Any],
   443	        expected_states: Mapping[str, Mapping[str, Any]],
   444	    ) -> None:
   445	        for relative, expected_state in expected_states.items():
   446	            actual_state = self._read_json_object(self.root / relative, f"persisted {relative}")
   447	            if actual_state != expected_state:
   448	                raise DogfoodArchiveError(
   449	                    "persisted topic observation state does not match canonical dogfood state"
   450	                )
   451	        if (
   452	            self._archive_body(payload) != self._archive_body(expected_archive)
   453	            or payload["archive_digest_sha256"] != expected_archive["archive_digest_sha256"]
   454	        ):
   455	            raise DogfoodArchiveError(
   456	                "persisted archive does not match canonical dogfood execution"
   457	            )
