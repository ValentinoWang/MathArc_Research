   530	    def _load_result(self) -> dict[str, Any]:
   531	        try: payload = json.loads(self.result_path.read_text(encoding="utf-8"))
   532	        except (OSError, json.JSONDecodeError) as exc: raise DogfoodArchiveError("persisted archive is unreadable") from exc
   533	        if not isinstance(payload, dict): raise DogfoodArchiveError("persisted archive must be an object")
   534	        schema_version = payload.get("schema_version")
   535	        if schema_version in _LEGACY_SCHEMA_VERSIONS:
   536	            raise DogfoodArchiveError(
   537	                f"persisted archive schema_version {schema_version!r} is legacy; "
   538	                f"recovery contract {_RECOVERY_CONTRACT!r} requires preserving the "
   539	                "legacy archive and rerunning the checked-in dogfood inputs"
   540	            )
   541	        if schema_version != _SCHEMA_VERSION:
   542	            raise DogfoodArchiveError(
   543	                f"unsupported persisted archive schema_version {schema_version!r}; "
   544	                f"recovery contract {_RECOVERY_CONTRACT!r} requires an explicit "
   545	                "operator recovery"
   546	            )
   547	        self._validate_archive_shape(payload)
   548	        if payload["recovery_contract"] != _RECOVERY_CONTRACT:
   549	            raise DogfoodArchiveError("persisted archive recovery contract does not match the current schema")
   550	        if payload["schema_version"] != _SCHEMA_VERSION or payload["topic_id"] != _TOPIC_ID or payload["fixture_files"] != list(_S1_NAMES) or not payload["archive_blocked"]: raise DogfoodArchiveError("persisted archive identity or fixture contract mismatch")
   551	        if not isinstance(payload["blocking_manual_queue"], list) or any(not isinstance(item, dict) for item in payload["blocking_manual_queue"]):
   552	            raise DogfoodArchiveError("persisted manual queue is malformed")
   553	        try:
   554	            normalized_entries = [ManualReviewItem.from_dict(item).to_dict() for item in payload["blocking_manual_queue"]]
   555	        except (KeyError, TypeError, ValueError) as exc:
   556	            raise DogfoodArchiveError("persisted manual queue is malformed") from exc
   557	        if digest_json(normalized_entries) != digest_json(payload["blocking_manual_queue"]):
   558	            raise DogfoodArchiveError("persisted manual queue is not canonical")
   559	        if [item["manual_id"] for item in normalized_entries] != payload["blocking_manual_ids"]:
   560	            raise DogfoodArchiveError("persisted manual queue IDs do not match entries")
   561	        if payload["budget_digest_sha256"] != self.contract["expected_budget_digest_sha256"]: raise DogfoodArchiveError("persisted budget snapshot identity mismatch")
   562	        if payload["budget_digest_sha256"] != digest_json(payload["budget_snapshot"]): raise DogfoodArchiveError("persisted budget snapshot digest mismatch")
   563	        digest_payload = {k: v for k, v in payload.items() if k not in {"archive_digest_sha256", "replayed"}}
   564	        if payload["archive_digest_sha256"] != digest_json(digest_payload): raise DogfoodArchiveError("persisted archive digest mismatch")
   565	        return payload
