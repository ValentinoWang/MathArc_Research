  1496	    @staticmethod
  1497	    def _load_manual_queue(
  1498	        value: object,
  1499	        *,
  1500	        enclosing_topic_id: str,
  1501	    ) -> list[ManualReviewItem]:
  1502	        try:
  1503	            _require_nonempty(enclosing_topic_id, "enclosing topic_id")
  1504	            if not isinstance(value, list):
  1505	                raise TopicObservationError("topic observation state has invalid manual queue")
  1506	            manual_queue: list[ManualReviewItem] = []
  1507	            for item in value:
  1508	                if not isinstance(item, dict):
  1509	                    raise TopicObservationError("manual queue entry is malformed")
  1510	                manual = ManualReviewItem.from_dict(item)
  1511	                if manual.topic_id != enclosing_topic_id:
  1512	                    if manual.reason is ManualReviewReason.CURSOR_CONFLICT:
  1513	                        raise ManualQueueObservationError(
  1514	                            "cursor conflict manual topic_id does not match enclosing state topic"
  1515	                        )
  1516	                    raise ManualQueueObservationError(
  1517	                        "manual queue topic_id does not match enclosing state topic"
  1518	                    )
  1519	                manual_queue.append(manual)
  1520	            manual_ids = [item.manual_id for item in manual_queue]
  1521	            if len(manual_ids) != len(set(manual_ids)):
  1522	                raise TopicObservationError("manual queue manual_ids must be unique")
