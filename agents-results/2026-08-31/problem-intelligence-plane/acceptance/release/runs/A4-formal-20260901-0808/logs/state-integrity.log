import copy, hashlib, json, tempfile
from pathlib import Path
from matharc.v02.dogfood_archives import DogfoodArchiveRunner
from matharc.v02.schema import digest_json
from matharc.v02.source_observation import SourceObservation
from matharc.v02.topic_observation import TopicObservationBatch, TopicObservationInput, TopicObservationRunner

REPO = Path('/Users/vsiyo/Desktop/创业项目/AI4Math/Project/MathArc_Research')
FIXTURES = REPO / 'agents-results/2026-08-31/problem-intelligence-plane/evidence/s1-fixtures'

def archive_digest(payload):
    return digest_json({k: v for k, v in payload.items() if k not in {'archive_digest_sha256', 'replayed'}})

def capture(label, fn):
    try:
        detail = fn()
        return {'probe': label, 'result': 'PASS', 'detail': detail}
    except Exception as exc:
        return {'probe': label, 'result': 'FAIL', 'detail': f'{type(exc).__name__}: {exc}'}

results = []

def restart_replay():
    with tempfile.TemporaryDirectory(prefix='matharc-a4-restart-') as d:
        root = Path(d)
        first = DogfoodArchiveRunner(root, FIXTURES).run()
        archive_before = (root / 'dogfood-archives.json').read_bytes()
        state_before = (root / 'topic-observation/topic-observation-state.json').read_bytes()
        second = DogfoodArchiveRunner(root, FIXTURES).run()
        assert first['replayed'] is False and second['replayed'] is True
        assert [c['problem_id'] for c in second['cases']] == [
            'P-FRANKL-Q6', 'P-ARXIV-2601-22401-COLLISION',
            'P-FRANKL-Q6-FOUR-OR-MORE-SMALL-OUTSIDE-PARTS']
        assert archive_before == (root / 'dogfood-archives.json').read_bytes()
        assert state_before == (root / 'topic-observation/topic-observation-state.json').read_bytes()
        return 'replayed false->true; archive and topic state bytes unchanged'
results.append(capture('restart_replay', restart_replay))

def cursor_conflict():
    with tempfile.TemporaryDirectory(prefix='matharc-a4-cursor-') as d:
        root = Path(d)
        DogfoodArchiveRunner(root, FIXTURES).run()
        state_path = root / 'topic-observation/topic-observation-state.json'
        state = json.loads(state_path.read_text())
        projection = state['batches']['dogfood-c0']['input_projections']['P-FRANKL-Q6:source:00']
        obs = SourceObservation.from_dict(projection['observation'])
        conflicting = TopicObservationInput('P-FRANKL-Q6:source:00', obs, b'changed bytes')
        runner = TopicObservationRunner(root / 'topic-observation', topic_id='union-closed', initial_cursor='dogfood-c0')
        before = runner.next_cursor
        out = runner.run(TopicObservationBatch('union-closed', 'dogfood-c0', 'dogfood-c1', (conflicting,)))
        after = runner.next_cursor
        assert out.status.value == 'CURSOR_BLOCKED' and before == after == 'dogfood-c4'
        assert runner.manual_queue[-1].reason.value == 'CURSOR_CONFLICT' or any(x.reason.value == 'CURSOR_CONFLICT' for x in runner.manual_queue)
        return 'CURSOR_BLOCKED; next_cursor remained dogfood-c4; cursor-conflict manual event linked'
results.append(capture('cursor_conflict', cursor_conflict))

def coordinated_tamper():
    with tempfile.TemporaryDirectory(prefix='matharc-a4-coord-') as d:
        root = Path(d)
        DogfoodArchiveRunner(root, FIXTURES).run()
        sp = root / 'topic-observation/topic-observation-state.json'
        state = json.loads(sp.read_text())
        q = next(x for x in state['manual_queue'] if x['input_id'] == 'collision-review-alert')
        q['detail'] += ' coordinated'
        ident = '|'.join(q[k] for k in ('topic_id','cursor','input_id','reason','detail'))
        new_id = 'manual-' + hashlib.sha256(ident.encode()).hexdigest()[:24]
        old_id = q['manual_id']; q['manual_id'] = new_id
        stored = state['batches']['dogfood-c2']
        stored['result']['item_results'][0]['manual_id'] = new_id
        stored['disposition_evidence']['collision-review-alert']['manual_id'] = new_id
        stored['result_digest_sha256'] = digest_json(stored['result'])
        sp.write_text(json.dumps(state))
        ap = root / 'dogfood-archives.json'; archive = json.loads(ap.read_text())
        aq = next(x for x in archive['blocking_manual_queue'] if x['manual_id'] == old_id)
        aq.update(detail=q['detail'], manual_id=new_id)
        archive['blocking_manual_queue'].sort(key=lambda x:x['manual_id'])
        archive['blocking_manual_ids'] = [x['manual_id'] for x in archive['blocking_manual_queue']]
        archive['archive_digest_sha256'] = archive_digest(archive)
        ap.write_text(json.dumps(archive))
        try:
            DogfoodArchiveRunner(root, FIXTURES).run()
        except Exception as exc:
            assert 'canonical dogfood state' in str(exc)
            return f'{type(exc).__name__}: {exc}'
        raise AssertionError('coordinated tampering was accepted')
results.append(capture('coordinated_tampering', coordinated_tamper))

def manual_linkage():
    with tempfile.TemporaryDirectory(prefix='matharc-a4-manual-') as d:
        root = Path(d); DogfoodArchiveRunner(root, FIXTURES).run()
        sp = root / 'topic-observation/topic-observation-state.json'; state = json.loads(sp.read_text())
        q = next(x for x in state['manual_queue'] if x['input_id'] == 'collision-review-alert')
        q['input_id'] = 'foreign-input'
        ident = '|'.join(q[k] for k in ('topic_id','cursor','input_id','reason','detail'))
        q['manual_id'] = 'manual-' + hashlib.sha256(ident.encode()).hexdigest()[:24]
        sp.write_text(json.dumps(state))
        try:
            DogfoodArchiveRunner(root, FIXTURES).run()
        except Exception as exc:
            assert 'manual' in str(exc).lower()
            return f'{type(exc).__name__}: {exc}'
        raise AssertionError('unlinked manual queue was accepted')
results.append(capture('manual_queue_linkage', manual_linkage))

def budget_binding():
    with tempfile.TemporaryDirectory(prefix='matharc-a4-budget-') as d:
        root = Path(d); DogfoodArchiveRunner(root, FIXTURES).run()
        ap = root / 'dogfood-archives.json'; archive = json.loads(ap.read_text())
        archive['budget_snapshot']['spent']['model_calls'] = 2
        archive['budget_digest_sha256'] = digest_json(archive['budget_snapshot'])
        archive['archive_digest_sha256'] = archive_digest(archive)
        ap.write_text(json.dumps(archive))
        try:
            DogfoodArchiveRunner(root, FIXTURES).run()
        except Exception as exc:
            assert 'budget snapshot identity' in str(exc)
            return f'{type(exc).__name__}: {exc}'
        raise AssertionError('recomputed budget drift was accepted')
results.append(capture('budget_binding', budget_binding))

def legacy_recovery():
    with tempfile.TemporaryDirectory(prefix='matharc-a4-legacy-') as d:
        root = Path(d); DogfoodArchiveRunner(root, FIXTURES).run()
        sp = root / 'topic-observation/topic-observation-state.json'; state = json.loads(sp.read_text())
        state['schema_version'] = '1.3'; legacy_state = json.dumps(state).encode(); sp.write_bytes(legacy_state)
        try: TopicObservationRunner(root / 'topic-observation', topic_id='union-closed', initial_cursor='dogfood-c0').next_cursor
        except Exception as exc: state_error = f'{type(exc).__name__}: {exc}'
        else: raise AssertionError('legacy state accepted')
        assert sp.read_bytes() == legacy_state
        root2 = root / 'archive'; DogfoodArchiveRunner(root2, FIXTURES).run()
        ap = root2 / 'dogfood-archives.json'; archive = json.loads(ap.read_text()); archive['schema_version']='1.1'; archive['archive_digest_sha256']=archive_digest(archive)
        legacy_archive=json.dumps(archive).encode(); ap.write_bytes(legacy_archive)
        try: DogfoodArchiveRunner(root2, FIXTURES).run()
        except Exception as exc: archive_error=f'{type(exc).__name__}: {exc}'
        else: raise AssertionError('legacy archive accepted')
        assert ap.read_bytes() == legacy_archive
        return state_error + ' | ' + archive_error + ' | both byte-preserved'
results.append(capture('legacy_recovery', legacy_recovery))

print(json.dumps(results, indent=2, sort_keys=True))
assert all(item['result'] == 'PASS' for item in results)
