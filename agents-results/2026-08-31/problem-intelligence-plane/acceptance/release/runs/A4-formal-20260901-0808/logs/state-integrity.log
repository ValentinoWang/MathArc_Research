   410	    @staticmethod
   411	    def _read_json_object(path: Path, name: str) -> dict[str, Any]:
   412	        try:
   413	            payload = json.loads(path.read_text(encoding="utf-8"))
   414	        except (OSError, json.JSONDecodeError) as exc:
   415	            raise DogfoodArchiveError(f"{name} is unreadable") from exc
   416	        if not isinstance(payload, dict):
   417	            raise DogfoodArchiveError(f"{name} must be an object")
   418	        return payload
