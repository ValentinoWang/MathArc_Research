  1473	    @staticmethod
  1474	    def _load_manual_events(value: object) -> list[dict[str, str]]:
  1475	        try:
  1476	            if not isinstance(value, list):
  1477	                raise TopicObservationError("topic observation state has invalid manual events")
  1478	            events: list[dict[str, str]] = []
  1479	            for item in value:
  1480	                if not isinstance(item, dict):
  1481	                    raise TopicObservationError("manual event is malformed")
  1482	                _require_fields(item, {"event_type", "manual_id"}, "manual event")
  1483	                if item["event_type"] != "CURSOR_CONFLICT":
  1484	                    raise TopicObservationError("manual event has an unsupported type")
  1485	                _require_nonempty(item["manual_id"], "manual event manual_id")
  1486	                events.append({"event_type": item["event_type"], "manual_id": item["manual_id"]})
  1487	            event_ids = [item["manual_id"] for item in events]
  1488	            if len(event_ids) != len(set(event_ids)):
  1489	                raise TopicObservationError("manual event manual_ids must be unique")
  1490	            return events
  1491	        except ManualQueueObservationError:
  1492	            raise
  1493	        except (KeyError, TypeError, ValueError, TopicObservationError) as exc:
  1494	            raise ManualQueueObservationError(str(exc)) from exc
