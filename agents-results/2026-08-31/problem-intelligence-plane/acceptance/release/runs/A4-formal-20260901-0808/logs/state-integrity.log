   351	            raise DogfoodArchiveError("persisted case status must be an object")
   352	        _fields(status, _STATUS_FIELDS, "persisted case status")
   353	        _text(status["reported_status"], "persisted case reported_status")
   354	        _text(status["validated_status"], "persisted case validated_status")
   355	        cls._require_string_list(status["invalidations"], "persisted case invalidations")
   356	        if not isinstance(status["dossier"], dict):
   357	            raise DogfoodArchiveError("persisted case dossier must be an object")
