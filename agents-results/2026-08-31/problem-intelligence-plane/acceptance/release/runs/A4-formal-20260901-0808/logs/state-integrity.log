   567	    def _save(self, result: Mapping[str, Any]) -> None:
   568	        payload = dict(result); payload.pop("archive_digest_sha256", None); payload["archive_digest_sha256"] = digest_json({k: v for k, v in payload.items() if k != "replayed"})
   569	        temporary = self.result_path.with_suffix(".tmp"); temporary.write_text(canonical_json(payload) + "\n", encoding="utf-8"); os.replace(temporary, self.result_path)
  1170	        return payload
