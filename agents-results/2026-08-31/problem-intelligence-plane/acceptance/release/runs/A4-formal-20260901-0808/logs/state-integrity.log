   359	        novelty = case["novelty"]
   360	        if novelty is not None:
   361	            if not isinstance(novelty, dict):
   362	                raise DogfoodArchiveError("persisted case novelty must be an object or null")
   363	            _fields(novelty, _NOVELTY_FIELDS, "persisted case novelty")
   364	            if not isinstance(novelty["record"], dict):
   365	                raise DogfoodArchiveError("persisted case novelty record must be an object")
   366	            _text(novelty["authorization_status"], "persisted novelty authorization_status")
   367	            cls._require_bool(
   368	                novelty["complete_research_budget"],
   369	                "persisted novelty complete_research_budget",
   370	            )
   371	            cls._require_bool(
   372	                novelty["public_qualitative_conclusion"],
   373	                "persisted novelty public_qualitative_conclusion",
   374	            )
   375	            cls._require_string_list(novelty["invalidations"], "persisted novelty invalidations")
