   465	        _require_fields(payload, expected, "topic-batch-result")
   466	        items = payload["item_results"]
   467	        if not isinstance(items, list) or any(not isinstance(item, Mapping) for item in items):
   468	            raise TopicObservationError("item_results must be an array of objects")
   469	        return cls(
   470	            topic_id=payload["topic_id"],
   471	            cursor=payload["cursor"],
   472	            next_cursor=payload["next_cursor"],
   473	            status=TopicRunStatus(payload["status"]),
   474	            item_results=tuple(TopicItemResult.from_dict(item) for item in items),
   475	            replayed=payload["replayed"],
   476	        )
