   377	    @classmethod
   378	    def _validate_archive_shape(cls, payload: Mapping[str, Any]) -> None:
   379	        _fields(payload, _ARCHIVE_FIELDS, "persisted archive")
   380	        for field in (
   381	            "schema_version", "recovery_contract", "topic_id", "contract_digest_sha256",
   382	            "fixture_identity_digest_sha256", "source_identity_digest_sha256", "budget_digest_sha256",
   383	            "archive_digest_sha256",
   384	        ):
   385	            _text(payload[field], f"persisted archive {field}")
   386	        for field in (
   387	            "contract_digest_sha256", "fixture_identity_digest_sha256", "source_identity_digest_sha256",
   388	            "budget_digest_sha256", "archive_digest_sha256",
   389	        ):
   390	            value = payload[field]
   391	            if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
   392	                raise DogfoodArchiveError(f"persisted archive {field} must be a lowercase SHA-256 digest")
   393	        cls._require_bool(payload["replayed"], "persisted archive replayed")
   394	        cls._require_bool(payload["archive_blocked"], "persisted archive archive_blocked")
   395	        cls._require_bool(payload["no_claim_or_trace_created"], "persisted archive no_claim_or_trace_created")
   396	        if not isinstance(payload["fixture_files"], list) or any(
   397	            not isinstance(item, str) for item in payload["fixture_files"]
   398	        ):
   399	            raise DogfoodArchiveError("persisted archive fixture_files must be an array of strings")
   400	        cls._require_string_list(payload["blocking_manual_ids"], "persisted archive blocking_manual_ids")
   401	        if not isinstance(payload["blocking_manual_queue"], list):
   402	            raise DogfoodArchiveError("persisted archive blocking_manual_queue must be an array")
   403	        if not isinstance(payload["cases"], list):
   404	            raise DogfoodArchiveError("persisted archive cases must be an array")
   405	        for case in payload["cases"]:
   406	            cls._validate_case_shape(case)
   407	        if not isinstance(payload["budget_snapshot"], dict):
   408	            raise DogfoodArchiveError("persisted archive budget_snapshot must be an object")
