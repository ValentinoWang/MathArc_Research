   479	class TopicObservationRunner:
   480	    """Durably process one topic without granting status or proof authority."""
   481	
   482	    def __init__(
   483	        self,
   484	        root: str | Path,
   485	        *,
   486	        topic_id: str,
   487	        initial_cursor: str,
   488	        budget: BudgetLedger | None = None,
   489	    ) -> None:
   490	        self.root = Path(root)
   491	        self.root.mkdir(parents=True, exist_ok=True)
   492	        self.topic_id = _require_nonempty(topic_id, "topic_id")
   493	        self.initial_cursor = _require_nonempty(initial_cursor, "initial_cursor")
   494	        if budget is not None and not isinstance(budget, BudgetLedger):
   495	            raise TypeError("budget must be a BudgetLedger or None")
   496	        self.budget = budget
   497	        self.state_path = self.root / "topic-observation-state.json"
   498	        self.lock_path = self.root / ".topic-observation.lock"
   499	        self.literature = LiteratureBase(self.root / "literature", budget=budget)
   500	
   501	    @property
   502	    def manual_queue(self) -> tuple[ManualReviewItem, ...]:
   503	        state = self._load_state()
   504	        return tuple(ManualReviewItem.from_dict(item) for item in state["manual_queue"])
   505	
   506	    @property
   507	    def next_cursor(self) -> str:
   508	        return _require_nonempty(self._load_state()["next_cursor"], "next_cursor")
   509	
   510	    def run(self, batch: TopicObservationBatch) -> TopicBatchResult:
   511	        if not isinstance(batch, TopicObservationBatch):
   512	            raise TypeError("batch must be a TopicObservationBatch")
   513	        if batch.topic_id != self.topic_id:
   514	            raise TopicObservationError("batch topic_id does not match runner topic_id")
   515	        with self._writer_lock():
   516	            self.literature = LiteratureBase(self.root / "literature", budget=self.budget)
   517	            state = self._load_state()
   518	            batches = state["batches"]
   519	            previous = batches.get(batch.cursor)
   520	            if previous is not None:
   521	                if previous["batch_digest_sha256"] == batch.batch_digest_sha256:
   522	                    return replace(TopicBatchResult.from_dict(previous["result"]), replayed=True, status=TopicRunStatus.REPLAYED)
   523	                manual = self._add_manual(
   524	                    state,
   525	                    cursor=batch.cursor,
   526	                    input_id="cursor",
   527	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   528	                    detail="A cursor was replayed with different batch content.",
   529	                )
   530	                self._record_manual_event(state, manual)
   531	                self._save_state(state)
   532	                return TopicBatchResult(
   533	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   534	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   535	                )
   536	            if batch.cursor != state["next_cursor"]:
   537	                manual = self._add_manual(
   538	                    state,
   539	                    cursor=batch.cursor,
   540	                    input_id="cursor",
   541	                    reason=ManualReviewReason.CURSOR_CONFLICT,
   542	                    detail=f"Expected cursor {state['next_cursor']!r}, received {batch.cursor!r}.",
   543	                )
   544	                self._record_manual_event(state, manual)
   545	                self._save_state(state)
   546	                return TopicBatchResult(
   547	                    self.topic_id, batch.cursor, state["next_cursor"], TopicRunStatus.CURSOR_BLOCKED,
   548	                    (TopicItemResult("cursor", TopicItemStatus.MANUAL_REVIEW, "cursor", manual.manual_id),),
   549	                )
   550	
   551	            results: list[TopicItemResult] = []
   552	            disposition_evidence: dict[str, dict[str, Any]] = {}
   553	            batch_digest_sha256 = batch.batch_digest_sha256
   554	            for item in batch.inputs:
   555	                item_result, evidence = self._process_input(state, batch, item)
   556	                results.append(item_result)
   557	                disposition_evidence[item.input_id] = evidence
   558	            status = TopicRunStatus.MANUAL_REVIEW if any(
   559	                item.status is TopicItemStatus.MANUAL_REVIEW for item in results
   560	            ) else TopicRunStatus.APPLIED
   561	            batch_result = TopicBatchResult(
   562	                self.topic_id, batch.cursor, batch.next_cursor, status, tuple(results)
   563	            )
   564	            input_projections = {
   565	                item.input_id: item.input_projection for item in batch.inputs
   566	            }
   567	            for input_id, evidence in disposition_evidence.items():
   568	                evidence["input_projection_binding_sha256"] = _input_projection_binding_digest(
   569	                    topic_id=batch.topic_id,
   570	                    cursor=batch.cursor,
   571	                    next_cursor=batch.next_cursor,
   572	                    batch_digest_sha256=batch_digest_sha256,
   573	                    input_projection=input_projections[input_id],
   574	                )
   575	            batches[batch.cursor] = {
   576	                "batch_digest_sha256": batch_digest_sha256,
   577	                "result_digest_sha256": digest_json(batch_result.to_dict()),
   578	                "input_fingerprints": {
   579	                    item.input_id: item.fingerprint_sha256 for item in batch.inputs
   580	                },
   581	                "input_projection_digest_sha256": _input_projection_digest(
   582	                    topic_id=batch.topic_id,
   583	                    cursor=batch.cursor,
   584	                    next_cursor=batch.next_cursor,
   585	                    batch_digest_sha256=batch_digest_sha256,
   586	                    input_projections=input_projections,
   587	                ),
   588	                "input_projections": input_projections,
   589	                "input_observation_ids": {
   590	                    item.input_id: item.observation_id for item in results
   591	                },
   592	                "disposition_evidence": disposition_evidence,
   593	                "result": batch_result.to_dict(),
   594	            }
   595	            state["next_cursor"] = batch.next_cursor
   596	            self._save_state(state)
   597	            return batch_result
