   339	            identity = "|".join(
   340	                (
   341	                    queue_entry["topic_id"],
   342	                    queue_entry["cursor"],
   343	                    queue_entry["input_id"],
   344	                    queue_entry["reason"],
   345	                    tampered_detail,
   346	                )
   347	            )
   348	            tampered_manual_id = "manual-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
   349	            queue_entry.update(detail=tampered_detail, manual_id=tampered_manual_id)
   350	            stored = state["batches"]["dogfood-c2"]
