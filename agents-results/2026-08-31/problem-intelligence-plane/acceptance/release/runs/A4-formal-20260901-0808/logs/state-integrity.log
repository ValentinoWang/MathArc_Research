   420	    def _canonical_expected_execution(
   421	        self,
   422	        fixtures: Mapping[str, Mapping[str, Any]],
   423	        specs: Mapping[str, list[dict[str, str]]],
   424	    ) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
   425	        with tempfile.TemporaryDirectory(prefix="matharc-dogfood-archive-") as directory:
   426	            expected_runner = DogfoodArchiveRunner(directory, self.fixture_root)
   427	            expected_runner.contract = self.contract
   428	            expected_runner._execute(fixtures, specs)
   429	            expected_archive = self._read_json_object(
   430	                expected_runner.result_path,
   431	                "canonical dogfood-archives.json",
   432	            )
   433	            expected_states = {
   434	                relative: self._read_json_object(Path(directory) / relative, f"canonical {relative}")
   435	                for relative in _STATE_SNAPSHOT_PATHS
   436	            }
   437	            return expected_archive, expected_states
