   360	                for entry in payload["blocking_manual_queue"]
   361	                if entry["input_id"] == queue_entry["input_id"]
   362	            )
   363	            archived_entry.update(detail=tampered_detail, manual_id=tampered_manual_id)
   364	            payload["blocking_manual_queue"].sort(key=lambda entry: entry["manual_id"])
