   341	  let rejectReady;
   342	  const ready = new Promise((resolve, reject) => { resolveReady = resolve; rejectReady = reject; });
   343	  child.stderr.setEncoding("utf8");
   344	  child.stderr.on("data", chunk => { stderr += chunk; });
   345	  child.stdout.setEncoding("utf8");
   346	  child.stdout.on("data", chunk => {
   347	    buffer += chunk;
