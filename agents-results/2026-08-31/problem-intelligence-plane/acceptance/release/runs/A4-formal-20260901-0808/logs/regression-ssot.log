   485	    def _assert_contract_results(self, result: Mapping[str, Any]) -> None:
   486	        raw_cases = result.get("cases")
   487	        expected_ids = tuple(case["problem_id"] for case in self.contract["cases"])
   488	        if (
   489	            not isinstance(raw_cases, list)
   490	            or any(not isinstance(case, dict) or not isinstance(case.get("problem_id"), str) for case in raw_cases)
   491	        ):
   492	            raise DogfoodArchiveError(
   493	                "persisted result must contain exactly the contract case IDs once each"
   494	            )
   495	        case_ids = [case["problem_id"] for case in raw_cases]
   496	        if (
   497	            len(case_ids) != len(expected_ids)
   498	            or len(set(case_ids)) != len(case_ids)
   499	            or set(case_ids) != set(expected_ids)
   500	        ):
   501	            raise DogfoodArchiveError(
   502	                "persisted result must contain exactly the contract case IDs once each"
   503	            )
   504	        cases = {case["problem_id"]: case for case in raw_cases}
   505	        for expected in self.contract["cases"]:
   506	            actual = cases.get(expected["problem_id"])
   507	            if actual is None:
   508	                raise DogfoodArchiveError("persisted result is missing a contract case")
   509	            self._validate_case_shape(actual)
   510	            for field in ("promotion_allowed", "claim_created", "trace_created"):
   511	                if actual.get(field) is not False:
   512	                    raise DogfoodArchiveError(
   513	                        f"persisted case {expected['problem_id']} must have {field}=False"
   514	                    )
   515	            checks = {
   516	                "case_role": expected["case_role"],
   517	                "topic_status": expected["expected_topic_status"],
   518	                "promotion_allowed": expected["expected_promotion_allowed"],
   519	                "manual_reason": expected["expected_manual_reason"],
   520	            }
   521	            for field, value in checks.items():
   522	                if actual.get(field) != value:
   523	                    raise DogfoodArchiveError(f"contract expected {field}={value!r}, got {actual.get(field)!r}")
