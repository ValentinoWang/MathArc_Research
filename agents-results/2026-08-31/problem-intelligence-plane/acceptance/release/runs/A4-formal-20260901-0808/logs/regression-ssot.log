   299	function pythonEnvironment() {
   300	  return { ...process.env, PYTHONPATH: [ROOT, process.env.PYTHONPATH].filter(Boolean).join(":") };
   301	}
   302	
   303	function runPython(program, args, label) {
   304	  const completed = spawnSync(PYTHON, ["-c", program, ...args], {
   305	    cwd: ROOT,
   306	    encoding: "utf8",
   307	    env: pythonEnvironment(),
   308	  });
   309	  if (completed.status !== 0) fail(`${label}: ${completed.stderr || completed.stdout}`);
   310	  try {
   311	    return JSON.parse(completed.stdout);
   312	  } catch (error) {
   313	    fail(`${label} emitted invalid JSON: ${completed.stdout || error.message}`);
   314	  }
   315	}
   316	
   317	function wait(milliseconds) {
   318	  return new Promise(resolve => setTimeout(resolve, milliseconds));
   319	}
   320	
   321	async function waitFor(predicate, message, timeout = 8000) {
   322	  const deadline = Date.now() + timeout;
   323	  while (Date.now() < deadline) {
   324	    if (await predicate()) return;
   325	    await wait(25);
   326	  }
   327	  fail(message);
   328	}
