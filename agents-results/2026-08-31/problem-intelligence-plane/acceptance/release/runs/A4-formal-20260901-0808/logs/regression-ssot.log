    65	class DogfoodArchiveRunner:
    66	    """Run and replay exactly three checked-in, provenance-bound archives."""
    67	    def __init__(self, root: str | Path, fixture_root: str | Path) -> None:
    68	        self.root, self.fixture_root = Path(root), Path(fixture_root)
    69	        self.root.mkdir(parents=True, exist_ok=True)
    70	        self.contract_path = self.fixture_root / "three-real-archives.json"
    71	        if not self.contract_path.exists(): self.contract_path = self.fixture_root.parent / "t2-fixtures" / "three-real-archives.json"
    72	        self.result_path = self.root / "dogfood-archives.json"
    73	        self.contract: dict[str, Any] = {}
    74	
    75	    def run(self) -> dict[str, Any]:
    76	        self.contract = self._load_contract()
    77	        fixtures = self._load_s1_fixtures()
    78	        specs = self._load_source_specs()
    79	        try:
    80	            if self.result_path.exists(): return self._replay(specs)
    81	            return self._execute(fixtures, specs)
    82	        except DogfoodArchiveError:
    83	            raise
    84	        except ManualQueueObservationError as exc:
    85	            raise DogfoodArchiveError(
    86	                f"topic observation manual queue does not match persisted archive: {exc}"
    87	            ) from exc
    88	        except TopicObservationError as exc:
    89	            raise DogfoodArchiveError(
    90	                f"topic observation state is missing or invalid: {exc}"
    91	            ) from exc
    92	        except (KeyError, TypeError, ValueError, OSError) as exc:
    93	            raise DogfoodArchiveError(
    94	                f"topic observation state is missing or invalid: {exc}"
    95	            ) from exc
    96	
    97	    def _load_contract(self) -> dict[str, Any]:
    98	        try: contract = json.loads(self.contract_path.read_text(encoding="utf-8"))
    99	        except (OSError, json.JSONDecodeError) as exc: raise DogfoodArchiveError("T2 contract is unreadable") from exc
   100	        if not isinstance(contract, dict): raise DogfoodArchiveError("T2 contract must be an object")
   101	        _fields(contract, {"fixture_kind", "topic_id", "source_fixture_directory", "fixture_sha256", "source_artifacts", "expected_budget_snapshot", "expected_budget_digest_sha256", "non_claim_boundary", "cases"}, "T2 contract")
   102	        if contract["fixture_kind"] != "t2-dogfood-archive-contract" or contract["topic_id"] != _TOPIC_ID: raise DogfoodArchiveError("incompatible T2 contract identity")
   103	        if contract["source_fixture_directory"] != _EXPECTED_SOURCE_FIXTURE_DIRECTORY:
   104	            raise DogfoodArchiveError("T2 source fixture directory identity drift")
   105	        if (self.contract_path.parent / contract["source_fixture_directory"]).resolve() != self.fixture_root.resolve():
   106	            raise DogfoodArchiveError("T2 source fixture directory does not match runner input")
   107	        if contract["non_claim_boundary"] != _EXPECTED_NON_CLAIM_BOUNDARY:
   108	            raise DogfoodArchiveError("T2 non-claim boundary identity drift")
   109	        if not isinstance(contract["cases"], list) or len(contract["cases"]) != 3: raise DogfoodArchiveError("T2 contract must define exactly three cases")
   110	        case_fields = {"problem_id", "case_role", "expected_topic_status", "expected_problem_status", "expected_manual_reason", "expected_novelty_status", "expected_promotion_allowed"}
   111	        ids = []
   112	        for case in contract["cases"]:
   113	            if not isinstance(case, dict): raise DogfoodArchiveError("T2 contract case must be an object")
   114	            _fields(case, case_fields, "T2 contract case")
   115	            problem_id = _text(case["problem_id"], "contract problem_id")
   116	            if problem_id not in _ROLES or case["case_role"] != _ROLES[problem_id]: raise DogfoodArchiveError("unknown or mismatched contract case")
   117	            if case["expected_promotion_allowed"] is not False: raise DogfoodArchiveError("dogfood promotion must remain disabled")
   118	            ids.append(problem_id)
   119	        if tuple(ids) != _CASE_ORDER: raise DogfoodArchiveError("contract case order or identity drift")
   120	        if set(contract["fixture_sha256"]) != set(_S1_NAMES) or any(not isinstance(value, str) or len(value) != 64 for value in contract["fixture_sha256"].values()):
   121	            raise DogfoodArchiveError("fixture_sha256 must cover exactly the three S1 fixtures")
   122	        if contract["expected_budget_snapshot"] != self._new_residual_budget().to_dict():
   123	            raise DogfoodArchiveError("T2 contract budget identity is incompatible")
   124	        if contract["expected_budget_digest_sha256"] != digest_json(contract["expected_budget_snapshot"]):
   125	            raise DogfoodArchiveError("T2 contract budget digest mismatch")
   126	        if not isinstance(contract["source_artifacts"], dict): raise DogfoodArchiveError("source_artifacts must be an object")
   127	        return contract
   128	
   129	    @staticmethod
   130	    def _new_residual_budget() -> BudgetLedger:
   131	        budget = BudgetLedger(input_token_limit=1)
   132	        budget.charge_model_usage({"input_tokens": 1})
   133	        return budget
   134	
   135	    def _load_s1_fixtures(self) -> dict[str, dict[str, Any]]:
   136	        paths = sorted(self.fixture_root.glob("*.json"))
   137	        if tuple(path.name for path in paths) != tuple(sorted(_S1_NAMES)): raise DogfoodArchiveError("S1 fixture directory must contain exactly the three named fixtures")
   138	        values = {}
   139	        for path in paths:
   140	            expected_sha = self.contract["fixture_sha256"].get(path.name)
   141	            actual_sha = hashlib.sha256(path.read_bytes()).hexdigest()
   142	            if expected_sha != actual_sha: raise DogfoodArchiveError(f"S1 fixture digest mismatch: {path.name}")
   143	            try: payload = json.loads(path.read_text(encoding="utf-8"))
   144	            except (OSError, json.JSONDecodeError) as exc: raise DogfoodArchiveError(f"fixture is unreadable: {path.name}") from exc
   145	            if not isinstance(payload, dict): raise DogfoodArchiveError(f"fixture must be an object: {path.name}")
   146	            problem_id = _text(payload.get("problem_id"), "problem_id")
   147	            if problem_id not in _ROLES or payload.get("case_role") != _ROLES[problem_id]: raise DogfoodArchiveError("unknown or mismatched S1 case")
   148	            for field in ("statement", "source_assertions", "expected_report_status", "limitations"):
   149	                if field not in payload: raise DogfoodArchiveError(f"missing S1 fixture field: {field}")
   150	            if not isinstance(payload["source_assertions"], list) or not payload["source_assertions"]:
   151	                raise DogfoodArchiveError("missing source assertions")
   152	            for assertion in payload["source_assertions"]:
   153	                if not isinstance(assertion, dict): raise DogfoodArchiveError("malformed source assertion")
   154	                required = {"source_kind", "assertion"} | ({"source_path"} if problem_id != _CASE_ORDER[1] else set())
   155	                if problem_id == _CASE_ORDER[1]:
   156	                    if not required.issubset(assertion): raise DogfoodArchiveError("missing S1 source assertion fields")
   157	                else:
   158	                    _fields(assertion, required, "S1 source assertion")
   159	            if problem_id == _CASE_ORDER[1]:
   160	                chain = payload.get("source_chain")
   161	                if not isinstance(chain, list) or not chain: raise DogfoodArchiveError("missing collision source_chain")
   162	                for entry in chain: _fields(entry, {"source_kind", "canonical_uri", "pinned_version", "locator", "assertion"}, "collision source provenance")
   163	            values[problem_id] = payload
   164	        if set(values) != set(_CASE_ORDER): raise DogfoodArchiveError("S1 fixtures do not define exactly three cases")
   165	        return {key: values[key] for key in _CASE_ORDER}
   166	
   167	    def _load_source_specs(self) -> dict[str, list[dict[str, str]]]:
   168	        raw = self.contract["source_artifacts"]
   169	        specs: dict[str, list[dict[str, str]]] = {}
   170	        required = {"path", "sha256", "canonical_uri", "pinned_version", "locator"}
   171	        for problem_id in _CASE_ORDER:
   172	            if problem_id not in raw: raise DogfoodArchiveError(f"missing source_artifacts for {problem_id}")
   173	            entries = raw[problem_id] if isinstance(raw[problem_id], list) else [raw[problem_id]]
   174	            specs[problem_id] = []
   175	            for item in entries:
   176	                if not isinstance(item, dict): raise DogfoodArchiveError("source artifact spec must be an object")
   177	                _fields(item, required | ({"source_kind", "reported_status"} if problem_id == _CASE_ORDER[1] else set()), "source artifact spec")
   178	                path = self.contract_path.parent / item["path"]
   179	                if not path.is_file(): raise DogfoodArchiveError(f"missing source artifact: {item['path']}")
   180	                content = path.read_bytes()
   181	                if hashlib.sha256(content).hexdigest() != item["sha256"]: raise DogfoodArchiveError(f"source artifact digest mismatch: {item['path']}")
   182	                for field in required: _text(item[field], field)
   183	                specs[problem_id].append(dict(item))
   184	        return specs
   185	
   186	    def _inputs_for(self, fixture: Mapping[str, Any], specs: list[dict[str, str]]) -> tuple[tuple[TopicObservationInput, ...], list[dict[str, str]]]:
   187	        inputs, provenance = [], []
   188	        for index, spec in enumerate(specs):
   189	            path, content = self.contract_path.parent / spec["path"], (self.contract_path.parent / spec["path"]).read_bytes()
   190	            source_id = "source-" + hashlib.sha256(f"{spec['canonical_uri']}|{spec['pinned_version']}".encode()).hexdigest()[:24]
   191	            observation = SourceObservation(source_id, spec["canonical_uri"], spec["pinned_version"], "2026-08-31T11:00:00+00:00", LicenseStatus.OPEN, "Checked-in pinned artifact license/provenance record.", f"Pinned source artifact for {fixture['case_role']}.", "T2 source artifact contract.", "text/html" if path.suffix == ".html" else "text/plain", hashlib.sha256(content).hexdigest())
   192	            inputs.append(TopicObservationInput(f"{fixture['problem_id']}:source:{index:02d}", observation, content))
   193	            provenance.append({"source_id": source_id, "source_kind": spec.get("source_kind", "local-document"), "canonical_uri": spec["canonical_uri"], "pinned_version": spec["pinned_version"], "locator": spec["locator"], "artifact_path": spec["path"], "content_sha256": observation.content_digest_sha256, **({"reported_status": spec["reported_status"]} if "reported_status" in spec else {})})
   194	        return tuple(inputs), provenance
   195	
   196	    def _execute(self, fixtures: Mapping[str, Mapping[str, Any]], specs: Mapping[str, list[dict[str, str]]]) -> dict[str, Any]:
   197	        main = TopicObservationRunner(self.root / "topic-observation", topic_id=_TOPIC_ID, initial_cursor="dogfood-c0")
   198	        fi, fp = self._inputs_for(fixtures[_CASE_ORDER[0]], specs[_CASE_ORDER[0]])
   199	        first, replay = main.run(TopicObservationBatch(_TOPIC_ID, "dogfood-c0", "dogfood-c1", fi)), main.run(TopicObservationBatch(_TOPIC_ID, "dogfood-c0", "dogfood-c1", fi))
   200	        if first.status is not TopicRunStatus.APPLIED or replay.status is not TopicRunStatus.REPLAYED: raise DogfoodArchiveError("Frankl cursor replay failed")
   201	        ci, cp = self._inputs_for(fixtures[_CASE_ORDER[1]], specs[_CASE_ORDER[1]])
   202	        cr = main.run(TopicObservationBatch(_TOPIC_ID, "dogfood-c1", "dogfood-c2", ci))
   203	        if cr.status is not TopicRunStatus.APPLIED: raise DogfoodArchiveError("collision source import failed")
   204	        observations = {item.observation_id: item for item in main.literature.observations}
   205	        cs = self._reported_status(fixtures[_CASE_ORDER[0]], fp, observations, main), self._reported_status(fixtures[_CASE_ORDER[1]], cp, observations, main)
   206	        alert = TopicObservationInput("collision-review-alert", ci[0].observation, ci[0].content, ("reported-resolution",))
   207	        ar = main.run(TopicObservationBatch(_TOPIC_ID, "dogfood-c2", "dogfood-c3", (alert,)))
   208	        duplicate = TopicObservationInput("collision-review-recheck", ci[0].observation, ci[0].content)
   209	        dr = main.run(TopicObservationBatch(_TOPIC_ID, "dogfood-c3", "dogfood-c4", (duplicate,)))
   210	        if ar.status is not TopicRunStatus.MANUAL_REVIEW or dr.item_results[0].status.value != "DUPLICATE": raise DogfoodArchiveError("collision review/replay boundary failed")
   211	        ri, rp = self._inputs_for(fixtures[_CASE_ORDER[2]], specs[_CASE_ORDER[2]])
   212	        budget = self._new_residual_budget()
   213	        residual_runner = TopicObservationRunner(self.root / "residual-budget", topic_id=_TOPIC_ID, initial_cursor="budget-c0", budget=budget)
   214	        rr = residual_runner.run(TopicObservationBatch(_TOPIC_ID, "budget-c0", "budget-c1", ri))
   215	        if rr.status is not TopicRunStatus.MANUAL_REVIEW: raise DogfoodArchiveError("residual budget boundary failed")
   216	        rs = self._insufficient_status(fixtures[_CASE_ORDER[2]], ri[0].observation, residual_runner)
   217	        blocking_entries = self._manual_queue_entries(main, residual_runner)
   218	        blocking = [item["manual_id"] for item in blocking_entries]
