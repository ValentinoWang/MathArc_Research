   525	                raise DogfoodArchiveError("contract expected problem status drift")
   526	            novelty_status = actual["novelty"]["authorization_status"] if actual["novelty"] else None
   527	            if novelty_status != expected["expected_novelty_status"]:
   528	                raise DogfoodArchiveError("contract expected novelty status drift")
