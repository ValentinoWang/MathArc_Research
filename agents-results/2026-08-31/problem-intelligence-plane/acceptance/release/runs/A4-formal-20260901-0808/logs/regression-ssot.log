   536	            raise DogfoodArchiveError(
   537	                f"persisted archive schema_version {schema_version!r} is legacy; "
   538	                f"recovery contract {_RECOVERY_CONTRACT!r} requires preserving the "
   539	                "legacy archive and rerunning the checked-in dogfood inputs"
   540	            )
   541	        if schema_version != _SCHEMA_VERSION:
   542	            raise DogfoodArchiveError(
   543	                f"unsupported persisted archive schema_version {schema_version!r}; "
   544	                f"recovery contract {_RECOVERY_CONTRACT!r} requires an explicit "
