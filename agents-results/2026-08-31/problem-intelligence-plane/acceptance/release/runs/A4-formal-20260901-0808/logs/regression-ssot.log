    53	class DogfoodArchiveError(ValueError):
    54	    """Raised when a fixture, source artifact, or persisted archive is invalid."""
    55	
    56	def _text(value: object, field: str) -> str:
    57	    if not isinstance(value, str) or not value.strip(): raise DogfoodArchiveError(f"{field} must be non-empty")
    58	    return value
    59	
    60	def _fields(value: Mapping[str, Any], expected: set[str], name: str) -> None:
    61	    unknown, missing = set(value) - expected, expected - set(value)
    62	    if unknown: raise DogfoodArchiveError(f"unknown {name} fields: {sorted(unknown)}")
    63	    if missing: raise DogfoodArchiveError(f"missing {name} fields: {sorted(missing)}")
